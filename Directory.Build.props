<Project>
  <!-- 全仓库共用的构建设置；各项目只写自己不同的部分。按项目属性（IsLibrary）区分的设置在 Directory.Build.targets -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 版本要在 props 里定：SDK 在导入 Directory.Build.targets 之前就算好了版本 -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <!-- 全仓库的分析器级别（RUNE006 等） -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)rune.globalconfig" />
  </ItemGroup>

  <!-- CI 上做确定性构建（路径规范化，包可复现） -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    本地构建不带提交号（InformationalVersion 里的、SourceLink 的源码地址里的）：它们是编译的输入，每次提交后所有项目都要重新编译，
    源生成器重新编译后还要拷进 bin，而语言服务器（csharp-ls）加载着它、文件被锁，构建失败。本地调试用不上 SourceLink；CI 上照常
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
</Project>
