@*
    文档站的外壳（同 vue-tsx-pro 文档站的 App）：AppShell 的顶栏（站点名、搜索、主题切换、仓库链接、全屏）、左侧的站点导航、右侧的本页目录，
    正文是当前路由的页面，末尾是上一篇 / 下一篇。导航、搜索、翻页都取文档目录（DocsCatalog），顺序一致。
    换页时路由交来新的 Body，外壳重新渲染一次；侧栏、顶栏工具、本页目录是各自独立、没有参数的组件，不跟着重来。
    主题与配置的 RuneProvider 在 Routes 里（顶部的加载条也要取主题的变量）。
*@
@inherits RuneLayoutComponent
@inject NavigationManager Navigation
@* 启动时就建好：它要记下打开站点时的那一页（那一页的示例不排队） *@
@inject RenderQueue RenderQueue

@* 首页没有右侧栏（同 vue：aside 只在非首页给），正文占满剩下的宽度 *@
<AppShell PropsMain="MainLayer" Aside="@(IsHome ? null : Toc)">
    <Brand><AppShellBrand Href="" Icon="Lucide.Boxes">Rune</AppShellBrand></Brand>
    <Header><DocsHeaderTools /></Header>
    <Sidebar><DocsNav /></Sidebar>
    <ChildContent>
        <div @attributes="Attrs.Merge(PageLayer)">
            @* 按地址换 key：每次换页重新播放进场动画 *@
            <div @key="Path" @attributes="Attrs.Merge(EnterLayer)">@Body</div>
            @if (!IsHome && Neighbors() is var (previous, next))
            {
                <Container Size="@(Path.StartsWith("components/", StringComparison.Ordinal) ? ContainerSize.Xl : ContainerSize.Md)" Padding="SpaceScale.None">
                    <Pager Previous="previous" Next="next" Sx="PagerStyle" />
                </Container>
            }
        </div>
    </ChildContent>
</AppShell>
<Toaster />
<DialogHost />

@code {
    /// <summary>仓库地址（顶栏与窄屏侧栏的链接）。</summary>
    internal const string Repository = "https://github.com/kenconnet666/RuneForBlazor";

    static readonly RenderFragment Toc = @<DocsToc />;

    static readonly Attrs MainLayer = new() { Sx = Main };
    static readonly Attrs PageLayer = new() { Sx = Page };
    static readonly Attrs EnterLayer = new() { Sx = Enter };

    string Path => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    bool IsHome => Path.Length == 0;

    // 上一篇 / 下一篇：侧栏顺序
    (PagerLink? Previous, PagerLink? Next) Neighbors()
    {
        var all = DocsCatalog.All;
        var index = all.ToList().FindIndex(p => p.Path.Trim('/') == Path);
        if (index < 0) return (null, null);
        static PagerLink Link(DocEntry entry) => new(entry.Path.TrimStart('/'), entry.Meta.Title);
        return (index > 0 ? Link(all[index - 1]) : null, index < all.Count - 1 ? Link(all[index + 1]) : null);
    }

    // 标题离顶栏远一点，页底留出空白，不贴着窗口下沿
    static Style Main => Css.Define(static () => new Style { PaddingBlockStart = CssLength.Rem(2.5), PaddingBlockEnd = CssLength.Rem(4) });

    static Style Page => Css.Define(static () => new Style { Display = Display.Flex, FlexDirection = FlexDirection.Column, Gap = Space.Xl });

    // 换页时新页面轻轻浮上来；时长取主题 token，“减少动态效果”时为 0
    static Style Enter => Css.Define(static () => new Style
    {
        Keyframes = PageEnter,
        AnimationDuration = Durations.Md,
        AnimationTimingFunction = Easings.Enter,
    });

    static Keyframes PageEnter => Css.Define(static () => new Keyframes
    {
        ["from"] = new() { Opacity = 0, Transform = "translateY(6px)" },
        ["to"] = new() { Opacity = 1, Transform = "none" },
    });

    static Style PagerStyle => Css.Define(static () => new Style { MarginBlockStart = Space.Xl });
}
