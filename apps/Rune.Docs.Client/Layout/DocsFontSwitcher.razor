@*
    顶栏的字体切换（同 vue-tsx-pro 文档站的 FontSwitcher）：图标按钮弹出单选菜单，在系统字体（默认）、更纱黑体等宽、
    霞鹜文楷等宽之间换。记住选择、加载字体、换字体变量都在 wwwroot/fonts.js 与 app.css。
*@
@inherits RuneComponent
@using Microsoft.JSInterop
@inject IJSRuntime JS

<Menu>
    <Trigger Context="t"><IconButton Icon="Lucide.Type" Label="字体" @attributes="t" /></Trigger>
    <ChildContent>
        <MenuRadioGroup aria-label="字体" Value="@font" ValueChanged="Choose">
            @foreach (var (name, label) in Fonts)
            {
                <MenuRadioItem @key="name" Value="@name">@label</MenuRadioItem>
            }
        </MenuRadioGroup>
    </ChildContent>
</Menu>

@code {
    // 菜单里按这个顺序列出；名字与 fonts.js 的一致
    static readonly (string Name, string Label)[] Fonts =
    [
        ("system", "系统字体（苹方、微软雅黑）"),
        ("sarasa", "更纱黑体等宽"),
        ("wenkai", "霞鹜文楷等宽"),
    ];

    string font = "system";

    // 预渲染时读不到浏览器里的选择：交互后再取，选中标记随后对上
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string>("docsFonts.get");
        if (stored == font) return;
        font = stored;
        StateHasChanged();
    }

    async Task Choose(string? name)
    {
        font = name ?? "system";
        await JS.InvokeVoidAsync("docsFonts.set", font);
    }
}
