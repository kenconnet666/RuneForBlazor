@*
    交互演示：同一个组件分别以 Server、WebAssembly、Auto 三种模式挂载（见 Pages/Demo*.razor）。
    交互根里放一个 RuneStyles，输出这个交互模式下新用到的样式。
*@
@inherits RuneComponent
@inject CounterStore Store

<RuneStyles />

<h1>@Heading</h1>
<p>运行在 @RendererInfo.Name（@(RendererInfo.IsInteractive ? "已交互" : "预渲染")）</p>

<section @attributes="Attrs.Merge(DemoStyles.Section)">
    <h2>信号：只重新渲染读了它的组件</h2>
    <div @attributes="Attrs.Merge(DemoStyles.Row)">
        <button @onclick="() => Store.A++">A + 1</button>
        <button @onclick="() => Store.B++">B + 1</button>
    </div>
    <CounterView Label="A" />
    <CounterView Label="B" />
    <CounterView Label="Sum" />
</section>

<section @attributes="Attrs.Merge(DemoStyles.Section)">
    <h2>双向绑定与样式覆盖</h2>
    <Collapsible @bind-Open="FiltersOpen" Variant="CollapsibleVariant.Outline"
                 PropsTrigger="@(new() { Sx = DemoStyles.AccentWhenExpanded })">
        <Title>受控（@@bind-Open）：父级的值是 @FiltersOpen</Title>
        <ChildContent>展开时标题变成强调色：来自使用方的 PropsTrigger.Sx，只覆盖展开这一个状态。</ChildContent>
    </Collapsible>
    <Collapsible Open="true">
        <Title>非受控：只给了初始值</Title>
        <ChildContent>组件自己维护展开状态，父级不会因此重新渲染。</ChildContent>
    </Collapsible>
</section>
