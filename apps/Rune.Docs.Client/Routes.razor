@*
    文档站的路由：首页、找不到页面在这里，指南与组件页在 Rune.Docs.Content（带 @page 与 [DocMeta]）。
    整个路由是 WebAssembly 的交互根（App.razor 给它加 @rendermode）：交互模式下新用到的样式由这里的 RuneStyles 输出。
    顶部的加载条：预渲染的页面显示后 WebAssembly 还在下载、启动（这期间点什么都没反应）时在走，接管后消失；
    只有部分页面用到的程序集（图表、地图数据、省市区，见 LazyAssemblies）进入那些页面前才下载，期间同样显示。
*@
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inherits RuneComponent
@inject LazyAssemblyLoader Loader
@inject RenderQueue Queue

<RuneStyles />
@* 应用级主题在最外层：加载条与各页面都在里面（主题的变量只在这个类下面有定义） *@
<RuneProvider>
    <LoadingBar Controller="bar" Startup="true" />
    <Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="[typeof(DocsCatalog).Assembly]" NotFoundPage="typeof(Pages.NotFound)"
            OnNavigateAsync="LoadAssembliesAsync">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(DocsLayout)" />
            @* 站内换页后把焦点移到标题上。打开站点的第一页不做：页面是浏览器自己加载的，它已经滚到 #锚点（或刷新前的位置），
               交互接管时再聚焦标题会把页面拉回顶部 *@
            @if (Queue.Deferring)
            {
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            }
        </Found>
    </Router>
</RuneProvider>

@code {
    readonly LoadingBarController bar = new();
    readonly HashSet<string> loaded = [];

    // 页面用到的程序集在渲染页面之前加载好（第一次打开时下载，之后在内存里）
    async Task LoadAssembliesAsync(NavigationContext context)
    {
        var files = LazyAssemblies.For(context.Path).Where(f => !loaded.Contains(f)).ToList();
        if (files.Count == 0) return;
        bar.Start();
        try
        {
            await Loader.LoadAssembliesAsync(files);
            loaded.UnionWith(files);
            bar.Finish();
        }
        catch
        {
            bar.Error();
            throw;
        }
    }
}
