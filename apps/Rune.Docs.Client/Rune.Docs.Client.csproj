<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- 文档与演示的页面：可以在服务端渲染，也可以在浏览器里（WebAssembly）运行 -->
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="..\..\src\Rune.UI\Rune.UI.csproj" />
    <ProjectReference Include="..\..\src\Rune\Rune.csproj" />
    <!-- [State] 生成器：以分析器方式引用 -->
    <ProjectReference Include="..\..\src\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
