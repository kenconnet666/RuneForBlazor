<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- 文档站的 WebAssembly 端：路由、站点外壳（AppShell）与首页；页面内容在 Rune.Docs.Content。
       整站在浏览器里运行（预渲染出 HTML，WebAssembly 接管），可以导出成静态文件部署 -->
  <PropertyGroup>
    <RootNamespace>Rune.Docs.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- 数字、金额按语言包的语言格式化（LangFormat），不随浏览器的语言：默认只按浏览器语言加载一片 ICU 数据，
         英文浏览器里取不到 zh-CN（金额显示成 CNY 而不是 ¥），所以加载全部 -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- 只有部分页面用到的程序集：启动时不下载，进入那些页面前由 Routes 加载（LazyAssemblies）。
       AOT（-p:RunAOTCompilation=true）时不懒加载：启动时懒加载的程序集还没到，依赖它们的 AOT 模块（内容项目、收着全部泛型实例的
       aot-instances）整个不可用、退回解释执行，而方法的 IL 在 AOT 后已经剥掉，一启动就报 function signature mismatch
       或解释器的断言（dotnet/runtime#109550） -->
  <PropertyGroup Condition="'$(RunAOTCompilation)' != 'true'">
    <DefineConstants>$(DefineConstants);LAZY_ASSEMBLIES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RunAOTCompilation)' != 'true'">
    <BlazorWebAssemblyLazyLoad Include="Rune.Charts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Rune.Charts.Maps.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Rune.UI.Area.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Rune.Three.wasm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <ProjectReference Include="..\Rune.Docs.Content\Rune.Docs.Content.csproj" />
    <ProjectReference Include="..\..\src\Rune\Rune.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI\Rune.UI.csproj" />
    <ProjectReference Include="..\..\src\Rune.Icons\Rune.Icons.csproj" />
    <ProjectReference Include="..\..\src\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Rune.CodeFixes\Rune.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
