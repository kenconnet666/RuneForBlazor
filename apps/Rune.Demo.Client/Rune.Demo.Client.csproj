<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- 渲染模式测试台的 WebAssembly 端：文档内容（Rune.Docs.Content）的页面按地址里的模式运行（静态 SSR、Server、WebAssembly、Auto） -->
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- 数字、金额按语言包的语言格式化（LangFormat），不随浏览器的语言：默认只按浏览器语言加载一片 ICU 数据，
         英文浏览器里取不到 zh-CN（金额显示成 CNY 而不是 ¥），所以加载全部 -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- 页面与示例都在文档内容里：这里按渲染模式渲染它们 -->
    <ProjectReference Include="..\Rune.Docs.Content\Rune.Docs.Content.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI\Rune.UI.csproj" />
    <ProjectReference Include="..\..\src\Rune\Rune.csproj" />
    <ProjectReference Include="..\..\src\Rune.Icons\Rune.Icons.csproj" />
    <!-- [State] 生成器：以分析器方式引用 -->
    <ProjectReference Include="..\..\src\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Rune.CodeFixes\Rune.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
