@* 首页：页面目录。每个页面都能以四种渲染模式打开 *@
@page "/"
@inherits RuneComponent

<PageTitle>Rune 渲染模式测试台</PageTitle>

<h1>Rune 渲染模式测试台</h1>
<p>
    文档站（Rune.Docs.Content）的每个页面都能在这里以四种渲染模式打开：左侧选页面，页面顶部切换渲染模式；
    改代码用 <code>dotnet watch --project apps/Rune.Demo</code>，保存后热重载。
</p>

@foreach (var section in DocsCatalog.Sections)
{
    <H2 Size="Size.Lg">@section.Label</H2>
    @foreach (var entry in section.Pages)
    {
        <Flex Wrap="true" Gap="SpaceScale.Sm" Align="ItemAlign.Center">
            <strong>@entry.Meta.Title</strong>
            @foreach (var (mode, title) in DemoRenderModes.All)
            {
                <a href="@($"{mode}/{entry.Slug}")">@title</a>
            }
        </Flex>
    }
}

<H2 Size="Size.Lg">渲染方式</H2>
<a href="streaming">流式渲染</a>
