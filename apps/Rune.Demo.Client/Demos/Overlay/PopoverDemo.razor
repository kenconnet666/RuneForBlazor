@*
    弹出框、提示与悬停卡片：示例与 vue-tsx-pro 文档站的 /components/popover 对应。数据是虚构的。
*@
@attribute [ComponentDemo("popover", "弹出框与提示", Group = "浮层", Order = 0)]
@inherits RuneComponent

<DemoSection Id="popover" Title="Popover">
    <Description><Code>Trigger</Code> 拿到要加在触发元素上的属性（<Code>@@attributes="t"</Code>），组件接管打开、定位与 aria-expanded。打开时焦点移进去，点外面、Esc 关闭，焦点回到触发元素。弹出层是 role="dialog"，名称默认取触发元素的文字。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <Flex Gap="SpaceScale.Sm" Wrap="true">
                <Popover @bind-Open="sharing" Placement="Placement.BottomStart" Arrow="true">
                    <Trigger Context="t"><Button @attributes="t" Icon="Lucide.Share2">分享</Button></Trigger>
                    <ChildContent>
                        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" style="width: 20rem">
                            <Strong>分享“第三季度报告”</Strong>
                            <Flex Gap="SpaceScale.Xs">
                                <TextField Value="@link" ReadOnly="true" aria-label="分享链接" />
                                <CopyButton Value="@link" />
                            </Flex>
                            <Switch @bind-Value="comments">允许查看者评论</Switch>
                        </Flex>
                    </ChildContent>
                </Popover>
                <Popover @bind-Open="filtering" Placement="Placement.BottomStart" data-testid="filter-popover">
                    <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Outline" Tone="Tone.Neutral" Icon="Lucide.Funnel">订单状态@(applied.Count > 0 ? $"（{applied.Count}）" : "")</Button></Trigger>
                    <ChildContent>
                        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                            <CheckboxGroup Items="statuses" @bind-Value="picked" aria-label="订单状态" />
                            <Flex Gap="SpaceScale.Sm" Justify="ContentJustify.End">
                                <Button Size="Size.Sm" Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" @onclick="() => picked = []">清空</Button>
                                <Button Size="Size.Sm" @onclick="Apply">应用</Button>
                            </Flex>
                        </Flex>
                    </ChildContent>
                </Popover>
            </Flex>
            <Small Tone="TextTone.Muted">筛选：@(applied.Count > 0 ? string.Join("、", applied) : "全部状态")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="tooltip" Title="Tooltip">
    <Description>给图标按钮补一句用途和快捷键。指针停一会儿显示，在一排按钮上移动时不用每次都等；键盘聚焦立即显示，Esc 隐藏。提示经 aria-describedby 补充说明，触发元素自己要有名称，提示里不放可交互的内容。同一个按钮既有提示又打开菜单时，用 <Code>Attrs.Merge(tip, menu)</Code> 合并两个触发元素的属性。</Description>
    <ChildContent>
        <Card Padding="SpaceScale.Xs">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs" Wrap="true">
                @for (var index = 0; index < toolGroups.Length; index++)
                {
                    if (index > 0)
                    {
                        <Separator Orientation="Orientation.Vertical" />
                    }
                    foreach (var (icon, label, shortcut) in toolGroups[index])
                    {
                        <Tooltip @key="label">
                            <Trigger Context="t"><IconButton @attributes="t" Icon="icon" Label="@label" /></Trigger>
                            <ChildContent>@label@if (shortcut is not null)
                                {
                                    @(" ")@ShortcutKeys(shortcut)
                                }</ChildContent>
                        </Tooltip>
                    }
                }
                <Separator Orientation="Orientation.Vertical" />
                @* 同一个按钮既有提示又打开菜单：合并两边交给触发元素的属性 *@
                <Tooltip>
                    <Trigger Context="tip">
                        <Menu>
                            <Trigger Context="menu"><IconButton @attributes="Attrs.Merge(tip, menu)" Icon="Lucide.Ellipsis" Label="更多格式" /></Trigger>
                            <ChildContent>
                                <MenuItem>上标</MenuItem>
                                <MenuItem>下标</MenuItem>
                                <MenuItem>清除格式</MenuItem>
                            </ChildContent>
                        </Menu>
                    </Trigger>
                    <ChildContent>更多格式</ChildContent>
                </Tooltip>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="hover-card" Title="HoverCard">
    <Description>悬停或聚焦链接时弹出一张富内容卡片：可以移到卡片上，卡片里能放按钮（键盘 Tab 进入）。卡片只是预览，里面的信息在别处也要能拿到——触屏没有悬停。</Description>
    <ChildContent>
        <Paragraph>
            这一版的设计由 @Mention(people[0]) 负责，组件实现与文档是 @Mention(people[1]) 做的。把指针停在名字上，或用 Tab 聚焦它，就能看到资料卡。
        </Paragraph>
    </ChildContent>
</DemoSection>

<DemoSection Id="placement" Title="位置与箭头">
    <Description><Code>Placement</Code> 是边加对齐，共 12 种；空间不够时自动翻到另一边、贴着视口平移。<Code>Arrow</Code> 显示指向触发元素的小箭头。</Description>
    <ChildContent>
        <div @attributes="Attrs.Merge(PlacementGrid)">
            @foreach (var placement in placementCells)
            {
                if (placement is { } value)
                {
                    <Tooltip @key="value" Placement="value" Arrow="true">
                        <Trigger Context="t"><Button @attributes="t" Size="Size.Sm" Variant="ButtonVariant.Outline" Tone="Tone.Neutral">@Floating.NameOf(value)</Button></Trigger>
                        <ChildContent>placement="@Floating.NameOf(value)"</ChildContent>
                    </Tooltip>
                }
                else
                {
                    <span></span>
                }
            }
        </div>
    </ChildContent>
</DemoSection>

<DemoSection Id="timing" Title="显示的时机">
    <Description>Tooltip 的 <Code>Delay</Code> 是指针停多久才显示（默认 500 毫秒），工具栏这类连续的按钮可以设成 0；<Code>Disabled</Code> 时只渲染触发元素。HoverCard 的 <Code>Delay</Code> / <Code>CloseDelay</Code> 分别控制打开与离开后关闭的等待，<Code>Offset</Code> 是与触发元素的距离（像素）。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg" Align="ItemAlign.Start">
            <Flex Gap="SpaceScale.Md" Align="ItemAlign.Center" Wrap="true">
                <Flex Gap="SpaceScale.Xs">
                    @foreach (var (icon, label, shortcut) in marks)
                    {
                        <Tooltip @key="label" Delay="0" Disabled="!hints">
                            <Trigger Context="t"><IconButton @attributes="t" Icon="icon" Label="@label" Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" /></Trigger>
                            <ChildContent>@label <Kbd>@shortcut</Kbd></ChildContent>
                        </Tooltip>
                    }
                </Flex>
                <Switch @bind-Value="hints">显示按钮提示</Switch>
            </Flex>
            <Flex Gap="SpaceScale.Lg" Align="ItemAlign.Center" Wrap="true">
                <Tooltip Delay="1000">
                    <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Outline" Tone="Tone.Neutral">停一秒才提示</Button></Trigger>
                    <ChildContent>不常用的说明可以等久一点，免得指针划过时到处弹出</ChildContent>
                </Tooltip>
                <Small Tone="TextTone.Muted">
                    作者
                    <HoverCard Delay="200" CloseDelay="600" Offset="12">
                        <Trigger Context="t"><TextLink @attributes="t" Href="server/avatar">@@周一航</TextLink></Trigger>
                        <ChildContent>
                            <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
                                <Avatar Name="周一航" />
                                <Flex Direction="LayoutDirection.Column">
                                    <Strong>周一航</Strong>
                                    <Small Tone="TextTone.Muted">设计中心 · 高级交互设计师</Small>
                                </Flex>
                            </Flex>
                        </ChildContent>
                    </HoverCard>
                    发布于 3 天前
                </Small>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    const string link = "https://example.com/s/q3-report";
    static readonly string[] statuses = ["待付款", "备货中", "已发货", "已完成", "已退款"];

    sealed record Person(string Key, string Name, string Handle, string Bio, string City, string Joined, string Followers);

    static readonly Person[] people =
    [
        new("yihang", "周一航", "@yihang", "交互设计师，做了八年工具类产品。喜欢把复杂的事讲简单。", "上海", "2019 年加入", "1,284"),
        new("xiaoman", "林小满", "@xiaoman", "前端工程师，Rune 的维护者之一。", "杭州", "2021 年加入", "3,096"),
    ];

    // 句子里的 @某人：悬停或聚焦时弹出资料卡
    static RenderFragment Mention(Person person) => @<HoverCard data-testid="@($"card-{person.Key}")">
        <Trigger Context="t"><TextLink @attributes="t" Href="@($"server/popover#{person.Key}")">@person.Handle</TextLink></Trigger>
        <ChildContent>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Md">
                    <Avatar Name="@person.Name" />
                    <Button Size="Size.Sm" Variant="ButtonVariant.Soft">关注</Button>
                </Flex>
                <Flex Direction="LayoutDirection.Column">
                    <Strong>@person.Name</Strong>
                    <Small Tone="TextTone.Muted">@person.Handle</Small>
                </Flex>
                <Paragraph Size="Size.Sm">@person.Bio</Paragraph>
                <Flex Gap="SpaceScale.Md" Wrap="true">
                    <Small Tone="TextTone.Muted"><Icon Data="Lucide.MapPin" /> @person.City</Small>
                    <Small Tone="TextTone.Muted"><Icon Data="Lucide.CalendarDays" /> @person.Joined</Small>
                    <Small Tone="TextTone.Muted">@person.Followers 关注者</Small>
                </Flex>
            </Flex>
        </ChildContent>
    </HoverCard>;

    static readonly (IconData Icon, string Label, string? Shortcut)[][] toolGroups =
    [
        [(Lucide.LetterB, "加粗", "Ctrl B"), (Lucide.Italic, "斜体", "Ctrl I"), (Lucide.Underline, "下划线", "Ctrl U"), (Lucide.Strikethrough, "删除线", null)],
        [(Lucide.List, "无序列表", null), (Lucide.ListOrdered, "有序列表", null), (Lucide.Quote, "引用", null)],
        [(Lucide.Link2, "插入链接", "Ctrl K")],
    ];

    static readonly (IconData Icon, string Label, string Shortcut)[] marks =
    [
        (Lucide.LetterB, "加粗", "Ctrl+B"),
        (Lucide.Italic, "斜体", "Ctrl+I"),
        (Lucide.Underline, "下划线", "Ctrl+U"),
    ];

    // 五行五列围着中间：每条边三个对齐方式
    static readonly Placement?[] placementCells =
    [
        null, Placement.TopStart, Placement.Top, Placement.TopEnd, null,
        Placement.LeftStart, null, null, null, Placement.RightStart,
        Placement.Left, null, null, null, Placement.Right,
        Placement.LeftEnd, null, null, null, Placement.RightEnd,
        null, Placement.BottomStart, Placement.Bottom, Placement.BottomEnd, null,
    ];

    bool sharing;
    bool filtering;
    bool comments = true;
    bool hints = true;
    IReadOnlyList<string> picked = ["待付款", "备货中"];
    IReadOnlyList<string> applied = ["待付款", "备货中"];

    static Style PlacementGrid => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        GridTemplateColumns = "repeat(5, max-content)",
        Gap = Space.Sm,
        JustifyContent = JustifyContent.Center,
    });


    void Apply()
    {
        applied = [.. picked];
        filtering = false;
    }

    // “Ctrl B” → <Kbd>Ctrl</Kbd> + <Kbd>B</Kbd>
    static RenderFragment ShortcutKeys(string shortcut) => builder =>
    {
        var keys = shortcut.Split(' ');
        for (var index = 0; index < keys.Length; index++)
        {
            // 子内容是延后执行的委托：取出当前的键，不捕获循环变量
            var key = keys[index];
            if (index > 0) builder.AddContent(0, " + ");
            builder.OpenComponent<Kbd>(1);
            builder.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, key)));
            builder.CloseComponent();
        }
    };
}
