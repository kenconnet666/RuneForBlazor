@*
    气泡确认：示例与 vue-tsx-pro 文档站的 /components/popconfirm 对应。
    头像用 DemoStyles.Initials 代替（Avatar 在阶段 7 做）；失败提示用现有的 Toast（阶段 6 补齐说明、位置）。
*@
@attribute [ComponentDemo("popconfirm", "气泡确认", Group = "浮层", Order = 2)]
@inherits RuneComponent
@inject ToastService Toasts

<DemoSection Id="members" Title="移出成员">
    <Description><Code>Trigger</Code> 同 Popover。<Code>OnConfirm</Code> 执行期间确认按钮加载中、取消暂不可用，完成后关闭；把参数的 <Code>KeepOpen</Code> 设为 true 时保持打开，可以再试或取消，失败原因由调用方提示（这里用 Toast）。打开时焦点落在“取消”上，误按 Enter 不会执行。弹出层是 role="alertdialog"，以问题为名称、说明为描述。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            @foreach (var member in members)
            {
                <Flex @key="member.Id" Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Md">
                    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                        <span @attributes="Attrs.Merge(DemoStyles.Initials)">@member.Name[..1]</span>
                        <Flex Direction="LayoutDirection.Column">
                            <TextSpan Size="Size.Sm" Weight="Weight.Medium">@member.Name</TextSpan>
                            <Small Tone="TextTone.Muted">@member.Role</Small>
                        </Flex>
                        @if (member.Owner)
                        {
                            <Badge Size="Size.Xs" Variant="StatusVariant.Soft" Tone="Tone.Accent">负责人</Badge>
                        }
                    </Flex>
                    @if (member.Owner)
                    {
                        <Small Tone="TextTone.Muted">不能移出</Small>
                    }
                    else
                    {
                        <Popconfirm Title="@($"把 {member.Name} 移出项目？")" Description="移出后不再收到项目的待办与通知，已提交的记录保留。"
                                    Tone="Tone.Danger" ConfirmText="移出" OnConfirm="e => RemoveAsync(member, e)">
                            <Trigger Context="t"><IconButton @attributes="t" Icon="Lucide.UserMinus" Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" Label="@($"移出 {member.Name}")" /></Trigger>
                        </Popconfirm>
                    }
                </Flex>
            }
            <Flex Justify="ContentJustify.End">
                <Popconfirm Title="清空回收站？" Description="回收站里的 12 个文件将被永久删除。" Tone="Tone.Danger" Icon="Lucide.Trash" ConfirmText="清空"
                            Placement="Placement.TopEnd" OnConfirm="@(() => Toasts.Show("回收站已清空", Tone.Success))">
                    <Trigger Context="t"><Button @attributes="t" Size="Size.Sm" Variant="ButtonVariant.Soft" Tone="Tone.Danger" Icon="Lucide.Trash">清空回收站</Button></Trigger>
                </Popconfirm>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="variants" Title="色调、图标与位置">
    <Description><Code>Tone</Code> 决定图标与确认按钮的颜色，默认 Warning，删除这类用 Danger；<Code>Icon</Code> 换图标，<Code>HideIcon</Code> 不显示。<Code>Placement</Code> 默认在上方，<Code>Arrow</Code> 加指向触发元素的箭头。<Code>OnCancel</Code> 在点取消、点外面、按 Esc 时调用。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Gap="SpaceScale.Sm" Wrap="true">
                <Popconfirm Title="撤回这次提交？" Description="撤回后审批流程回到草稿，审批人的意见会保留。" ConfirmText="撤回"
                            OnConfirm="@(() => last = "已撤回")" OnCancel="@(() => last = "取消了撤回")">
                    <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Outline" Tone="Tone.Neutral" Icon="Lucide.Undo2">撤回（warning）</Button></Trigger>
                </Popconfirm>
                <Popconfirm Title="发送给全部 248 位客户？" Tone="Tone.Accent" Icon="Lucide.Send" ConfirmText="发送" Placement="Placement.Bottom" Arrow="true"
                            OnConfirm="@(() => last = "已发送")" OnCancel="@(() => last = "取消了发送")">
                    <Trigger Context="t"><Button @attributes="t" Icon="Lucide.Send">群发（accent、箭头）</Button></Trigger>
                </Popconfirm>
                <Popconfirm Title="归档这个项目？" HideIcon="true" Tone="Tone.Neutral" ConfirmText="归档" Placement="Placement.Right"
                            OnConfirm="@(() => last = "已归档")" OnCancel="@(() => last = "取消了归档")">
                    <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Soft" Tone="Tone.Neutral" Icon="Lucide.Archive">归档（不显示图标）</Button></Trigger>
                </Popconfirm>
            </Flex>
            <Small Tone="TextTone.Muted" aria-live="polite" data-testid="popconfirm-last">@(last ?? "点按钮试试；点外面或按 Esc 等于取消")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<Toaster />

@code {
    sealed record Member(string Id, string Name, string Role, bool Owner = false);

    List<Member> members =
    [
        new("m1", "林小满", "项目负责人", Owner: true),
        new("m2", "韩笑", "设计"),
        new("m3", "周一航", "前端（移出会失败）"),
        new("m4", "许悠", "测试"),
    ];

    string? last;

    // 假的接口：600ms 后返回；名字里带“周”的模拟失败，气泡保持打开
    async Task RemoveAsync(Member member, ConfirmEventArgs e)
    {
        await Task.Delay(600);
        if (member.Name.Contains('周'))
        {
            Toasts.Show("没有权限", Tone.Danger, "移出失败");
            e.KeepOpen = true;
            return;
        }
        members = [.. members.Where(m => m.Id != member.Id)];
        Toasts.Show($"已移出 {member.Name}", Tone.Success);
    }
}
