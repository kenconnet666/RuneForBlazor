@*
    命令面板：示例与 vue-tsx-pro 文档站的 /components/command-palette 对应。数据是虚构的。
*@
@attribute [ComponentDemo("command-palette", "命令面板", Group = "浮层", Order = 6)]
@inherits RuneComponent
@implements IDisposable

<DemoSection Id="commands" Title="命令与页面">
    <Description>选项按 <Code>Group</Code> 分组，可以带图标、说明、不可用。焦点一直在输入框里：<Kbd>↑</Kbd> <Kbd>↓</Kbd> 移动高亮，<Kbd>Enter</Kbd> 执行，<Kbd>Esc</Kbd> 关闭。<Code>Hotkey</Code> 默认是 Mod+K（留给站内搜索），这里换成 Mod+J。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <CommandPalette Items="commands" Hotkey="Mod+J" Label="命令" Placeholder="输入命令或页面名称" OnAction="@((ListboxOption c) => last = c.Label)" data-testid="commands" />
            <Small Tone="TextTone.Muted" data-testid="last">
                也可以按 <Kbd>Ctrl</Kbd> + <Kbd>J</Kbd>（macOS 上 <Kbd>⌘</Kbd> + <Kbd>J</Kbd>）打开。@(last.Length > 0 ? $" 执行了：{last}" : "")
            </Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="remote" Title="远程搜索">
    <Description>与 Combobox 相同的写法：<Code>@@bind-InputValue</Code> 拿到输入去服务端查，<Code>LocalFilter="false"</Code> 表示 <Code>Items</Code> 就是结果、不再本地过滤；查询期间 <Code>Loading</Code> 为 true，列表里是骨架行。晚到的旧请求要自己丢掉。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <CommandPalette TItem="Order" Items="results" InputValue="@keyword" InputValueChanged="SearchAsync" LocalFilter="false" Loading="searching" Hotkey="@null"
                            ToOption="@(o => new(o.Id, $"{o.Id} · {o.Customer}") { Description = $"¥{o.Amount:#,0}", Group = o.Status })"
                            Label="搜索订单" Placeholder="订单号或客户名" OnAction="@((Order o) => picked = $"{o.Id}（{o.Customer}，{o.Status}）")">
                <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Outline" Tone="Tone.Neutral" Icon="Lucide.Search">搜索订单</Button></Trigger>
            </CommandPalette>
            <Small Tone="TextTone.Muted">@(picked.Length > 0 ? $"打开了订单 {picked}" : "每次输入都向“服务端”查询，结果约半秒后到")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="custom" Title="任意数据与自定义选项">
    <Description>后端数据直接给 <Code>Items</Code>，<Code>ToOption</Code> 说明值、文字和分组；<Code>Filter</Code> 自定义匹配（这里姓名、邮箱都能搜），子内容自定义每一项；<Code>Trigger</Code> 换成自己的按钮，<Code>Hotkey="@@null"</Code> 不注册快捷键；<Code>Empty</Code> 换掉没有匹配时的内容。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <CommandPalette TItem="Person" Items="people" ToOption="@(p => new(p.Id, p.Name) { Group = p.Team })" Hotkey="@null"
                            Filter="@((p, q) => p.Name.Contains(q) || p.Email.Contains(q, StringComparison.OrdinalIgnoreCase))"
                            Label="提及成员" Placeholder="输入姓名或邮箱" OnAction="@((Person p) => mentioned = p)">
                <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Soft" Icon="Lucide.AtSign">提及成员</Button></Trigger>
                <ChildContent Context="option">
                    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                        <Avatar Size="Size.Sm" Name="@option.Item.Name" />
                        <Flex Direction="LayoutDirection.Column" Grow="true">
                            <TextSpan>@option.Item.Name</TextSpan>
                            <Small Tone="TextTone.Muted">@option.Item.Email</Small>
                        </Flex>
                    </Flex>
                </ChildContent>
                <Empty>
                    <Empty Icon="Lucide.UserPlus" Size="Size.Sm">
                        <Title>没有找到这个人</Title>
                        <Description>可以先邀请对方加入团队</Description>
                    </Empty>
                </Empty>
            </CommandPalette>
            <Small Tone="TextTone.Muted">@(mentioned is { } p ? $"已提及 @{p.Name}（{p.Team}）" : "还没有提及谁")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    sealed record Person(string Id, string Name, string Email, string Team);
    sealed record Order(string Id, string Customer, int Amount, string Status);

    static readonly ListboxOption[] commands =
    [
        new("home", "概览", Icon: Lucide.House, Group: "页面"),
        new("orders", "订单", Description: "全部订单、退款与售后", Icon: Lucide.ShoppingCart, Group: "页面"),
        new("products", "商品", Icon: Lucide.Package, Group: "页面"),
        new("customers", "客户", Icon: Lucide.Users, Group: "页面"),
        new("reports", "报表", Description: "销售、库存、流量", Icon: Lucide.ChartLine, Group: "页面"),
        new("new-product", "新建商品", Icon: Lucide.FilePlus, Group: "操作"),
        new("invite", "邀请成员", Icon: Lucide.UserPlus, Group: "操作"),
        new("theme", "切换暗色模式", Icon: Lucide.Moon, Group: "操作"),
        new("settings", "设置", Icon: Lucide.Settings, Group: "操作"),
        new("logout", "退出登录", Disabled: true, Icon: Lucide.LogOut, Group: "操作"),
    ];

    static readonly Person[] people =
    [
        new("zyh", "周一航", "yihang@example.com", "设计中心"),
        new("lxm", "林小满", "xiaoman@example.com", "前端"),
        new("cm", "陈默", "chenmo@example.com", "后端"),
        new("xy", "许悠", "xuyou@example.com", "产品"),
        new("wq", "王晴", "wangqing@example.com", "市场"),
        new("zhr", "赵浩然", "haoran@example.com", "前端"),
    ];

    static readonly string[] customers = ["林小满", "周一航", "陈思远", "王可欣", "赵子墨", "孙若溪"];
    static readonly string[] statuses = ["待付款", "已发货", "已完成"];
    static readonly Order[] orders = [.. Enumerable.Range(0, 60).Select(i => new Order($"A-{10200 + i * 7}", customers[i % customers.Length], 120 + i * 389 % 2400, statuses[i % statuses.Length]))];

    string last = "", picked = "";
    Person? mentioned;
    string? keyword = "";
    IReadOnlyList<Order> results = [.. orders.Take(20)];
    bool searching;
    CancellationTokenSource? search;

    // 模拟服务端搜索：按订单号、客户名匹配，延迟 450 毫秒返回；晚到的旧请求丢掉
    async Task SearchAsync(string? text)
    {
        keyword = text;
        search?.Cancel();
        search = new CancellationTokenSource();
        var token = search.Token;
        searching = true;
        try
        {
            await Task.Delay(450, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        var query = (text ?? "").Trim();
        results = [.. orders.Where(o => query.Length == 0 || o.Id.Contains(query, StringComparison.OrdinalIgnoreCase) || o.Customer.Contains(query)).Take(20)];
        searching = false;
    }

    public void Dispose() => search?.Cancel();
}
