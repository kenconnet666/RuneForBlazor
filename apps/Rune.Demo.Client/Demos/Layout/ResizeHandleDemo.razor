@*
    宽度调整手柄：示例与 vue-tsx-pro 文档站的 /components/resize-handle 对应。
    vue 版的零件列表用 NavList（阶段 8 做）；这里先用按钮列表，做好后换上。数据是虚构的。
*@
@attribute [ComponentDemo("resize-handle", "宽度调整手柄", Group = "布局", Order = 3)]
@inherits RuneComponent

<DemoSection Id="split" Title="可以拖宽的列表">
    <Description>手柄放在要调整的元素里（它要有 position: relative 或 fixed），宽度从这个元素量起；<Code>@@bind-Width</Code> 拿到已经夹在 <Code>MinWidth</Code>、<Code>MaxWidth</Code> 之间的新宽度。拖动用 Pointer Events 并捕获指针，移出窗口也能继续；聚焦后按 ← / → 每次调整 <Code>Step</Code>（默认 16 px），这是拖动的键盘替代（WCAG 2.5.7）；写了 <Code>DefaultWidth</Code> 时双击回到它。从右到左排版下方向自动镜像。拖动中由 JS 当场改宽度，松手后才交给 C#。</Description>
    <ChildContent>
        <div @attributes="Attrs.Merge(Frame)">
            <div style="@($"width:{width}px")" @attributes="Attrs.Merge(Panel)" data-testid="panel">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs" role="list" aria-label="零件">
                    @foreach (var part in parts)
                    {
                        <Button @key="part.No" Variant="@(part.No == current ? ButtonVariant.Soft : ButtonVariant.Ghost)" Tone="Tone.Neutral" role="listitem"
                                aria-current="@(part.No == current ? "true" : null)" Sx="ItemButton" @onclick="() => current = part.No">@part.Name</Button>
                    }
                </Flex>
                <ResizeHandle @bind-Width="width" MinWidth="160" MaxWidth="360" DefaultWidth="220" aria-label="调整零件列表宽度" data-testid="handle" />
            </div>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Sx="Detail">
                <TextSpan Weight="Weight.Semibold">@Current.Name</TextSpan>
                <Descriptions Columns="2" Size="Size.Sm">
                    <DescriptionsItem Label="件号" Value="@Current.No" />
                    <DescriptionsItem Label="材料牌号" Value="@Current.Material" />
                    <DescriptionsItem Label="数量" Value="@Current.Quantity.ToString()" />
                    <DescriptionsItem Label="列表宽度" Value="@($"{width} px")" data-testid="width" />
                </Descriptions>
                <Small Tone="TextTone.Muted">拖动列表的右边、聚焦后按 ← / →，或双击回到 220 px</Small>
            </Flex>
        </div>
    </ChildContent>
</DemoSection>

@code {
    sealed record Part(string No, string Name, string Material, int Quantity);

    static readonly Part[] parts =
    [
        new("SKU-0213", "显示器支架", "铝合金", 2),
        new("SKU-0475", "线缆收纳夹", "ABS", 8),
        new("SKU-0630", "包装纸箱", "瓦楞纸", 4),
        new("SKU-0847", "桌面挡板", "亚克力", 6),
    ];

    static readonly Attrs Frame = new() { Sx = FrameStyle };
    static readonly Attrs Panel = new() { Sx = PanelStyle };

    double? width = 220;
    string current = parts[0].No;

    Part Current => parts.First(p => p.No == current);

    static Style FrameStyle => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        Height = CssLength.Rem(12),
        BorderWidth = BorderWidths.Xs,
        BorderStyle = BorderStyle.Solid,
        BorderColor = Colors.Border,
        BorderRadius = Radii.Md,
        Overflow = Overflow.Hidden,
    });

    // 手柄是 position: absolute，量的是这个面板的宽度
    static Style PanelStyle => Css.Define(static () => new Style
    {
        Position = Position.Relative,
        FlexShrink = 0,
        BoxSizing = BoxSizing.BorderBox,
        Padding = Space.Sm,
        BorderInlineEndWidth = BorderWidths.Xs,
        BorderInlineEndStyle = BorderStyle.Solid,
        BorderInlineEndColor = Colors.Border,
        Overflow = Overflow.Hidden,
    });

    static Style ItemButton => Css.Define(static () => new Style { JustifyContent = JustifyContent.FlexStart });

    static Style Detail => Css.Define(static () => new Style { FlexGrow = 1, MinWidth = 0, Padding = Space.Md });
}
