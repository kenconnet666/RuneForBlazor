@* 图标按钮：示例与 vue-tsx-pro 文档站的 /components/icon-button 一一对应。 *@
@attribute [ComponentDemo("icon-button", "图标按钮", Group = "基础组件", Order = 1)]
@inherits RuneComponent

<DemoSection Id="toolbar" Title="基础用法">
    <Description>宽高相等，默认 Ghost 样式、中性色（一排图标不会满屏品牌色）；外观选项同 Button。没有文字，必须写 Label，读屏才知道它是做什么的。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            @* 编辑器工具栏：默认 Ghost，一组按钮之间用分隔线隔开 *@
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs" Wrap="true">
                <IconButton Icon="Lucide.LetterB" Label="加粗" />
                <IconButton Icon="Lucide.Italic" Label="斜体" />
                <IconButton Icon="Lucide.Underline" Label="下划线" />
                <IconButton Icon="Lucide.Link2" Label="插入链接" />
                <Separator Orientation="Orientation.Vertical" />
                <IconButton Icon="Lucide.TextAlignStart" Label="左对齐" />
                <IconButton Icon="Lucide.TextAlignCenter" Label="居中" />
                <IconButton Icon="Lucide.TextAlignEnd" Label="右对齐" />
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">样式</TextSpan>
                <IconButton Icon="Lucide.Pencil" Variant="ButtonVariant.Solid" Tone="Tone.Accent" Label="编辑" />
                <IconButton Icon="Lucide.Share2" Variant="ButtonVariant.Soft" Label="分享" />
                <IconButton Icon="Lucide.Settings" Variant="ButtonVariant.Surface" Label="设置" />
                <IconButton Icon="Lucide.Ellipsis" Variant="ButtonVariant.Outline" Label="更多" />
                <IconButton Icon="Lucide.Heart" Variant="ButtonVariant.Soft" Tone="Tone.Danger" Radius="Radius.Full" Label="收藏" />
                <IconButton Icon="Lucide.Trash" Tone="Tone.Danger" Label="删除" />
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">尺寸</TextSpan>
                @foreach (var size in sizes)
                {
                    <IconButton Icon="Lucide.Settings" Size="size" Variant="ButtonVariant.Surface" Label="@($"设置（{size.ToString().ToLowerInvariant()}）")" />
                }
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="states" Title="加载、不可用与异步复制">
    <Description>Loading 时图标换成转圈、点击无效；FocusableWhenDisabled 让不可用的按钮仍能聚焦，配 Tooltip 说明为什么不能点。CopyButton 的 GetValue 点击时才生成内容（等待时转圈），Timeout 是对勾停留的毫秒数，OnCopied 拿到是否成功。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                <IconButton Icon="Lucide.RefreshCw" Variant="ButtonVariant.Surface" Loading="refreshing" Label="刷新" @onclick="RefreshAsync" data-testid="refresh" />
                <Small Tone="TextTone.Muted">@(updated is { } time ? $"更新于 {time:HH:mm:ss}" : "还没刷新过")</Small>
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                <Tooltip Content="只有项目所有者可以删除">
                    <IconButton Icon="Lucide.Trash" Tone="Tone.Danger" Disabled="true" FocusableWhenDisabled="true" Label="删除项目" />
                </Tooltip>
                <Small Tone="TextTone.Muted">不可用，但能聚焦、悬停看原因</Small>
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                <Code>邀请链接（点击时生成）</Code>
                <CopyButton GetValue="CreateInviteAsync" Variant="ButtonVariant.Surface" Timeout="3000" Label="复制邀请链接"
                            OnCopied="success => { if (success) copies++; }" data-testid="copy-invite" />
                <Small Tone="TextTone.Muted" data-testid="copies">已复制 @copies 次</Small>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="presets" Title="预设按钮">
    <Description>CloseButton、ClearButton 带好了图标与读屏名称；CopyButton 复制成功时图标换成对勾、读屏播报“已复制”，几秒后复原。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            @if (dismissed)
            {
                <TextSpan Size="Size.Sm" Tone="TextTone.Muted">提示已关闭（刷新示例可以恢复）</TextSpan>
            }
            else
            {
                <Card>
                    <Flex Align="ItemAlign.Start" Justify="ContentJustify.Between" Gap="SpaceScale.Sm">
                        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                            <Strong>新版本已发布</Strong>
                            <TextSpan Size="Size.Sm" Tone="TextTone.Muted">CloseButton 的读屏名称取语言包的“关闭”。</TextSpan>
                        </Flex>
                        <CloseButton @onclick="() => dismissed = true" />
                    </Flex>
                </Card>
            }
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                <TextField @bind-Value="keyword" Immediate="true" aria-label="搜索关键词" />
                <ClearButton Disabled="string.IsNullOrEmpty(keyword)" @onclick="() => keyword = string.Empty" />
            </Flex>
            <Card Variant="CardVariant.Surface">
                <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                    <Icon Data="Lucide.KeyRound" />
                    <Code>@ApiKey</Code>
                    <CopyButton Value="@ApiKey" Label="复制 API 密钥" data-testid="copy-key" />
                </Flex>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="links" Title="图标链接">
    <Description>点了去别处的图标用 IconLinkButton（a 元素）；External 在新窗口打开。</Description>
    <ChildContent>
        <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Md" Wrap="true">
            <TextSpan Size="Size.Sm" Tone="TextTone.Muted">© 2026 vue-tsx-pro</TextSpan>
            <Flex Gap="SpaceScale.Xs">
                <IconLinkButton Href="server/text" Icon="Lucide.BookOpen" Label="文档" />
                <IconLinkButton Href="https://example.com/feed.xml" External="true" Icon="Lucide.Rss" Label="订阅" />
                <IconLinkButton Href="https://youtube.com" External="true" Icon="Lucide.Video" Label="视频教程" />
                <IconLinkButton Href="mailto:hi@example.com" Icon="Lucide.Mail" Label="发邮件" />
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    const string ApiKey = "sk-live-3f9a7c21e8b44d0a";

    static readonly Size[] sizes = [Size.Xs, Size.Sm, Size.Md, Size.Lg, Size.Xl];

    bool refreshing, dismissed;
    DateTime? updated;
    int copies;
    string keyword = "vue-tsx-pro";

    async Task RefreshAsync()
    {
        refreshing = true;
        await Task.Delay(1200);
        refreshing = false;
        updated = DateTime.Now;
    }

    // 模拟向服务端申请一条一次性的邀请链接
    static async Task<string> CreateInviteAsync()
    {
        await Task.Delay(800);
        return $"https://example.com/invite/{Guid.NewGuid().ToString("N")[..8]}";
    }
}
