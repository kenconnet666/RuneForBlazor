@* 图标：示例与 vue-tsx-pro 文档站的 /components/icon 一一对应；页面最后是 Lucide 全集（图标在第一次用到时才创建）。 *@
@attribute [ComponentDemo("icon", "图标", Group = "基础组件", Order = 2)]
@using System.Reflection
@inherits RuneComponent

<DemoSection Id="basic" Title="基础用法">
    <Description>Rune.Icons 的 Lucide.Xxx 交给 Data；WebAssembly 发布时裁剪掉没用到的图标。全部图标见页面下方的图标库。</Description>
    <ChildContent>
        <Grid MinItemWidth="@("5.5rem")" Gap="SpaceScale.Md">
            @foreach (var (name, icon) in basicIcons)
            {
                <Flex Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                    <Icon Data="icon" Size="Size.Xl" />
                    <Small Tone="TextTone.Muted">@name</Small>
                </Flex>
            }
        </Grid>
    </ChildContent>
</DemoSection>

<DemoSection Id="sizes" Title="尺寸与线宽">
    <Description>不写 Size 时是 1em，跟随所在文字；档位对应主题字号，数字是像素。StrokeWidth 调线宽，大图标用细一点的线更精致。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Gap="SpaceScale.Lg" Align="ItemAlign.End" Wrap="true">
                @foreach (var size in sizes)
                {
                    <Flex Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                        <Icon Data="Lucide.Star" Size="size" />
                        <Small Tone="TextTone.Muted">@size.ToString().ToLowerInvariant()</Small>
                    </Flex>
                }
                <Flex Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                    <TextSpan Size="Size.Xl"><Icon Data="Lucide.Star" /> 星标</TextSpan>
                    <Small Tone="TextTone.Muted">跟随文字</Small>
                </Flex>
            </Flex>
            <Flex Gap="SpaceScale.Lg" Align="ItemAlign.End" Wrap="true">
                @foreach (var pixels in new[] { 16, 24, 32, 48 })
                {
                    <Flex Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                        <Icon Data="Lucide.Star" Size="pixels" />
                        <Small Tone="TextTone.Muted">@(pixels)px</Small>
                    </Flex>
                }
            </Flex>
            <Flex Gap="SpaceScale.Lg" Align="ItemAlign.End" Wrap="true">
                @foreach (var width in new[] { 1, 1.5, 2, 2.5, 3 })
                {
                    <Flex Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                        <Icon Data="Lucide.Star" Size="32" StrokeWidth="width" />
                        <Small Tone="TextTone.Muted">线宽 @width</Small>
                    </Flex>
                }
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="tones" Title="色调">
    <Description>不写 Tone 时跟随文字颜色；状态图标用 Success、Warning、Danger 等色调，和提示条、标记的颜色一致。</Description>
    <ChildContent>
        <Grid MinItemWidth="@("9rem")" Gap="SpaceScale.Md">
            @foreach (var (tone, icon, label) in tones)
            {
                <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
                    <Icon Data="icon" Tone="tone" Size="Size.Xl" />
                    <TextSpan Size="Size.Sm">@label</TextSpan>
                </Flex>
            }
        </Grid>
    </ChildContent>
</DemoSection>

<DemoSection Id="with-text" Title="与文字、按钮搭配">
    <Description>图标与文字基线对齐，不撑高行距；按钮、标记、链接里的图标由组件排好间距。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Gap="SpaceScale.Lg" Wrap="true">
                <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.MapPin" /> 上海·徐汇</TextSpan>
                <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.Clock" /> 3 分钟前</TextSpan>
                <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.Users" /> 128 人参与</TextSpan>
            </Flex>
            <Paragraph>
                图标跟随文字的字号与颜色，和文字基线对齐；放在句子中间也不会撑高行距，<TextLink Href="server/icon">查看设计规范 <Icon Data="Lucide.ExternalLink" /></TextLink>。
            </Paragraph>
            <Flex Gap="SpaceScale.Sm" Wrap="true" Align="ItemAlign.Center">
                <Button Icon="Lucide.Plus">新建项目</Button>
                <Button Variant="ButtonVariant.Ghost" IconEnd="Lucide.ArrowRight">继续</Button>
                <Badge Tone="Tone.Warning" Icon="Lucide.Star">精选</Badge>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="direction" Title="从右到左">
    <Description>FlipInRtl 让图标在从右到左的排版里水平翻转（按所在元素的 dir 判断）：箭头、chevron、“返回”这类有方向的图标要翻，时钟、勾号不翻。</Description>
    <ChildContent>
        <Grid MinItemWidth="@("14rem")" Gap="SpaceScale.Md">
            @foreach (var (dir, label) in directions)
            {
                <Card Padding="SpaceScale.Sm" dir="@dir">
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                        <Small Tone="TextTone.Muted">@label</Small>
                        <TextSpan><Icon Data="Lucide.ChevronLeft" FlipInRtl="true" /> 返回</TextSpan>
                        <TextSpan>下一步 <Icon Data="Lucide.ArrowRight" FlipInRtl="true" /></TextSpan>
                        <TextSpan><Icon Data="Lucide.Clock" /> 刚刚更新</TextSpan>
                        <TextSpan><Icon Data="Lucide.Check" /> 已读</TextSpan>
                    </Flex>
                </Card>
            }
        </Grid>
    </ChildContent>
</DemoSection>

<DemoSection Id="accessibility" Title="装饰与含义">
    <Description>旁边已有文字时图标只是装饰，默认对读屏隐藏；单独出现、表达含义的图标要给 Label。</Description>
    <ChildContent>
        <Flex Gap="SpaceScale.Xl" Wrap="true">
            @* 旁边已有文字：图标只是装饰，读屏跳过 *@
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                <TextSpan><Icon Data="Lucide.CircleCheck" Tone="TextTone.Success" /> 已保存</TextSpan>
                <TextSpan><Icon Data="Lucide.TriangleExclamationPoint" Tone="TextTone.Warning" /> 3 项待确认</TextSpan>
                <TextSpan><Icon Data="Lucide.CircleX" Tone="TextTone.Danger" /> 同步失败</TextSpan>
            </Flex>
            @* 单独出现、表达含义：给名称 *@
            <Flex Gap="SpaceScale.Md" Align="ItemAlign.Center">
                <Icon Data="Lucide.TriangleExclamationPoint" Tone="TextTone.Warning" Size="Size.Xl" Label="有未保存的修改" />
                <Icon Data="Lucide.Lock" Tone="TextTone.Muted" Size="Size.Xl" Label="仅自己可见" />
                <Icon Data="Lucide.Wifi" Tone="TextTone.Success" Size="Size.Xl" Label="已连接" />
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="draw" Title="描线动画">
    <Description>Draw 由 false 变为 true 时一笔画出；开启“减少动态效果”时直接画好。</Description>
    <ChildContent>
        <Flex Gap="SpaceScale.Lg" Align="ItemAlign.Center" Wrap="true">
            <Icon Data="Lucide.CircleCheck" Size="40" Tone="TextTone.Success" Draw="drawn" />
            <Icon Data="Lucide.Heart" Size="40" Tone="TextTone.Danger" Draw="drawn" />
            <Icon Data="Lucide.Rocket" Size="40" Tone="TextTone.Accent" Draw="drawn" />
            <Icon Data="Lucide.Signature" Size="40" Draw="drawn" />
            <Button Variant="ButtonVariant.Soft" @onclick="() => drawn = !drawn" data-testid="draw">@(drawn ? "重置" : "画出来")</Button>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="custom" Title="自定义图标">
    <Description>按 Lucide 的格式写 svg 里面的元素即可，画布默认 24 格，不是 24 时写 ViewBox。</Description>
    <ChildContent>
        <Flex Gap="SpaceScale.Xl" Align="ItemAlign.Center">
            <Icon Data="logo" Size="40" Label="站点标志" />
            <Icon Data="verified" Size="40" Tone="TextTone.Accent" Label="已认证" />
            <Icon Data="wave" Size="40" Tone="TextTone.Info" Label="信号" />
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Title="@($"图标库（Lucide 全集 {all.Value.Count} 个）")">
    <TextField @bind-Value="query" Immediate="true" placeholder="按英文名搜索，如 arrow、user、chart" aria-label="搜索图标" data-testid="icon-search" />
    <div @attributes="Attrs.Merge(DemoStyles.IconGrid)">
        @foreach (var (name, read) in Matches.Take(120))
        {
            <div @attributes="Attrs.Merge(DemoStyles.IconCell)" title="@name">
                <Icon Data="read()" Size="Size.Xl" />
                <small>@name</small>
            </div>
        }
    </div>
</DemoSection>

@code {
    static readonly (string Name, IconData Icon)[] basicIcons =
    [
        ("Search", Lucide.Search), ("Bell", Lucide.Bell), ("Heart", Lucide.Heart), ("Settings", Lucide.Settings),
        ("House", Lucide.House), ("User", Lucide.User), ("Mail", Lucide.Mail), ("Calendar", Lucide.Calendar),
        ("Camera", Lucide.Camera), ("Cloud", Lucide.Cloud), ("Download", Lucide.Download), ("Folder", Lucide.Folder),
        ("MapPin", Lucide.MapPin), ("ShoppingCart", Lucide.ShoppingCart), ("Star", Lucide.Star), ("Zap", Lucide.Zap),
    ];

    static readonly Size[] sizes = [Size.Xs, Size.Sm, Size.Md, Size.Lg, Size.Xl];

    static readonly (TextTone Tone, IconData Icon, string Label)[] tones =
    [
        (TextTone.Neutral, Lucide.CircleUser, "中性：正文色"),
        (TextTone.Muted, Lucide.CircleUser, "次要"),
        (TextTone.Accent, Lucide.Sparkles, "品牌色"),
        (TextTone.Info, Lucide.Info, "信息"),
        (TextTone.Success, Lucide.CircleCheck, "成功"),
        (TextTone.Warning, Lucide.TriangleExclamationPoint, "警告"),
        (TextTone.Danger, Lucide.CircleExclamationPoint, "危险"),
    ];

    static readonly (string Dir, string Label)[] directions =
    [
        ("ltr", "从左到右（中文、英文）"),
        ("rtl", "从右到左（阿拉伯语、希伯来语）"),
    ];

    // 自己的图标：按 Lucide 的格式写 svg 里面的元素；实心的部分写 fill="currentColor"，颜色仍跟随文字
    static readonly IconData logo = new("site-logo", """<path d="M4 6l8 12 8-12"/><circle cx="12" cy="4" r="1.5"/>""");
    static readonly IconData verified = new("verified", """<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/><circle cx="18.5" cy="5.5" r="2.5" fill="currentColor"/>""");
    static readonly IconData wave = new("wave", """<path d="M2 16c4-8 8-8 12 0s8 8 12 0 4-4 4-4"/>""", ViewBox: "0 0 32 32");

    bool drawn = true;
    string query = "";

    // 只取属性的名字与读取方法，不读值：图标在显示时才创建
    static readonly Lazy<IReadOnlyList<(string Name, Func<IconData> Read)>> all = new(() =>
        typeof(Lucide).GetProperties(BindingFlags.Public | BindingFlags.Static)
            // 旧名（[Obsolete] 转发）不重复列出
            .Where(p => p.PropertyType == typeof(IconData) && !p.IsDefined(typeof(ObsoleteAttribute)))
            .Select(p => (p.Name, (Func<IconData>)p.GetMethod!.CreateDelegate(typeof(Func<IconData>))))
            .ToList());

    IEnumerable<(string Name, Func<IconData> Read)> Matches =>
        string.IsNullOrWhiteSpace(query)
            ? all.Value
            : all.Value.Where(i => i.Name.Contains(query.Replace("-", ""), StringComparison.OrdinalIgnoreCase));
}
