@*
    标记与标签：示例与 vue-tsx-pro 文档站的 /components/badge 一一对应。
    表格里的状态（in-context）等 Table 做好后补上；状态映射示例里的“按状态筛选”等 Select 做好后补上。
*@
@attribute [ComponentDemo("badge", "标记", Group = "基础组件", Order = 2)]
@inherits RuneComponent

<DemoSection Id="matrix" Title="样式与色调">
    <Description>Variant 决定醒目程度：Solid 实底最醒目，Soft 浅底（默认），Surface 浅底加描边，Outline 只有描边；Tone 是状态色调。</Description>
    <ChildContent>
        <div @attributes="Attrs.Merge(MatrixGrid)">
            @foreach (var variant in Enum.GetValues<StatusVariant>())
            {
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">@variant.ToString().ToLowerInvariant()</TextSpan>
                @foreach (var (tone, label) in tones)
                {
                    <Badge Variant="variant" Tone="tone">@label</Badge>
                }
            }
        </div>
    </ChildContent>
</DemoSection>

<DemoSection Id="shapes" Title="尺寸、形状与图标">
    <Description>字号默认 Xs，Size 改档位；Radius.Full 是胶囊形，适合计数与在线状态；Icon 放在文字前。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">字号</TextSpan>
                @foreach (var size in sizes)
                {
                    <Badge Size="size" Tone="Tone.Accent">size=@size.ToString().ToLowerInvariant()</Badge>
                }
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">胶囊与计数</TextSpan>
                <Badge Radius="Radius.Full" Variant="StatusVariant.Solid" Tone="Tone.Danger">12</Badge>
                <Badge Radius="Radius.Full" Variant="StatusVariant.Solid">99+</Badge>
                <Badge Radius="Radius.Full" Tone="Tone.Success">在线</Badge>
                <Badge Radius="Radius.Full" Variant="StatusVariant.Outline">v2.4.0</Badge>
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">图标</TextSpan>
                <Badge Icon="Lucide.CircleCheck" Tone="Tone.Success">已通过</Badge>
                <Badge Icon="Lucide.Clock" Tone="Tone.Warning">待审核</Badge>
                <Badge Icon="Lucide.TriangleExclamationPoint" Tone="Tone.Danger" Variant="StatusVariant.Surface">3 个错误</Badge>
                <Badge Icon="Lucide.Sparkles" Tone="Tone.Accent" Variant="StatusVariant.Solid">Beta</Badge>
                <Badge Icon="Lucide.Flame" Tone="Tone.Warning" Variant="StatusVariant.Outline" Radius="Radius.Full">热门</Badge>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="statuses" Title="状态映射">
    <Description>StatusMap 把每种状态的名字、色调、图标与说明写在一处，定义的顺序就是阶段的顺序（Order）；StatusBadge 按它显示。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs" Wrap="true">
                @* 子内容是推迟执行的委托：不能捕获 for 的循环变量，用 foreach *@
                @foreach (var key in TaskStatuses.Keys)
                {
                    <Flex Inline="true" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                        @if (TaskStatuses.Order(key) > 0)
                        {
                            <Icon Data="Lucide.ChevronRight" Tone="TextTone.Muted" aria-hidden="true" />
                        }
                        <StatusBadge Statuses="TaskStatuses" Value="key" Radius="Radius.Full" />
                    </Flex>
                }
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <Small Tone="TextTone.Muted">异常状态</Small>
                @foreach (var key in Exceptions.Keys)
                {
                    <StatusBadge Statuses="Exceptions" Value="key" Variant="StatusVariant.Outline" />
                }
            </Flex>
            <TextSpan Size="Size.Sm" Tone="TextTone.Muted">
                “测试中”排在第 @(TaskStatuses.Order("verifying") + 1) 个阶段；不认识的状态显示成：<StatusBadge Statuses="TaskStatuses" Value="@("archived")" />
            </TextSpan>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="tag" Title="Tag 标签">
    <Description>Tag 的外观选项与 Badge 相同，BadgeDefaults 一起改两者的默认值；技能、分类、关键词这类成组出现的短文字用它。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">技能</TextSpan>
                <Tag Icon="Lucide.CodeXml">TypeScript</Tag>
                <Tag Icon="Lucide.Palette" Tone="Tone.Accent">设计系统</Tag>
                <Tag Icon="Lucide.Database" Tone="Tone.Info">PostgreSQL</Tag>
                <Tag Icon="Lucide.Smartphone" Tone="Tone.Success">移动端</Tag>
                <Tag Icon="Lucide.Globe" Tone="Tone.Warning">国际化</Tag>
            </Flex>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <TextSpan Size="Size.Xs" Tone="TextTone.Muted">样式</TextSpan>
                <Tag Variant="StatusVariant.Solid" Tone="Tone.Accent">solid</Tag>
                <Tag Variant="StatusVariant.Soft" Tone="Tone.Accent">soft</Tag>
                <Tag Variant="StatusVariant.Surface" Tone="Tone.Accent">surface</Tag>
                <Tag Variant="StatusVariant.Outline" Tone="Tone.Accent">outline</Tag>
                <Tag Radius="Radius.Full" Tone="Tone.Neutral">胶囊形</Tag>
                <Tag Size="Size.Sm" Tone="Tone.Neutral" Variant="StatusVariant.Surface">size=sm</Tag>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="tag-removable" Title="可移除的标签">
    <Description>写了 OnRemove 就有移除按钮：先淡出，离场结束才调用 OnRemove；按钮的读屏名称是“移除 + 标签文字”，RemoveLabel 可以改。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Sm">
                    <Strong>已选筛选条件（@filters.Count）</Strong>
                    <Button Size="Size.Sm" Variant="ButtonVariant.Ghost" Icon="Lucide.RotateCcw"
                            Disabled="filters.Count == initialFilters.Length" @onclick="() => filters = [.. initialFilters]">恢复</Button>
                </Flex>
                <Flex Gap="SpaceScale.Sm" Wrap="true" data-testid="filters">
                    @foreach (var (label, tone) in filters)
                    {
                        <Tag @key="label" Tone="tone" Radius="Radius.Full" RemoveLabel="@($"移除 {label}")"
                             OnRemove="() => filters.RemoveAll(f => f.Label == label)">@label</Tag>
                    }
                    @if (filters.Count == 0)
                    {
                        <TextSpan Size="Size.Sm" Tone="TextTone.Muted">没有筛选条件，显示全部商品</TextSpan>
                    }
                </Flex>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

@code {
    static readonly (Tone Tone, string Label)[] tones =
    [
        (Tone.Neutral, "草稿"),
        (Tone.Accent, "新功能"),
        (Tone.Info, "处理中"),
        (Tone.Success, "已完成"),
        (Tone.Warning, "即将到期"),
        (Tone.Danger, "已失败"),
    ];

    static readonly Size[] sizes = [Size.Xs, Size.Sm, Size.Md, Size.Lg];

    static readonly StatusMap<string> TaskStatuses = new()
    {
        ["pending"] = new("待启动"),
        ["designing"] = new("设计中", Tone.Info),
        ["verifying"] = new("测试中", Tone.Info),
        ["awaiting"] = new("待验收", Tone.Warning, Description: "等需求方出具验收报告"),
        ["accepted"] = new("已验收", Tone.Accent),
        ["settling"] = new("结算中", Tone.Warning, Description: "财务对账，30 天内回填结算金额"),
        ["settled"] = new("已结算", Tone.Success),
        ["closed"] = new("关闭", Tone.Success),
    };

    static readonly StatusMap<string> Exceptions = new()
    {
        ["paused"] = new("暂停", Tone.Warning, Lucide.CirclePause),
        ["terminated"] = new("终止", Tone.Danger, Lucide.CircleSlash),
        ["queued"] = new("待排期", Tone.Neutral, Lucide.Hourglass),
    };

    static readonly (string Label, Tone Tone)[] initialFilters =
    [
        ("价格：100–500 元", Tone.Accent),
        ("品牌：小米", Tone.Neutral),
        ("品牌：华为", Tone.Neutral),
        ("有货", Tone.Success),
        ("包邮", Tone.Info),
        ("评分 4.5 以上", Tone.Warning),
    ];

    List<(string Label, Tone Tone)> filters = [.. initialFilters];

    // 一行一种样式、一列一种色调：第一列是样式名
    static Style MatrixGrid => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        GridTemplateColumns = "repeat(7, max-content)",
        JustifyContent = JustifyContent.Start,
        AlignItems = AlignItems.Center,
        Gap = Space.Sm,
        ColumnGap = Space.Md,
        OverflowX = Overflow.Auto,
    });
}
