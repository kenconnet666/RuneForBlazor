@*
    代码：示例与 vue-tsx-pro 文档站的 /components/code 对应，代码换成 Rune 的写法（C#、Razor）。
    “一组代码”（CodeGroup，要 Tabs）与“示例卡片”（CodePreview）做好后补上。
*@
@attribute [ComponentDemo("code", "代码", Group = "基础组件", Order = 10)]
@inherits RuneComponent

<DemoSection Id="basic" Title="行内代码">
    <Description>句子里的命令、文件名、标识符用 <Code>Code</Code>：等宽字体、浅底，长内容可以在任意位置换行。</Description>
    <ChildContent>
        <Paragraph>运行 <Code>dotnet add package Rune.UI</Code> 安装，然后在 <Code>Program.cs</Code> 里调用 <Code>builder.Services.AddRuneUI()</Code>。</Paragraph>
    </ChildContent>
</DemoSection>

<DemoSection Id="block" Title="代码块">
    <Description><Code>CodeBlock</Code> 先显示纯文本，浏览器里用 Shiki 上色（第一次用到时才加载），结果到了再替换，布局不跳；<Code>LineNumbers</Code> 行号，<Code>HighlightLines</Code> 高亮行，有标题时复制按钮在标题栏里。</Description>
    <ChildContent>
        <CodeBlock Code="@program" Lang="csharp" Title="Program.cs" LineNumbers="true" HighlightLines="3,6" data-testid="program" />
    </ChildContent>
</DemoSection>

<DemoSection Id="text" Title="文案里的行内代码">
    <Description>文案写在数据里时用 <Code>CodeText</Code>：反引号里的是行内代码，不用拆成多个节点。只认成对的反引号，不是 Markdown。</Description>
    <ChildContent>
        <ul>
            @foreach (var tip in tips)
            {
                <li @key="tip"><CodeText Text="@tip" /></li>
            }
        </ul>
    </ChildContent>
</DemoSection>

<DemoSection Id="options" Title="换行、复制与延后高亮">
    <Description>长行默认在浮层滚动条里横向滚动，<Code>Wrap</Code> 改成自动换行；<Code>Copyable="false"</Code> 去掉复制按钮。<Code>Highlight="false"</Code> 时按纯文本显示，改回 true 才上色：收起的、还没滚到的代码可以等要显示时再高亮。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Gap="SpaceScale.Lg" Wrap="true">
                <Switch @bind-Value="wrap">自动换行</Switch>
                <Switch @bind-Value="copyable">复制按钮</Switch>
                <Switch @bind-Value="highlight">语法高亮</Switch>
            </Flex>
            <CodeBlock Code="@curl" Lang="bash" Wrap="wrap" Copyable="copyable" Highlight="highlight" data-testid="curl" />
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="diff" Title="增删与折叠">
    <Description><Code>AddedLines</Code>、<Code>RemovedLines</Code> 标出新增与删除的行；长代码写 <Code>MaxLines</Code>，超出的部分折叠，底部的按钮展开或收起。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <CodeBlock Code="@change" Lang="razor" Title="Counter.razor：从字段换成 Bindable" LineNumbers="true" RemovedLines="2,5" AddedLines="3,6" />
            <CodeBlock Code="@data" Lang="csharp" Title="Data.cs" MaxLines="8" data-testid="long" />
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="flush" Title="嵌在外框里">
    <Description><Code>Flush</Code> 去掉代码块自己的边框、圆角和底色，放进卡片、标签页这类已经有外框的容器。</Description>
    <ChildContent>
        <Card Variant="CardVariant.Outline" Padding="SpaceScale.None">
            <CodeBlock Flush="true" Title="C#" Code="@query" Lang="csharp" />
            <Separator />
            <CodeBlock Flush="true" Title="SQL" Code="@sql" Lang="sql" />
        </Card>
    </ChildContent>
</DemoSection>

@code {
    const string program = """
        var builder = WebApplication.CreateBuilder(args);

        builder.Services.AddRuneUI(options => options.Theme = Themes.Ocean);
        builder.Services.AddRazorComponents().AddInteractiveServerComponents();

        app.MapRazorComponents<App>().AddInteractiveServerRenderMode();
        """;

    const string sql = "SELECT * FROM t_user WHERE age >= @p0;";

    const string curl = """curl -X POST https://api.example.com/v1/projects/42/deployments -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -d '{"ref":"main","environment":"production","notify":true}'""";

    const string change = """
        @code {
            int count;
            Bindable<int> count { get => field ??= new(this, () => Value, () => ValueChanged); }
        }
        <button @onclick="() => count++">@count</button>
        <button @onclick="() => count.SetAsync(count.Value + 1)">@count.Value</button>
        """;

    const string query = """
        var adults = await db.Users
            .Where(u => u.Age >= 18)
            .ToListAsync();
        """;

    static readonly string[] tips =
    [
        "`Where` 里串起来的条件是 AND，要 OR 用 `||`。",
        "开发时运行 `dotnet watch`，提交前运行 `dotnet test`。",
        "密钥写在 `appsettings.Development.json` 或用户机密里，不提交。",
    ];

    static readonly string data = "var items = new[]\n{\n" +
        string.Join("\n", Enumerable.Range(1, 40).Select(i => $"    new {{ Id = {i}, Name = \"项目 {i}\", Done = {(i % 3 == 1 ? "true" : "false")} }},")) + "\n};";

    bool wrap = true, copyable = true, highlight = true;
}
