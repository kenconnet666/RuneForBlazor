@*
    切换按钮组：示例与 vue-tsx-pro 文档站的 /components/toggle-group 对应。
    vue-tsx-pro 的“多选的字形”提到放进 Toolbar 时焦点交给工具栏（Toolbar 在阶段 8）。
*@
@attribute [ComponentDemo("toggle-group", "切换按钮组", Group = "表单", Order = 9)]
@inherits RuneComponent

<DemoSection Id="segmented" Title="视图切换">
    <Description>单选时 <Code>Value</Code> 是字符串；<Code>Required</Code> 时至少保留一项（分段控件）。<Code>Icon</Code> 放在文字前；选中项的底色是一个指示条，切换时滑过去，减少动态效果时直接到位。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Md" Wrap="true">
                <ToggleGroup @bind-Value="view" Required="true" aria-label="视图" data-testid="view">
                    <ToggleItem Value="list" Icon="Lucide.List">列表</ToggleItem>
                    <ToggleItem Value="board" Icon="Lucide.Columns3">看板</ToggleItem>
                    <ToggleItem Value="grid" Icon="Lucide.LayoutGrid">卡片</ToggleItem>
                    <ToggleItem Value="calendar" Icon="Lucide.CalendarDays">日历</ToggleItem>
                </ToggleGroup>
                <ToggleGroup @bind-Value="period" Required="true" Size="Size.Sm" aria-label="时间范围">
                    <ToggleItem Value="day">日</ToggleItem>
                    <ToggleItem Value="week">周</ToggleItem>
                    <ToggleItem Value="month">月</ToggleItem>
                    <ToggleItem Value="year">年</ToggleItem>
                </ToggleGroup>
            </Flex>
            <Small Tone="TextTone.Muted" data-testid="view-summary">@view · @period：Required 时至少保留一项，再点已选项不会取消（分段控件）</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="multiple" Title="多选的字形">
    <Description><Code>SelectionMode.Multiple</Code> 时值是 <Code>Values</Code>（列表），每一项各自开关（aria-pressed）。只有图标的项要写 <Code>aria-label</Code>。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Flex Gap="SpaceScale.Sm" Wrap="true">
                @* 多选：每一项各自开关 *@
                <ToggleGroup SelectionMode="SelectionMode.Multiple" @bind-Values="marks" aria-label="字形" data-testid="marks">
                    <ToggleItem Value="bold" Icon="Lucide.LetterB" aria-label="加粗" />
                    <ToggleItem Value="italic" Icon="Lucide.Italic" aria-label="斜体" />
                    <ToggleItem Value="underline" Icon="Lucide.Underline" aria-label="下划线" />
                    <ToggleItem Value="strike" Icon="Lucide.Strikethrough" aria-label="删除线" />
                </ToggleGroup>
                <ToggleGroup @bind-Value="align" Required="true" aria-label="对齐">
                    <ToggleItem Value="left" Icon="Lucide.TextAlignStart" aria-label="左对齐" />
                    <ToggleItem Value="center" Icon="Lucide.TextAlignCenter" aria-label="居中" />
                    <ToggleItem Value="right" Icon="Lucide.TextAlignEnd" aria-label="右对齐" />
                    <ToggleItem Value="justify" Icon="Lucide.TextAlignJustify" aria-label="两端对齐" />
                </ToggleGroup>
            </Flex>
            <Card>
                <Paragraph Sx="TextStyle">分段控件是一组互斥或可多选的按钮：方向键在组内移动，整组只占一个 Tab 位置。只有图标的项要写 aria-label。</Paragraph>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="vertical" Title="竖排与不可用">
    <Description><Code>Orientation.Vertical</Code> 竖排，键盘改用 ↑↓。放进 Field 时以标签为名称，沿用 Field 的不可用；单项可以单独不可用。</Description>
    <ChildContent>
        <Grid MinItemWidth="@CssLength.Rem(12)" Gap="SpaceScale.Lg">
            <Field Label="外观">
                <ToggleGroup @bind-Value="appearance" Orientation="Orientation.Vertical" Required="true">
                    <ToggleItem Value="light" Icon="Lucide.Sun">亮色</ToggleItem>
                    <ToggleItem Value="dark" Icon="Lucide.Moon">暗色</ToggleItem>
                    <ToggleItem Value="system" Icon="Lucide.Monitor">跟随系统</ToggleItem>
                </ToggleGroup>
            </Field>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                <Field Label="整组不可用">
                    <ToggleGroup @bind-Value="density" Required="true" Disabled="true">
                        <ToggleItem Value="compact">紧凑</ToggleItem>
                        <ToggleItem Value="comfortable">适中</ToggleItem>
                    </ToggleGroup>
                </Field>
                <Field Label="单项不可用">
                    <ToggleGroup @bind-Value="density" Required="true" Size="Size.Lg">
                        <ToggleItem Value="compact">紧凑</ToggleItem>
                        <ToggleItem Value="comfortable">适中</ToggleItem>
                        <ToggleItem Value="spacious" Disabled="true">宽松</ToggleItem>
                    </ToggleGroup>
                </Field>
            </Flex>
        </Grid>
    </ChildContent>
</DemoSection>

@code {
    string? view = "board";
    string? period = "week";
    IReadOnlyList<string> marks = ["bold"];
    string? align = "left";
    string? appearance = "system";
    string? density = "comfortable";

    // 示例段落按字形与对齐变化
    Sx TextStyle => Sx.Of(
        marks.Contains("bold") ? Bold : null,
        marks.Contains("italic") ? Italic : null,
        (marks.Contains("underline"), marks.Contains("strike")) switch
        {
            (true, true) => UnderlineStrike,
            (true, false) => Underline,
            (false, true) => Strike,
            _ => null,
        },
        AlignOf(align ?? "left"));

    static Style Bold => Css.Define(static () => new Style { FontWeight = FontWeights.Bold });

    static Style Italic => Css.Define(static () => new Style { FontStyle = FontStyle.Italic });

    static Style Underline => Css.Define(static () => new Style { TextDecorationLine = TextDecorationLine.Underline });

    static Style Strike => Css.Define(static () => new Style { TextDecorationLine = TextDecorationLine.LineThrough });

    static Style UnderlineStrike => Css.Define(static () => new Style { TextDecorationLine = "underline line-through" });

    static Style AlignOf(string value) => Css.Define(value, static value => new Style { TextAlign = value });
}
