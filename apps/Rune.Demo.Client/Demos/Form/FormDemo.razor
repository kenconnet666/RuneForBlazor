@* 表单：Form（包 EditForm）+ Field + 各输入控件，DataAnnotations 校验、提交中、错误汇总 *@
@attribute [ComponentDemo("form", "表单与输入", Group = "表单", Order = 0)]
@using System.ComponentModel.DataAnnotations
@inherits RuneComponent

<DemoSection Title="Form：校验、提交中、错误汇总">
    <Form Model="model" OnValidSubmit="SubmitAsync" Sx="FormWidth" data-testid="signup">
        <Field Label="姓名" Required="true">
            <TextField @bind-Value="model.Name" placeholder="张三" autocomplete="name" data-testid="name" />
        </Field>
        <Field Label="邮箱" Description="用于找回密码" Required="true">
            <TextField @bind-Value="model.Email" Type="email" Icon="Lucide.Mail" placeholder="name@example.com" data-testid="email" />
        </Field>
        <Field Label="数量" Description="1–99，按 ↑↓ 加减">
            <NumberField @bind-Value="model.Quantity" Min="1" Max="99" data-testid="quantity" />
        </Field>
        <Field Label="配送方式" Required="true">
            <RadioGroup @bind-Value="model.Shipping" Orientation="Orientation.Horizontal" data-testid="shipping">
                <Radio Value="@("express")">快递</Radio>
                <Radio Value="@("pickup")">自提</Radio>
                <Radio Value="@("same-day")" Disabled="true">当日达（暂停）</Radio>
            </RadioGroup>
        </Field>
        <Field Label="城市" Required="true">
            <NativeSelect @bind-Value="model.City" Items="cities" Placeholder="选择城市" data-testid="city" />
        </Field>
        <Field Label="预算" Description="@($"{model.Budget:N0} 元")">
            <Slider @bind-Value="model.Budget" Min="0" Max="5000" Step="100" ValueText="@(v => $"{v:N0} 元")" />
        </Field>
        <Field Label="个人简介" Description="最多 60 个字">
            <Textarea @bind-Value="model.Bio" placeholder="一句话介绍自己" data-testid="bio" />
        </Field>
        <Field>
            <Checkbox @bind-Value="model.Agreed" data-testid="agree">我已阅读并同意服务条款</Checkbox>
        </Field>
        <Switch @bind-Value="model.Notify">有新消息时通知我</Switch>
        <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
            <Button Type="submit" data-testid="submit">注册（模拟保存 1 秒）</Button>
            <TextSpan Tone="TextTone.Muted" Size="Size.Sm" data-testid="result">@result</TextSpan>
        </Flex>
    </Form>
</DemoSection>

<DemoSection Title="数字、单选、下拉、滑块">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Sx="FormWidth">
        <NumberField @bind-Value="price" Step="0.01m" Format="N2" aria-label="单价">
            <Prefix>¥</Prefix>
        </NumberField>
        <TextSpan Tone="TextTone.Muted" Size="Size.Sm" data-testid="price">单价：@(price?.ToString("N2") ?? "（空）")（decimal，步长 0.01，没有浮点误差）</TextSpan>
        <RadioGroup @bind-Value="plan" aria-label="套餐">
            <Radio Value="Plan.Free">免费版</Radio>
            <Radio Value="Plan.Pro">专业版</Radio>
            <Radio Value="Plan.Team">团队版</Radio>
        </RadioGroup>
        <TextSpan Tone="TextTone.Muted" Size="Size.Sm">套餐：@plan（枚举值）</TextSpan>
        <Slider @bind-Value="volume" aria-label="音量" />
        <TextSpan Tone="TextTone.Muted" Size="Size.Sm">音量：@volume（拖动中实时写回）</TextSpan>
    </Flex>
</DemoSection>

<DemoSection Title="单独使用">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Sx="FormWidth">
        <TextField @bind-Value="keyword" Immediate="true" Icon="Lucide.Search" placeholder="边输边搜（Immediate）" data-testid="search" />
        <TextSpan Tone="TextTone.Muted" Size="Size.Sm">关键词：@(string.IsNullOrEmpty(keyword) ? "（空）" : keyword)</TextSpan>
        <TextField Value="@("只读的值")" ReadOnly="true" />
        <TextField placeholder="不可用" Disabled="true" />
        <TextField placeholder="金额" Size="Size.Lg">
            <Suffix>元</Suffix>
        </TextField>
        <Field Label="直接给错误信息" Error="这个用户名已被占用">
            <TextField Value="@("admin")" />
        </Field>
    </Flex>
</DemoSection>

<DemoSection Title="勾选框：全选与半选">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Checkbox Value="AllSelected" Indeterminate="SomeSelected" ValueChanged="SelectAll" data-testid="select-all">全选</Checkbox>
        @foreach (var fruit in fruits)
        {
            <Checkbox @key="fruit" Value="selected.Contains(fruit)" ValueChanged="@(on => Toggle(fruit, on))" Sx="Indent">@fruit</Checkbox>
        }
        <Checkbox Disabled="true">不可用</Checkbox>
    </Flex>
</DemoSection>

@code {
    static readonly string[] fruits = ["苹果", "香蕉", "橙子"];
    readonly HashSet<string> selected = ["苹果"];
    readonly SignupModel model = new();
    string? keyword;
    decimal? price = 9.9m;
    Plan plan = Plan.Pro;
    int volume = 40;

    enum Plan { Free, Pro, Team }
    string result = "";

    bool AllSelected => selected.Count == fruits.Length;
    bool SomeSelected => selected.Count > 0 && !AllSelected;

    void SelectAll(bool on)
    {
        selected.Clear();
        if (on) selected.UnionWith(fruits);
    }

    void Toggle(string fruit, bool on)
    {
        if (on) selected.Add(fruit);
        else selected.Remove(fruit);
    }

    static readonly string[] cities = ["北京", "上海", "广州", "深圳"];

    async Task SubmitAsync()
    {
        await Task.Delay(1000);
        result = $"已提交：{model.Name} <{model.Email}>，{model.Quantity} 件，{model.Shipping}，{model.City}，预算 {model.Budget:N0} 元";
    }

    static Style FormWidth => Css.Define(static () => new Style { MaxWidth = 420 });

    static Style Indent => Css.Define(static () => new Style { MarginInlineStart = Space.Lg });

    sealed class SignupModel
    {
        [Required(ErrorMessage = "请填写姓名")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "请填写邮箱")]
        [EmailAddress(ErrorMessage = "邮箱格式不对")]
        public string? Email { get; set; }

        [MaxLength(60, ErrorMessage = "最多 60 个字")]
        public string? Bio { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "请先同意服务条款")]
        public bool Agreed { get; set; }

        public bool Notify { get; set; } = true;

        [Range(1, 99, ErrorMessage = "数量在 1–99 之间")]
        public int? Quantity { get; set; } = 1;

        [Required(ErrorMessage = "请选择配送方式")]
        public string? Shipping { get; set; }

        [Required(ErrorMessage = "请选择城市")]
        public string? City { get; set; }

        public double Budget { get; set; } = 1000;
    }
}
