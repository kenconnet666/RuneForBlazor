@*
    颜色输入：示例与 vue-tsx-pro 文档站的 /components/color-field 对应。
    ColorSwatch（swatch 一节）在 vue 的 docs-kit（文档工具包）里，属于可选模块，先不放。数据是虚构的。
*@
@attribute [ComponentDemo("color-field", "颜色输入", Group = "表单", Order = 14)]
@inherits RuneComponent

<DemoSection Id="brand" Title="品牌配色">
    <Description>值是 <Code>#rrggbb</Code>，绑定后随拖动实时写回。外观、Field 关联与 TextField 相同。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Grid MinItemWidth="@CssLength.Rem(10)" Gap="SpaceScale.Md">
                <Field Label="品牌色"><ColorField @bind-Value="brand" data-testid="brand" /></Field>
                <Field Label="卡片底色"><ColorField @bind-Value="background" /></Field>
                <Field Label="文字色"><ColorField @bind-Value="text" /></Field>
            </Grid>
            <Card Padding="SpaceScale.None">
                <div @attributes="Attrs.Merge(Preview)" style="@($"background-color: {background}; color: {text}")" data-testid="preview">
                    <span @attributes="Attrs.Merge(BrandBadge)" style="@($"background-color: {brand}")"><Icon Data="Lucide.Sparkles" /></span>
                    <Flex Direction="LayoutDirection.Column">
                        <Strong>小满商城 · 会员日</Strong>
                        <Small>全场满 300 减 50，今晚 24:00 截止</Small>
                    </Flex>
                </div>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="formats" Title="格式与透明度">
    <Description>能输入 CSS 的颜色写法（rgb()、hsl()、hwb()、oklch()、颜色名），失焦或回车时规范成 #hex；写不成颜色时标为无效、值不变，失焦后恢复。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Field Label="任意格式" Description="输入 rgb(255 99 71)、hsl(…)、颜色名（tomato）后回车或失焦，规范成 #hex 写回">
                <ColorField @bind-Value="color" data-testid="any" />
            </Field>
            <Small Tone="TextTone.Muted">值：<Code data-testid="any-value">@color</Code></Small>
            <Field Label="带透明度" Description="#rrggbbaa；用原生取色器选色时透明度会去掉（它不支持透明度）">
                <ColorField @bind-Value="overlay" />
            </Field>
            <Field Label="只读" ReadOnly="true">
                <ColorField Value="#16a34a" />
            </Field>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="states" Title="外观与状态">
    <Description><Code>Variant</Code>、<Code>Size</Code>、<Code>Radius</Code> 与其他输入框同一套；Field 上的 <Code>Required</Code>、<Code>Error</Code>、<Code>ReadOnly</Code>、<Code>Disabled</Code> 交给里面的 ColorField。</Description>
    <ChildContent>
        <Grid MinItemWidth="@CssLength.Rem(14)" Gap="SpaceScale.Lg">
            <Field Label="InputVariant.Soft、Radius.Full"><ColorField @bind-Value="accent" Variant="InputVariant.Soft" Radius="Radius.Full" /></Field>
            <Field Label="Size.Sm"><ColorField @bind-Value="accent" Size="Size.Sm" /></Field>
            <Field Label="背景色" Required="true" Error="@(string.IsNullOrEmpty(empty) ? "请填写背景色" : null)"><ColorField @bind-Value="empty" /></Field>
            <Field Label="只读" ReadOnly="true"><ColorField Value="#30a46c" /></Field>
            <Field Label="不可用" Disabled="true"><ColorField Value="#e5484d" /></Field>
        </Grid>
    </ChildContent>
</DemoSection>

@code {
    static readonly Attrs Preview = new() { Sx = PreviewStyle };
    static readonly Attrs BrandBadge = new() { Sx = BadgeStyle };

    string? brand = "#6e56cf", background = "#f4f0fe", text = "#2f265f";
    string? color = "#0ea5e9", overlay = "#11182799";
    string? accent = "#3e63dd", empty = "";

    static Style PreviewStyle => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        AlignItems = AlignItems.Center,
        Gap = Space.Md,
        Padding = Space.Lg,
        BorderRadius = Radii.Lg,
    });

    static Style BadgeStyle => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        PlaceItems = PlaceItems.Center,
        Width = CssLength.Rem(2.5),
        Height = CssLength.Rem(2.5),
        BorderRadius = Radii.Md,
        FontSize = CssLength.Rem(1.25),
        Color = "#fff",
    });
}
