@*
    文本框：示例与 vue-tsx-pro 文档站的 /components/text-field 一一对应。
    “手机号、身份证号、银行卡号”（输入时自动分组的 Format）做好后补上；评论示例里的头像（Avatar）先用圆形色块占位。
*@
@attribute [ComponentDemo("text-field", "文本框", Group = "表单", Order = 1)]
@inherits RuneComponent

<DemoSection Id="form" Title="注册表单">
    <Description>放进 Field：标签、说明、错误自动经 aria-labelledby / aria-describedby 关联，并沿用 Field 的必填、不可用。Type="password" 带显示密码的按钮；Prefix / Suffix 是固定的文字（区号、域名），不进值里；maxlength 加 ShowCount 显示字数。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                <Grid MinItemWidth="@("14rem")" Gap="SpaceScale.Lg">
                    <Field Label="邮箱" Required="true">
                        <TextField @bind-Value="email" Type="email" Icon="Lucide.Mail" placeholder="you@example.com" />
                    </Field>
                    <Field Label="密码" Required="true" Description="至少 8 位，包含字母和数字"
                           Error="@(password is { Length: > 0 and < 8 } ? $"还差 {8 - password.Length} 位" : null)">
                        <TextField @bind-Value="password" Type="password" Immediate="true" data-testid="password" />
                    </Field>
                    <Field Label="用户名">
                        <TextField @bind-Value="handle" Icon="Lucide.AtSign" maxlength="20" ShowCount="true" data-testid="handle" />
                    </Field>
                    <Field Label="手机号">
                        <TextField @bind-Value="phone" Type="tel" Icon="Lucide.Phone">
                            <Prefix>+86</Prefix>
                        </TextField>
                    </Field>
                </Grid>
                <Field Label="个人站点">
                    <TextField @bind-Value="site" Icon="Lucide.Globe">
                        <Prefix>https://</Prefix>
                        <Suffix>.example.com</Suffix>
                    </TextField>
                </Field>
                <Flex Justify="ContentJustify.End">
                    <Button>注册</Button>
                </Flex>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="appearance" Title="样式、尺寸与状态">
    <Description>Variant 有描边（Surface）与浅底（Soft），Size 对应字号档位，Radius 同按钮。不可用、只读、校验未通过的外观由 Field 统一给。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Grid Columns="2" Gap="SpaceScale.Md">
                @foreach (var variant in Enum.GetValues<InputVariant>())
                {
                    var name = variant.ToString().ToLowerInvariant();
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                        <Small Tone="TextTone.Muted">variant="@name"</Small>
                        @foreach (var size in sizes)
                        {
                            var sizeName = size.ToString().ToLowerInvariant();
                            <TextField Variant="variant" Size="size" Icon="Lucide.Search" placeholder="@($"size=\"{sizeName}\"")" aria-label="@($"{name} {sizeName}")" />
                        }
                        <TextField Variant="variant" Radius="Radius.Full" Icon="Lucide.Search" placeholder="radius=&quot;full&quot;" aria-label="@($"{name} 圆角")" />
                    </Flex>
                }
            </Grid>
            <Grid MinItemWidth="@("11rem")" Gap="SpaceScale.Md">
                <Field Label="不可用" Disabled="true"><TextField Value="不能改" /></Field>
                <Field Label="只读" ReadOnly="true"><TextField Value="可以选中复制" /></Field>
                <Field Label="校验未通过" Error="这个用户名已经被占用了"><TextField Value="admin" /></Field>
            </Grid>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="textarea" Title="Textarea">
    <Description>高度随内容在 Rows 与 MaxRows 之间增长（父级改值也会跟着变）；Fixed 关掉自动增高、允许拖动调整，Clearable 在右上角放清空按钮。字数计数超出上限时变成危险色，读屏念完整的句子。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Card>
                <Flex Gap="SpaceScale.Md" Align="ItemAlign.Start">
                    <span @attributes="Attrs.Merge(AvatarStandIn)" aria-hidden="true">林</span>
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm" Grow="true">
                        <Field Label="发表评论" Description="随内容自动增高，最多 6 行后出现滚动条">
                            <Textarea @bind-Value="comment" Rows="2" MaxRows="6" maxlength="200" ShowCount="true" placeholder="说点什么…" data-testid="comment" />
                        </Field>
                        <Flex Justify="ContentJustify.End">
                            <Button Size="Size.Sm" Disabled="string.IsNullOrWhiteSpace(comment)">发布</Button>
                        </Flex>
                    </Flex>
                </Flex>
            </Card>
            <Field Label="固定高度（fixed）" Description="不自动增高，右下角可以拖动调整；clearable 在右上角放清空按钮">
                <Textarea @bind-Value="notes" Rows="3" Fixed="true" Clearable="true" />
            </Field>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="adornments" Title="图标、前后缀、清空与字数">
    <Description>Icon / IconEnd 放在框的两头，Prefix / Suffix 是不算在值里的固定文字，Clearable 有内容时显示清空按钮。Field 的 Error 让框标红并把错误作为说明。自己做的输入组件用 CharacterCount 显示字数。</Description>
    <ChildContent>
        <Grid MinItemWidth="@("16rem")" Gap="SpaceScale.Lg">
            <Field Label="搜索">
                <TextField @bind-Value="keyword" Type="search" Icon="Lucide.Search" Clearable="true" Radius="Radius.Full" data-testid="search" />
            </Field>
            <Field Label="个人主页" Description="prefix 是不算在值里的固定文字，iconEnd 在框尾">
                <TextField @bind-Value="homepage" IconEnd="Lucide.Link2"><Prefix>https://</Prefix></TextField>
            </Field>
            <Field Label="用户名" Error="用户名已被占用，换一个试试">
                <TextField Value="xiaoman" Icon="Lucide.AtSign" />
            </Field>
            <Field Label="简介" Description="自己的输入组件（富文本、代码编辑器）用 CharacterCount 显示字数">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                    <Textarea @bind-Value="bio" Rows="3" />
                    <CharacterCount Count="bio.Length" Max="30" />
                </Flex>
            </Field>
        </Grid>
    </ChildContent>
</DemoSection>

@code {
    static readonly Size[] sizes = [Size.Sm, Size.Md, Size.Lg];

    string? email, password, handle, phone, site, comment;
    string? notes = "第一行\n第二行\n第三行";
    string? keyword = "设计规范";
    string? homepage = "github.com/linxiaoman";
    string bio = "喜欢做小而美的工具，周末在山里跑步。";

    // 头像（Avatar）做好前的占位：小号圆形、浅色底
    static Style AvatarStandIn => Css.Define(static () => new Style
    {
        Display = Display.InlineFlex,
        AlignItems = AlignItems.Center,
        JustifyContent = JustifyContent.Center,
        Width = CssLength.Em(2),
        Height = CssLength.Em(2),
        FlexShrink = 0,
        BorderRadius = Radii.Full,
        BackgroundColor = Tones.Accent.Soft,
        Color = Tones.Accent.Text,
        FontSize = FontSizes.Sm,
    });
}
