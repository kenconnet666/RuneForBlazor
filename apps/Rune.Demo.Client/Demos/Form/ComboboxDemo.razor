@*
    组合框：示例与 vue-tsx-pro 文档站的 /components/combobox 对应。
*@
@attribute [ComponentDemo("combobox", "输入选择", Group = "表单", Order = 6)]
@inherits RuneComponent

<DemoSection Id="basic" Title="本地筛选与远程搜索">
    <Description>默认本地筛选（忽略大小写与重音），中文输入法组合期间不拿拼音去筛选。远程搜索给 <Code>Load(输入, 取消令牌)</Code>：输入停下 300 ms 后请求，只采用最后一次，被顶掉的请求取消；自己管请求时写 <Code>LocalFilter="false"</Code>，按 <Code>InputValue</Code> 换 <Code>Items</Code>、配合 <Code>Loading</Code>。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Field Label="城市" Description="本地过滤：输入“州”试试">
                <Combobox Items="cities" @bind-Value="city" Clearable="true" placeholder="输入或选择" data-testid="city" />
            </Field>
            <Field Label="成员" Description="远程搜索：Load 在输入停下 300 ms 后请求，只采用最后一次">
                <Combobox TItem="string" Load="SearchUsersAsync" @bind-InputValue="keyword" @bind-Value="user" placeholder="输入用户名" data-testid="member">
                    <Empty>@(string.IsNullOrEmpty(keyword) ? "输入关键词开始搜索" : "没有匹配的成员")</Empty>
                </Combobox>
            </Field>
            <Small Tone="TextTone.Muted" data-testid="basic-summary">城市：@(city ?? "未选") · 成员：@(user ?? "未选")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="freeform" Title="自由输入、图标与状态">
    <Description><Code>AllowCustomValue</Code> 允许输入选项里没有的文字：失焦时保留，<Code>Value</Code> 为 null、文字在 <Code>InputValue</Code> 里。<Code>Icon</Code>、<Code>Variant</Code>、<Code>Radius</Code> 与只读、不可用同其他输入框。</Description>
    <ChildContent>
        <Grid MinItemWidth="@CssLength.Rem(15)" Gap="SpaceScale.Lg">
            <Field Label="职位" Description="@(title is not null ? $"选中了 {title}" : $"自由输入：{(string.IsNullOrEmpty(typed) ? "（空）" : typed)}，Value 为 null")">
                <Combobox Items="titles" @bind-Value="title" @bind-InputValue="typed" AllowCustomValue="true" Icon="Lucide.BriefcaseBusiness" Clearable="true"
                          placeholder="选择或输入" data-testid="title" />
            </Field>
            <Field Label="Variant=&quot;Soft&quot; Radius=&quot;Full&quot;">
                <Combobox Items="titles" Icon="Lucide.Search" Variant="InputVariant.Soft" Radius="Radius.Full" placeholder="搜索职位" />
            </Field>
            <Field Label="只读" ReadOnly="true">
                <Combobox Items="titles" Value="前端工程师" />
            </Field>
            <Field Label="不可用" Disabled="true">
                <Combobox Items="titles" Value="测试工程师" />
            </Field>
        </Grid>
    </ChildContent>
</DemoSection>

@code {
    static readonly string[] cities =
    [
        "北京", "上海", "广州", "深圳", "杭州", "南京", "苏州", "成都", "重庆", "武汉", "西安", "天津", "长沙", "郑州", "青岛",
        "厦门", "宁波", "合肥", "福州", "昆明", "大连", "沈阳", "哈尔滨", "济南", "无锡", "东莞", "佛山", "珠海", "南宁", "贵阳",
    ];

    static readonly string[] users = ["zhouyihang", "linxiaoman", "chenmo", "xuyou", "wangqing", "zhaohaoran", "sunsiyuan", "liyutong"];

    static readonly string[] titles = ["产品经理", "交互设计师", "视觉设计师", "前端工程师", "后端工程师", "测试工程师"];

    string? city;
    string? keyword = "";
    string? user;
    string? title;
    string? typed = "";

    // 假的远程搜索：300 ms 后返回包含关键词的用户名，被后来的请求顶掉时取消
    static async Task<IEnumerable<string>> SearchUsersAsync(string query, CancellationToken cancellation)
    {
        await Task.Delay(300, cancellation);
        return string.IsNullOrEmpty(query) ? [] : users.Where(name => name.Contains(query, StringComparison.OrdinalIgnoreCase));
    }
}
