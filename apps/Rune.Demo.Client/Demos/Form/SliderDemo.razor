@*
    滑块：示例与 vue-tsx-pro 文档站的 /components/slider 对应。
    vue 的值是数组时是范围；这里范围绑 Range（NumberRange），同 Select 的 Value / Values。
*@
@attribute [ComponentDemo("slider", "滑块", Group = "表单", Order = 11)]
@inherits RuneComponent

<DemoSection Id="player" Title="播放器">
    <Description><Code>ValueText</Code> 是读屏念的值（“1:12 / 4:05”）。<Kbd>←</Kbd> <Kbd>→</Kbd> 按 <Code>Step</Code> 走，<Kbd>Page Up</Kbd> / <Kbd>Page Down</Kbd> 按 <Code>BigStep</Code>（默认十分之一），<Kbd>Home</Kbd> / <Kbd>End</Kbd> 到两端；点轨道任意位置直接跳过去并接着拖。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                    <Slider @bind-Value="position" Max="Duration" ValueText="@(v => $"{Clock(v)} / {Clock(Duration)}")" aria-label="播放进度" data-testid="position" />
                    <Flex Justify="ContentJustify.Between">
                        <Small Tone="TextTone.Muted" data-testid="elapsed">@Clock(position)</Small>
                        <Small Tone="TextTone.Muted">-@Clock(Duration - position)</Small>
                    </Flex>
                </Flex>
                <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                    <IconButton Icon="VolumeIcon" Label="@(muted ? "取消静音" : "静音")" aria-pressed="@(muted ? "true" : "false")" @onclick="() => muted = !muted" />
                    <Slider TValue="int" Value="@(muted ? 0 : volume)" ValueChanged="SetVolume" ValueText="@(v => $"音量 {v}%")" aria-label="音量" />
                </Flex>
                <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                    <Icon Data="Lucide.Sun" />
                    <Slider @bind-Value="brightness" Min="0" Max="1" Step="0.05" Tone="Tone.Warning" ValueText="@(v => $"{Math.Round(v * 100)}%")" aria-label="亮度" />
                </Flex>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="range" Title="价格区间与刻度">
    <Description>绑 <Code>Range</Code>（<Code>NumberRange</Code>，低与高）时选一个范围：两个滑块各自可聚焦、不能交叉，读屏名称后面加上“最小值”“最大值”。<Code>Marks</Code> 是刻度；拖动时实时写回，<Code>OnRangeCommit</Code> 在松手时调用一次，适合去查询接口。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xl">
            <Field Label="价格区间" Description="拖动时实时写回；松手（或键盘改完）时 OnRangeCommit 才去查询">
                <Slider TValue="int" @bind-Range="price" Min="0" Max="5000" Step="100" Marks="priceMarks" ValueText="Yuan"
                             OnRangeCommit="@(next => committed = next)" data-testid="price" />
            </Field>
            <Small Tone="TextTone.Muted" data-testid="price-summary">正在看 @Yuan(price.Low)–@Yuan(price.High)；已查询 @Yuan(committed.Low)–@Yuan(committed.High)</Small>
            <Field Label="最低评分">
                <Slider @bind-Value="rating" Min="1" Max="5" Marks="ratingMarks" Tone="Tone.Success" ValueText="@(v => $"{v} 星及以上")" />
            </Field>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="vertical" Title="竖排的均衡器">
    <Description><Code>Orientation.Vertical</Code>：<Kbd>↑</Kbd> 增大、<Kbd>↓</Kbd> 减小。值的类型随绑定的变量（int、double、decimal……）。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                <ToggleGroup Value="@preset" ValueChanged="ApplyPreset" Required="true" Size="Size.Sm" aria-label="预设">
                    <ToggleItem Value="flat">平直</ToggleItem>
                    <ToggleItem Value="bass">低音</ToggleItem>
                    <ToggleItem Value="vocal">人声</ToggleItem>
                    <ToggleItem Value="bright">明亮</ToggleItem>
                </ToggleGroup>
                <Flex Justify="ContentJustify.Between" Gap="SpaceScale.Sm" data-testid="bands">
                    @for (var i = 0; i < Bands.Length; i++)
                    {
                        var index = i;
                        <Flex @key="Bands[index]" Direction="LayoutDirection.Column" Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                            <Slider TValue="int" Orientation="Orientation.Vertical" Value="gains[index]" ValueChanged="@(next => gains[index] = next)" Min="-12" Max="12" Size="Size.Sm"
                                    ValueText="@(v => $"{(v > 0 ? "+" : "")}{v} dB")" aria-label="@($"{Bands[index]} Hz")" />
                            <Small Tone="TextTone.Muted">@Bands[index]</Small>
                        </Flex>
                    }
                </Flex>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="form" Title="表单提交与不可用">
    <Description><Code>Name</Code> 用隐藏的 input 随表单提交当前值（静态 SSR 下拖动同样更新它）；拖动过程中值一直在变，<Code>OnValueCommit</Code> 只在松手（或键盘改完）时调用，适合保存到服务端。Field 的 <Code>Disabled</Code> 交给里面的滑块。</Description>
    <ChildContent>
        <form @onsubmit="Submit" @onsubmit:preventDefault data-testid="slider-form">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                <Field Label="提醒音量" Description="@($"拖动中 {reminder}，松手后才保存：{saved}")">
                    <Slider TValue="int" @bind-Value="reminder" Name="volume" OnValueCommit="@(value => saved = value)" />
                </Field>
                <Field Label="系统音量" Disabled="true" Description="由系统设置控制">
                    <Slider Value="40" />
                </Field>
                <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center" Wrap="true">
                    <Button Type="submit" Variant="ButtonVariant.Outline" Tone="Tone.Neutral">提交</Button>
                    @if (submitted is not null)
                    {
                        <Code data-testid="submitted">@submitted</Code>
                    }
                    else
                    {
                        <Small Tone="TextTone.Muted">Name 随表单提交当前值</Small>
                    }
                </Flex>
            </Flex>
        </form>
    </ChildContent>
</DemoSection>

@code {
    const int Duration = 245;
    static readonly string[] Bands = ["60", "150", "400", "1k", "2.4k", "6k", "15k"];
    static readonly Dictionary<string, int[]> Presets = new()
    {
        ["flat"] = [0, 0, 0, 0, 0, 0, 0],
        ["bass"] = [8, 6, 3, 0, -1, -2, -2],
        ["vocal"] = [-2, -1, 2, 5, 4, 1, 0],
        ["bright"] = [-1, -1, 0, 1, 3, 6, 8],
    };
    static readonly SliderMark<int>[] priceMarks = [new(0, "¥0"), new(1000, "¥1k"), new(2500, "¥2.5k"), new(5000, "¥5k+")];
    static readonly SliderMark<int>[] ratingMarks = [.. Enumerable.Range(1, 5).Select(v => new SliderMark<int>(v, $"{v} 星"))];

    int position = 72;
    int volume = 60;
    bool muted;
    double brightness = 0.8;

    NumberRange<int> price = new(800, 3500);
    NumberRange<int> committed = new(800, 3500);
    int rating = 4;

    string? preset = "bass";
    int[] gains = [.. Presets["bass"]];

    int reminder = 60;
    int saved = 60;
    string? submitted;

    IconData VolumeIcon => muted || volume == 0 ? Lucide.VolumeX : volume < 50 ? Lucide.Volume1 : Lucide.Volume2;

    static string Clock(int seconds) => $"{seconds / 60}:{seconds % 60:00}";

    static string Yuan(int value) => $"¥{value:N0}";

    void SetVolume(int next)
    {
        volume = next;
        muted = false;
    }

    void ApplyPreset(string? next)
    {
        preset = next;
        if (next is not null) gains = [.. Presets[next]];
    }

    void Submit() => submitted = $"{{\"volume\":\"{reminder}\"}}";
}
