@*
    列表框：示例与 vue-tsx-pro 文档站的 /components/listbox 对应。
    vue-tsx-pro 的 Listbox 始终虚拟滚动、loading 时显示骨架行；这两样在阶段 4 的虚拟滚动、骨架屏条目里补上，现在一千个选项全部渲染。
*@
@attribute [ComponentDemo("listbox", "列表框", Group = "表单", Order = 4)]
@inherits RuneComponent
@implements IDisposable

<DemoSection Id="multiple" Title="多选与虚拟滚动">
    <Description><Code>SelectionMode.Multiple</Code> 多选；焦点在列表上，按字母跳转。列表默认最高 20em，用 Sx 改。</Description>
    <ChildContent>
        <Card Padding="SpaceScale.Sm">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Listbox Items="fields" SelectionMode="SelectionMode.Multiple" @bind-Values="visible" aria-label="显示的列" Sx="ListHeight" data-testid="columns" />
                <Small Tone="TextTone.Muted">显示 @visible.Count 列 / 共 @fields.Length 个字段</Small>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="single" Title="单选、分组与说明">
    <Description>选项可以带 Icon、Description、Group，Disabled 的项高亮时跳过。Required 时单选至少保留一项，再点已选项不取消；在 Field 里时名称取 Field 的标签。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            <Field Label="套餐" Required="true">
                <Listbox Items="plans" @bind-Value="plan" data-testid="plans" />
            </Field>
            <Small Tone="TextTone.Muted" data-testid="plan-picked">选了：@(plans.FirstOrDefault(p => p.Value == plan)?.Label ?? "无")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="remote" Title="远程搜索：加载、空结果与点选">
    <Description><Code>Empty</Code> 换掉默认的空状态。<Code>OnPick</Code> 在每次点选（点击或 Enter）时调用，再点已选的那项也算，适合“选中即执行”。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            <Card Padding="SpaceScale.Sm">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                    <TextField Value="@query" ValueChanged="Search" Immediate="true" Icon="Lucide.Search" Variant="InputVariant.Soft" placeholder="搜索成员" aria-label="搜索成员" />
                    <Listbox aria-label="成员" Items="results" @bind-Value="picked" OnPick="Pick">
                        <Empty>
                            <Empty Title="@(b => b.AddContent(0, "没有找到"))" Description="@(b => b.AddContent(0, $"没有名字含“{query}”的成员"))" Size="Size.Sm">
                                <Button Size="Size.Sm" Variant="ButtonVariant.Soft" OnClick="() => Search(string.Empty)">清空搜索</Button>
                            </Empty>
                        </Empty>
                    </Listbox>
                </Flex>
            </Card>
            <Small Tone="TextTone.Muted">最后点选：@(lastPick ?? "无")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    static readonly string[] common = ["订单号", "客户", "金额", "状态", "下单时间", "收货地址"];

    // 一千个可选的列
    static readonly ListboxOption[] fields = [.. Enumerable.Range(0, 1000).Select(index => index < common.Length
        ? new ListboxOption($"field-{index}", common[index], Group: "常用")
        : new ListboxOption($"field-{index}", $"自定义字段 {index - 5}", Group: "自定义"))];

    static readonly ListboxOption[] plans =
    [
        new("free", "免费版", Icon: Lucide.Sprout, Description: "3 个项目、1 GB 存储", Group: "个人"),
        new("pro", "专业版", Icon: Lucide.Rocket, Description: "不限项目、100 GB 存储", Group: "个人"),
        new("team", "团队版", Icon: Lucide.Users, Description: "20 人以内，共享空间", Group: "团队"),
        new("enterprise", "企业版", Icon: Lucide.BuildingComplex, Description: "单点登录、审计日志（请联系销售）", Group: "团队", Disabled: true),
    ];

    static readonly ListboxOption[] people =
        [.. new[] { "林小满", "周一航", "陈默", "许悠", "王晴", "赵子墨", "孙可", "李想" }.Select(name => new ListboxOption(name, name))];

    IReadOnlyList<string> visible = ["field-0", "field-1", "field-2", "field-3"];
    string? plan = "pro";

    string query = string.Empty;
    IReadOnlyList<ListboxOption> results = people;
    string? picked;
    string? lastPick;
    CancellationTokenSource? searching;

    static Style ListHeight => Css.Define(static () => new Style { Height = "16rem" });

    // 模拟接口：输入停下 600ms 后返回
    async Task Search(string? text)
    {
        query = text ?? string.Empty;
        searching?.Cancel();
        var current = searching = new CancellationTokenSource();
        try
        {
            await Task.Delay(600, current.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        results = [.. people.Where(person => person.Label.Contains(query.Trim(), StringComparison.Ordinal))];
    }

    void Pick(string value) => lastPick = $"{value}（{DateTime.Now:T}）";

    /// <inheritdoc/>
    public void Dispose() => searching?.Cancel();
}
