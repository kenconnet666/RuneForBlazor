@*
    自动完成：示例与 vue-tsx-pro 文档站的 /components/autocomplete 对应。
*@
@attribute [ComponentDemo("autocomplete", "自动完成", Group = "表单", Order = 7)]
@inherits RuneComponent

<DemoSection Id="email" Title="邮箱后缀">
    <Description><Code>Value</Code> 就是输入框里的文字，不选建议也行；要从固定的选项里选一个（值是选项的 value）时用 Combobox。建议可以随输入算出来，配 <Code>LocalFilter="false"</Code> 不再本地过滤；没有可选的建议时不弹出列表。写了 <Code>Name</Code> 时表单提交的是文字。</Description>
    <ChildContent>
        <Grid MinItemWidth="@CssLength.Rem(15)" Gap="SpaceScale.Lg">
            @* 建议已经按输入算好，不再本地过滤 *@
            <Field Label="联系邮箱" Description="@($"值就是文字：{(string.IsNullOrEmpty(email) ? "（空）" : email)}")">
                <Autocomplete Items="Suggest(email)" LocalFilter="false" @bind-Value="email" Icon="Lucide.Mail" Clearable="true" placeholder="输入邮箱" Name="email" data-testid="email" />
            </Field>
            <Field Label="抄送" Description="已有值时照常显示；建议只在输入时出现">
                <Autocomplete Items="Suggest(cc)" LocalFilter="false" @bind-Value="cc" Icon="Lucide.Mail" />
            </Field>
        </Grid>
    </ChildContent>
</DemoSection>

<DemoSection Id="remote" Title="远程建议">
    <Description><Code>Load(输入, 取消令牌)</Code> 在输入停下 300 ms 后请求，只采用最后一次，被顶掉的请求取消（同 Combobox、Select）。系统里还没有的名称直接写全称，提交时再建。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
            <Field Label="供应商" Description="输入“杭州”“液压”试试；选不到时直接写全称，提交后会新建">
                <Autocomplete TItem="string" Load="SearchAsync" @bind-Value="supplier" Icon="Lucide.BuildingComplex" Clearable="true" placeholder="供应商全称" data-testid="supplier" />
            </Field>
            <Small Tone="TextTone.Muted" aria-live="polite">@(string.IsNullOrEmpty(supplier) ? "还没有填" : $"将提交：{supplier}")</Small>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    static readonly string[] domains = ["qq.com", "163.com", "foxmail.com", "gmail.com", "outlook.com", "company.cn"];

    static readonly string[] suppliers =
    [
        "杭州远山精密机械有限公司", "杭州青禾研发中心有限公司", "宁波海川液压件有限公司", "苏州明德电子科技有限公司",
        "无锡恒通密封件有限公司", "上海星澜涂装工程有限公司", "成都锐川钣金制造有限公司",
    ];

    string? email = "";
    string? cc = "finance@company.cn";
    string? supplier = "";

    // 按已输入的 @ 后面部分筛后缀：lin@q → lin@qq.com
    static string[] Suggest(string? text)
    {
        if (string.IsNullOrEmpty(text)) return [];
        var at = text.IndexOf('@');
        var name = at < 0 ? text : text[..at];
        var typedDomain = at < 0 ? "" : text[(at + 1)..];
        return [.. domains.Where(domain => domain.StartsWith(typedDomain, StringComparison.Ordinal)).Select(domain => $"{name}@{domain}")];
    }

    // 假的接口：400 ms 后返回包含输入的供应商（没输入时不给建议）；新的输入到来时取消
    static async Task<IEnumerable<string>> SearchAsync(string query, CancellationToken cancellation)
    {
        if (string.IsNullOrEmpty(query)) return [];
        await Task.Delay(400, cancellation);
        return suppliers.Where(name => name.Contains(query, StringComparison.Ordinal));
    }
}
