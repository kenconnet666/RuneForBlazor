@*
    复选框、开关与单选：示例与 vue-tsx-pro 文档站的 /components/checkbox 对应。
    开关的 loading 与轨道里的图标在阶段 6 做，做好后补齐那个示例。
*@
@attribute [ComponentDemo("checkbox", "复选框与开关", Group = "表单", Order = 3)]
@inherits RuneComponent

<DemoSection Id="checkbox" Title="复选框">
    <Description>单个复选框绑 <Code>Value</Code>；一组用 CheckboxGroup 绑值的列表，<Code>Name</Code> 随表单提交。全选框部分勾选时写 <Code>Indeterminate</Code>，读屏念“部分选中”。放进 Field 时组以标签为名称，并关联说明与错误。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Card Padding="SpaceScale.Sm">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                    @* 全选：部分勾选时 Indeterminate，读屏念“部分选中” *@
                    <Checkbox Value="AllGranted" Indeterminate="SomeGranted" ValueChanged="ToggleAll" data-testid="all">订单管理员（全部权限）</Checkbox>
                    <CheckboxGroup TItem="string" @bind-Value="granted" aria-label="权限" Sx="Indented" data-testid="permissions">
                        @foreach (var (value, label) in permissions)
                        {
                            <Checkbox @key="value" GroupValue="@value">@label</Checkbox>
                        }
                    </CheckboxGroup>
                </Flex>
            </Card>
            <Field Label="通知方式" Description="至少选一种" Error="@(channels.Count > 0 ? null : "请至少选一种")">
                <CheckboxGroup TItem="string" @bind-Value="channels" Name="channels" Orientation="Orientation.Horizontal">
                    <Checkbox GroupValue="email">邮件</Checkbox>
                    <Checkbox GroupValue="sms">短信</Checkbox>
                    <Checkbox GroupValue="push">App 推送</Checkbox>
                    <Checkbox GroupValue="phone" Disabled="true">电话（企业版）</Checkbox>
                </CheckboxGroup>
            </Field>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                <Checkbox @bind-Value="agreed" Tone="Tone.Success">我已阅读并同意《服务条款》</Checkbox>
                <Small Tone="TextTone.Muted" data-testid="granted">已授予：@(granted.Count == 0 ? "无" : string.Join("、", granted))</Small>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="switch" Title="开关">
    <Description>Switch 是立即生效的设置（需要提交才生效的用 Checkbox）。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                @SettingRow("接收通知", "订单状态变化时推送", @<Switch @bind-Value="notify" aria-label="接收通知" />)
                <Separator />
                @SettingRow("每周摘要", "每周一早上发送上周数据", @<Switch @bind-Value="digest" Disabled="!notify" aria-label="每周摘要" />)
                <Separator />
                @SettingRow("暗色模式", "轨道里可以放图标或文字", @<Switch @bind-Value="dark" Size="Size.Lg" aria-label="暗色模式" />)
                <Separator />
                @SettingRow("云端同步", "在所有设备上保持一致", @<Switch @bind-Value="sync" Tone="Tone.Success" aria-label="云端同步" />)
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="radio" Title="单选">
    <Description>同一组的原生 radio 共用 name：Tab 只停在选中项，方向键在组内移动并选中，都是浏览器的原生行为。选项里可以放任意内容（说明、价格）；Orientation="Orientation.Horizontal" 横排。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Field Label="配送方式">
                <RadioGroup @bind-Value="shipping" Name="shipping">
                    @foreach (var (value, title, time, price) in shippingOptions)
                    {
                        <Radio Value="value">
                            <Flex Justify="ContentJustify.Between" Gap="SpaceScale.Lg">
                                <Flex Direction="LayoutDirection.Column">
                                    <Strong>@title</Strong>
                                    <Small Tone="TextTone.Muted">@time</Small>
                                </Flex>
                                <Small>@price</Small>
                            </Flex>
                        </Radio>
                    }
                </RadioGroup>
            </Field>
            <Field Label="发票" Required="true" Error="@(invoice is null ? "请选择发票类型" : null)">
                <RadioGroup @bind-Value="invoice" Name="invoice" Orientation="Orientation.Horizontal">
                    <Radio Value="@("none")">不开发票</Radio>
                    <Radio Value="@("personal")">个人</Radio>
                    <Radio Value="@("company")">企业</Radio>
                </RadioGroup>
            </Field>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="validation" Title="必选与出错">
    <Description>提交时才检查：Field 的 <Code>Required</Code> 标出必填，<Code>Error</Code> 让整组标红并把错误作为说明念出；单个复选框（同意条款）同样包在 Field 里显示错误。<Code>Orientation.Horizontal</Code> 让一组横排。</Description>
    <ChildContent>
        <form novalidate @onsubmit="Submit" @onsubmit:preventDefault>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg" Align="ItemAlign.Start">
                <Field Label="通知方式" Required="true" Error="@(submitted && requiredChannels.Count == 0 ? "至少选一种通知方式" : null)">
                    <CheckboxGroup TItem="string" @bind-Value="requiredChannels" Orientation="Orientation.Horizontal">
                        <Checkbox GroupValue="email">邮件</Checkbox>
                        <Checkbox GroupValue="sms">短信</Checkbox>
                        <Checkbox GroupValue="inbox">站内信</Checkbox>
                    </CheckboxGroup>
                </Field>
                <Field Error="@(submitted && !termsAccepted ? "请先同意服务条款" : null)">
                    <Checkbox @bind-Value="termsAccepted" Required="true">我已阅读并同意服务条款</Checkbox>
                </Field>
                <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
                    <Button Type="submit">保存设置</Button>
                    @if (saved)
                    {
                        <Small Tone="TextTone.Success">已保存</Small>
                    }
                </Flex>
            </Flex>
        </form>
    </ChildContent>
</DemoSection>

<DemoSection Id="items" Title="选项来自数据">
    <Description><Code>CheckboxGroup</Code>、<Code>RadioGroup</Code> 的 <Code>Items</Code> 同 Select：ListboxOption（值、文字、说明、不可用）、字符串，或任意数据加 <Code>ToOption</Code>，选项来自字典、接口时不用一个个写。<Code>Description</Code> 显示在文字下方，经 aria-describedby 关联；单独的 <Code>Checkbox</Code>、<Code>Radio</Code> 也能写。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Field Label="套餐">
                @* 任意数据：ToOption 取出文字与说明 *@
                <RadioGroup Items="plans" @bind-Value="plan" ToOption="@(item => new ListboxOption(item.Id, item.Name, Description: PlanDescription(item)))" />
            </Field>
            <Field Label="通知方式">
                <DescriptionContent>已选：<Code>@(notifyBy.Count > 0 ? string.Join("、", notifyBy) : "（无）")</Code></DescriptionContent>
                <ChildContent>
                    <CheckboxGroup Items="notifyOptions" @bind-Value="notifyBy" data-testid="notify-by" />
                </ChildContent>
            </Field>
            <Field Label="横排的字符串选项">
                <RadioGroup Items="periods" @bind-Value="period" Orientation="Orientation.Horizontal" />
            </Field>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    sealed record Plan(string Id, string Name, string Price, int? Seats);

    static readonly Plan[] plans =
    [
        new("team", "团队版", "¥49 / 人 / 月", 50),
        new("business", "企业版", "¥99 / 人 / 月", 500),
        new("enterprise", "私有部署", "按需报价", null),
    ];

    static readonly ListboxOption[] notifyOptions =
    [
        new("email", "邮件", Description: "每天 9:00 汇总一封"),
        new("app", "站内信", Description: "实时推送，登录后可见"),
        new("sms", "短信", Description: "只发紧急的待办（需要绑定手机号）", Disabled: true),
    ];

    static readonly string[] periods = ["按日", "按周", "按月"];

    static string PlanDescription(Plan plan) => $"{plan.Price}，{(plan.Seats is { } seats ? $"最多 {seats} 人" : "人数不限")}";

    Plan plan = plans[1];
    IReadOnlyList<string> notifyBy = ["email", "app"];
    string? period = "按周";
    IReadOnlyList<string> channels = ["email"];
    IReadOnlyList<string> requiredChannels = [];

    static readonly (string Value, string Label)[] permissions =
    [
        ("orders:read", "查看订单"),
        ("orders:write", "修改订单"),
        ("refunds", "处理退款"),
        ("reports", "导出报表"),
    ];

    static readonly (string Value, string Title, string Time, string Price)[] shippingOptions =
    [
        ("standard", "标准快递", "3–5 天送达", "免运费"),
        ("express", "顺丰次日达", "明天 18:00 前", "¥12"),
        ("pickup", "门店自提", "今天 15:00 后可取", "免运费"),
    ];

    IReadOnlyList<string> granted = ["orders:read", "reports"];
    bool agreed, notify = true, digest, dark = true, sync, termsAccepted, submitted, saved;
    string shipping = "express";
    string? invoice;

    bool AllGranted => granted.Count == permissions.Length;

    bool SomeGranted => granted.Count > 0 && !AllGranted;

    void ToggleAll(bool _) => granted = AllGranted ? [] : [.. permissions.Select(p => p.Value)];

    void Submit()
    {
        submitted = true;
        saved = termsAccepted && requiredChannels.Count > 0;
    }

    // 一行设置：标题与说明在起始边，开关在结束边
    static RenderFragment SettingRow(string title, string description, RenderFragment control) => @<Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Lg">
        <Flex Direction="LayoutDirection.Column" Grow="true">
            <TextSpan Weight="Weight.Medium">@title</TextSpan>
            <Small Tone="TextTone.Muted">@description</Small>
        </Flex>
        @control
    </Flex>;

    static Style Indented => Css.Define(static () => new Style { PaddingInlineStart = CssLength.Em(1.75) });
}
