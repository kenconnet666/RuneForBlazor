@*
    评分：示例与 vue-tsx-pro 文档站的 /components/rating 对应。
*@
@attribute [ComponentDemo("rating", "评分", Group = "表单", Order = 12)]
@inherits RuneComponent

<DemoSection Id="review" Title="供应商评价">
    <Description>可编辑时是单选组：每颗星是一个原生 radio（视觉上隐藏），方向键、表单提交、读屏都是原生的，名称是“3 星”这样的文字。指针悬停时预览将要选的分数，再点一次已选的分数清空（<Code>Clearable</Code>，默认开）。<Code>AllowHalf</Code> 每颗星左右各一半。<Code>ReadOnly</Code> 只显示：整排是一个 role="img"，读“4.5 星，满分 5 星”。</Description>
    <ChildContent>
        <Card>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                <TextSpan Weight="Weight.Semibold">杭州远山精密机械 · 2026 年第三季度评价</TextSpan>
                <Grid MinItemWidth="@CssLength.Rem(13)" Gap="SpaceScale.Md">
                    @foreach (var aspect in aspects)
                    {
                        <Field @key="aspect.Key" Label="@aspect.Label" Description="@aspect.Hint">
                            <Rating Value="scores[aspect.Key]" ValueChanged="@(next => scores[aspect.Key] = next)" AllowHalf="true" data-testid="@aspect.Key" />
                        </Field>
                    }
                </Grid>
                <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                    <Small Tone="TextTone.Muted">综合</Small>
                    <Rating Value="Average" ReadOnly="true" AllowHalf="true" Size="Size.Sm" data-testid="average" />
                    <Small Tone="TextTone.Muted" data-testid="average-text">@(Average?.ToString() ?? "还没打分")</Small>
                </Flex>
            </Flex>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="variants" Title="图标、颜色与只读列表">
    <Description><Code>Icon</Code> 换图标（心、火焰），<Code>Tone</Code> 换选中的颜色，默认金黄（Warning）；<Code>Count</Code> 改星数，<Code>Size</Code> 跟字号档位缩放。评论列表里用只读的小号评分，旁边写上分数或文字。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Gap="SpaceScale.Lg" Wrap="true">
                <Field Label="喜欢程度" Description="Icon=Lucide.Heart Tone=Danger">
                    <Rating @bind-Value="like" Icon="Lucide.Heart" Tone="Tone.Danger" />
                </Field>
                <Field Label="紧急程度" Description="Count=3，Size=Lg">
                    <Rating @bind-Value="urgency" Icon="Lucide.Flame" Tone="Tone.Accent" Count="3" Size="Size.Lg" />
                </Field>
                <Field Label="不可用" Disabled="true">
                    <Rating Value="4" />
                </Field>
            </Flex>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                @foreach (var review in reviews)
                {
                    <Flex @key="review.Name" Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                        <Rating Value="review.Score" ReadOnly="true" AllowHalf="true" Size="Size.Xs" />
                        <Small>@review.Name</Small>
                        <Small Tone="TextTone.Muted">@review.Text</Small>
                    </Flex>
                }
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    sealed record Aspect(string Key, string Label, string Hint);

    sealed record Review(string Name, double Score, string Text);

    static readonly Aspect[] aspects =
    [
        new("quality", "质量", "来料合格率、返工次数"),
        new("delivery", "交期", "准时交付、紧急插单的响应"),
        new("service", "服务", "沟通、售后、资料齐全"),
    ];

    static readonly Review[] reviews =
    [
        new("林小满", 5, "交货快，包装很仔细"),
        new("周一航", 3.5, "质量可以，资料晚了两天"),
        new("许悠", 2, "第二批有划伤，已退换"),
    ];

    readonly Dictionary<string, double?> scores = new() { ["quality"] = 4.5, ["delivery"] = 3, ["service"] = null };
    double? like = 3;
    double? urgency = 2;

    // 给了分的几项平均，按半颗取整
    double? Average => scores.Values.OfType<double>().ToList() is { Count: > 0 } given
        ? Math.Round(given.Average() * 2, MidpointRounding.AwayFromZero) / 2
        : null;
}
