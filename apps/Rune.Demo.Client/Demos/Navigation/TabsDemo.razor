@*
    标签页：示例与 vue-tsx-pro 文档站的 /components/tabs 对应。数据是虚构的。
    “全部标签页”的菜单（showAllMenu）要等 Menu 有单选项（MenuRadioGroup）再补。
*@
@attribute [ComponentDemo("tabs", "标签页", Group = "导航", Order = 1)]
@inherits RuneComponent

<DemoSection Id="workspace" Title="多页签：关闭、新建、拖动">
    <Description><Code>Tab</Code> 写了 <Code>OnClose</Code> 就有关闭按钮（不进 Tab 顺序，焦点在标签上时按 Delete，鼠标中键也关）；关掉的是当前标签时选它后面的一个，焦点跟过去。<Code>TabList</Code> 的 <Code>OnAdd</Code> 在标签栏末尾放“新建标签页”，<Code>OnReorder</Code> 让标签能拖动排序（键盘：Alt + ← →），参数是新的顺序。放不下时列表横向滚动，两端出现滚动按钮，切到的标签自己滚进来。</Description>
    <ChildContent>
        <Card Padding="SpaceScale.Sm">
            <Tabs @bind-Value="currentPage">
                <TabList aria-label="打开的页面" OnAdd="AddPage" OnReorder="Reorder" data-testid="pages">
                    @foreach (var item in pages)
                    {
                        <Tab @key="item.Id" Value="@item.Id" Text="@item.Title" OnClose="@(item.Pinned ? default : EventCallback.Factory.Create(this, () => Close(item)))">@item.Title</Tab>
                    }
                </TabList>
                @foreach (var item in pages)
                {
                    <TabPanel @key="item.Id" Value="@item.Id">
                        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs" style="padding-block: 1em">
                            <TextSpan Weight="Weight.Semibold">@item.Title</TextSpan>
                            <Small Tone="TextTone.Muted">拖动标签换顺序（或在标签上按 Alt + ← →），Delete 或中键关闭；共 @pages.Count 个页签</Small>
                        </Flex>
                    </TabPanel>
                }
            </Tabs>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="line" Title="订单状态">
    <Description><Code>@@bind-Value</Code> 双向绑定当前标签；标签里可以放任意内容（计数徽标）。下划线是一个指示条，切换时滑过去，减少动态效果时直接到位。整组只占一个 Tab 位置，方向键移动、Home / End 到两端。</Description>
    <ChildContent>
        <Tabs @bind-Value="orderTab">
            <TabList aria-label="订单状态" data-testid="orders">
                @foreach (var (value, label) in orderTabs)
                {
                    <Tab @key="value" Value="@value">
                        <Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs">
                            @label
                            <Badge Radius="Radius.Full" Tone="@(orderTab == value ? Tone.Accent : Tone.Neutral)">@OrdersOf(value).Count()</Badge>
                        </Flex>
                    </Tab>
                }
            </TabList>
            @foreach (var (value, label) in orderTabs)
            {
                <TabPanel @key="value" Value="@value">
                    @if (OrdersOf(value).Any())
                    {
                        <FlexList Direction="LayoutDirection.Column">
                            @foreach (var order in OrdersOf(value))
                            {
                                <li @key="order.Id">
                                    <div @attributes="Attrs.Merge(OrderRow)">
                                        <Strong>@order.Id</Strong>
                                        <TextSpan Tone="TextTone.Muted">@order.Customer</TextSpan>
                                        <TextSpan>@order.Amount</TextSpan>
                                    </div>
                                </li>
                            }
                        </FlexList>
                    }
                    else
                    {
                        <Empty><Title>没有@(label)的订单</Title></Empty>
                    }
                </TabPanel>
            }
            <Small Tone="TextTone.Muted">方向键在标签之间移动，焦点到哪个就切到哪个</Small>
        </Tabs>
    </ChildContent>
</DemoSection>

<DemoSection Id="soft" Title="浅色底与手动切换">
    <Description><Code>TabsVariant.Soft</Code> 像分段控件；<Code>TabsActivation.Manual</Code> 时按 Enter / 空格才切换，适合切换代价大的内容。不写 Value 时选中第一个标签。</Description>
    <ChildContent>
        <Tabs Variant="TabsVariant.Soft" Size="Size.Sm" Activation="TabsActivation.Manual" data-testid="soft">
            <TabList aria-label="查看方式">
                <Tab Value="preview"><Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs"><Icon Data="Lucide.Eye" />预览</Flex></Tab>
                <Tab Value="code"><Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs"><Icon Data="Lucide.CodeXml" />代码</Flex></Tab>
                <Tab Value="split" Disabled="true"><Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs"><Icon Data="Lucide.SquareSplitHorizontal" />并排（宽屏）</Flex></Tab>
            </TabList>
            <TabPanel Value="preview">
                <Paragraph Sx="PreviewStyle">这里是效果。TabsActivation.Manual：方向键只移动焦点，按 Enter / 空格才切换。</Paragraph>
            </TabPanel>
            <TabPanel Value="code">
                <CodeBlock Code="@saveSource" Lang="razor" />
            </TabPanel>
        </Tabs>
    </ChildContent>
</DemoSection>

<DemoSection Id="vertical" Title="竖排">
    <Description><Code>Orientation.Vertical</Code>：标签在左、内容在右，键盘改用 ↑↓。设置页这类分组多、标签文字长的场景。<Code>Lazy</Code> 时面板第一次显示才渲染。</Description>
    <ChildContent>
        <Tabs Orientation="Orientation.Vertical" data-testid="vertical">
            <TabList aria-label="设置" Sx="SettingsList">
                @foreach (var (value, label, icon) in settings)
                {
                    <Tab @key="value" Value="@value"><Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm"><Icon Data="icon" />@label</Flex></Tab>
                }
            </TabList>
            <TabPanel Value="profile" Sx="SettingsPanel">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                    <Field Label="昵称"><TextField Value="周一航" /></Field>
                    <Field Label="个人主页"><TextField Type="url" placeholder="https://" /></Field>
                </Flex>
            </TabPanel>
            <TabPanel Value="security" Sx="SettingsPanel">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                    <Switch Value="true">两步验证</Switch>
                    <Switch>新设备登录时提醒</Switch>
                </Flex>
            </TabPanel>
            <TabPanel Value="notifications" Sx="SettingsPanel">
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                    <Checkbox Value="true">订单状态变化</Checkbox>
                    <Checkbox Value="true">有人提到我</Checkbox>
                    <Checkbox>每周报告</Checkbox>
                </Flex>
            </TabPanel>
        </Tabs>
    </ChildContent>
</DemoSection>

@code {
    sealed record Page(string Id, string Title, bool Pinned = false);
    sealed record Order(string Id, string Customer, string Amount, string Status);

    static readonly Order[] orders =
    [
        new("#10234", "林小满", "¥1,280.00", "shipped"),
        new("#10233", "周一航", "¥329.00", "unpaid"),
        new("#10232", "陈默", "¥4,299.00", "shipped"),
        new("#10231", "许悠", "¥659.00", "unpaid"),
        new("#10230", "王晴", "¥88.00", "done"),
    ];

    static readonly (string Value, string Label)[] orderTabs = [("all", "全部"), ("unpaid", "待付款"), ("shipped", "已发货"), ("done", "已完成"), ("refund", "退款")];

    static readonly (string Value, string Label, IconData Icon)[] settings =
    [
        ("profile", "个人资料", Lucide.User),
        ("security", "账号安全", Lucide.KeyRound),
        ("notifications", "通知", Lucide.Bell),
    ];

    const string saveSource = """
        <Button Tone="Tone.Success" Icon="Lucide.Check">
            保存
        </Button>
        """;

    static readonly Attrs OrderRow = new() { Sx = OrderRowStyle };

    List<Page> pages =
    [
        new("home", "工作台", Pinned: true),
        new("po-2401", "采购单 PO-2401"),
        new("po-2402", "采购单 PO-2402"),
        new("supplier-17", "供应商：远山精密"),
        new("report-q3", "第三季度销售报表"),
        new("inspect-88", "来料检验 IQC-88"),
        new("contract-5", "合同审批 CT-5"),
    ];

    string? currentPage = "po-2401";
    string? orderTab = "all";
    int created;

    static IEnumerable<Order> OrdersOf(string status) => status == "all" ? orders : orders.Where(o => o.Status == status);

    void AddPage()
    {
        created++;
        var item = new Page($"draft-{created}", $"新建草稿 {created}");
        pages.Add(item);
        currentPage = item.Id;
    }

    void Close(Page tab) => pages.Remove(tab);

    void Reorder(IReadOnlyList<string> order) => pages = [.. order.Select(id => pages.First(p => p.Id == id))];

    // 订单号、客户、金额三列对齐
    static Style OrderRowStyle => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        GridTemplateColumns = "6rem 1fr auto",
        Gap = Space.Md,
        PaddingBlock = Space.Sm,
        BorderBlockEndWidth = BorderWidths.Xs,
        BorderBlockEndStyle = BorderStyle.Solid,
        BorderBlockEndColor = Colors.BorderMuted,
    });

    static Style PreviewStyle => Css.Define(static () => new Style { Padding = Space.Lg, BorderRadius = Radii.Md, BackgroundColor = Colors.Fill });

    static Style SettingsList => Css.Define(static () => new Style { MinWidth = CssLength.Rem(9) });

    static Style SettingsPanel => Css.Define(static () => new Style { FlexGrow = 1, MinWidth = 0 });
}
