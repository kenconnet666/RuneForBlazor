@*
    侧边导航：示例与 vue-tsx-pro 文档站的 /components/nav-list 对应。“本页目录”（TableOfContents）做好后补上。
    示例里不真的换页：链接只写锚点，当前项由 Active 指定。数据是虚构的。
*@
@attribute [ComponentDemo("nav-list", "侧边导航", Group = "导航", Order = 4)]
@inherits RuneComponent

<DemoSection Id="groups" Title="后台导航">
    <Description>当前页按地址判断（也可以用 <Code>Active</Code> 指定），带 aria-current="page" 与高亮；含当前页的 NavGroup 自动展开。<Code>End</Code> 放计数之类的尾部内容。<Code>Match="NavLinkMatch.Prefix"</Code> 让 /orders 在 /orders/42 也高亮（同 Blazor 的 NavLink）。</Description>
    <ChildContent>
        <Card Padding="SpaceScale.Sm" Sx="Nav">
            <NavList aria-label="后台" data-testid="admin">
                @AdminItem("home", "概览", Lucide.House)
                <NavGroup Label="订单" Icon="Lucide.ShoppingCart">
                    @AdminItem("orders-all", "全部订单", count: 12)
                    @AdminItem("orders-refund", "退款售后", count: 3)
                    @AdminItem("orders-invoice", "发票")
                </NavGroup>
                <NavGroup Label="商品" Icon="Lucide.Package">
                    @AdminItem("products", "商品列表")
                    @AdminItem("inventory", "库存")
                </NavGroup>
                @AdminItem("customers", "客户", Lucide.Users)
                @AdminItem("reports", "报表", Lucide.ChartLine)
                @AdminItem("settings", "设置", Lucide.Settings)
            </NavList>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="compact" Title="窄侧栏：只显示图标">
    <Description><Code>Compact</Code> 时各项只剩图标，名称留给读屏、悬停或聚焦时用提示显示；NavSection 的 <Code>Icon</Code> 是小节标题前的标记（不能点），紧凑时代替标题。紧凑时 NavGroup 只剩图标，悬停、聚焦时子项从右边弹出来（完整的文字，Tab 进入），组里有当前页时图标高亮；NavItem 的 <Code>Badge</Code> 是计数角标，展开时在文字后面，紧凑时叠在图标上。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <Switch @bind-Value="compact">只显示图标</Switch>
            <Card Padding="SpaceScale.Xs" Sx="@(compact ? CompactNav : ExpandableNav)" data-testid="compact-card">
                <NavList aria-label="销售管理" Compact="compact" data-testid="compact">
                    <NavItem Href="#home" Icon="Lucide.House" Active="@(page == "首页")" @onclick="@(() => page = "首页")">首页</NavItem>
                    <NavGroup Label="审批" Icon="Lucide.ClipboardCheck">
                        @foreach (var (name, count) in approvals)
                        {
                            <NavItem @key="name" Href="@Anchor(name)" Badge="count" Active="@(page == name)" @onclick="@(() => page = name)">@name</NavItem>
                        }
                    </NavGroup>
                    @foreach (var (label, icon, pages) in sections)
                    {
                        <NavSection @key="label" Label="@label" Icon="icon">
                            @foreach (var (name, pageIcon, count) in pages)
                            {
                                <NavItem @key="name" Href="@Anchor(name)" Icon="pageIcon" Badge="count" Active="@(page == name)" @onclick="@(() => page = name)">@name</NavItem>
                            }
                        </NavSection>
                    }
                </NavList>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="sections" Title="文档站导航">
    <Description>NavSection 是带小标题、不能收起的一组：链接多、按主题分组的侧栏。<Code>Disabled</Code> 的项不能点、不能聚焦，<Code>End</Code> 放在项的末尾（计数、标记）。</Description>
    <ChildContent>
        <Card Padding="SpaceScale.Sm" Sx="Nav">
            <NavList aria-label="文档" data-testid="docs">
                @foreach (var (label, pages) in docs)
                {
                    <NavSection @key="label" Label="@label">
                        @foreach (var name in pages)
                        {
                            @* 还没上线的页面：不能点、不能聚焦 *@
                            <NavItem @key="name" Href="@Anchor(name)" Active="@(doc == name)" Disabled="@(name == "设计资源")" @onclick="@(() => doc = name)">
                                <ChildContent>@name</ChildContent>
                                <End>@if (name == "设计资源") { <Badge Variant="StatusVariant.Soft">即将上线</Badge> }</End>
                            </NavItem>
                        }
                    </NavSection>
                }
            </NavList>
        </Card>
    </ChildContent>
</DemoSection>

@code {
    static readonly (string Name, int Count)[] approvals = [("待我审批", 4), ("我发起的", 0)];

    static readonly (string Label, IconData Icon, (string Name, IconData Icon, int Count)[] Pages)[] sections =
    [
        ("项目", Lucide.FolderKanban, [("单价台账", Lucide.Wrench, 0), ("库存台账", Lucide.Gauge, 0)]),
        ("收益", Lucide.CircleDollarSign, [("财务复核", Lucide.BadgeCheck, 12), ("总账", Lucide.BookOpenText, 0)]),
    ];

    static readonly (string Label, string[] Pages)[] docs =
    [
        ("指南", ["快速开始", "主题定制", "国际化"]),
        ("组件", ["Button 按钮", "Dialog 对话框", "Tabs 标签页", "DataTable 数据表格"]),
        ("资源", ["更新日志", "设计资源"]),
    ];

    string current = "orders-all";
    string page = "单价台账";
    string doc = "Dialog 对话框";
    bool compact = true;

    static string Anchor(string name) => "#" + Uri.EscapeDataString(name);

    RenderFragment AdminItem(string key, string label, IconData? icon = null, int? count = null) =>
        @<NavItem Href="@($"#{key}")" Icon="icon" Active="@(current == key)" @onclick="@(() => current = key)">
            <ChildContent>@label</ChildContent>
            <End>@if (count is { } n) { <Badge Radius="Radius.Full">@n</Badge> }</End>
        </NavItem>;

    static Style Nav => Css.Define(static () => new Style { Width = CssLength.Rem(15) });

    // 紧凑示例的侧栏：宽窄切换有过渡
    static Style ExpandableNav => Css.Define(static () => new Style
    {
        Width = CssLength.Rem(15),
        Transition = $"width {Durations.Md} {Easings.Standard}",
    });

    static Style CompactNav => Css.Define(static () => new Style
    {
        Width = CssLength.Rem(3.5),
        Transition = $"width {Durations.Md} {Easings.Standard}",
    });
}
