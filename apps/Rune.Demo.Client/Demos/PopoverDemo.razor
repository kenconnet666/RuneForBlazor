@* 弹出层：Popover、Menu、Tooltip、Popconfirm（原生 popover + CSS 锚点定位） *@
@attribute [ComponentDemo("popover", "弹出层与提示", Group = "浮层", Order = 0)]
@inherits RuneComponent

<DemoSection Title="弹出框">
    <Flex Gap="SpaceScale.Sm" Wrap="true" Align="ItemAlign.Center">
        <Popover Title="筛选" data-testid="filter-popover">
            <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Surface" Icon="Lucide.Funnel">筛选</Button></Trigger>
            <ChildContent>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                    <TextSpan Muted="true" Size="Size.Sm">内容第一次打开才渲染；点外面或按 Esc 关闭。</TextSpan>
                    <Flex Gap="SpaceScale.Xs" Wrap="true">
                        @foreach (var status in statuses)
                        {
                            <Button Size="Size.Sm" Variant="@(status == filter ? ButtonVariant.Solid : ButtonVariant.Surface)" @onclick="() => filter = status">@status</Button>
                        }
                    </Flex>
                    <Flex Justify="ContentJustify.End">
                        <Button Size="Size.Sm" data-rune-close>完成</Button>
                    </Flex>
                </Flex>
            </ChildContent>
        </Popover>
        <TextSpan Muted="true">当前筛选：@filter</TextSpan>
    </Flex>
    <Flex Gap="SpaceScale.Sm" Wrap="true">
        @foreach (var placement in Enum.GetValues<Placement>())
        {
            <Popover Placement="placement" Role="@null">
                <Trigger Context="t"><Button @attributes="t" Size="Size.Sm" Variant="ButtonVariant.Outline">@placement</Button></Trigger>
                <ChildContent>在@(placement)；放不下时翻到对面。</ChildContent>
            </Popover>
        }
    </Flex>
</DemoSection>

<DemoSection Title="菜单">
    <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
        <Menu data-testid="row-menu">
            <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Surface" IconEnd="Lucide.ChevronDown">操作</Button></Trigger>
            <ChildContent>
                <MenuItem Icon="Lucide.Pencil" Shortcut="Ctrl E" @onclick="@(() => last = "编辑")">编辑</MenuItem>
                <MenuItem Icon="Lucide.Copy" @onclick="@(() => last = "复制")">复制</MenuItem>
                <MenuItem Icon="Lucide.Archive" Disabled="true">归档（不可用）</MenuItem>
                <MenuSeparator />
                <MenuItem Icon="Lucide.Trash" Tone="Tone.Danger" @onclick="@(() => last = "删除")">删除</MenuItem>
            </ChildContent>
        </Menu>
        <TextSpan Muted="true" data-testid="menu-last">上次选择：@(last ?? "无")</TextSpan>
    </Flex>
</DemoSection>

<DemoSection Title="提示">
    <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
        <Tooltip Content="编辑"><IconButton Icon="Lucide.Pencil" Label="编辑" /></Tooltip>
        <Tooltip Content="复制到剪贴板" Placement="Placement.Bottom"><IconButton Icon="Lucide.Copy" Label="复制" /></Tooltip>
        <Tooltip Content="删除后可以在回收站里找回 30 天" Placement="Placement.End"><IconButton Icon="Lucide.Trash" Label="删除" Tone="Tone.Danger" /></Tooltip>
        <TextSpan Muted="true" Size="Size.Sm">悬停或 Tab 聚焦一会儿后出现，Esc 隐藏（纯 CSS，没有往返）</TextSpan>
    </Flex>
</DemoSection>

<DemoSection Title="气泡确认">
    <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
        <Popconfirm Title="删除这条记录？" Description="删除后无法恢复。" ConfirmText="删除" ConfirmTone="Tone.Danger" OnConfirm="() => { deleted++; }">
            <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Soft" Tone="Tone.Danger" Icon="Lucide.Trash">删除</Button></Trigger>
        </Popconfirm>
        <TextSpan Muted="true" data-testid="deleted">已删除 @deleted 次</TextSpan>
    </Flex>
</DemoSection>

@code {
    static readonly string[] statuses = ["全部", "待处理", "进行中", "已完成"];
    string filter = "全部";
    string? last;
    int deleted;
}
