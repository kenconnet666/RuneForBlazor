@*
    主题切换：示例与 vue-tsx-pro 文档站的 /components/theme-switcher 对应。
    vue-tsx-pro 的示例只作用于下面一块区域；这里的切换作用于整页（同演示站目录顶部的按钮），局部主题还没做。
*@
@attribute [ComponentDemo("theme-switcher", "主题切换", Group = "页面组合", Order = 9)]
@inherits RuneComponent

<DemoSection Id="switcher" Title="主题切换按钮">
    <Description><Code>AddRuneUI</Code> 里设置 <Code>ThemeChoices</Code> 给出可选的主题（最外层的 RuneProvider 输出每套的变量），head 里放 <Code>ThemeBootScript</Code>（页面显示前按记住的选择设好，不闪默认主题）；<Code>ThemeSwitcher</Code> 列出“跟随系统”与各套主题，选中后记进 localStorage，新主题从按钮处圆形展开。切换全在浏览器里，没有往返，静态 SSR 也能用。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Align="ItemAlign.Start">
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                <ThemeSwitcher data-testid="switcher" />
                <Small Tone="TextTone.Muted">选择作用于整页，与目录顶部的按钮相同</Small>
            </Flex>
            <Card>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                        <Strong>通知设置</Strong>
                        <Small Tone="TextTone.Muted">这块区域用的是上面选的主题</Small>
                    </Flex>
                    <Switch @bind-Value="notify">新评论时提醒我</Switch>
                    <Flex Gap="SpaceScale.Sm">
                        <Button Size="Size.Sm" Icon="Lucide.Bell">保存</Button>
                        <Button Size="Size.Sm" Variant="ButtonVariant.Soft" Tone="Tone.Neutral">取消</Button>
                    </Flex>
                </Flex>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    bool notify = true;
}
