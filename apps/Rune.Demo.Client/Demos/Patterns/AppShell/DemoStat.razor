@*
    指标的替身（vue-tsx-pro 的 Stat 还没做）：标签、数值与单位、变化。做好 Stat 后换掉。
*@
@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
    <Small Tone="TextTone.Muted">@Label</Small>
    <Flex Align="ItemAlign.Baseline" Gap="SpaceScale.Xs">
        <TextSpan Sx="Value">@Text</TextSpan>
        @if (Unit is not null)
        {
            <Small Tone="TextTone.Muted">@Unit</Small>
        }
    </Flex>
    @if (Change is { } change)
    {
        <Small Tone="@(change >= 0 ^ InvertChange ? TextTone.Success : TextTone.Danger)">@(change >= 0 ? "↑" : "↓") @Math.Abs(change).ToString("P1")</Small>
    }
</Flex>

@code {
    /// <summary>指标名。</summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>显示的数值。</summary>
    [Parameter] public string Text { get; set; } = "";

    /// <summary>单位。</summary>
    [Parameter] public string? Unit { get; set; }

    /// <summary>环比变化（0.12 是涨了 12%）。</summary>
    [Parameter] public double? Change { get; set; }

    /// <summary>降是好事（退款率）。</summary>
    [Parameter] public bool InvertChange { get; set; }

    static Style Value => Css.Define(static () => new Style { FontSize = FontSizes.Xxl, FontWeight = FontWeights.Semibold, FontVariantNumeric = FontVariantNumeric.TabularNums });
}
