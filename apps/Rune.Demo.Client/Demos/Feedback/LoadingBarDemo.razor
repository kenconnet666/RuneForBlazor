@*
    顶部加载条：示例与 vue-tsx-pro 文档站的 /components/loading-bar 对应。数据是虚构的。
*@
@attribute [ComponentDemo("loading-bar", "加载条", Group = "反馈", Order = 4)]
@inherits RuneComponent
@implements IDisposable

<DemoSection Id="navigation" Title="换页时的加载">
    <Description>控制器加显示（同 Toast）：<Code>LoadingBarController</Code> 的 <Code>Start</Code> 开始、<Code>Finish</Code> 走满后淡出、<Code>Error</Code> 变成危险色走满。不知道真实进度，所以先快后慢地涨，停在 90% 前等完成；动画在浏览器里，没有往返。<Code>Delay</Code>（默认 200ms）之内就完成的不显示，免得每次切换都闪一下。加载条只是视觉提示：读屏读到的是页面内容区域的 <Code>aria-busy</Code> 与“正在加载”的文字。示例把加载条放进了框里（<Code>position: absolute</Code>），平时它贴在窗口顶部；<Code>Navigation="true"</Code> 时跟着 Blazor 的增强导航自己走。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Card Padding="SpaceScale.None" style="position: relative; overflow: hidden">
                <LoadingBar Controller="bar" style="position: absolute" data-testid="bar" />
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" style="padding: 1em">
                    <Tabs Value="@current" ValueChanged="LoadAsync">
                        <TabList aria-label="页面">
                            @foreach (var item in pages)
                            {
                                <Tab @key="item.Id" Value="@item.Id">@item.Label</Tab>
                            }
                        </TabList>
                    </Tabs>
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs" aria-busy="@(status == "loading" ? "true" : "false")" style="min-height: 4.5em">
                        @if (status == "loading")
                        {
                            <Small Tone="TextTone.Muted">正在加载@(Page.Label)…</Small>
                        }
                        else if (status == "failed")
                        {
                            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                                <Badge Tone="Tone.Danger" Variant="StatusVariant.Soft" Size="Size.Xs">加载失败</Badge>
                                <Small Tone="TextTone.Muted">服务器没有响应，请稍后重试</Small>
                                <Button Size="Size.Xs" Variant="ButtonVariant.Ghost" @onclick="() => LoadAsync(current)">重试</Button>
                            </Flex>
                        }
                        else
                        {
                            @foreach (var row in Page.Rows)
                            {
                                <TextSpan @key="row" Size="Size.Sm">@row</TextSpan>
                            }
                        }
                    </Flex>
                </Flex>
            </Card>
            <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm" Wrap="true">
                <Small Tone="TextTone.Muted">手动控制：</Small>
                <Button Size="Size.Sm" Variant="ButtonVariant.Soft" @onclick="bar.Start">Start()</Button>
                <Button Size="Size.Sm" Variant="ButtonVariant.Soft" @onclick="bar.Finish">Finish()</Button>
                <Button Size="Size.Sm" Variant="ButtonVariant.Soft" Tone="Tone.Danger" @onclick="bar.Error">Error()</Button>
                <Small Tone="TextTone.Muted">“个人设置”120ms 就好，不显示加载条</Small>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    sealed record DemoPage(string Id, string Label, int Delay, string[] Rows, bool Fails = false);

    static readonly DemoPage[] pages =
    [
        new("orders", "订单列表", 900, ["SO-24101 华东仓 已发货", "SO-24102 华南仓 待出库"]),
        new("stock", "库存台账", 1600, ["A-12 轴承 312 件", "B-07 密封圈 1 280 件"]),
        new("report", "财务报表", 1200, [], Fails: true),
        new("quick", "个人设置", 120, ["通知：仅提及我", "语言：简体中文"]),
    ];

    readonly LoadingBarController bar = new();
    CancellationTokenSource? loading;
    string? current = "orders";
    string status = "ready";

    DemoPage Page => pages.First(p => p.Id == current);

    // 模拟换页：加载条走起来，数据回来时走满淡出；“财务报表”那页会加载失败（危险色）
    async Task LoadAsync(string? id)
    {
        current = id;
        loading?.Cancel();
        loading = new CancellationTokenSource();
        var token = loading.Token;
        status = "loading";
        bar.Start();
        try
        {
            await Task.Delay(Page.Delay, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        status = Page.Fails ? "failed" : "ready";
        if (Page.Fails) bar.Error();
        else bar.Finish();
    }

    public void Dispose() => loading?.Cancel();
}
