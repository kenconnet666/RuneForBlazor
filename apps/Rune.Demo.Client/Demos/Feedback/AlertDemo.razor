@* 提示条：示例与 vue-tsx-pro 文档站的 /components/alert 一一对应。 *@
@attribute [ComponentDemo("alert", "提示条", Group = "反馈", Order = 0)]
@inherits RuneComponent

<DemoSection Id="tones" Title="色调">
    <Description>Tone 决定颜色与默认图标（Lucide），Icon 可以换，HideIcon 去掉。页面加载时就在的提示不打断读屏；操作后才出现的写 Live 让读屏播报。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            <Alert Tone="Tone.Info" Title="维护通知">本周六 02:00–04:00 系统升级，期间无法下单。</Alert>
            <Alert Tone="Tone.Success" Title="付款成功">订单 #10234 已付款 ¥1,280.00，预计明天发货。</Alert>
            <Alert Tone="Tone.Warning" Title="订阅即将到期">你的专业版将在 3 天后到期，<TextLink Href="server/alert">现在续费</TextLink>可享 8 折。</Alert>
            <Alert Tone="Tone.Danger" Title="同步失败">网络连接中断，3 个文件没有上传。</Alert>
            <Alert Tone="Tone.Neutral">没有标题时只显示正文：适合一行就说清楚的提示。</Alert>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="status" Title="进行中、播报与尺寸">
    <Description>操作后才出现的提示写 Live="AlertLive.Polite"（role="status"），读屏念完当前内容再念；错误等紧急信息用 Assertive。Loading 时图标换成加载指示并带 aria-busy。Size 是字号档位，图标与内边距随之缩放。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Flex>
                    <Button Variant="ButtonVariant.Outline" Tone="Tone.Neutral" Icon="Lucide.RefreshCw" Loading="checking" @onclick="CheckAsync" data-testid="check">检查更新</Button>
                </Flex>
                @if (checking || checkedOnce)
                {
                    <Alert Live="AlertLive.Polite" Loading="checking" Tone="@(checking ? Tone.Info : Tone.Success)"
                           Title="@(checking ? "正在检查更新…" : "已是最新版本")" data-testid="update-status">
                        @(checking ? "连接更新服务器" : "当前版本 2.4.0，发布于 10 月 18 日。")
                    </Alert>
                }
            </Flex>
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Alert Size="Size.Sm" Tone="Tone.Warning" Title="size=&quot;sm&quot;">侧栏、表单字段旁的紧凑提示。</Alert>
                <Alert Size="Size.Lg" Tone="Tone.Accent" Title="size=&quot;lg&quot;">页面顶部的重要公告。</Alert>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="variants" Title="样式、操作与关闭">
    <Description>Variant 有 Soft、Surface、Outline；Action 放在右侧，Loading 时图标换成旋转指示，写了 OnClose 就有关闭按钮。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            <Alert Variant="AlertVariant.Soft" Tone="Tone.Accent" Icon="Lucide.Sparkles" Title="soft（默认）">浅色底，没有描边。</Alert>
            <Alert Variant="AlertVariant.Surface" Tone="Tone.Accent" Title="surface">浅色底加描边：放在白色卡片里也看得清边界。</Alert>
            <Alert Variant="AlertVariant.Outline" Tone="Tone.Accent" Title="outline">只有描边：信息不那么紧急时用。</Alert>
            <Alert Variant="AlertVariant.Surface" Tone="Tone.Danger" Title="保存失败" Loading="retrying">
                <Action>
                    <Button Size="Size.Sm" Variant="ButtonVariant.Soft" Tone="Tone.Danger" Loading="retrying" @onclick="RetryAsync">重试</Button>
                </Action>
                <ChildContent>服务器暂时不可用。loading 时图标换成旋转指示。</ChildContent>
            </Alert>
            @if (!dismissed)
            {
                <Alert Tone="Tone.Info" Title="可以关闭" OnClose="() => dismissed = true" data-testid="closable">写了 onClose 就有关闭按钮。</Alert>
            }
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    bool checking, checkedOnce, retrying, dismissed;

    async Task CheckAsync()
    {
        checking = true;
        await Task.Delay(1500);
        checking = false;
        checkedOnce = true;
    }

    async Task RetryAsync()
    {
        retrying = true;
        await Task.Delay(1500);
        retrying = false;
    }
}
