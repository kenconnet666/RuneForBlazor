@*
    卡片：示例与 vue-tsx-pro 文档站的 /components/card 一一对应。
    加载中（骨架）与装饰效果之后补上。
*@
@attribute [ComponentDemo("card", "卡片", Group = "展示", Order = 0)]
@inherits RuneComponent

<DemoSection Id="variants" Title="样式">
    <Description>Variant 有 Surface（默认）、Outline、Elevated、Ghost，颜色与阴影都取主题；可以用 CardDefaults 统一改。</Description>
    <ChildContent>
        <Grid MinItemWidth="@("13em")" Gap="SpaceScale.Md">
            @foreach (var (variant, description) in variants)
            {
                <Card Variant="variant" data-testid="@($"card-{variant}")">
                    <Strong>@variant.ToString().ToLowerInvariant()</Strong>
                    <Paragraph Size="Size.Sm" Tone="TextTone.Muted">@description</Paragraph>
                </Card>
            }
        </Grid>
    </ChildContent>
</DemoSection>

<DemoSection Id="sections" Title="页头与页脚">
    <Description>Header、Footer 与正文之间有分隔线；需要语义容器时把标题放进 Header，或在外面包 article、section。</Description>
    <ChildContent>
        <Card data-testid="card-full">
            <Header>
                <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Sm">
                    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                        <H3 Size="Size.Md">订单 #10234</H3>
                        <Badge Tone="Tone.Success" Radius="Radius.Full">已发货</Badge>
                    </Flex>
                    <IconButton Icon="Lucide.Ellipsis" Label="更多操作" />
                </Flex>
            </Header>
            <ChildContent>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                    <Descriptions Columns="2">
                        <DescriptionsItem Label="收货人" Value="林小满 138****0021" />
                        <DescriptionsItem Label="配送方式" Value="顺丰次日达" />
                        <DescriptionsItem Label="收货地址" Value="上海市徐汇区漕溪北路 88 号 12 楼" Span="2" />
                    </Descriptions>
                    <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between">
                        <TextSpan Tone="TextTone.Muted">实付</TextSpan>
                        <TextSpan Size="Size.Lg" Weight="Weight.Bold">¥1,280.00</TextSpan>
                    </Flex>
                </Flex>
            </ChildContent>
            <Footer>
                <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Sm">
                    <Small Tone="TextTone.Muted">下单于 10 月 18 日 14:32</Small>
                    <Flex Gap="SpaceScale.Sm">
                        <Button Size="Size.Sm" Variant="ButtonVariant.Ghost">申请售后</Button>
                        <Button Size="Size.Sm" Icon="Lucide.Truck">查看物流</Button>
                    </Flex>
                </Flex>
            </Footer>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="extra" Title="页头的操作">
    <Description>Extra 在页头的结束边（“全部 ↗”、标记、按钮），和 Header 排在一行、放不下时换行，不用自己在 Header 里写两端对齐。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <Card Variant="CardVariant.Outline" Padding="SpaceScale.Md">
                <Header>超时最久的项目</Header>
                <Extra><TextLink Href="server/card">全部超时<Icon Data="Lucide.ArrowUpRight" /></TextLink></Extra>
                <ChildContent><Small Tone="TextTone.Muted">PO-2026-0276 线缆收纳夹改版 · 超时 15 天</Small></ChildContent>
            </Card>
            <Card Variant="CardVariant.Outline" Padding="SpaceScale.Md">
                <Header>结项材料</Header>
                <Extra><Badge Tone="Tone.Warning">缺 2 项</Badge></Extra>
                <ChildContent><Small Tone="TextTone.Muted">验收报告、财务复核意见、合同签订记录，缺一不能结项</Small></ChildContent>
            </Card>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    static readonly (CardVariant Variant, string Description)[] variants =
    [
        (CardVariant.Surface, "表面色加描边（默认）：页面上最常见的卡片"),
        (CardVariant.Outline, "只有描边、没有底色：放在有底色的区域里"),
        (CardVariant.Elevated, "浮起的表面加阴影：可点击、可拖动的卡片"),
        (CardVariant.Ghost, "没有边框与底色：只用来分组与留白"),
    ];
}
