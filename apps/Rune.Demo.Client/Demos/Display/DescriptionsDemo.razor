@*
    描述列表：示例与 vue-tsx-pro 文档站的 /components/descriptions 对应。数据是虚构的。
*@
@attribute [ComponentDemo("descriptions", "描述列表", Group = "展示", Order = 5)]
@inherits RuneComponent

<DemoSection Id="basic" Title="基础用法">
    <Description>每个 <Code>DescriptionsItem</Code> 是一个标签与值，值可以是任意内容；<Code>Columns</Code> 分栏，<Code>Span</Code> 跨列。语义是 dl，读屏按“名称、值”念；容器窄于 32em 时自动排成一列。</Description>
    <ChildContent>
        <Card>
            <Descriptions Title="订单信息" Columns="3" data-testid="order">
                <DescriptionsItem Label="订单号">
                    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Xs">A-10234 <CopyButton Value="A-10234" Size="Size.Xs" Label="复制订单号" /></Flex>
                </DescriptionsItem>
                <DescriptionsItem Label="状态"><Badge Tone="Tone.Success" Radius="Radius.Full">已发货</Badge></DescriptionsItem>
                <DescriptionsItem Label="下单时间" Value="2026-10-18 14:32" />
                <DescriptionsItem Label="收货人" Value="林小满" />
                <DescriptionsItem Label="电话" Value="138****0021" />
                <DescriptionsItem Label="物流"><TextLink Href="server/descriptions">SF1234567890</TextLink></DescriptionsItem>
                <DescriptionsItem Label="收货地址" Value="上海市徐汇区漕溪北路 88 号 12 楼 1203 室" Span="3" />
            </Descriptions>
        </Card>
    </ChildContent>
</DemoSection>

<DemoSection Id="layouts" Title="边框、竖排与尺寸">
    <Description><Code>Bordered</Code> 是表格样式，<Code>DescriptionsLayout.Vertical</Code> 标签在上，<Code>DescriptionsLayout.Inline</Code> 各项一行排开、放不下换行（详情页页头里的编号、团队、主办），<Code>Size</Code> 跟字号档位缩放。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xl">
            <Descriptions Title="Bordered：带边框的表格样式" Columns="2" Bordered="true">@Staff</Descriptions>
            <Descriptions Title="DescriptionsLayout.Vertical：标签在上" Columns="4" Layout="DescriptionsLayout.Vertical">@Staff</Descriptions>
            <Descriptions Title="Size.Sm" Columns="2" Size="Size.Sm" Bordered="true">@Staff</Descriptions>
            <Descriptions Title="DescriptionsLayout.Inline：一行排开（页头里的关键信息）" Size="Size.Sm" Layout="DescriptionsLayout.Inline">@Staff</Descriptions>
        </Flex>
    </ChildContent>
</DemoSection>

<DemoSection Id="auto" Title="自适应栏数与复制：供应商档案">
    <Description>写了 <Code>MinItemWidth</Code> 时按容器的宽度定栏数：每栏不窄于它（vue-tsx-pro 的 columns="auto" 默认 240px），最多 <Code>MaxColumns</Code>（默认 4）栏，同一份详情放在抽屉、整页里各自合适；跨列（<Code>Span</Code>）按算出的栏数封顶。都是容器查询，不量宽度。项写 <Code>Copyable</Code> 时值后面有复制按钮（名称“复制 + 标签”），复制的是 <Code>Value</Code>，要复制完整写法时用 <Code>CopyText</Code> 指定。</Description>
    <ChildContent>
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
            <Flex Gap="SpaceScale.Lg" Wrap="true" Align="ItemAlign.Start">
                <Card Sx="Narrow">
                    <Descriptions Title="抽屉里（窄）" MinItemWidth="220" data-testid="narrow">@Supplier</Descriptions>
                </Card>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                    <div @attributes="Attrs.Merge(Resizable)" data-testid="resizable">
                        <Descriptions Title="详情页（拖动右下角调宽）" MinItemWidth="220" data-testid="wide">@Supplier</Descriptions>
                    </div>
                    <Small Tone="TextTone.Muted">每栏不窄于 220px，最多 4 栏；地址跨 3 栏，栏数少时按栏数封顶</Small>
                </Flex>
            </Flex>
        </Flex>
    </ChildContent>
</DemoSection>

@code {
    static readonly Attrs Resizable = new() { Sx = ResizableStyle };

    static readonly RenderFragment Staff = @<text>
        <DescriptionsItem Label="姓名" Value="周一航" />
        <DescriptionsItem Label="部门" Value="设计中心" />
        <DescriptionsItem Label="职位" Value="高级交互设计师" />
        <DescriptionsItem Label="入职日期" Value="2021-03-15" />
    </text>;

    static readonly RenderFragment Supplier = @<text>
        <DescriptionsItem Label="供应商" Value="华辰精密机械有限公司" />
        <DescriptionsItem Label="信用代码" Value="91310115MA1K4QXX2R" Copyable="true" />
        <DescriptionsItem Label="等级"><Badge Tone="Tone.Success">A 级</Badge></DescriptionsItem>
        <DescriptionsItem Label="联系人" Value="林小满 · 138 0013 8000" />
        <DescriptionsItem Label="开户行" Value="招商银行上海张江支行" />
        <DescriptionsItem Label="银行账号" Value="6214 8301 2345 6789" Copyable="true" CopyText="6214830123456789" />
        <DescriptionsItem Label="地址" Value="上海浦东张江高科园区 88 号" Copyable="true" CopyText="上海市浦东新区张江高科技园区碧波路 88 号 3 号楼" Span="3" />
    </text>;

    static Style Narrow => Css.Define(static () => new Style { Width = CssLength.Rem(20), FlexShrink = 0 });

    // 可以拖宽的区域：原生的 resize 手柄
    static Style ResizableStyle => Css.Define(static () => new Style
    {
        Resize = Resize.Horizontal,
        Overflow = Overflow.Hidden,
        MinWidth = CssLength.Rem(16),
        MaxWidth = CssLength.Percent(100),
        Width = CssLength.Rem(40),
        Padding = CssLength.Rem(1),
        BorderWidth = 1,
        BorderStyle = BorderStyle.Dashed,
        BorderColor = "color-mix(in srgb, currentColor 25%, transparent)",
        BorderRadius = CssLength.Rem(0.5),
    });
}
