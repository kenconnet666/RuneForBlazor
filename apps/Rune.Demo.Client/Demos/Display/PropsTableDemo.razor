@*
    API 表格：示例与 vue-tsx-pro 文档站的 /components/props-table 对应。
*@
@attribute [ComponentDemo("props-table", "API 表格", Group = "展示", Order = 21)]
@inherits RuneComponent

<DemoSection Id="handwritten" Title="给自己的组件写 API 表">
    <Description>数据类型是 <Code>ApiProp</Code>：名称、种类（参数、事件、内容、部件属性）、类型、必填、默认值、能否 <Code>@@bind</Code>、说明，档位类的 <Code>Values</Code> 列出每个可选值的含义。必填、可绑定的标记文案取语言包；外层是静态表格，窄屏时横向滚动。文档站的 API 表从类型与 XML 文档注释自动生成同样的数据。外观参数同 Table：<Code>Density</Code> 默认 Compact，<Code>Variant</Code>、<Code>Striped</Code> 照常可用。</Description>
    <ChildContent>
        @* 外观参数同 Table：Density 默认 Compact，这里加了斑马纹 *@
        <PropsTable Props="props" Striped="true">
            <Caption>Rating 的参数</Caption>
        </PropsTable>
    </ChildContent>
</DemoSection>

@code {
    // 给自己的组件手写 API 数据：名称、种类、类型、必填、默认值、可绑定、说明，档位类的列出每个可选值
    static readonly ApiProp[] props =
    [
        new("Value", ApiPropKind.Prop, "double", "当前评分，父级写 @bind-Value=\"score\"") { Bindable = true, Default = "0" },
        new("Count", ApiPropKind.Prop, "int", "星星的个数") { Default = "5" },
        new("Size", ApiPropKind.Prop, "Size?", "尺寸")
        {
            Default = "Size.Md",
            Values = [new("Sm", "表格、列表里"), new("Md", "表单里（默认）"), new("Lg", "详情页的总评分")],
        },
        new("Label", ApiPropKind.Prop, "string", "评分的名称，读屏念的是它") { Required = true },
    ];
}
