@*
    演示页里的一个示例：标题、说明、效果区，结构同 vue-tsx-pro 文档站的 Example（小节标题带 id，效果区是表面色的网格）。
    Id 与文档站示例的锚点一致时，tools/parity 按它配对两边的示例。
*@
@inherits RuneComponent

<section @attributes="Attrs.Merge(SectionStyle, Rest)">
    <H2 Size="Size.Lg" id="@Id">@Title</H2>
    @if (Description is not null)
    {
        <Paragraph Sx="DescriptionStyle">@Description</Paragraph>
    }
    <div @attributes="Attrs.Merge(FrameBorder)">
        @if (Frame is not null)
        {
            @* 整页示例：iframe 贴满效果区，单独打开 /{模式}/frame/{演示}/{名字} *@
            <div data-demo-canvas @attributes="Attrs.Merge(FramedCanvas)">
                <iframe src="@FrameSrc" title="@Title" loading="lazy" allow="fullscreen" style="height:@FrameHeight" @attributes="Attrs.Merge(IFrame)"></iframe>
            </div>
        }
        else
        {
            <div data-demo-canvas @attributes="Attrs.Merge(Canvas)">@ChildContent</div>
        }
    </div>
</section>

@code {
    /// <summary>小节的锚点，同文档站示例的 id（英文，本页唯一）。</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>这一块的标题。</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>说明文字。</summary>
    [Parameter] public RenderFragment? Description { get; set; }

    /// <summary>整页示例的名字（<see cref="DemoFrameAttribute"/>）：写了时效果区是打开它的 iframe，不用 ChildContent。</summary>
    [Parameter] public string? Frame { get; set; }

    /// <summary>整页示例的高度（CSS 长度），默认 40rem。</summary>
    [Parameter] public string FrameHeight { get; set; } = "40rem";

    [Inject] NavigationManager Navigation { get; set; } = default!;

    // 当前地址是 /{模式}/{演示}
    string FrameSrc
    {
        get
        {
            var segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Split('/');
            return $"{segments[0]}/frame/{segments.ElementAtOrDefault(1)}/{Frame}";
        }
    }

    /// <summary>演示内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    static Style SectionStyle => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        FlexDirection = FlexDirection.Column,
        Gap = Space.Sm,
        MinWidth = 0,
    });

    static Style DescriptionStyle => Css.Define(static () => new Style { Color = Colors.TextMuted });

    static Style FrameBorder => Css.Define(static () => new Style
    {
        BorderWidth = BorderWidths.Xs,
        BorderStyle = BorderStyle.Solid,
        BorderColor = Colors.BorderMuted,
        BorderRadius = Radii.Lg,
        OverflowX = Overflow.Auto,
    });

    // 同文档站示例的画布：界面默认字号、行高，表面色衬底，内容按网格排、起始边对齐
    static Style Canvas => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        AlignItems = AlignItems.Center,
        Gap = Space.Md,
        Padding = Space.Xl,
        FontSize = FontSizes.Md,
        LineHeight = LineHeights.Normal,
        BackgroundColor = Colors.Surface,
    });

    static Style FramedCanvasStyle => Css.Define(static () => new Style { Display = Display.Grid, BackgroundColor = Colors.Surface });

    static readonly Attrs FramedCanvas = new() { Sx = FramedCanvasStyle };

    static Style IFrameStyle => Css.Define(static () => new Style { Display = Display.Block, Width = Sizes.Full, BorderStyle = BorderStyle.None });

    static readonly Attrs IFrame = new() { Sx = IFrameStyle };
}
