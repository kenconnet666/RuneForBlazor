{
  // 文档站部署到 Cloudflare Workers 的静态资源（免费额度：纯静态文件不限访问量）。上传由 .github/workflows/docs.yml 做（手动触发），
  // 先用 tools/docs-export 导出到 artifacts/docs-site。同 vue-tsx-pro 的 apps/docs/wrangler.jsonc：自定义域名由 deploy 建好 DNS 记录与证书，不用手动配
  "$schema": "https://www.unpkg.com/wrangler@4.156.1/config-schema.json",
  "name": "rune-docs",
  "account_id": "8a86512a720965d45283b05a276608e8",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../artifacts/docs-site",
    // /components/button 直接取 components/button.html（默认的 auto-trailing-slash，不跳转）；没有对应文件的地址回 404.html
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "rune-for-blazor.zerodep.dpdns.org", "custom_domain": true }],
}
