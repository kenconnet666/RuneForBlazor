@* 渲染模式测试台的外壳：左侧是文档页的目录，切换演示时保持当前的渲染模式；RuneProvider 套上应用级主题 *@
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<RuneProvider>
<div class="demo-shell">
    <nav class="demo-nav" aria-label="演示目录">
        <div class="demo-brand"><a href="">Rune 测试台</a><ThemeSwitcher /></div>
        @foreach (var section in DocsCatalog.Sections)
        {
            <div class="demo-nav-group">@section.Label</div>
            @foreach (var entry in section.Pages)
            {
                <a href="@($"{CurrentMode}/{entry.Slug}")">@entry.Meta.Title</a>
            }
        }
        <div class="demo-nav-group">渲染方式</div>
        <a href="streaming">流式渲染</a>
    </nav>

    <main class="demo-main">
        @Body
    </main>
</div>
</RuneProvider>

<div id="blazor-error-ui" data-nosnippet>
    出现了未处理的错误。
    <a href="." class="reload">重新加载</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // 地址的第一段是渲染模式时沿用它，否则用默认模式
    string CurrentMode
    {
        get
        {
            var first = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', '?', '#')[0];
            return DemoRenderModes.IsKnown(first) ? first : DemoRenderModes.Default;
        }
    }
}
