@*
    组件页的 API 小节（同 vue-tsx-pro 文档站的 ApiReference）：服务端从组件类型与 XML 文档注释生成的数据（DocsData）按种类分表列出：
    参数、事件、内容、部件属性。复合组件写几个类型，依次列出。
    <ApiReference Types="[typeof(Button), typeof(IconButton)]" />
*@
@namespace Rune.Docs.Site
@inherits RuneComponent
@inject DocHeadings Headings
@inject DocsData Docs
@inject RenderQueue Queue

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
    <H2 id="api" Size="Size.Xl" Anchor="true">API</H2>
    @* 预渲染时整段 API 两头留标记；第一页交互接管后数据（浏览器里要下载）还没到时，占位里先留着预渲染的那段 *@
    @if (!RendererInfo.IsInteractive)
    {
        @((MarkupString)"<!--docs-hold:api-->")
    }
    else if (apis.Count == 0 && !Queue.Deferring)
    {
        <div data-docs-hold="api" style="display:contents"></div>
    }
    @foreach (var api in apis)
    {
        <Flex @key="api.Component" Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            @if (Types.Count > 1)
            {
                <H3 id="@($"api-{Slug(api.Component)}")" Size="Size.Lg" Anchor="true">@api.Component</H3>
            }
            @if (api.Description.Length > 0)
            {
                <Paragraph Tone="TextTone.Muted">@api.Description</Paragraph>
            }
            @* 表格多（上百个单元格）：排在示例后面渲染 *@
            <Queued Hold="@($"api-{Slug(api.Component)}")">
                @foreach (var (kind, label) in Kinds)
                {
                    var props = api.Props.Where(p => p.Kind == kind).ToList();
                    if (props.Count == 0) continue;
                    <div @key="kind" @attributes="Attrs.Merge(TableLayer)">
                        <PropsTable Props="props"><Caption>@label</Caption></PropsTable>
                    </div>
                }
            </Queued>
        </Flex>
    }
    @if (!RendererInfo.IsInteractive)
    {
        @((MarkupString)"<!--/docs-hold:api-->")
    }
</Flex>

@code {
    static readonly Attrs TableLayer = new() { Sx = Table };

    // 各种类的小节标题与顺序
    static readonly (ApiPropKind Kind, string Label)[] Kinds =
    [
        (ApiPropKind.Prop, "参数"),
        (ApiPropKind.Event, "事件"),
        (ApiPropKind.Content, "内容"),
        (ApiPropKind.Part, "部件属性"),
    ];

    /// <summary>一个或几个组件的类型（复合组件各部分依次列出）；泛型组件写开放类型。</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Type> Types { get; set; } = [];

    IReadOnlyList<ComponentApi> apis = [];
    IReadOnlyList<Type>? loaded;

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        Headings.Add(this, new("api", "API"), DocHeadings.Last);
        if (loaded is null || !Types.SequenceEqual(loaded))
        {
            loaded = Types;
            apis = await Task.WhenAll(Types.Select(t => Docs.ApiAsync(t).AsTask()));
        }
        if (Types.Count > 1)
            foreach (var api in apis) Headings.Add(this, new($"api-{Slug(api.Component)}", api.Component, 3), DocHeadings.Last);
    }

    /// <inheritdoc/>
    protected override void OnDispose() => Headings.Remove(this);

    static string Slug(string name) => new([.. name.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant)]);

    // API 表在页面底部，打开页面时在视口外：滚到附近才排版、绘制；auto 记住排过一次的高度，滚回来时滚动条不跳
    static Style Table => Css.Define(static () => new Style { ContentVisibility = ContentVisibility.Auto, ContainIntrinsicSize = "auto 24rem" });
}
