@*
    本页目录：页面登记的标题（DocHeadings）变了只重新渲染这里，不牵动整个外壳（每登记一个标题都会通知一次）。
*@
@namespace Rune.Docs.Site
@inherits RuneComponent
@inject DocHeadings Headings

<TableOfContents Items="Headings.All" />

@code {
    /// <inheritdoc/>
    protected override void OnInitialized() => Headings.Changed += OnHeadingsChanged;

    void OnHeadingsChanged() => InvokeAsync(StateHasChanged);

    /// <inheritdoc/>
    protected override void OnDispose() => Headings.Changed -= OnHeadingsChanged;
}
