@*
    文档页的骨架（同 vue-tsx-pro 文档站的 DocPage）：标题、简介、安装哪个包（组件页），后面是各个示例与 API。组件页与指南页都用它。
    vue 的组件页在简介下写一行 import；组件都在 Rune.UI 命名空间里，这里对应的是装哪个包（按分类推出，地图页这类另要包的写 Package）。
    组件页写 Wide：内容区放宽，示例（Examples）在宽屏时分两列；指南页保持适合阅读的宽度。
    <DocPage Meta="Meta" Wide="true">…</DocPage>          （页面继承 DocPageBase，Meta 取自页面的 [DocMeta]）
*@
@namespace Rune.Docs.Site
@inherits RuneComponent

<PageTitle>@Meta.Title · Rune</PageTitle>
<Container Size="@(Wide ? ContainerSize.Xl : ContainerSize.Md)" Padding="SpaceScale.None">
    <DocArticle Title="@Meta.Title" Description="@Meta.Description" Lead="Install">@ChildContent</DocArticle>
</Container>

@code {
    /// <summary>页面的标题与简介。</summary>
    [Parameter, EditorRequired] public DocMetaAttribute Meta { get; set; } = default!;

    /// <summary>宽版面：组件页用，示例在宽屏时分两列。</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>组件页要装的 NuGet 包，默认按分类：日期 Rune.UI.Dates、图表 Rune.Charts、3D Rune.Three，其余 Rune.UI；指南页不写。</summary>
    [Parameter] public string? Package { get; set; }

    /// <summary>正文。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    RenderFragment? Install => (Package ?? Meta.Category switch
    {
        DocCategory.Guide => null,
        DocCategory.Date => "RuneForBlazor.UI.Dates",
        DocCategory.Charts => "RuneForBlazor.Charts",
        DocCategory.Three => "RuneForBlazor.Three",
        _ => "RuneForBlazor.UI",
    }) is { } package ? @<CodeBlock Code="@($"dotnet add package {package}")" Lang="bash" /> : null;
}
