@*
    排队渲染的内容（见 RenderQueue）：站内换页后先不渲染，轮到时才渲染；首页、静态渲染时直接渲染。
    <Queued><DynamicComponent Type="Demo" /></Queued>
*@
@namespace Rune.Docs.Site
@inherits RuneComponent
@inject RenderQueue Queue

@if (shown)
{
    @ChildContent
}

@code {
    bool shown;
    bool disposed;
    // 轮到自己时拿到：渲染完自己后调用，放下一个
    Action? release;

    /// <summary>要排队渲染的内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc/>
    protected override void OnInitialized() => shown = !RendererInfo.IsInteractive || !Queue.Deferring;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (release is not null)
        {
            Release();
            return;
        }
        if (!firstRender || shown) return;
        release = await Queue.WaitTurnAsync();
        // 等的时候页面换走了：直接放下一个
        if (disposed)
        {
            Release();
            return;
        }
        shown = true;
        StateHasChanged();
    }

    void Release()
    {
        var done = release;
        release = null;
        done?.Invoke();
    }

    /// <inheritdoc/>
    protected override void OnDispose()
    {
        disposed = true;
        Release();
    }
}
