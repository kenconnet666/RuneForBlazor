@*
    排队渲染的内容（见 RenderQueue）：交互模式下先不渲染，轮到时才渲染；静态渲染、预渲染时直接渲染。
    <Queued Hold="@Id"><DynamicComponent Type="Demo" /></Queued>
    Hold 是这段内容在本页里的名字：预渲染时在内容两头各留一个注释标记；打开站点的第一页交互接管时先渲染一个空的占位
    （data-docs-hold，不占排版的格子），文档站的 JS 初始化器把预渲染的那段节点放回占位里，画面不变；轮到时占位换成真正渲染的内容。
    没写 Hold 的在第一页直接渲染（同以前）。站内换页后没有预渲染的内容可留，轮到之前什么都不渲染。
*@
@namespace Rune.Docs.Site
@inherits RuneComponent
@inject RenderQueue Queue

@if (shown)
{
    @if (Hold is not null && !RendererInfo.IsInteractive)
    {
        @((MarkupString)$"<!--docs-hold:{Hold}-->")
        @ChildContent
        @((MarkupString)$"<!--/docs-hold:{Hold}-->")
    }
    else
    {
        @ChildContent
    }
}
else if (holding)
{
    <div data-docs-hold="@Hold" style="display:contents"></div>
}

@code {
    bool shown;
    // 第一页交互接管：占位里留着预渲染的内容
    bool holding;
    bool waiting;
    bool disposed;
    // 轮到自己时拿到：渲染完自己后调用，放下一个
    Action? release;

    /// <summary>要排队渲染的内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>这段内容在本页里的名字（示例的 id）：第一页交互接管时预渲染的内容按它留到轮到自己。只能是字母、数字、连字符。</summary>
    [Parameter] public string? Hold { get; set; }

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        holding = RendererInfo.IsInteractive && !Queue.Deferring && Hold is not null;
        shown = !RendererInfo.IsInteractive || (!Queue.Deferring && !holding);
        if (shown) return;
        waiting = true;
        Queue.Enter();
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (release is not null)
        {
            Release();
            return;
        }
        if (!firstRender || shown) return;
        release = await Queue.WaitTurnAsync();
        // 等的时候页面换走了：直接放下一个
        if (disposed)
        {
            Release();
            return;
        }
        shown = true;
        StateHasChanged();
    }

    void Release()
    {
        var done = release;
        release = null;
        done?.Invoke();
        if (!waiting) return;
        waiting = false;
        Queue.Leave();
    }

    /// <inheritdoc/>
    protected override void OnDispose()
    {
        disposed = true;
        Release();
    }
}
