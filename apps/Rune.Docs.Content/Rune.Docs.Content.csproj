<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- 文档站的内容：各组件页与示例（一个示例一个文件）、指南页、站点的部件（示例卡片、API 表）。
       文档站（Rune.Docs.Client）与渲染模式测试台（Rune.Demo.Client）都渲染这里的页面 -->
  <PropertyGroup>
    <RootNamespace>Rune.Docs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Can 页的示例用 AuthorizeView（Blazor 的授权就是 vue-tsx-pro 的 Can 在这边的写法） -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <ProjectReference Include="..\..\src\Rune\Rune.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI\Rune.UI.csproj" />
    <ProjectReference Include="..\..\src\Rune.Icons\Rune.Icons.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI.Dates\Rune.UI.Dates.csproj" />
    <!-- [State] 生成器：以分析器方式引用 -->
    <ProjectReference Include="..\..\src\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Rune.CodeFixes\Rune.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 示例的源码嵌进程序集：示例卡片按示例的类型取出原文（examples/分类/组件/Demo/名字.razor），WebAssembly 里也能读 -->
    <EmbeddedResource Include="Components\**\*.razor" LogicalName="examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 组件库的 XML 文档注释嵌进程序集：API 表的说明从这里读（引用解析后它在 ReferenceCopyLocalPaths 里） -->
  <Target Name="EmbedComponentDocs" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.xml' and ('%(Filename)' == 'Rune.UI' or '%(Filename)' == 'Rune.UI.Dates')" LogicalName="api/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
