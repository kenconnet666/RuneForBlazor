@inherits RuneComponent

@* 外观参数同 Table：Density 默认 Compact，这里加了斑马纹 *@
<PropsTable Props="props" Striped="true">
    <Caption>Rating 的参数</Caption>
</PropsTable>

@code {
    // 给自己的组件手写 API 数据：名称、种类、类型、必填、默认值、可绑定、说明，档位类的列出每个可选值
    static readonly ApiProp[] props =
    [
        new("Value", ApiPropKind.Prop, "double", "当前评分，父级写 @bind-Value=\"score\"") { Bindable = true, Default = "0" },
        new("Count", ApiPropKind.Prop, "int", "星星的个数") { Default = "5" },
        new("Size", ApiPropKind.Prop, "Size?", "尺寸")
        {
            Default = "Size.Md",
            Values = [new("Sm", "表格、列表里"), new("Md", "表单里（默认）"), new("Lg", "详情页的总评分")],
        },
        new("Label", ApiPropKind.Prop, "string", "评分的名称，读屏念的是它") { Required = true },
    ];
}
