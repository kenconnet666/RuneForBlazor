@inherits RuneComponent

<Grid MinItemWidth="@("10em")" Gap="SpaceScale.Lg">
    @foreach (var (shape, label) in shapes)
    {
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
            <div @attributes="Attrs.Merge(Stage)">
                <Skeleton Shape="shape" />
            </div>
            <Small Tone="TextTone.Muted">@label shape="@Lower(shape)"</Small>
        </Flex>
    }
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
        <div @attributes="Attrs.Merge(Stage)">
            <SkeletonText Lines="3" />
        </div>
        <Small Tone="TextTone.Muted">段落 SkeletonText</Small>
    </Flex>
</Grid>

@code {
    static readonly (SkeletonShape Shape, string Label)[] shapes =
    [
        (SkeletonShape.Text, "文字行"),
        (SkeletonShape.Heading, "标题"),
        (SkeletonShape.Circle, "头像"),
        (SkeletonShape.Button, "按钮"),
        (SkeletonShape.Image, "图片"),
    ];

    // 同一行的格子一样高：形状在剩下的空间里居中，说明文字都落在格子底部
    static Style Stage => Css.Define(static () => new Style
    {
        FlexGrow = 1,
        Display = Display.Flex,
        FlexDirection = FlexDirection.Column,
        JustifyContent = JustifyContent.Center,
    });
}
