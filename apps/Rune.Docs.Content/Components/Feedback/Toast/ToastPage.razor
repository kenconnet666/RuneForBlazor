@page "/components/toast"
@attribute [DocMeta("Toast 通知", "操作结果的短暂提示，几秒后自动消失：ToastService 在组件内外都能用，Toaster 是显示区域；可撤销、可跟踪一个任务。", DocCategory.Feedback, Order = 3)]
@inherits DocPageBase
@using Rune.Docs.Components.Feedback.Toast.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="basic" Title="基础用法" Demo="typeof(BasicExample)">
                应用里注入 <Code>ToastService</Code>（scoped，后台线程里也能调），布局里放一个 <Code>Toaster</Code> 显示区域，然后在任意位置
                <Code>Toasts.Show(…)</Code>。每条通知就是 Alert：图标、标题、正文、操作、关闭按钮都一样；<Code>PromiseAsync</Code>
                跟踪一个任务，从加载中换成成功或失败。默认 5 秒后消失，指针停在上面、焦点在里面时暂停；横向滑动可以关掉。
            </Example>
            <Example Id="persistent" Title="常驻与更新" Demo="typeof(PersistentExample)">
                <Code>Duration = Timeout.InfiniteTimeSpan</Code> 不自动消失，<Code>Closable = false</Code> 去掉关闭按钮——问题解决前一直提醒。
                <Code>Update(id, …)</Code> 把同一条通知换成新的内容，计时按新的 <Code>Duration</Code> 重新开始；<Code>Icon</Code> 换掉按色调选的图标。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="layout" Title="位置、叠放与剩余时间" Demo="typeof(LayoutExample)">
                <Code>Placement</Code> 是视口的六个位置；<Code>Stack</Code> 像 Sonner 一样叠成一摞，悬停或聚焦时展开；
                <Code>Progress</Code> 在底部显示剩余时间，暂停时一起停；<Code>Max</Code> 限制同时显示的条数，更早的先排队。
                <Code>DefaultDuration</Code> 改默认的显示时长。示例各自 new 一个 ToastService 交给自己的 Toaster（<Code>Controller</Code>）。
            </Example>
            <Example Id="shortcuts" Title="快捷方法、同 Id 只留一条、关闭回调" Demo="typeof(ShortcutsExample)">
                <Code>Success</Code> / <Code>Error</Code> / <Code>Warning</Code> / <Code>Info</Code> / <Code>Loading</Code> 第一个参数是标题；
                <Code>Error</Code> 读屏立即播报，<Code>Loading</Code> 不自动消失。写了 <Code>Id</Code> 的通知只有一条：同一个 Id 再显示时换掉原来那条并重新计时，
                连点保存、接口重试不会堆一摞；先 <Code>Loading("正在导出", new() { Id = "export" })</Code>，完成后同一个 Id 的 <Code>Success</Code> 原地换成结果。
                <Code>OnClose(reason)</Code> 在开始关闭时调用，reason 是到时（Timeout）还是被关掉（Dismissed）。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("F8", "有通知时焦点跳到通知区域；区域里有焦点时计时暂停"),
        ("Tab / Shift+Tab", "在通知的操作、关闭按钮之间移动"),
        ("Esc", "关闭焦点所在的通知，焦点交给相邻的通知，没有时回到进入区域之前的位置"),
    ])">
        通知区域是 aria-live 的 <Code>section</Code>：新通知出现时读屏自动念出，焦点不会被抢走。按 <Kbd>F8</Kbd> 才进入区域。
    </KeyboardReference>
    <ApiReference Types="[typeof(Toaster)]" />
</DocPage>
