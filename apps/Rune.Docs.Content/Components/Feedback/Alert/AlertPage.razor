@page "/components/alert"
@attribute [DocMeta("Alert 提示条与横幅", "页面或区块里的说明、成功、警告、错误信息（Alert）：图标按色调自动选，可带操作、加载中、可以关闭；贴着页面顶部、整页都相关的通栏通知用 Banner。", DocCategory.Feedback, Order = 0)]
@inherits DocPageBase
@using Rune.Docs.Components.Feedback.Alert.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="tones" Title="色调" Demo="typeof(TonesExample)">
                Tone 决定颜色与默认图标（Lucide），Icon 可以换，HideIcon 去掉。页面加载时就在的提示不打断读屏；操作后才出现的写 Live 让读屏播报。
            </Example>
            <Example Id="status" Title="进行中、播报与尺寸" Demo="typeof(StatusExample)">
                操作后才出现的提示写 Live="AlertLive.Polite"（role="status"），读屏念完当前内容再念；错误等紧急信息用 Assertive。Loading 时图标换成加载指示并带 aria-busy。Size 是字号档位，图标与内边距随之缩放。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="variants" Title="样式、操作与关闭" Demo="typeof(VariantsExample)">
                Variant 有 Soft、Surface、Outline；Action 放在右侧，Loading 时图标换成旋转指示，写了 OnClose 就有关闭按钮。
            </Example>
            <Example Id="banner" Title="页面顶部的横幅" Demo="typeof(BannerExample)">
                横幅占满宽度、内容居中，<Code>Title</Code> 是加粗的开头，<Code>Action</Code> 跟在正文后面（链接或小按钮）。<Code>Variant="BannerVariant.Solid"</Code>
                最醒目，用于必须先看到的消息；默认浅色底。写了 <Code>OnClose</Code> 才有关闭按钮：先淡出再报告，使用方移除并记住“已关闭”，没移除就重新出现；
                关闭后焦点交给相邻的可聚焦元素。页面加载时就在的横幅不播报，运行中才出现的写 <Code>Live</Code>（同 Alert）。放在内容里、说明某一块状态、要写几行的用 Alert。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(Alert), typeof(Banner)]" />
</DocPage>
