@page "/components/banner"
@attribute [DocMeta("Banner 横幅", "贴着页面顶部的一行通栏通知：系统维护、试用到期、只读模式这类整页都相关的消息，可以关闭。", DocCategory.Feedback, Order = 1)]
@inherits DocPageBase
@using Rune.Docs.Components.Feedback.Banner.Demo

<DocPage Meta="Meta">
    <Example Id="page" Title="页面顶部" Demo="typeof(PageExample)">
        横幅占满宽度、内容居中，<Code>Title</Code> 是加粗的开头，<Code>Action</Code> 跟在正文后面（链接或小按钮）。<Code>Variant="BannerVariant.Solid"</Code>
        最醒目，用于必须先看到的消息；默认浅色底。写了 <Code>OnClose</Code> 才有关闭按钮：先淡出再报告，使用方移除并记住“已关闭”，没移除就重新出现；
        关闭后焦点交给相邻的可聚焦元素。页面加载时就在的横幅不播报，运行中才出现的写 <Code>Live</Code>（同 Alert）。放在内容里、说明某一块状态、要写几行的用 Alert。
    </Example>
    <ApiReference Types="[typeof(Banner)]" />
</DocPage>
