@page "/components/progress"
@attribute [DocMeta("Progress 进度与加载", "进度条（Progress）、加载中的旋转指示（Spinner）与盖住一块区域的加载遮罩（LoadingOverlay）；内容还没来时的占位用 Skeleton。", DocCategory.Feedback, Order = 2)]
@inherits DocPageBase
@using Rune.Docs.Components.Feedback.Progress.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="progress" Title="进度条" Demo="typeof(ProgressExample)">
                <Code>Value</Code> 与 <Code>Max</Code>（默认 100）算完成比例，超出时夹住；<Code>Tone</Code> 表示状态。<Code>Label</Code> 显示在上方，同时是进度条的名称；右侧默认是按语言格式化的百分比，<Code>ValueLabel</Code> 换成自己的文字（只是显示），读屏念的用 <Code>ValueText</Code> 改，<Code>ShowValueLabel="false"</Code> 不显示。
            </Example>
            <Example Id="rings" Title="环形与目标" Demo="typeof(RingsExample)">
                <Code>ProgressShape.Circle</Code> 是环形：中间显示数值，<Code>Label</Code> 在下方，直径随 <Code>Size</Code> 缩放，适合仪表盘与卡片里的完成率；不写 <Code>Value</Code> 时一段弧一直转。<Code>Target</Code> 是目标值：条上画一条竖线、环上画一道刻度，读屏念成“60%，目标 80%”。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="spinner" Title="旋转指示" Demo="typeof(SpinnerExample)">
                <Code>Spinner</Code> 默认跟随所在文字的大小与颜色，旁边有文字时是装饰；单独出现时写 <Code>Label</Code>（role="status"）。按钮的加载用 Button 的 <Code>Loading</Code>。
            </Example>
            <Example Id="overlay" Title="加载遮罩" Demo="typeof(OverlayExample)">
                <Code>LoadingOverlay</Code> 盖住一块区域，内容保留在下面，外层带 aria-busy；很快完成时不出现，出现后至少显示一会儿，淡入淡出。<Code>Blur</Code> 模糊下面的内容。
            </Example>
            <Example Id="shapes" Title="粗细与不确定进度" Demo="typeof(ShapesExample)">
                <Code>Size</Code> 跟字号档位缩放粗细，<Code>Radius</Code> 改圆角；不写 <Code>Value</Code> 是不确定进度，循环滑动，减少动态效果时变慢。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(LoadingOverlay), typeof(Progress), typeof(Spinner)]" />
</DocPage>
