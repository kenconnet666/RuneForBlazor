@page "/components/loading-bar"
@attribute [DocMeta("LoadingBar 加载条", "窗口顶部的一条细线进度：路由切换、整页刷新数据时提示“正在加载”，很快完成的不显示。", DocCategory.Feedback, Order = 7)]
@inherits DocPageBase
@using Rune.Docs.Components.Feedback.LoadingBar.Demo

<DocPage Meta="Meta" Wide="false">
    <Example Id="navigation" Title="换页时的加载" Demo="typeof(NavigationExample)">
        控制器加显示（同 Toast）：<Code>LoadingBarController</Code> 的 <Code>Start</Code> 开始、<Code>Finish</Code> 走满后淡出、<Code>Error</Code> 变成危险色走满。不知道真实进度，所以先快后慢地涨，停在 90% 前等完成；动画在浏览器里，没有往返。<Code>Delay</Code>（默认 200ms）之内就完成的不显示，免得每次切换都闪一下。加载条只是视觉提示：读屏读到的是页面内容区域的 <Code>aria-busy</Code> 与“正在加载”的文字。示例把加载条放进了框里（<Code>position: absolute</Code>），平时它贴在窗口顶部；<Code>Navigation="true"</Code> 时跟着 Blazor 的增强导航自己走。
    </Example>
    <ApiReference Types="[typeof(LoadingBar)]" />
</DocPage>
