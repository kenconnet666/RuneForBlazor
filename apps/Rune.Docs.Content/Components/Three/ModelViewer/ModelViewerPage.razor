@page "/components/model-viewer"
@attribute [DocMeta("ModelViewer 模型查看器", "加载 glTF / GLB 或程序生成的对象，自动居中缩放，拖动环绕查看、缓缓自转，摄影棚式的环境光。", DocCategory.Three, Order = 8)]
@inherits DocPageBase
@using Rune.Docs.Components.Three.ModelViewer.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="product" Title="商品详情" Demo="typeof(ProductExample)">
        <Code>Src</Code> 是 glTF / GLB 的地址，模型按外接球居中、缩放到占满画面。拖动环绕（松手带惯性），获得焦点后 <Kbd>←</Kbd> <Kbd>→</Kbd> <Kbd>↑</Kbd> <Kbd>↓</Kbd> 也能转；
        <Code>Zoom</Code> 打开滚轮与 <Kbd>+</Kbd> / <Kbd>-</Kbd> 缩放。写了 <Code>Alt</Code> 时整块是带名称的图像；加载完成调用 <Code>OnLoad</Code>。
    </Example>
    <Example Id="objects" Title="程序生成的对象与出错" Demo="typeof(ObjectsExample)">
        <Code>ObjectModule</Code> 是生成对象的 JS 模块：导出一个函数，参数是 three.js 的全部导出，返回 three 的对象（vue 里直接给对象，C# 拿不到 three 的对象）；
        地址后面写 <Code>#名字</Code> 用那个导出。光照是 RoomEnvironment 的环境光，金属、清漆、透光的材质都能正确地反光，<Code>Exposure</Code> 调整体亮度；
        加载失败时显示语言包里的提示，<Code>OnError</Code> 拿到原因。
    </Example>
    <Example Id="angles" Title="多角度展示" Demo="typeof(AnglesExample)">
        <Code>Orbit</Code> 是一开始的角度（<Code>Yaw</Code> 绕竖轴、<Code>Pitch</Code> 从上往下看为正，单位度）；<Code>Controls="false"</Code> 关掉拖动与方向键，整块不可聚焦。
        缩略图用 <Code>Quality="ThreeQuality.Low"</Code> 与较低的 <Code>Resolution</Code>；<Code>Paused</Code> 停住自转，没有 WebGL 时显示 <Code>Fallback</Code>。
    </Example>
    <KeyboardReference Keys="Keys">
        能操作（Controls，默认打开）时整块可以 Tab 聚焦；写了 Alt 时它是带名称的图像，读屏念出 Alt。
    </KeyboardReference>
    <ApiReference Types="[typeof(ModelViewer)]" />
</DocPage>

@code {
    static readonly (string Key, string Action)[] Keys =
    [
        ("← / →", "左右转 15°（绕竖轴）"),
        ("↑ / ↓", "上下转 15°（俯仰，到头为止）"),
        ("+ / -", "写了 Zoom 时：拉近 / 推远"),
    ];
}
