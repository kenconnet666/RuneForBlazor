@inherits RuneComponent

@* 画质（陆地点数随它缩放）与暂停；Off 时显示 Fallback；子内容叠在地球上（这里是底部的说明） *@
<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Grid MinItemWidth="@("12rem")" Gap="SpaceScale.Lg" Align="ItemAlign.End">
        <Field Label="画质">
            <ToggleGroup @bind-Value="quality" Required="true">
                <ToggleItem Value="Auto">自动</ToggleItem>
                <ToggleItem Value="Low">低</ToggleItem>
                <ToggleItem Value="High">高</ToggleItem>
                <ToggleItem Value="Off">关</ToggleItem>
            </ToggleGroup>
        </Field>
        <Switch @bind-Value="paused">暂停</Switch>
    </Grid>
    <Globe Sx="GlobeStyle" Markers="Sites" Quality="Enum.Parse<ThreeQuality>(quality!)" Paused="paused" PropsContent="ContentLayer">
        <Fallback>
            <div @attributes="Attrs.Merge(FallbackLayer)"><Icon Data="Lucide.Globe" Sx="FallbackIcon" /></div>
        </Fallback>
        <ChildContent>
            <Badge Variant="StatusVariant.Soft">@Sites.Length 个数据中心</Badge>
        </ChildContent>
    </Globe>
</Flex>

@code {
    static readonly GlobeMarker[] Sites = [new(39.9, 116.4), new(1.35, 103.8), new(50.1, 8.7), new(37.4, -122.1)];

    static readonly Attrs ContentLayer = new() { Sx = Content };
    static readonly Attrs FallbackLayer = new() { Sx = FallbackStyle };

    string? quality = nameof(ThreeQuality.Auto);
    bool paused;

    static Style GlobeStyle => Css.Define(static () => new Style { MaxWidth = CssLength.Rem(18), MarginInline = CssLength.Auto, Display = Display.Flex, AlignItems = AlignItems.FlexEnd });

    static Style Content => Css.Define(static () => new Style { Width = CssLength.Percent(100), Display = Display.Flex, JustifyContent = JustifyContent.Center, PaddingBottom = Space.Sm });

    static Style FallbackStyle => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        PlaceItems = PlaceItems.Center,
        Height = CssLength.Percent(100),
        Color = Colors.TextMuted,
    });

    static Style FallbackIcon => Css.Define(static () => new Style { Width = CssLength.Percent(45), Height = CssLength.Percent(45), StrokeWidth = 0.75 });
}
