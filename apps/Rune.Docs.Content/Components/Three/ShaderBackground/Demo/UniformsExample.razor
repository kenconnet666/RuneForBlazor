@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Field Label="@($"圆环数 {rings}")" Sx="RingsField">
        <Slider TValue="int" @bind-Value="rings" Min="1" Max="20" />
    </Field>
    <ShaderBackground Sx="Stage" FragmentShader="@Ripples" Uniforms="@(new Dictionary<string, double> { ["uRings"] = rings })" />
</Flex>

@code {
    // 同心圆环从指针处荡开：uRings 是自己加的 uniform，uPointer 自动提供（z 是指针在区域内的程度）
    const string Ripples = """
        uniform float uRings;

        vec4 shade(vec2 uv) {
          float aspect = uResolution.x / uResolution.y;
          vec2 center = mix(vec2(0.0), uPointer.xy, uPointer.z) * 0.5;
          float d = distance((uv - 0.5) * vec2(aspect, 1.0), center * vec2(aspect, 1.0));
          float wave = sin(d * uRings * 6.2832 - uTime * 2.0) * 0.5 + 0.5;
          float n = fbm(vec3(uv * 2.0, uTime * 0.1)) * 0.15;
          vec3 color = themePalette(clamp(wave * 0.8 + n + d * 0.3, 0.0, 1.0));
          // 边缘渐隐到透明，透出页面底色
          float alpha = 1.0 - smoothstep(0.35, 0.9, d);
          return vec4(color, alpha);
        }
        """;

    int rings = 6;

    static Style Stage => Css.Define(static () => new Style { Height = CssLength.Rem(18) });

    static Style RingsField => Css.Define(static () => new Style { MaxWidth = CssLength.Rem(20) });
}
