@page "/components/mentions"
@attribute [DocMeta("Mentions 提及", "多行文本框里输入 @ 弹出人员列表，选中后写成“@名字”；Mentioned 给出提到了谁，MentionText 显示时高亮提及。", DocCategory.Input, Order = 7)]
@inherits DocPageBase
@using Rune.Docs.Components.Input.Mentions.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="approval" Title="审批意见" Demo="typeof(ApprovalExample)">
                <Code>Items</Code> 是可以提及的人（选项的分组、说明照常显示）。输入框还是文字：选中一项写成“@@名字 ”，
                <Code>Mentioned</Code> 是文字里提到的人的值，随文字增删——删掉“@@名字”就不再算；父级给的文字里已有的提及也认得出来。
                @@ 在开头或前面不是字母数字时才弹出（邮箱不算），@@ 与光标之间有空白就收起。显示留言时用 <Code>MentionText</Code> 高亮提及，
                要自己排版时用 <Code>MentionSegments.Of</Code> 拆分。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="remote" Title="远程搜索与自定义选项" Demo="typeof(RemoteExample)">
                <Code>Load</Code> 按 @@ 后面的文字搜索（停下 300 ms 后请求，只采用最后一次，被顶掉的请求经 CancellationToken 取消），
                选项用 <Code>ToOption</Code> 映射、<Code>ChildContent</Code> 自己渲染。搜索换掉选项之后，提及过的人仍按见过的选项认出来。
            </Example>
            <Example Id="prefix" Title="换触发字符、字数与显示" Demo="typeof(TopicsExample)">
                <Code>Prefix</Code> 换成别的触发字符（# 引用单据、话题），<Code>MentionText</Code> 与 <Code>MentionSegments</Code> 要写同一个。<Code>Empty</Code> 是没有匹配时列表里的一句话；
                <Code>ShowCount</Code>、<Code>Clearable</Code>、<Code>Variant</Code>、只读与不可用同 Textarea。显示时 MentionText 的 <Code>ChildContent</Code> 自己渲染一个提及：做成链接、悬停卡片。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("@", "弹出可以提及的人（开头或前面不是字母数字时）"),
        ("↑ / ↓", "移动高亮"),
        ("Enter / Tab", "选中高亮的人，写成“@名字 ”"),
        ("Esc", "关闭列表；这个 @ 不再弹出，直到重新输入"),
    ])">
        焦点一直在文本框里，高亮项经 aria-activedescendant 告诉读屏，匹配的数量会播报；中文输入法组合期间不弹出、不过滤。
    </KeyboardReference>
    <ApiReference Types="[typeof(Mentions<>), typeof(MentionText)]" />
</DocPage>
