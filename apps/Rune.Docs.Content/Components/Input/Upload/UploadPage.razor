@page "/components/upload"
@attribute [DocMeta("Upload 上传", "选文件、看进度、失败重试：Upload 管列表与状态，怎么上传由 UploadAsync 决定；FileDrop 是只负责选文件的拖放区域。", DocCategory.Input, Order = 13)]
@inherits DocPageBase
@using Rune.Docs.Components.Input.Upload.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="wall" Title="图片墙：预览、排序与粘贴" Demo="typeof(WallExample)">
        <Code>ListType="UploadListType.Picture"</Code> 时文件是方形缩略图（<Code>ThumbnailSize</Code>，默认 104 px）：
        选的图片用本地地址马上显示，不等上传（JS 建的 object URL，不经过 C#，不用了就收回）；点开看大图（墙上的图共用一个预览，按墙上的顺序左右切换），
        别的文件显示图标与文件名。上传中盖一层进度，失败标红、可以重试；选文件的区域是墙上最后一格，到了 <Code>MaxFiles</Code> 就收起。
        <Code>Sortable</Code> 时每张图上有把手，拖动或聚焦后用空格拿起、方向键移动（↑↓ 跨行），松开才把新顺序写回值；
        <Code>Pasteable</Code> 时焦点在组件里按 <Kbd>Ctrl</Kbd> + <Kbd>V</Kbd>，剪贴板里的图片（截图）就加进来。
    </Example>
    <Examples>
        <ExampleColumn>
            <Example Id="photos" Title="选好就上传" Demo="typeof(PhotosExample)">
                给了 <Code>UploadAsync</Code> 时选到文件就开始上传：它拿到文件（<Code>IBrowserFile</Code>，用 <Code>OpenReadStream</Code> 读）、
                报告进度的 <Code>IProgress&lt;double&gt;</Code> 和取消用的 <Code>CancellationToken</Code>，返回值记在 <Code>Response</Code> 上，抛异常算失败。
                失败的可以重试，移除正在上传的会取消。超过 <Code>MaxSize</Code>、不在 <Code>Accept</Code> 里的也列出来，带错误、不上传；
                到了 <Code>MaxFiles</Code> 再选的不加进来。进度按整数百分比变化才更新，Server 模式下不会每个包都推一次。
            </Example>
            <Example Id="form" Title="随表单提交" Demo="typeof(ResumeExample)">
                不给 <Code>UploadAsync</Code> 时文件停在“已选择”，值里带着 <Code>IBrowserFile</Code>，在 <Code>OnValidSubmit</Code> 里和别的字段一起处理；
                校验照常写在模型上。单选（不写 <Code>Multiple</Code>）时新文件替换旧的。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="existing" Title="已有文件" Demo="typeof(ExistingExample)">
                之前上传过、从后端读回来的文件用 <Code>UploadFile.Existing</Code> 放进值里：状态是完成、不重新上传，给了地址时文件名链到它；
                可以移除，新选的照常上传。
            </Example>
            <Example Id="file-drop" Title="FileDrop" Demo="typeof(ImportExample)">
                只负责选文件：点击、聚焦后按 Enter / 空格、或把文件拖进来。选到的经 <Code>ValueChanged</Code> 交出去；
                拖放不受 accept 限制，不合格的经 <Code>OnReject</Code> 交出去。
            </Example>
            <Example Id="folder" Title="上传整个文件夹" Demo="typeof(FolderExample)">
                <Code>Directory</Code> 时对话框里选文件夹（webkitdirectory），拖进来的文件夹也由浏览器读出里面的文件（含子文件夹），列表里显示相对路径。FileDrop 同样有这个参数，相对路径用它的 <Code>PathOf(file)</Code> 取。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Enter / Space", "在选择区域上：打开系统的文件对话框（原生 input[type=file]）"),
        ("Tab", "每个文件的“重新上传”“移除”按钮都在 Tab 顺序里"),
        ("Enter / Space", "在“重新上传”“移除”上：重新上传 / 移除这个文件（上传中的会取消）"),
        ("Enter / Space", "图片墙：在缩略图上看大图；在把手上拿起、放下"),
        ("← / → / ↑ / ↓", "图片墙拿起后：前后移一格 / 跨一行；Esc 取消"),
        ("Ctrl + V", "Pasteable 时：把剪贴板里的图片、文件加进来"),
    ])" />
    <ApiReference Types="[typeof(Upload), typeof(FileDrop), typeof(UploadFile)]" />
</DocPage>
