@inherits RuneComponent

<Grid MinItemWidth="@CssLength.Rem(16)" Gap="SpaceScale.Lg">
    <Field Label="话题" Description="@($"最多 3 个，已有 {hashTags.Count} 个")">
        <TagsInput TItem="string" @bind-Value="hashTags" Max="3" Icon="Lucide.Hash" Clearable="true" placeholder="输入后回车" />
    </Field>
    <Field Label="关键词" Required="true" Error="@(requiredTags.Count > 0 ? null : "至少填一个关键词")">
        <TagsInput TItem="string" @bind-Value="requiredTags" Variant="InputVariant.Soft" placeholder="逗号或分号分隔" />
    </Field>
    <Field Label="只读" ReadOnly="true">
        <TagsInput TItem="string" Value="fixedTags" />
    </Field>
    <Field Label="不可用" Disabled="true">
        <TagsInput TItem="string" Value="fixedTags" Size="Size.Sm" />
    </Field>
</Grid>

@code {
    static readonly IReadOnlyList<string> fixedTags = ["设计", "前端"];

    IReadOnlyList<string> hashTags = ["vue", "tsx"];

    IReadOnlyList<string> requiredTags = [];
}
