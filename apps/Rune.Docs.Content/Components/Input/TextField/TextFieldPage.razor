@page "/components/text-field"
@attribute [DocMeta("TextField 文本框", "单行的 TextField 与自动增高的 Textarea：前后图标、固定的前后缀、一键清空、显示密码、字数计数；放进 Field 自动关联标签、说明与错误。", DocCategory.Input, Order = 1)]
@inherits DocPageBase
@using Rune.Docs.Components.Input.TextField.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="form" Title="注册表单" Demo="typeof(FormExample)">
                放进 Field：标签、说明、错误自动经 aria-labelledby / aria-describedby 关联，并沿用 Field 的必填、不可用。Type="password" 带显示密码的按钮；Prefix / Suffix 是固定的文字（区号、域名），不进值里；maxlength 加 ShowCount 显示字数。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="appearance" Title="样式、尺寸与状态" Demo="typeof(AppearanceExample)">
                Variant 有描边（Surface）与浅底（Soft），Size 对应字号档位，Radius 同按钮。不可用、只读、校验未通过的外观由 Field 统一给。
            </Example>
            <Example Id="textarea" Title="Textarea" Demo="typeof(TextareaExample)">
                高度随内容在 Rows 与 MaxRows 之间增长（父级改值也会跟着变）；Fixed 关掉自动增高、允许拖动调整，Clearable 在右上角放清空按钮。字数计数超出上限时变成危险色，读屏念完整的句子。
            </Example>
            <Example Id="adornments" Title="图标、前后缀、清空与字数" Demo="typeof(AdornmentsExample)">
                Icon / IconEnd 放在框的两头，Prefix / Suffix 是不算在值里的固定文字，Clearable 有内容时显示清空按钮。Field 的 Error 让框标红并把错误作为说明。自己做的输入组件用 CharacterCount 显示字数。
            </Example>
            <Example Id="formats" Title="手机号、身份证号、银行卡号" Demo="typeof(FormatsExample)">
                <Code>Format</Code> 让输入时自动分组显示（<Code>TextFormat.Phone</Code>、<Code>IdCard</Code>、<Code>BankCard</Code>，别的 new 一个 <Code>TextFormat</Code>）：
                值是去掉分隔的原文，过滤掉不接受的字符、截到最长，在中间插字光标也不跳。只管显示，校验写在模型上：
                <Code>[ChinaPhone]</Code> 看号段，<Code>[IdCard]</Code> 看出生日期与校验码。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(CharacterCount), typeof(Textarea), typeof(TextField)]" />
</DocPage>
