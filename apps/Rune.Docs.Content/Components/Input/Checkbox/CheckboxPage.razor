@page "/components/checkbox"
@attribute [DocMeta("Checkbox 复选、单选与开关", "选择：多选的 Checkbox 与 CheckboxGroup、单选的 Radio 与 RadioGroup、立即生效的 Switch。都是原生 input，键盘与读屏行为由浏览器保证。", DocCategory.Input, Order = 4)]
@inherits DocPageBase
@using Rune.Docs.Components.Input.Checkbox.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="checkbox" Title="复选框" Demo="typeof(CheckboxExample)">
                单个复选框绑 <Code>Value</Code>；一组用 CheckboxGroup 绑值的列表，<Code>Name</Code> 随表单提交。全选框部分勾选时写 <Code>Indeterminate</Code>，读屏念“部分选中”。放进 Field 时组以标签为名称，并关联说明与错误。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="switch" Title="开关" Demo="typeof(SwitchExample)">
                Switch 是立即生效的设置（需要提交才生效的用 Checkbox）。
            </Example>
            <Example Id="radio" Title="单选" Demo="typeof(RadioExample)">
                同一组的原生 radio 共用 name：Tab 只停在选中项，方向键在组内移动并选中，都是浏览器的原生行为。选项里可以放任意内容（说明、价格）；Orientation="Orientation.Horizontal" 横排。
            </Example>
            <Example Id="validation" Title="必选与出错" Demo="typeof(ValidationExample)">
                提交时才检查：Field 的 <Code>Required</Code> 标出必填，<Code>Error</Code> 让整组标红并把错误作为说明念出；单个复选框（同意条款）同样包在 Field 里显示错误。<Code>Orientation.Horizontal</Code> 让一组横排。
            </Example>
            <Example Id="items" Title="选项来自数据" Demo="typeof(ItemsExample)">
                <Code>CheckboxGroup</Code>、<Code>RadioGroup</Code> 的 <Code>Items</Code> 同 Select：ListboxOption（值、文字、说明、不可用）、字符串，或任意数据加 <Code>ToOption</Code>，选项来自字典、接口时不用一个个写。<Code>Description</Code> 显示在文字下方，经 aria-describedby 关联；单独的 <Code>Checkbox</Code>、<Code>Radio</Code> 也能写。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Space", "复选框、开关：切换勾选"),
        ("↓ / → / ↑ / ←", "单选组里：移到下一个 / 上一个选项并选中（原生 radio，整组一个 Tab 位置）"),
        ("Tab", "复选框、开关各占一个 Tab 位置；单选组只停在已选（或第一个）选项上"),
    ])">
        都是原生的 input，键盘与读屏行为来自浏览器；样式自己画。
    </KeyboardReference>
    <ApiReference Types="[typeof(CheckboxGroup<>), typeof(Checkbox), typeof(RadioGroup<>), typeof(Radio<>), typeof(Switch)]" />
</DocPage>
