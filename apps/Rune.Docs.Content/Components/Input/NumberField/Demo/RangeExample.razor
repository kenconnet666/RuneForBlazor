@inherits RuneComponent

<Grid MinItemWidth="@CssLength.Rem(16)" Gap="SpaceScale.Lg">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Field Label="预期收益量级" Description="填 50 和 10 试试：失焦后自动对调">
            <NumberRangeField @bind-Value="saving" Scale="10000" Format="#,0.##" Min="0" data-testid="saving"><Suffix>万元</Suffix></NumberRangeField>
        </Field>
        <Small Tone="TextTone.Muted">保存的值：<Code data-testid="saving-value">@RangeText(saving, " 元")</Code></Small>
    </Flex>
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Field Label="门店数量" Description="只填起：20 家以上">
            <NumberRangeField @bind-Value="storeRange" Min="0"><Suffix>家</Suffix><Separator>至</Separator></NumberRangeField>
        </Field>
        <Small Tone="TextTone.Muted">值：<Code>@RangeText(storeRange, "")</Code></Small>
    </Flex>
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Field Label="单价" Description="筛选栏里常用：浅底、小号、胶囊形">
            <NumberRangeField @bind-Value="priceRange" Min="0" Variant="InputVariant.Soft" Size="Size.Sm" Radius="Radius.Full"><Prefix>$</Prefix></NumberRangeField>
        </Field>
        <Small Tone="TextTone.Muted">值：<Code>@RangeText(priceRange, "")</Code></Small>
    </Flex>
</Grid>

@code {
    NumberRange<decimal?> saving = new(100000, 500000);

    NumberRange<int?> storeRange = new(20, null);

    NumberRange<decimal?> priceRange = new(null, 1200);

    static string RangeText<T>(NumberRange<T> range, string unit) =>
        $"{(range.Low is { } low ? $"{low}{unit}" : "不限")} ～ {(range.High is { } high ? $"{high}{unit}" : "不限")}";
}
