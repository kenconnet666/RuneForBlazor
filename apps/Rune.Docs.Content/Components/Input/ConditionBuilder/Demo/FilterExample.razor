@* 筛选本地数据：Conditions.Matches 按条件筛表格的行（同一份条件也能交给后端，结果一致）；
   MaxDepth="1" 不能加组，只有一层“全部满足 / 任一满足”的条件，Size="Size.Sm" 用小一档的控件 *@
@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <ConditionBuilder Fields="fields" @bind-Value="condition" MaxDepth="1" Size="Size.Sm" aria-label="订单筛选条件" />
    <Small Tone="TextTone.Muted">@Rows.Count / @orders.Length 张订单</Small>
    <DataTable Items="Rows" GetKey="o => o.Id" aria-label="订单">
        <PropertyColumn Property="o => o.Id" Title="订单号" Width="100" />
        <PropertyColumn Property="o => o.Supplier" Title="供应商" Width="120" />
        <PropertyColumn Property="o => o.Category" Title="品类" Width="80" />
        <PropertyColumn Property="o => o.Amount" Title="金额（元）" Width="120" Format="Whole" />
        <PropertyColumn Property="o => o.Delivery" Title="交货日期" Width="120" />
    </DataTable>
</Flex>

@code {
    sealed record Order(string Id, string Supplier, string Category, decimal Amount, string Delivery);

    static readonly NumberFormat Whole = new() { MaximumFractionDigits = 0 };

    static readonly Order[] orders =
    [
        new("PO-1031", "华东钢铁", "钢材", 128000, "2026-11-03"),
        new("PO-1032", "西南铝业", "铝材", 86500, "2026-11-12"),
        new("PO-1033", "华东钢铁", "钢材", 42000, "2026-10-28"),
        new("PO-1034", "精工紧固件", "紧固件", 6800, "2026-11-01"),
        new("PO-1035", "北方检测", "服务", 15000, "2026-12-15"),
        new("PO-1036", "西南铝业", "铝材", 213000, "2026-12-02"),
    ];

    static readonly IReadOnlyList<ConditionField> fields =
    [
        new("supplier", "供应商", ConditionFieldType.Text),
        new("category", "品类", ConditionFieldType.Select) { Options = [.. new[] { "钢材", "铝材", "紧固件", "服务" }.Select(name => new ConditionOption(name, name))] },
        new("amount", "金额", ConditionFieldType.Number),
        new("delivery", "交货日期", ConditionFieldType.Date),
    ];

    ConditionExpression? condition = new ConditionAll([new ConditionRule("amount", ConditionOp.Gte, 40000m)]);

    // 字段名 → 这一行的值
    static object? Read(Order order, string name) => name switch
    {
        "supplier" => order.Supplier,
        "category" => order.Category,
        "amount" => order.Amount,
        "delivery" => order.Delivery,
        _ => null,
    };

    IReadOnlyList<Order> Rows => condition is null ? orders : [.. orders.Where(order => Conditions.Matches(condition, name => Read(order, name)))];
}
