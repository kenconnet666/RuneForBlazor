@page "/components/people-picker"
@attribute [DocMeta("PeoplePicker 人员与组织选择器", "选人员、部门、角色：按组织架构一层层找、搜索、看最近选过的，右边是已选的。数据由接入方的 PeopleSource 提供，表单字段或直接放面板。", DocCategory.Input, Order = 18)]
@inherits DocPageBase
@using Rune.Docs.Components.Input.PeoplePicker.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="field" Title="表单字段" Demo="typeof(FieldExample)">
        <Code>PeoplePicker</Code> 的触发框里是已选的标签，点开对话框挑选，按“确定”才写回。<Code>Types</Code> 决定能选哪几种，<Code>Max="1"</Code> 只选一个；
        <Code>RecentKey</Code> 把勾过的记在浏览器里（“最近”页）。值是 <Code>PeopleEntry</Code> 的列表，带着名字，回显不用再查。
    </Example>
    <Example Id="panel" Title="直接放面板" Demo="typeof(PanelExample)">
        <Code>PeoplePickerPanel</Code> 可以直接放在页面、抽屉里，改动立即写回。<Code>Source.Roles</Code> 给了时有“角色”页；<Code>Max</Code> 勾满之后其余的勾选框不可用。
    </Example>
    <Example Id="remote" Title="远程数据" Demo="typeof(RemoteExample)">
        <Code>PeopleSource</Code> 的 <Code>Children</Code>、<Code>Search</Code>、<Code>Roles</Code> 按自己的接口实现，令牌在换了部门、改了搜索词时取消。
        搜索在输入停下 300 ms 后进行，只采用最后一次。整棵组织架构已经在内存里时用 <Code>PeopleSource.Local</Code>。
    </Example>
    <KeyboardReference Keys="@([
        ("Enter / Space / ↓", "触发按钮上：打开对话框"),
        ("Backspace", "触发按钮上：移除最后一个"),
        ("Tab", "对话框里依次经过搜索框、浏览方式、面包屑、全选、每行的勾选框与“下级”、已选的移除按钮"),
        ("Space", "勾上或取消一行"),
    ])">
        每行的勾选框以名字为名，“下级”按钮的名称是“下级：某部门”，进去后焦点落到列表上。面包屑的当前一级标 aria-current="location"。
    </KeyboardReference>
    <ApiReference Types="[typeof(PeoplePicker), typeof(PeoplePickerPanel), typeof(PeopleSource), typeof(PeopleEntry)]" />
</DocPage>
