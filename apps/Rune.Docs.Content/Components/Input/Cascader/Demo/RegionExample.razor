@* 收货地址：全国省 / 市 / 区三级（Rune.UI.Area 包的数据），只能选到区；可搜索、可清空。开票地区只到市（Area.Tree(2)） *@
@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Switch @bind-Value="allLevels">显示整条路径</Switch>
    <Grid MinItemWidth="CssLength.Rem(17)" Gap="SpaceScale.Md">
        <Field Label="收货地址">
            <Cascader TItem="AreaNode" Items="Area.Tree()" GetKey="Area.KeyAt" GetLabel="Area.LabelOf" GetChildren="Area.ChildrenOf"
                      @bind-Value="address" ShowAllLevels="allLevels" Icon="Lucide.MapPin" Searchable="true" Clearable="true" />
        </Field>
        <Field Label="开票地区">
            <Cascader TItem="AreaNode" Items="Area.Tree(2)" GetKey="Area.KeyAt" GetLabel="Area.LabelOf" GetChildren="Area.ChildrenOf"
                      @bind-Value="invoice" ShowAllLevels="allLevels" Placeholder="省 / 市" Searchable="true" />
        </Field>
    </Grid>
    <Small Tone="TextTone.Muted">
        value：@(address is null ? "null" : $"[{string.Join(", ", address.Select(code => $"\"{code}\""))}]")
        @if (address is not null)
        {
            <span>（@string.Join(" ", Area.Names(address))）</span>
        }
    </Small>
</Flex>

@code {
    IReadOnlyList<string>? address = ["330000", "330100", "330106"];
    IReadOnlyList<string>? invoice;
    bool allLevels = true;
}
