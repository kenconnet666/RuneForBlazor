@inherits RuneComponent

<p>这片区域把卡片的默认外观改成 Outline：组件上没写 Variant，取的是 Provider 的默认值。</p>
<RuneProvider Components="@outlineByDefault">
    <Flex Gap="SpaceScale.Md" Wrap="true">
        <Card data-testid="default-variant">
            <Header>没写 Variant 的卡片</Header>
            <ChildContent>外观来自 Provider。</ChildContent>
        </Card>
        <Card Variant="CardVariant.Elevated" data-testid="explicit-variant">
            <Header>显式写了 Variant="Elevated"</Header>
            <ChildContent>组件上写的参数优先。</ChildContent>
        </Card>
    </Flex>
</RuneProvider>

@code {
    // 配置对象在组件里只创建一次：Provider 按引用判断配置有没有变
    readonly ComponentConfigs outlineByDefault = new()
    {
        new ComponentConfig<CardDefaults, CardPart> { Defaults = new() { Variant = CardVariant.Outline } },
    };
}
