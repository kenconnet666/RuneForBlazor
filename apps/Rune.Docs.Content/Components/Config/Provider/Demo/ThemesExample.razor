@inherits RuneComponent

<Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center" Wrap="true">
    <NativeSelect @bind-Value="theme" Items="Themes.All" ItemText="t => t.Name" aria-label="主题" Sx="ThemePicker" data-testid="theme-picker" />
    <TextSpan Tone="TextTone.Muted" Size="Size.Sm">@(theme.IsDark ? "暗色" : "亮色")主题：颜色、阴影、字体、圆角都来自主题</TextSpan>
</Flex>
<RuneProvider Theme="theme" DarkTheme="theme" ColorScheme="ColorScheme.Light">
    <div @attributes="Attrs.Merge(ThemePreview)" data-testid="theme-gallery">
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
            <H3>@theme.Name</H3>
            <Flex Wrap="true" Gap="SpaceScale.Sm">
                @foreach (var tone in Enum.GetValues<Tone>())
                {
                    <Button Tone="tone">@tone</Button>
                }
            </Flex>
            <Flex Wrap="true" Gap="SpaceScale.Sm">
                @foreach (var variant in Enum.GetValues<ButtonVariant>())
                {
                    <Button Variant="variant">@variant</Button>
                }
            </Flex>
            <Flex Wrap="true" Gap="SpaceScale.Sm">
                @foreach (var tone in Enum.GetValues<Tone>())
                {
                    <Badge Tone="tone">@tone</Badge>
                }
            </Flex>
            <Alert Tone="Tone.Warning" Title="提示条">浅色底、色调文字与图标都来自主题。</Alert>
            <Grid MinItemWidth="@("14em")" Gap="SpaceScale.Md">
                <Card Header="@CardHeader">
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                        <TextField placeholder="输入框" />
                        <Checkbox Value="true">勾选框</Checkbox>
                        <Switch Value="true">开关</Switch>
                    </Flex>
                </Card>
                <Card Variant="CardVariant.Elevated" Header="@ElevatedHeader">
                    <Paragraph Tone="TextTone.Muted">阴影来自主题（赛博朋克是发光的阴影）。</Paragraph>
                    <TextLink Href="components/provider">链接</TextLink>
                </Card>
            </Grid>
        </Flex>
    </div>
</RuneProvider>

@code {
    static readonly RenderFragment CardHeader = builder => builder.AddContent(0, "卡片");

    static readonly RenderFragment ElevatedHeader = builder => builder.AddContent(0, "浮起的卡片");

    Theme theme = Themes.Cyberpunk;

    static Style ThemePicker => Css.Define(static () => new Style { Width = CssLength.Em(14) });

    static Style ThemePreview => Css.Define(static () => new Style
    {
        Padding = Space.Md,
        BorderRadius = Radii.Md,
        BackgroundColor = Colors.Background,
        Color = Colors.Text,
    });
}
