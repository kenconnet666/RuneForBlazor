@inherits RuneComponent

<p>这片区域给所有卡片的页头（CardPart.Header）追加了样式：标题用强调色。</p>
<RuneProvider Styles="@accentHeaders">
    <Card data-testid="styled-header">
        <Header>页头样式来自 Provider</Header>
        <ChildContent>没有改组件，也没有在使用处写 Sx。</ChildContent>
    </Card>
</RuneProvider>

@code {
    readonly ComponentStyles accentHeaders = new() { { CardPart.Header, AccentText } };

    static Style AccentText => Css.Define(static () => new Style { Color = Tones.Accent.Text });
}
