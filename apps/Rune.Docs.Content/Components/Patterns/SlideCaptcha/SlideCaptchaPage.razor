@page "/components/slide-captcha"
@attribute [DocMeta("SlideCaptcha 滑块验证", "登录前的拼图滑块验证：服务端出题，拖动滑块让拼图对准缺口，松手把位置和拖动轨迹交给服务端判定。", DocCategory.Patterns, Order = 10)]
@inherits DocPageBase
@using Rune.Docs.Components.Patterns.SlideCaptcha.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="basic" Title="服务端出题、服务端判定" Demo="typeof(BasicExample)">
                组件只负责交互，不判对错：<Code>Challenge</Code> 是服务端给的图（背景带缺口、拼图块和背景一样高，左边缘就是缺口的左边缘），
                松手时 <Code>OnRelease</Code> 交出 <Code>SlideResult</Code>（<Code>X</Code>、<Code>Track</Code>、<Code>Duration</Code>），
                服务端按位置和轨迹（真人有加减速和抖动）判定，再由父级设置 <Code>Status</Code>：Verifying 时不能拖，Success 锁定，Error 时滑块晃一下，
                设回 Idle 或换新图后回到起点。聚焦滑块后 ←/→ 微调、Home/End、Enter 松手；这类验证对读屏和运动障碍的用户不友好，应用应当另外提供别的方式。
                这个示例在 C# 里自己出题、自己判，只为演示。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("→ / ←", "滑块往前 / 往回挪 2px（从右到左排版时反过来）"),
        ("Home / End", "滑块到起点 / 终点"),
        ("Enter / Space", "松手：交出位置与轨迹，等判定"),
    ])">
        滑块是 slider，读屏念出当前的位置；判定中与通过后不可用、离开 Tab 顺序，结果经礼貌的实时区域念出。
    </KeyboardReference>
    <ApiReference Types="[typeof(SlideCaptcha), typeof(SlideChallenge), typeof(SlideResult)]" />
</DocPage>
