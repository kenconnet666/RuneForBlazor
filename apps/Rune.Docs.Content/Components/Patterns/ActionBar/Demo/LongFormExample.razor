@* 长表单：操作栏贴在滚动区域的底边，起始边写着改了几处；盖着下面的字段时带阴影，滚到底与内容平齐 *@
@using System.ComponentModel.DataAnnotations
@inherits RuneComponent

<Card Padding="SpaceScale.None">
    <Form Model="supplier" OnValidSubmit="SaveAsync">
        <ScrollArea style="height: 24rem">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xl" style="padding: var(--rune-space-lg)">
                <FormSection Title="基本信息" Columns="2" MinColumnWidth="CssLength.Em(15)">
                    <Field Label="供应商名称"><TextField @bind-Value="supplier.Name" /></Field>
                    <Field Label="统一社会信用代码"><TextField @bind-Value="supplier.Code" /></Field>
                    <Field Label="联系人"><TextField @bind-Value="supplier.Contact" /></Field>
                    <Field Label="手机"><TextField @bind-Value="supplier.Phone" inputmode="numeric" /></Field>
                    <GridItem FullRow="true">
                        <Field Label="地址"><TextField @bind-Value="supplier.Address" /></Field>
                    </GridItem>
                </FormSection>
                <FormSection Title="结算信息" Columns="2" MinColumnWidth="CssLength.Em(15)">
                    <Field Label="开户行"><TextField @bind-Value="supplier.Bank" /></Field>
                    <Field Label="账号"><TextField @bind-Value="supplier.Account" /></Field>
                    <Field Label="发票类型"><Select Items="invoices" @bind-Value="supplier.Invoice" /></Field>
                    <Field Label="账期"><Select Items="terms" @bind-Value="supplier.Terms" /></Field>
                </FormSection>
                <FormSection Title="变更说明">
                    <Field Label="为什么改" Description="审批人会看到，写清楚改了什么、依据是什么">
                        <Textarea @bind-Value="supplier.Note" Rows="3" />
                    </Field>
                </FormSection>
            </Flex>
            <ActionBar>
                <Start>@(Changed > 0 ? $"有 {Changed} 处改动还没保存" : "没有改动")</Start>
                <ChildContent>
                    <Button Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" Disabled="Changed == 0" @onclick="Undo">撤销改动</Button>
                    <Button Type="submit" Disabled="Changed == 0" Loading="saving">保存</Button>
                </ChildContent>
            </ActionBar>
        </ScrollArea>
    </Form>
</Card>

@code {
    sealed class Supplier
    {
        [Required(ErrorMessage = "请填写供应商名称"), MinLength(2, ErrorMessage = "至少 2 个字")] public string? Name { get; set; } = "供应商甲精密制造有限公司";
        [RegularExpression("^[0-9A-Z]{18}$", ErrorMessage = "18 位数字或大写字母")] public string? Code { get; set; } = "91310115MA1K4XXX0Q";
        [Required(ErrorMessage = "请填写联系人")] public string? Contact { get; set; } = "周岚";
        [RegularExpression(@"^1\d{10}$", ErrorMessage = "11 位手机号")] public string? Phone { get; set; } = "13800001234";
        public string? Address { get; set; } = "上海市浦东新区某路 88 号";
        [Required(ErrorMessage = "请填写开户行")] public string? Bank { get; set; } = "某银行上海浦东支行";
        [Required(ErrorMessage = "请填写账号")] public string? Account { get; set; } = "6222 0210 0100 1234 567";
        public string? Invoice { get; set; } = "special";
        public string? Terms { get; set; } = "60";
        [Required(ErrorMessage = "请写变更说明"), MinLength(6, ErrorMessage = "至少写 6 个字"), MaxLength(200)] public string? Note { get; set; }

        public string?[] Values => [Name, Code, Contact, Phone, Address, Bank, Account, Invoice, Terms, Note];

        public Supplier CopyFrom(Supplier other)
        {
            (Name, Code, Contact, Phone, Address, Bank, Account, Invoice, Terms, Note) =
                (other.Name, other.Code, other.Contact, other.Phone, other.Address, other.Bank, other.Account, other.Invoice, other.Terms, other.Note);
            return this;
        }
    }

    static readonly ListboxOption[] invoices = [new("special", "增值税专用发票"), new("normal", "增值税普通发票")];
    static readonly ListboxOption[] terms = [new("30", "30 天"), new("60", "60 天"), new("90", "90 天")];

    readonly Supplier supplier = new();
    // 上一次保存的值：和它比改了几处
    readonly Supplier saved = new();
    bool saving;

    int Changed => supplier.Values.Zip(saved.Values).Count(pair => pair.First != pair.Second);

    void Undo() => supplier.CopyFrom(saved);

    async Task SaveAsync()
    {
        saving = true;
        await Task.Delay(800);
        saved.CopyFrom(supplier);
        saving = false;
    }
}
