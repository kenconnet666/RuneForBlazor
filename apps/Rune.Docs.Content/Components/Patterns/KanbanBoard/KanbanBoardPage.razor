@page "/components/kanban-board"
@attribute [DocMeta("KanbanBoard 看板", "卡片按状态分列，拖到别的列表示推进，列内可以排序：能不能放由使用方判断并写明原因，放下后由使用方改数据；键盘、读屏都能操作。", DocCategory.Patterns, Order = 7)]
@inherits DocPageBase
@using Rune.Docs.Components.Patterns.KanbanBoard.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn Wide="true">
            <Example Id="flow" Title="只能挪到相邻的列，列内排序" Demo="typeof(FlowExample)">
                看板不自己挪卡片：放下时报告 <Code>OnMove</Code>（带上在目标列里的位置，落点处有一条插入线），使用方改了数据卡片才换列。
                给了 <Code>OnReorder</Code> 时列内也能拖动排序，写回整个列表。<Code>CanMove</Code> 返回不能放的原因：拖动经过时那一列标红并写出原因，
                放下时卡片弹回、报告 <Code>OnReject</Code>。列名旁的计数用 <Code>Tone</Code> 提示要注意的列。各列至少 <Code>ColumnWidth</Code> 宽，
                放得下时平分整行，放不下时横向滚动；<Code>ColumnHeight</Code> 是列的最大高度，卡片多时列里滚动。
            </Example>
        </ExampleColumn>
        <ExampleColumn Wide="true">
            <Example Id="confirm" Title="放下后先确认" Demo="typeof(ConfirmExample)">
                要填意见、要审批的移动：<Code>OnMove</Code> 里打开对话框（这里是 <Code>DialogService.PromptAsync</Code>，也可以是抽屉），确认后再改数据，取消就什么都不变。
                卡片的内容拿到 <Code>Dragging</Code>，拖动中可以换一种写法；空列显示 <Code>Empty</Code>。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Space / Enter", "在卡片的把手上：拿起；拿起后再按：放到落点"),
        ("← / →", "拿起后：换到左边 / 右边一列（跟随从右到左排版），播报那一列能不能放"),
        ("↑ / ↓", "拿起后：在本列里排序（给了 OnReorder 时）；在别的列里调整落点"),
        ("Esc", "取消，卡片留在原来的列"),
    ])">
        鼠标在卡片上按下拖动，触屏从把手拖；卡片里的链接、按钮照常点。拿起、换列、放下、取消都会播报给读屏（WCAG 2.5.7 的拖动替代操作）。
    </KeyboardReference>
    <ApiReference Types="[typeof(KanbanBoard<>), typeof(KanbanColumn)]" />
</DocPage>
