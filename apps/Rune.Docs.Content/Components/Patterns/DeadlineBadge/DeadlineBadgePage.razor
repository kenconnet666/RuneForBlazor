@page "/components/deadline-badge"
@attribute [DocMeta("DeadlineBadge 时限标记", "按工作日算还剩几天、今天到期、超时几天，颜色随状态：收件箱、待办、各种有时限的列表。", DocCategory.Patterns, Order = 8)]
@inherits DocPageBase
@using Rune.Docs.Components.Patterns.DeadlineBadge.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="states" Title="状态" Demo="typeof(StatesExample)">
                <Code>Due</Code> 是截止日。还早是中性色；剩下的工作日不多于 <Code>Soon</Code>（默认 2）和今天到期是警示色；超时是危险色。写了 <Code>Done</Code>
                按完成那天算，显示按时或超时完成。悬停看截止日，读屏也会念。演示固定了 <Code>Today</Code>，业务以服务器日期为准时也这样传。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="todos" Title="待办列表" Demo="typeof(TodosExample)">
                最常见的用法：列表每条的结束边（ItemList 的 <Code>End</Code>）放一个时限标记，超时、快到期的一眼看出来；已完成的写 <Code>Done</Code>，显示按时还是超时完成。
            </Example>
        </ExampleColumn>
        <ExampleColumn Wide="true">
            <Example Id="calendar" Title="开始日加工作日、节假日" Demo="typeof(CalendarExample)">
                <Code>Start</Code> + <Code>Workdays</Code> 算截止日。工作日按 <Code>AddRuneUI</Code> / <Code>RuneProvider</Code> 的 <Code>WorkCalendar</Code>
                （带上法定节假日与调休补班），没给时只按周末；算法见 <Code>WorkCalendar.DeadlineOf</Code>。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(DeadlineBadge)]" />
</DocPage>
