@page "/components/command-palette"
@attribute [DocMeta("CommandPalette 命令面板", "快捷键或按钮打开的搜索对话框：边输入边过滤，回车执行。站内搜索、后台的“跳转到…”、提及成员都用它；本站右上角的搜索就是。", DocCategory.Overlay, Order = 5)]
@inherits DocPageBase
@using Rune.Docs.Components.Overlay.CommandPalette.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="commands" Title="命令与页面" Demo="typeof(CommandsExample)">
                选项按 <Code>Group</Code> 分组，可以带图标、说明、不可用。焦点一直在输入框里：<Kbd>↑</Kbd> <Kbd>↓</Kbd> 移动高亮，<Kbd>Enter</Kbd> 执行，<Kbd>Esc</Kbd> 关闭。<Code>Hotkey</Code> 默认是 Mod+K（留给站内搜索），这里换成 Mod+J。
            </Example>
            <Example Id="remote" Title="远程搜索" Demo="typeof(RemoteExample)">
                与 Combobox 相同的写法：<Code>@@bind-InputValue</Code> 拿到输入去服务端查，<Code>LocalFilter="false"</Code> 表示 <Code>Items</Code> 就是结果、不再本地过滤；查询期间 <Code>Loading</Code> 为 true，列表里是骨架行。晚到的旧请求要自己丢掉。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="custom" Title="任意数据与自定义选项" Demo="typeof(CustomExample)">
                后端数据直接给 <Code>Items</Code>，<Code>ToOption</Code> 说明值、文字和分组；<Code>Filter</Code> 自定义匹配（这里姓名、邮箱都能搜），子内容自定义每一项；<Code>Trigger</Code> 换成自己的按钮，<Code>Hotkey="@@null"</Code> 不注册快捷键；<Code>Empty</Code> 换掉没有匹配时的内容。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Ctrl+K / ⌘+K", "打开或关闭面板（Hotkey，默认 mod+k；输入框里也生效）"),
        ("↓ / ↑", "移动高亮，焦点留在输入框里（aria-activedescendant）"),
        ("PageDown / PageUp", "按一屏移动高亮"),
        ("Enter", "执行高亮的一项，随后关闭面板"),
        ("Esc", "关闭面板，焦点回到打开它的元素"),
    ])" />
    <ApiReference Types="[typeof(CommandPalette<>)]" />
</DocPage>
