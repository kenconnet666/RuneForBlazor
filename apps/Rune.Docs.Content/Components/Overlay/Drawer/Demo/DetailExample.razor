@inherits RuneComponent

@* 详情抽屉：列表留在原处，点一行（或编号）从结束边滑出详情——关键信息、时限、流转记录；关上后焦点回到那一行的编号，
   正在看的那一行一直高亮（ActiveKey） *@
<DataTable Items="Projects" GetKey="row => row.Id" ActiveKey="@(open ? active : null)" OnRowClick="@((Project row) => Show(row.Id))"
           Density="TableDensity.Compact" aria-label="项目">
    <TemplateColumn Key="code" Title="编号" Width="150" Context="row">
        <Button Size="Size.Sm" Variant="ButtonVariant.Link" @onclick="() => Show(row.Id)">@row.Code</Button>
    </TemplateColumn>
    <PropertyColumn Property="row => row.Name" Title="名称" Width="240" />
    <PropertyColumn Property="row => row.Team" Title="责任团队" Width="140" />
    <TemplateColumn Key="status" Title="状态" Width="120" Context="row">
        <StatusBadge Statuses="Statuses" Value="row.Status" />
    </TemplateColumn>
    <PropertyColumn Property="row => row.Saving" Title="预计年节省" Width="140" Type="ColumnType.Currency" />
    <TemplateColumn Key="due" Title="当前环节时限" Width="150" Context="row">
        <DeadlineBadge Due="row.Due" Today="Today" />
    </TemplateColumn>
</DataTable>
<Drawer @bind-Open="open" Size="ContainerSize.Sm" Title="@(Current?.Name ?? "")" Description="@(Current is { } project ? $"{project.Code} · {project.Team}" : null)">
    <Footer>
        <LinkButton Href="#detail" Variant="ButtonVariant.Soft" Tone="Tone.Neutral" Icon="Lucide.ExternalLink">打开完整详情</LinkButton>
    </Footer>
    <ChildContent>
        @if (Current is { } current)
        {
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                <Flex Align="ItemAlign.Center" Gap="SpaceScale.Sm">
                    <StatusBadge Statuses="Statuses" Value="current.Status" />
                    <DeadlineBadge Due="current.Due" Today="Today" />
                </Flex>
                <Descriptions Columns="2">
                    <DescriptionsItem Label="主办" Value="@current.Owner" />
                    <DescriptionsItem Label="责任团队" Value="@current.Team" />
                    <DescriptionsItem Label="预计年节省"><TextSpan Numeric="true">@current.Saving.ToString("C0", Yuan)</TextSpan></DescriptionsItem>
                    <DescriptionsItem Label="当前环节截止" Value="@current.Due.ToString("yyyy-MM-dd")" />
                </Descriptions>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                    <H3 Size="Size.Sm">流转记录</H3>
                    <Timeline Items="current.Records" Size="Size.Sm" Reverse="true" />
                </Flex>
            </Flex>
        }
    </ChildContent>
</Drawer>

@code {
    sealed record Project(string Id, string Code, string Name, string Team, string Owner, string Status, decimal Saving, DateOnly Due, TimelineItem[] Records);

    static readonly DateOnly Today = new(2026, 10, 21);

    static readonly System.Globalization.CultureInfo Yuan = System.Globalization.CultureInfo.GetCultureInfo("zh-CN");

    static readonly StatusMap<string> Statuses = new()
    {
        ["designing"] = new("设计中", Tone.Info),
        ["verifying"] = new("测试中", Tone.Accent),
        ["confirming"] = new("待验收", Tone.Warning),
    };

    static TimelineItem Record(string title, string time, Tone? tone = null) => new(title) { Time = time, Tone = tone };

    static readonly Project[] Projects =
    [
        new("p1", "PO-2026-0187", "显示器支架合并为一体成型", "研发中心", "林小满", "verifying", 174752, new(2026, 10, 23),
        [
            Record("林小满 发起", "09-02 10:12", Tone.Accent),
            Record("王晴 · 资料审核：通过", "09-05 14:30", Tone.Success),
            Record("周宁 · 方案设计：提交方案", "09-28 16:05", Tone.Success),
            Record("到达 验证实施", "10-08 09:00"),
        ]),
        new("p2", "PO-2026-0214", "线束卡箍改用铝合金", "生产部", "周宁", "designing", 86400, new(2026, 10, 16),
        [
            Record("周宁 发起", "09-20 09:40", Tone.Accent),
            Record("陆川 · 部门审批：退回修改", "10-10 11:20", Tone.Warning),
        ]),
        new("p3", "PO-2026-0233", "机柜导轨第二供应商", "供应链管理", "韩笑", "confirming", 312000, new(2026, 10, 30),
        [
            Record("韩笑 发起", "08-12 15:00", Tone.Accent),
            Record("方圆 · 费用核算：出测算", "09-30 10:30", Tone.Success),
        ]),
        new("p4", "FA-2026-0142", "密封件国产化", "产品部", "陆川", "verifying", 128900, Today, [Record("陆川 发起", "09-11 08:50", Tone.Accent)]),
        new("p5", "PO-2026-0179", "货架紧固件减量", "生产部", "方圆", "designing", 52600, new(2026, 11, 12), [Record("方圆 发起", "10-15 13:25", Tone.Accent)]),
    ];

    string? active;
    bool open;

    Project? Current => Projects.FirstOrDefault(row => row.Id == active);

    void Show(string id) => (active, open) = (id, true);
}
