@page "/components/drawer"
@attribute [DocMeta("Drawer 抽屉", "从一侧滑入的模态面板：看详情、编辑、筛选时列表留在原处；可以拖动调宽、记住宽度，关闭前确认未保存的改动。与 Dialog 共用同一个内核。", DocCategory.Overlay, Order = 2)]
@inherits DocPageBase
@using Rune.Docs.Components.Overlay.Drawer.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn Wide="true">
            <Example Id="detail" Title="详情：列表留在原处" Demo="typeof(DetailExample)">
                点一行（或编号按钮，键盘也能打开）从结束边滑出详情：状态与时限、关键信息、流转记录，列表不跳走；正在看的那一行用 DataTable 的 <Code>ActiveKey</Code> 高亮。
                <Code>Title</Code> 与 <Code>Description</Code> 是抽屉的名称与描述，<Code>Footer</Code> 放“打开完整详情”这类去处；关上后焦点回到打开它的按钮。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="edit" Title="编辑：拖宽度与关闭前确认" Demo="typeof(EditExample)">
                靠正文的一边可以拖宽、拖到几乎关上（<Code>@@bind-Width</Code> 记住宽度），聚焦手柄后按 ← / → 也行，双击回到打开时的宽度；<Code>Resizable="false"</Code> 关掉。<Code>OnConfirm</Code> 是保存：执行期间按钮加载中、关不掉。<Code>BeforeClose</Code> 在取消、关闭按钮、<Kbd>Esc</Kbd>、点遮罩时先问一次，返回 false 不关——有未保存的改动时确认。
            </Example>
            <Example Id="sides" Title="方向与宽度" Demo="typeof(SidesExample)">
                <Code>Side</Code> 取 Start、End（默认）、Top、Bottom，Start / End 跟随从右到左排版；<Code>Size</Code> 与 Container 同档，只管左右两侧的宽度，上下两侧的高度随内容。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="filters" Title="筛选" Demo="typeof(FiltersExample)">
                条件多、页面放不下时收进抽屉：改的是一份草稿，<Code>OnConfirm</Code>（查看结果）时才生效，关掉就放弃；<Code>Footer</Code> 里的“重置”排在取消、确认前面，确认按钮上写着已设几项。
            </Example>
            <Example Id="imperative" Title="命令式：从表格的一行打开" Demo="typeof(ImperativeExample)">
                <Code>DialogService.Open(new DrawerOptions { … })</Code> 用法同命令式对话框：每一行的“编辑”直接打开，页面里不放 Drawer。草稿留在这次打开里，
                <Code>OnConfirm</Code> 保存时写回表格；<Code>await handle.Closed</Code> 得到关上的原因（保存是 Confirm，放弃是 Escape、Outside、Close）。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Tab / Shift+Tab", "在抽屉里的可聚焦元素之间移动；页面其余部分不可操作（原生模态 dialog）"),
        ("Esc", "关闭抽屉（要先确认时先问），焦点回到打开它的元素"),
        ("← / →", "宽度调整手柄聚焦时（Resizable）：调宽、调窄（跟随从右到左排版）；双击回到初始宽度"),
    ])">
        打开时焦点落在带 <Code>autofocus</Code> 的元素上，没有就是第一个可聚焦的元素。
    </KeyboardReference>
    <ApiReference Types="[typeof(Drawer)]" />
</DocPage>
