@page "/components/menu"
@attribute [DocMeta("Menu 菜单", "按钮弹出的一列操作：普通项、复选项、单选组、子菜单、链接项；ContextMenu 是从指针位置弹出的同一套菜单。", DocCategory.Overlay, Order = 4)]
@inherits DocPageBase
@using Rune.Docs.Components.Overlay.Menu.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="actions" Title="操作菜单" Demo="typeof(ActionsExample)">
                点击、<Kbd>Enter</Kbd>、<Kbd>Space</Kbd> 执行菜单项，随后关闭菜单。<Code>Shortcut</Code> 显示快捷键；<Code>Tone="Tone.Danger"</Code> 标出破坏性操作；不可用的项方向键跳过。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Enter / Space / ↓", "在触发器上：打开菜单并聚焦第一项"),
        ("↑", "在触发器上：打开菜单并聚焦最后一项"),
        ("↓ / ↑", "移到下一项 / 上一项，到头后循环；跳过不可用的项"),
        ("Home / End", "移到第一项 / 最后一项"),
        ("字母键", "移到下一个以它开头的项"),
        ("Enter / Space", "执行这一项；单选项选中"),
        ("Esc", "关闭菜单，焦点回到触发器"),
        ("Tab", "关闭菜单，焦点回到触发器"),
    ])">
        菜单遵循 WAI-ARIA 的 Menu Button 模式：触发器是 <Code>aria-haspopup="menu"</Code> 的按钮，菜单里的项用方向键移动，不在 Tab 顺序里。
    </KeyboardReference>
    <ApiReference Types="[typeof(MenuItem), typeof(Menu), typeof(MenuRadioGroup), typeof(MenuRadioItem)]" />
</DocPage>
