@inherits RuneComponent
@using System.ComponentModel.DataAnnotations

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" Sx="FormWidth">
    <NumberField @bind-Value="price" Step="0.01m" Format="N2" aria-label="单价">
        <Prefix>¥</Prefix>
    </NumberField>
    <TextSpan Tone="TextTone.Muted" Size="Size.Sm" data-testid="price">单价：@(price?.ToString("N2") ?? "（空）")（decimal，步长 0.01，没有浮点误差）</TextSpan>
    <RadioGroup @bind-Value="plan" aria-label="套餐">
        <Radio Value="Plan.Free">免费版</Radio>
        <Radio Value="Plan.Pro">专业版</Radio>
        <Radio Value="Plan.Team">团队版</Radio>
    </RadioGroup>
    <TextSpan Tone="TextTone.Muted" Size="Size.Sm">套餐：@plan（枚举值）</TextSpan>
    <Slider @bind-Value="volume" aria-label="音量" />
    <TextSpan Tone="TextTone.Muted" Size="Size.Sm">音量：@volume（拖动中实时写回）</TextSpan>
</Flex>

@code {
    decimal? price = 9.9m;

    Plan plan = Plan.Pro;

    int volume = 40;

    enum Plan { Free, Pro, Team }

    static Style FormWidth => Css.Define(static () => new Style { MaxWidth = 420 });
}
