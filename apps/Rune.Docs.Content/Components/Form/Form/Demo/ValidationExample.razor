@inherits RuneComponent
@using System.ComponentModel.DataAnnotations

<Form Model="model" OnValidSubmit="SubmitAsync" Sx="FormWidth" data-testid="signup">
    <Field Label="姓名" Required="true">
        <TextField @bind-Value="model.Name" placeholder="张三" autocomplete="name" data-testid="name" />
    </Field>
    <Field Label="邮箱" Description="用于找回密码" Required="true">
        <TextField @bind-Value="model.Email" Type="email" Icon="Lucide.Mail" placeholder="name@example.com" data-testid="email" />
    </Field>
    <Field Label="数量" Description="1–99，按 ↑↓ 加减">
        <NumberField @bind-Value="model.Quantity" Min="1" Max="99" data-testid="quantity" />
    </Field>
    <Field Label="配送方式" Required="true">
        <RadioGroup @bind-Value="model.Shipping" Orientation="Orientation.Horizontal" data-testid="shipping">
            <Radio Value="@("express")">快递</Radio>
            <Radio Value="@("pickup")">自提</Radio>
            <Radio Value="@("same-day")" Disabled="true">当日达（暂停）</Radio>
        </RadioGroup>
    </Field>
    <Field Label="城市" Required="true">
        <NativeSelect @bind-Value="model.City" Items="cities" Placeholder="选择城市" data-testid="city" />
    </Field>
    <Field Label="预算" Description="@($"{model.Budget:N0} 元")">
        <Slider @bind-Value="model.Budget" Min="0" Max="5000" Step="100" ValueText="@(v => $"{v:N0} 元")" />
    </Field>
    <Field Label="个人简介" Description="最多 60 个字">
        <Textarea @bind-Value="model.Bio" placeholder="一句话介绍自己" data-testid="bio" />
    </Field>
    <Field>
        <Checkbox @bind-Value="model.Agreed" data-testid="agree">我已阅读并同意服务条款</Checkbox>
    </Field>
    <Switch @bind-Value="model.Notify">有新消息时通知我</Switch>
    <Flex Gap="SpaceScale.Sm" Align="ItemAlign.Center">
        <Button Type="submit" data-testid="submit">注册（模拟保存 1 秒）</Button>
        <TextSpan Tone="TextTone.Muted" Size="Size.Sm" data-testid="result">@result</TextSpan>
    </Flex>
</Form>

@code {
    readonly SignupModel model = new();

    string result = "";

    static readonly string[] cities = ["北京", "上海", "广州", "深圳"];

    async Task SubmitAsync()
    {
        await Task.Delay(1000);
        result = $"已提交：{model.Name} <{model.Email}>，{model.Quantity} 件，{model.Shipping}，{model.City}，预算 {model.Budget:N0} 元";
    }

    static Style FormWidth => Css.Define(static () => new Style { MaxWidth = 420 });

    sealed class SignupModel
    {
        [Required(ErrorMessage = "请填写姓名")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "请填写邮箱")]
        [EmailAddress(ErrorMessage = "邮箱格式不对")]
        public string? Email { get; set; }

        [MaxLength(60, ErrorMessage = "最多 60 个字")]
        public string? Bio { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "请先同意服务条款")]
        public bool Agreed { get; set; }

        public bool Notify { get; set; } = true;

        [Range(1, 99, ErrorMessage = "数量在 1–99 之间")]
        public int? Quantity { get; set; } = 1;

        [Required(ErrorMessage = "请选择配送方式")]
        public string? Shipping { get; set; }

        [Required(ErrorMessage = "请选择城市")]
        public string? City { get; set; }

        public double Budget { get; set; } = 1000;
    }
}
