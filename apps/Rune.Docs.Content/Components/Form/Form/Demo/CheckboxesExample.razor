@inherits RuneComponent
@using System.ComponentModel.DataAnnotations

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
    <Checkbox Value="AllSelected" Indeterminate="SomeSelected" ValueChanged="SelectAll" data-testid="select-all">全选</Checkbox>
    @foreach (var fruit in fruits)
    {
        <Checkbox @key="fruit" Value="selected.Contains(fruit)" ValueChanged="@(on => Toggle(fruit, on))" Sx="Indent">@fruit</Checkbox>
    }
    <Checkbox Disabled="true">不可用</Checkbox>
</Flex>

@code {
    static readonly string[] fruits = ["苹果", "香蕉", "橙子"];

    readonly HashSet<string> selected = ["苹果"];

    bool AllSelected => selected.Count == fruits.Length;

    bool SomeSelected => selected.Count > 0 && !AllSelected;

    void SelectAll(bool on)
    {
        selected.Clear();
        if (on) selected.UnionWith(fruits);
    }

    void Toggle(string fruit, bool on)
    {
        if (on) selected.Add(fruit);
        else selected.Remove(fruit);
    }

    static Style Indent => Css.Define(static () => new Style { MarginInlineStart = Space.Lg });
}
