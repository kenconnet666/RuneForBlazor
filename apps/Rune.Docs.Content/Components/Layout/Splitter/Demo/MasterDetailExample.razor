@* 左列表、右详情：拖分隔条调比例（双击回到初始比例），右栏可以收起 *@
@inherits RuneComponent

<Splitter Sx="Frame" @bind-Size="size" Collapsible="SplitterSide.End" @bind-Collapsed="hidden">
    <StartContent>
        <ItemList Inset="SpaceScale.Md" aria-label="消息">
            @foreach (var mail in mails)
            {
                <ItemListItem @key="mail.Id" Title="@mail.Title" Description="@mail.From" Selected="mail.Id == current" OnSelect="() => current = mail.Id" />
            }
        </ItemList>
    </StartContent>
    <EndContent>
        @{ var selected = mails.First(m => m.Id == current); }
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm" Sx="Detail">
            <TextSpan Weight="Weight.Semibold">@selected.Title</TextSpan>
            <Small Tone="TextTone.Muted">来自 @selected.From</Small>
            <TextSpan Size="Size.Sm">@selected.Body</TextSpan>
        </Flex>
    </EndContent>
</Splitter>

@code {
    static readonly (int Id, string From, string Title, string Body)[] mails =
    [
        (1, "财务部", "费用核算待复核", "测算参数与报价不一致，请复核材料单价。"),
        (2, "PMO", "派单：机柜导轨第二供应商", "请在 5 个工作日内完成方案设计。"),
        (3, "财务", "结算超 30 天提醒", "显示器支架的结算已经 32 天。"),
    ];

    double size = 40;
    bool hidden;
    int current = 1;

    static Style Frame => Css.Define(static () => new Style
    {
        Height = CssLength.Rem(16),
        BorderWidth = BorderWidths.Xs,
        BorderStyle = BorderStyle.Solid,
        BorderColor = Colors.Border,
        BorderRadius = Radii.Md,
    });

    static Style Detail => Css.Define(static () => new Style { Padding = Space.Md });
}
