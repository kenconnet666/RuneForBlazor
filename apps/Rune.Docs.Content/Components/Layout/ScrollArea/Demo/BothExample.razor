@inherits RuneComponent

@* 两个方向都能滚的明细表：Table 外层本来就是 ScrollArea，PropsRoot 改成两个方向、限高；表头吸顶（StickyHeader），行号固定在起始边（Sticky），滚到哪都看得到 *@
<Table aria-label="销售明细表" Density="TableDensity.Compact" StickyHeader="true" PropsRoot="SheetArea">
    <TableHead>
        <TableRow>
            <TableHeaderCell Sticky="true" Width="CssLength.Rem(3)"><VisuallyHidden>行号</VisuallyHidden></TableHeaderCell>
            @foreach (var column in columns)
            {
                <TableHeaderCell @key="column" Align="TableAlign.Center" Width="CssLength.Rem(5.5)">@column</TableHeaderCell>
            }
        </TableRow>
    </TableHead>
    <TableBody>
        @foreach (var row in rows)
        {
            <TableRow @key="row">
                <TableHeaderCell Scope="row" Sticky="true">@row</TableHeaderCell>
                @for (var index = 0; index < columns.Length; index++)
                {
                    var value = CellValue(row, index);
                    <TableCell Align="TableAlign.End" NoWrap="true">@value.ToString("0.00")</TableCell>
                }
            </TableRow>
        }
    </TableBody>
</Table>

@code {
    static readonly string[] columns = [.. Enumerable.Range(0, 14).Select(i => ((char)('A' + i)).ToString())];

    static readonly int[] rows = [.. Enumerable.Range(1, 30)];

    static readonly Attrs SheetArea = new() { ["Axis"] = ScrollAxis.Both, Sx = Area };

    static double CellValue(int row, int column) => (row * 7919 + column * 104_729) % 100_000 / 100.0;

    static Style Area => Css.Define(static () => new Style { Height = CssLength.Rem(18) });
}
