@inherits RuneComponent

@* 文件列表的“新建”速拨：点主按钮展开三种新建方式，选了一种就收起 *@
<Card Padding="SpaceScale.Sm" style="contain: layout; min-height: 20rem">
    <ItemList>
        @foreach (var name in files)
        {
            <ItemListItem @key="name" Title="@name" />
        }
    </ItemList>
    <Small Tone="TextTone.Muted" style="display: block; padding: 0.5em 0.75em">共 @files.Count 个文件</Small>
    <FloatButtonGroup Icon="Lucide.Plus" Label="新建" @bind-Open="open">
        @foreach (var (icon, label, prefix) in actions)
        {
            <FloatButton @key="label" Icon="icon" Label="@label" Size="Size.Md" @onclick="() => Add(prefix)" />
        }
    </FloatButtonGroup>
</Card>

@code {
    static readonly (IconData Icon, string Label, string Prefix)[] actions =
    [
        (Lucide.FileText, "新建文档", "未命名文档"),
        (Lucide.FileSpreadsheet, "新建表格", "未命名表格"),
        (Lucide.Upload, "上传文件", "未命名文件"),
    ];

    readonly List<string> files = ["季度经营分析.docx", "供应商名录.xlsx", "产品路线图.pdf"];

    bool open;

    void Add(string prefix)
    {
        files.Add($"{prefix} {files.Count + 1}");
        open = false;
    }
}
