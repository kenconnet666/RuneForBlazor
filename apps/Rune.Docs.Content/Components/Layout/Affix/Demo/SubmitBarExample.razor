@* 长表单底部的提交栏：OffsetBottom 贴在滚动面板的底边，滚到表单末尾时回到原位；
   还压着下面的内容时（data-stuck）有阴影，到底了阴影消失——看得出下面还有没有内容 *@
@inherits RuneComponent

<Card Padding="SpaceScale.None" style="overflow: hidden">
    <ScrollArea style="height: 20rem" PropsViewport="@(new Attrs { Id = PanelId })">
        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md" style="padding: 0.75em">
            @foreach (var label in fields)
            {
                <Field @key="label" Label="@label"><TextField /></Field>
            }
            <Field Label="备注"><Textarea Rows="3" /></Field>
            <Affix Target="@PanelId" OffsetBottom="0" OnChange="next => stuck = next">
                <Card Padding="SpaceScale.Sm">
                    <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Sm" Wrap="true">
                        <Small Tone="TextTone.Muted" aria-live="polite">@(saved ? "已保存" : stuck ? "下面还有内容，往下滚" : "到底了")</Small>
                        <Flex Gap="SpaceScale.Xs">
                            <Button Size="Size.Sm" Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" @onclick="() => saved = false">取消</Button>
                            <Button Size="Size.Sm" @onclick="() => saved = true">保存</Button>
                        </Flex>
                    </Flex>
                </Card>
            </Affix>
        </Flex>
    </ScrollArea>
</Card>

@code {
    const string PanelId = "affix-submit-panel";
    static readonly string[] fields = ["供应商名称", "统一社会信用代码", "开户银行", "银行账号", "联系人", "联系电话", "收货地址", "发票抬头"];

    bool stuck;
    bool saved;
}
