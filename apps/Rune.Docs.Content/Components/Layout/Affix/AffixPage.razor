@page "/components/affix"
@attribute [DocMeta("Affix 固钉与回到顶部", "滚动时贴住视口顶部或底部的操作条（Affix），长页面滚下去后出现的回到顶部按钮（BackTop）。", DocCategory.Layout, Order = 10)]
@inherits DocPageBase
@using Rune.Docs.Components.Layout.Affix.Demo

<DocPage Meta="Meta">
    <Example Id="affix" Title="滚动面板里的操作条" Demo="typeof(ToolbarExample)">
        <Code>Affix</Code> 用 CSS 的 <Code>position: sticky</Code>：在所在的那一层里贴住，不脱离文档流（不用占位、不用量宽度），那一层滚出去时跟着走。
        <Code>OffsetTop</Code> 是贴住时离顶部多远（整页时让开顶栏），<Code>OffsetBottom</Code> 贴在底部（表单的提交栏）。
        祖先里有 overflow 不是 visible 的元素（这里的示例面板）时，sticky 相对它贴住，把它的 id 写进 <Code>Target</Code>。
        是否贴住由 JS 的 IntersectionObserver 看一个零高度的哨兵：贴住时加阴影、写 data-stuck；给了 <Code>OnChange</Code> 才把变化报给 C#。
        <Code>BackTop</Code> 在整页（或 <Code>Target</Code> 给的容器）滚过 <Code>Threshold</Code> 后出现在右下角，点了平滑滚回顶部（减少动态效果时直接跳回），
        焦点也回到开头；出现与滚回都在浏览器里，滚动时没有往返。它是一个 FloatButton，可以和客服、反馈按钮一起放进 FloatButtonGroup。
    </Example>
    <Example Id="bottom" Title="贴在底部的提交栏" Demo="typeof(SubmitBarExample)">
        <Code>OffsetBottom</Code> 把它贴在底边：长表单的保存、提交一直够得着，滚到表单末尾时回到原来的位置。还压着下面的内容时有阴影（<Code>Shadow="false"</Code> 关掉）、
        写 data-stuck，<Code>OnChange</Code> 报告贴住与离开——这里用它提示下面还有没有内容。
    </Example>
    <ApiReference Types="[typeof(Affix), typeof(BackTop)]" />
</DocPage>
