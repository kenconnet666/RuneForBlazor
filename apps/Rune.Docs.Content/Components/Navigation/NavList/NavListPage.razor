@page "/components/nav-list"
@attribute [DocMeta("NavList 导航菜单", "侧栏里的导航链接（NavList：NavItem、可展开的 NavGroup、带小标题的 NavSection）、按菜单数据渲染的 NavMenu、顶栏一行的 NavBar；TableOfContents 是本页目录，SkipLink 是跳到正文的链接。", DocCategory.Navigation, Order = 4)]
@inherits DocPageBase
@using Rune.Docs.Components.Navigation.NavList.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="groups" Title="后台导航" Demo="typeof(GroupsExample)">
                当前页按地址判断（也可以用 <Code>Active</Code> 指定），带 aria-current="page" 与高亮；含当前页的 NavGroup 自动展开。<Code>End</Code> 放计数之类的尾部内容。<Code>Match="NavLinkMatch.Prefix"</Code> 让 /orders 在 /orders/42 也高亮（同 Blazor 的 NavLink）。
            </Example>
            <Example Id="compact" Title="窄侧栏：只显示图标" Demo="typeof(CompactExample)">
                <Code>Compact</Code> 时各项只剩图标，名称留给读屏、悬停或聚焦时用提示显示；NavSection 的 <Code>Icon</Code> 是小节标题前的标记（不能点），紧凑时代替标题。紧凑时 NavGroup 只剩图标，悬停、聚焦时子项从右边弹出来（完整的文字，Tab 进入），组里有当前页时图标高亮；NavItem 的 <Code>Badge</Code> 是计数角标，展开时在文字后面，紧凑时叠在图标上。
            </Example>
            <Example Id="menu" Title="按菜单数据渲染：NavMenu" Demo="typeof(MenuExample)">
                <Code>Items</Code> 的字段同 <TextLink Href="components/nav-list#nav-bar">NavBar</TextLink> 的项（<Code>NavMenuItem</Code>：Label、Href、Icon、Badge、Disabled、Children），
                同一份菜单数据可以同时给顶部的 NavBar 和侧栏的 NavMenu。有 <Code>Children</Code> 的项是一组：顶层的默认是带小标题、一直展开的小节，
                <Code>TopLevel="NavMenuTopLevel.Group"</Code> 改成可收起的分组；更深的层级都是分组，含当前页的组自动展开。没有 <Code>Href</Code> 又没有可显示子项的目录不画，
                后端返回的目录下没有该用户能看的页面时，目录自然消失。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="sections" Title="文档站导航" Demo="typeof(SectionsExample)">
                NavSection 是带小标题、不能收起的一组：链接多、按主题分组的侧栏。<Code>Disabled</Code> 的项不能点、不能聚焦，<Code>End</Code> 放在项的末尾（计数、标记）。
            </Example>
            <Example Id="toc" Title="本页目录" Demo="typeof(TocExample)">
                TableOfContents 列出各节标题，滚动时高亮正在读的一节，指示条滑过去；当前节带 aria-current="location"。目录项写成 <Code>HeadingEntry</Code>（id、文字、级别）。正文在自己的滚动区域里时给 <Code>ScrollRoot</Code>（滚动容器的 id）。
            </Example>
            <Example Id="nav-bar" Title="顶栏一行：NavBar" Demo="typeof(NavBarExample)">
                <Code>Items</Code> 里有 <Code>Href</Code> 的是链接，有 <Code>Children</Code> 的是下拉菜单（Menu，菜单项是链接）。当前页按地址判断（同 <TextLink Href="components/nav-list">NavList</TextLink>），
                链接带 aria-current 与下划线，子项是当前页时它的下拉按钮也高亮；<Code>Badge</Code> 是计数角标。放不下时后面的项收进“更多”菜单（有子项的按分组列出），
                藏起来的项不占位、读屏与 Tab 都跳过。菜单数据同 <TextLink Href="components/nav-list#menu">NavMenu</TextLink>（<Code>NavMenuItem</Code>）。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(NavGroup), typeof(NavItem), typeof(NavList), typeof(NavSection), typeof(SkipLink), typeof(TableOfContents), typeof(NavMenu), typeof(NavBar)]" />
</DocPage>
