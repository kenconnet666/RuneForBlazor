@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Small Tone="TextTone.Muted">Href：渲染为链接，可以分享、可以被收录</Small>
        <Pagination aria-label="文章分页" Page="3" PageCount="12" Href="@(page => $"components/pagination#articles-page-{page}")" />
    </Flex>
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Small Tone="TextTone.Muted">Pager：文章末尾的上一篇 / 下一篇</Small>
        <Pager aria-label="文章翻页" Previous="@(new("components/tabs", "Tabs 标签页"))" Next="@(new("components/toolbar", "Toolbar 工具栏"))" data-testid="pager" />
    </Flex>
</Flex>
