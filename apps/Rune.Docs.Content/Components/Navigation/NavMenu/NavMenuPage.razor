@page "/components/nav-menu"
@attribute [DocMeta("NavMenu 菜单导航", "数据驱动的侧边导航：菜单是一棵树（后端按角色返回、或配置里写的），交给 NavMenu 渲染成小节、分组和链接。", DocCategory.Navigation, Order = 5)]
@inherits DocPageBase
@using Rune.Docs.Components.Navigation.NavMenu.Demo

<DocPage Meta="Meta">
    <Example Id="tree" Title="菜单树" Demo="typeof(TreeExample)">
        <Code>Items</Code> 的字段同 <TextLink Href="components/nav-bar">NavBar</TextLink> 的项（<Code>NavMenuItem</Code>：Label、Href、Icon、Badge、Disabled、Children），
        同一份菜单数据可以同时给顶部的 NavBar 和侧栏的 NavMenu。有 <Code>Children</Code> 的项是一组：顶层的默认是带小标题、一直展开的小节，
        <Code>TopLevel="NavMenuTopLevel.Group"</Code> 改成可收起的分组；更深的层级都是分组，含当前页的组自动展开。没有 <Code>Href</Code> 又没有可显示子项的目录不画，
        后端返回的目录下没有该用户能看的页面时，目录自然消失。
    </Example>
    <ApiReference Types="[typeof(NavMenu)]" />
</DocPage>
