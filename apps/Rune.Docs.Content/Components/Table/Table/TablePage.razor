@page "/components/table"
@attribute [DocMeta("Table 表格", "静态表格：原生 table 的各个元素各一个组件，内容直接写在 JSX 里（说明文字里的表格、对比表、明细）；ColumnTable 按列定义渲染、可以合并单元格。要排序、勾选、虚拟滚动的用 DataTable。", DocCategory.Table, Order = 1)]
@inherits DocPageBase
@using Rune.Docs.Components.Table.Table.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="plans" Title="套餐对比" Demo="typeof(PlansExample)">
                行标题用 <Code>TableHeaderCell Scope="row"</Code>，读屏念单元格时会带上行名与列名。只用图标表达的值（勾与叉）旁边放一份隐藏文字。<Code>TableCaption</Code> 是表格的标题。外层限了高度时 <Code>StickyHeader</Code> 让表头吸顶，单元格的 <Code>Sticky</Code> 把第一列固定在起始边（见 ScrollArea 页的明细表）。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="invoice" Title="报价明细" Demo="typeof(InvoiceExample)">
                <Code>Density</Code> 三档行高、<Code>Striped</Code> 斑马纹，<Code>TableVariant.Ghost</Code> 去掉外框（放在卡片、对话框里）；数字列 <Code>Align="TableAlign.End"</Code> 右对齐、<Code>NoWrap</Code> 不换行；合计放在 <Code>TableFoot</Code>。
            </Example>
        </ExampleColumn>
    </Examples>
    <Example Id="column-table" Title="列定义与合并单元格：询价比价单" Demo="typeof(QuotesExample)">
        <Code>ColumnTable</Code> 按列渲染静态表格：列与 DataTable 相同（<Code>PropertyColumn</Code>、<Code>StatusColumn</Code>、<Code>TemplateColumn</Code>；
        <Code>Type</Code>、<Code>Format</Code>、<Code>EmptyText</Code>、<Code>Summary</Code>），不虚拟滚动、列宽按内容，适合详情页的明细、打印与导出预览。
        <Code>MergeRepeated</Code> 写列的 key：这几列里上下相邻、值相同的格合成一格，后一列只在前一列的同一格里合并（不同供应商下的同名品类不合）；
        <Code>CellSpan</Code> 更灵活，返回 <Code>CellSpan(RowSpan, ColSpan)</Code>，被合并掉的格返回 0（同 Ant Design 的 onCell）——这里没报价的行把“单价”“小计”合成一格写原因。
    </Example>
    <ApiReference Types="[typeof(TableCell), typeof(TableHeaderCell), typeof(Table), typeof(ColumnTable<>)]" />
</DocPage>
