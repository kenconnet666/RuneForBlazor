@inherits RuneComponent

@* 滚动加载：OnRangeChange 报告可见行的范围，离末尾不到 10 行时取下一页；取的时候 Loading，骨架接在末尾。EstimateRowHeight 是行高的估计 *@
<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
    <DataTable Items="rows" GetKey="e => e.Id.ToString()" Loading="loading" EstimateRowHeight="44" OnRangeChange="OnRangeChangeAsync"
               aria-label="事件流" PropsRoot="TableHeight">
        <PropertyColumn Property="e => e.Id" Title="#" Width="64" />
        <PropertyColumn Property="e => e.At" Title="时间" Width="80" />
        <PropertyColumn Property="e => e.Message" Title="事件" Width="280" Wrap="true" />
    </DataTable>
    <Small Tone="TextTone.Muted">已加载 @rows.Count / @Total 条</Small>
</Flex>

@code {
    sealed record LogEvent(int Id, string At, string Message);

    const int Page = 40;
    const int Total = 400;
    static readonly string[] Messages = ["用户登录成功", "导出报表：2026 年 9 月销售明细（含退款与优惠券核销）", "支付回调重试第 2 次", "库存同步完成"];

    static Attrs TableHeight => new() { Sx = Css.Define(static () => new Style { Height = CssLength.Rem(18) }) };

    IReadOnlyList<LogEvent> rows = [];
    bool loading;

    protected override Task OnInitializedAsync() => LoadMoreAsync();

    // 模拟接口：第 page 页的事件，400ms 后返回
    static async Task<IReadOnlyList<LogEvent>> FetchPageAsync(int page)
    {
        await Task.Delay(400);
        return [.. Enumerable.Range(0, Page).Select(index =>
        {
            var id = page * Page + index + 1;
            return new LogEvent(id, $"10:{id % 60:D2}", Messages[id % Messages.Length]);
        })];
    }

    async Task LoadMoreAsync()
    {
        if (loading || rows.Count >= Total) return;
        loading = true;
        StateHasChanged();
        rows = [.. rows, .. await FetchPageAsync(rows.Count / Page)];
        loading = false;
    }

    Task OnRangeChangeAsync(VisibleRange range) => range.EndIndex >= rows.Count - 10 ? LoadMoreAsync() : Task.CompletedTask;
}
