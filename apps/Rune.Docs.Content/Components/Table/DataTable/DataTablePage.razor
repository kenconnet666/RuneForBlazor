@page "/components/data-table"
@attribute [DocMeta("DataTable 数据表格", "按列渲染一组行：虚拟滚动、排序、勾选、固定列、合计、加载与空状态。", DocCategory.Table, Order = 2)]
@inherits DocPageBase
@using Rune.Docs.Components.Table.DataTable.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="orders" Title="一万条订单" Demo="typeof(OrdersExample)">
        列用子组件声明：<Code>PropertyColumn</Code> 取一个属性（key 是属性路径，标题取 <Code>[Display]</Code>），<Code>TemplateColumn</Code> 自己写内容（要排序时给 <Code>Value</Code>）。
        <Code>Type</Code> 决定默认的格式与对齐（Number、Currency、Percent、FileSize、Date、DateTime，跟随语言；不写时按第一个值推断，数字靠结束边）。
        点可排序的列标题在正序、倒序、不排之间切换（本地按数字、日期、按语言的文字排，<Code>ManualSort</Code> 时交给服务端）；
        <Code>SelectionMode.Multiple</Code> 多一列勾选框；<Code>Sticky</Code> 的列横向滚动时固定在两侧。工具栏（搜索、批量操作、分页）用现有组件组合，不内置。
    </Example>
    <Example Id="columns" Title="采购单：表头筛选、多列排序与列菜单" Demo="typeof(ColumnsExample)">
        列写 <Code>Filter</Code> 时列标题上有筛选按钮：<Code>ColumnFilterKind.Values</Code> 列出这一列出现过的值（状态列按阶段顺序、显示状态名），也可以给 <Code>FilterOptions</Code>；
        <Code>ColumnFilterKind.Keyword</Code> 是输入关键字。<Code>Filters</Code> 双向绑定各列选中的值，默认在本地筛，<Code>ManualFilter</Code> 时交给服务端。
        <Code>MultiSort</Code> 时点列标题只按这一列排，按住 Shift 点是追加一列（列标题上标着次序），排序写在 <Code>Sorts</Code>。
        <Code>ColumnMenu</Code> 在列标题结尾放 ⋮：排序、固定在开头 / 结尾、前后移动、隐藏，写回 <Code>ColumnPins</Code>、<Code>ColumnOrder</Code>、<Code>HiddenColumns</Code>；
        <Code>Resizable</Code> 时可以拖动或用键盘调整列宽，写回 <Code>ColumnWidths</Code>。这几项都能双向绑定、存进各人的设置。
    </Example>
    <Example Id="editable" Title="采购申请明细：就地编辑与校验" Demo="typeof(EditableExample)">
        列写 <Code>Editable</Code>（或按行判断的 <Code>IsEditable</Code>）时可以就地编辑，表格随之变成网格（role="grid"）：方向键在格之间走，只有一格能 Tab 进入；
        在可编辑的格上按 Enter、F2、双击或直接打字开始编辑，Enter 提交、Tab 提交并到下一个可编辑的格、点开别处提交、Esc 放弃。
        默认编辑器按值类型选（状态列是 Select，数字是 NumberField，文字是 TextField），<Code>Editor</Code> 自己写（这里的交期用日期输入框）。
        列的 <Code>Validate</Code> 拦下不合理的值，<Code>OnCellChange</Code> 写回，不接受时（接口拒绝）调用 <Code>Reject</Code>，编辑器留着并显示原因；
        <Code>ValidateRow</Code> 返回整行的问题，标在对应的格上（红框，悬停与读屏都能知道原因）。<Code>EditTrigger.Click</Code> 时单击就进入编辑。
    </Example>
    <Example Id="reorder" Title="需求排期：拖动行" Demo="typeof(PriorityExample)">
        给了 <Code>OnReorder</Code> 时第一个数据列前面有把手：按下拖动，或聚焦后空格拿起、↑↓ 移动、空格放下（每一步读屏都会播报），拖完拿到新的顺序。
        排序、筛选时显示的顺序不是数据的顺序，把手收起，取消后又能拖。
    </Example>
    <Example Id="changes" Title="采购方案调整：分组表头" Demo="typeof(ChangesExample)">
        列写 <Code>Group</Code>（组标题）时，相邻、同组的几列上方共用一个标题，表头变成两行，没分组的列跨两行；组与相邻的列之间有竖线，固定列照常固定。
        排序、列宽、隐藏都按列算，组里的列全隐藏时这一组也不显示。<Code>PropsCellFor</Code> 按行与列给单元格加属性（节省是负数时标红）。
    </Example>
    <Example Id="details" Title="供应商改进建议：展开行" Demo="typeof(ProposalsExample)">
        <Code>DetailContent</Code> 给出一行的详情：多一列展开按钮（aria-expanded，aria-controls 指向详情），展开的行下面多一行跨全部列的详情，
        虚拟滚动按真实高度测量；<Code>HasDetail</Code> 决定哪些行能展开，<Code>ExpandedRows</Code> 可以双向绑定。详情横向滚动时贴着可见区域的起始边，宽度不超过可见区域。
    </Example>
    <Example Id="locate" Title="定位到行" Demo="typeof(LocateExample)">
        用 <Code>@@ref</Code> 拿到表格后调用 <Code>ScrollToRow(key, align)</Code>：虚拟滚动里还没渲染的行也能滚到，停在吸顶表头之下、吸底合计行之上
        （<Code>ScrollAlign</Code> 同 VirtualList，默认已完整可见就不动）；找不到这一行时返回 false。滚到之后用 <Code>RowTone</Code> 闪一下，方便从通知、搜索结果跳过来时找到它。
    </Example>
    <Example Id="master-detail" Title="主从视图：点一行看详情" Demo="typeof(MasterDetailExample)">
        <Code>OnRowClick</Code> 点一行（点在按钮、链接、输入框上的除外）在旁边打开详情，<Code>ActiveKey</Code> 高亮正在看的那一行（起始边一条竖线，带 aria-current）。
        整行点击只是鼠标的捷径：行里还要有键盘能到的入口，这里编号是按钮。配 Splitter 做成可拖动的左右两栏。
    </Example>
    <Examples>
        <ExampleColumn>
            <Example Id="import" Title="导入校验" Demo="typeof(ImportExample)">
                <Code>RowTone</Code> 给整行着色：错误行浅红、提醒行浅黄，底色不透明，固定列也盖得住；配合 <Code>IsRowSelectable</Code> 只让没有错误的行能勾选，全选也跳过它们。
            </Example>
            <Example Id="states" Title="加载、空状态与密度" Demo="typeof(StatesExample)">
                只用骨架行：<Code>Loading</Code> 时表体换成骨架（首次加载、刷新），表格带 aria-busy；没有数据时显示 <Code>Empty</Code>（默认是语言包的“暂无数据”）。
                <Code>Density</Code> 三档行高，<Code>TableVariant.Ghost</Code> 去掉外框，<Code>Striped</Code> 斑马纹。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="pick" Title="单选" Demo="typeof(PickExample)">
                <Code>SelectionMode.Single</Code> 时每行是同一组的单选框：方向键在行之间移动并选中，选中的行整行高亮；没有全选，这一列的标题只给读屏。
            </Example>
            <Example Id="infinite" Title="滚动加载" Demo="typeof(InfiniteExample)">
                <Code>OnRangeChange</Code> 报告可见行的范围，接近末尾时取下一页；取的时候 <Code>Loading</Code>，已有数据时骨架接在末尾（不换掉表体、不丢滚动位置）。
                <Code>EstimateRowHeight</Code> 是行高的估计，渲染后按实际高度测量。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(DataTable<>), typeof(PropertyColumn<,>), typeof(StatusColumn<,>), typeof(TemplateColumn<>)]" />
</DocPage>
