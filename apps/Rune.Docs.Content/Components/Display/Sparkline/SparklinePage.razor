@page "/components/sparkline"
@attribute [DocMeta("Sparkline 迷你图", "没有坐标轴的小折线、面积或柱：嵌在指标卡、表格的格子、列表的一行里看走势。纯 SVG，不依赖图表库。", DocCategory.Display, Order = 12)]
@inherits DocPageBase
@using Rune.Docs.Components.Display.Sparkline.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="cards" Title="指标卡里" Demo="typeof(CardsExample)">
        放进 Stat 的子内容：占满数值下面的一行。<Code>Type</Code> 是 <Code>Line</Code>（默认）、<Code>Area</Code>（下面填一层浅色）或 <Code>Bar</Code>
        （每个值一根柱，从 0 起），<Code>Tone</Code> 是色调。默认标出最后一个点（<Code>ShowLast</Code>）。读屏念成一句话：几个值、从哪到哪、最低最高，
        按 <Code>ValueFormat</Code> 格式化，<Code>Label</Code> 写在前面。SVG 由 C# 直接输出，静态 SSR 也一样。
    </Example>
    <Example Id="in-table" Title="表格里" Demo="typeof(InTableExample)">
        宽度占满容器，<Code>Height</Code> 默认 2em（随字号缩放），表格里配合行高调小。空值（<Code>null</Code>）处断开。
        <Code>Min</Code>、<Code>Max</Code> 固定纵向的范围（几行一起比较时用同一个范围）。
    </Example>
    <ApiReference Types="[typeof(Sparkline)]" />
</DocPage>
