@* 表格里的一列走势：每行一条迷你图，高度跟行高；有缺的月份时折线在这里断开。Tone 按走势选：单价降了是好事（Success），涨了标危险色 *@
@inherits RuneComponent

<ColumnTable Items="parts" GetKey="part => part.Code" aria-label="零件单价走势">
    <PropertyColumn Property="part => part.Code" Title="件号" Width="130" />
    <PropertyColumn Property="part => part.Name" Title="名称" />
    <PropertyColumn Property="part => part.Latest" Title="最新单价（元）" Type="ColumnType.Number" Format="OneDecimal" />
    <TemplateColumn Key="trend" Title="近 7 个月" Width="160" Context="part">
        <Sparkline Data="part.Prices" Tone="@(part.Latest <= part.First ? Tone.Success : Tone.Danger)" Height="CssLength.Em(1.5)" Label="@($"{part.Name}近 7 个月单价")" />
    </TemplateColumn>
</ColumnTable>

@code {
    sealed record Part(string Code, string Name, decimal?[] Prices)
    {
        public decimal First => Prices.First(price => price is not null)!.Value;
        public decimal Latest => Prices[^1]!.Value;
    }

    static readonly NumberFormat OneDecimal = new() { MinimumFractionDigits = 1, MaximumFractionDigits = 1 };

    static readonly Part[] parts =
    [
        new("SKU-21108", "显示器支架", [128.6m, 127.9m, 126.2m, 121.4m, 119.4m, 118.9m, 116.8m]),
        new("SKU-53214", "线束卡箍", [3.2m, 3.2m, 3.3m, null, 3.6m, 3.7m, 3.9m]),
        new("SKU-11802", "办公椅", [2150, 2120, 2080, 2075, 2060, 1990, 1985]),
        new("SKU-70431", "包装胶带", [86, 88, 85, 91, 89, 93, 95]),
    ];
}
