@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Switch @bind-Value="loading">加载中</Switch>
    <Grid MinItemWidth="@("12em")" Gap="SpaceScale.Md">
        <Card><Stat Label="项目总数" Value="6" Unit="项" Icon="Lucide.ClipboardList" Loading="loading" /></Card>
        <Card>
            <Stat Label="实际销售额" Value="910.36m" Format="TwoDecimals" Unit="万元" Icon="Lucide.JapaneseYen" Change="0.123m" ChangeLabel="较上月" Loading="loading" />
        </Card>
        <Card Loading="loading">
            <Header>本月说明</Header>
            <ChildContent>实际销售额按财务口径统计，每月 5 日更新上月数据。</ChildContent>
        </Card>
    </Grid>
</Flex>

@code {
    static readonly NumberFormat TwoDecimals = new() { MinimumFractionDigits = 2 };

    bool loading = true;
}
