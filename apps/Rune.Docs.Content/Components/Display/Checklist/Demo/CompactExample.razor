@* 紧凑的排法：表格的格子里用 Icons（只有一排状态图标，悬停与读屏有每一项的说明），详情行、卡片的一角用 Inline（一行排开、放不下换行） *@
@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
    <Table aria-label="项目">
        <TableHead>
            <TableRow>
                <TableHeaderCell>编号</TableHeaderCell>
                <TableHeaderCell>名称</TableHeaderCell>
                <TableHeaderCell>节点</TableHeaderCell>
            </TableRow>
        </TableHead>
        <TableBody>
            @foreach (var project in projects)
            {
                <TableRow @key="project.Code">
                    <TableCell>@project.Code</TableCell>
                    <TableCell>@project.Name</TableCell>
                    <TableCell><Checklist Layout="ChecklistLayout.Icons" Items="project.Nodes" /></TableCell>
                </TableRow>
            }
        </TableBody>
    </Table>
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
        <Small Tone="TextTone.Muted">PO-2026-0187 的实施节点</Small>
        <Checklist Layout="ChecklistLayout.Inline" Items="projects[0].Nodes" />
    </Flex>
</Flex>

@code {
    static ChecklistItem Node(string label, ChecklistStatus status, string? date = null) => new(label) { Status = status, Date = date };

    static readonly (string Code, string Name, ChecklistItem[] Nodes)[] projects =
    [
        ("PO-2026-0187", "官网首页改版", [Node("评审", ChecklistStatus.Done, "08-12"), Node("样品", ChecklistStatus.Done, "09-20"), Node("切换", ChecklistStatus.Overdue, "计划 10-15"), Node("关闭", ChecklistStatus.Todo)]),
        ("PO-2026-0203", "线缆收纳夹国产化", [Node("评审", ChecklistStatus.Done, "09-02"), Node("样品", ChecklistStatus.Todo, "计划 11-05"), Node("切换", ChecklistStatus.Todo), Node("关闭", ChecklistStatus.Todo)]),
        ("PO-2026-0211", "门店照明改造", [Node("评审", ChecklistStatus.Done, "07-30"), Node("样品", ChecklistStatus.Done, "08-28"), Node("切换", ChecklistStatus.Done, "09-30"), Node("关闭", ChecklistStatus.Blocked, "等财务复核")]),
    ];
}
