@* 运行日志：InfiniteList 一页页取，滚到最后几行时取下一页；第 3 页第一次会失败，列表下方出现“重试” *@
@inherits RuneComponent

<Card Padding="SpaceScale.None">
    <VirtualList Items="logs.Items" GetKey="e => e.Id" EstimateSize="32" Loading="logs.Loading" OnRangeChange="logs.OnRangeChange" aria-label="运行日志"
                 Sx="ListHeight" Context="entry" data-testid="feed">
        <Flex Gap="SpaceScale.Sm" Sx="Padded">
            <Small Tone="@LevelTones[entry.Level]" Sx="LevelWidth">@entry.Level</Small>
            <TextSpan Size="Size.Sm">@entry.Message</TextSpan>
        </Flex>
    </VirtualList>
    <InfiniteListStatus List="logs" />
    <Small Tone="TextTone.Muted" Sx="Padded">已加载 @logs.Count / @(Page * Pages) 条</Small>
</Card>

@code {
    sealed record Entry(int Id, string Level, string Message);

    static readonly string[] Levels = ["INFO", "WARN", "INFO", "ERROR", "INFO", "DEBUG"];
    static readonly Dictionary<string, TextTone> LevelTones = new() { ["DEBUG"] = TextTone.Muted, ["INFO"] = TextTone.Info, ["WARN"] = TextTone.Warning, ["ERROR"] = TextTone.Danger };
    static readonly string[] Messages =
    [
        "订单服务健康检查通过",
        "支付回调重试第 2 次",
        "缓存命中率 97.4%",
        "库存同步超时，已放入重试队列",
        "用户 1024 登录成功",
        "定时任务 report:daily 开始执行，预计耗时 3 分钟，完成后会把结果推送到运营群",
    ];

    static Style ListHeight => Css.Define(static () => new Style { Height = CssLength.Rem(22) });

    static Style Padded => Css.Define(static () => new Style { PaddingBlock = Space.Xs, PaddingInline = Space.Md });

    // 级别定宽，消息才对得齐
    static Style LevelWidth => Css.Define(static () => new Style { FlexShrink = 0, Width = CssLength.Em(3.5), FontFamily = Fonts.Mono });

    const int Page = 30;
    const int Pages = 5;

    InfiniteList<Entry, int> logs = default!;
    bool failed;

    protected override void OnInitialized() => logs = new(FetchLogsAsync, new() { Key = entry => entry.Id });

    // 假的日志接口：第 page 页（第一页时游标是 0），900 ms 后返回；第 3 页第一次失败
    async Task<InfinitePage<Entry, int>> FetchLogsAsync(int cursor, CancellationToken cancellation)
    {
        var page = cursor == 0 ? 1 : cursor;
        await Task.Delay(900, cancellation);
        if (page == 3 && !failed)
        {
            failed = true;
            throw new TimeoutException("网关超时");
        }
        var start = (page - 1) * Page;
        Entry[] items = [.. Enumerable.Range(start, Page).Select(index => new Entry(index, Levels[index % Levels.Length], Messages[index % Messages.Length]))];
        return new(items, page + 1, page < Pages);
    }
}
