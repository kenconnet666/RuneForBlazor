@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Lg" Wrap="true">
        <Indicator Count="unread" data-testid="unread">
            <IconButton Icon="Lucide.Bell" Variant="ButtonVariant.Surface" Label="通知" />
        </Indicator>
        <Indicator Count="120" Max="99" Tone="Tone.Accent">
            <IconButton Icon="Lucide.Inbox" Variant="ButtonVariant.Surface" Label="收件箱" />
        </Indicator>
        <Indicator Count="0" ShowZero="true" Tone="Tone.Neutral">
            <IconButton Icon="Lucide.ListTodo" Variant="ButtonVariant.Surface" Label="待办" />
        </Indicator>
        <Indicator Dot="true" Tone="Tone.Warning" Label="有新回复">
            <IconButton Icon="Lucide.MessageCircle" Variant="ButtonVariant.Surface" Label="评论" />
        </Indicator>
        <Button Size="Size.Sm" Variant="ButtonVariant.Soft" @onclick="() => unread++">来一条消息</Button>
        <Button Size="Size.Sm" Variant="ButtonVariant.Ghost" Disabled="unread == 0" @onclick="() => unread = 0">全部已读</Button>
    </Flex>
    <Flex Align="ItemAlign.Center" Gap="SpaceScale.Lg" Wrap="true">
        <TextSpan Size="Size.Xs" Tone="TextTone.Muted">在线状态</TextSpan>
        @for (var i = 0; i < 4; i++)
        {
            var index = i;
            var member = DemoPeople.Members[index];
            <Indicator @key="member.Name" Dot="true" Tone="@(index == 3 ? Tone.Neutral : index == 2 ? Tone.Warning : Tone.Success)"
                       Placement="IndicatorPlacement.BottomEnd" Overlap="IndicatorOverlap.Circular" Label="@(index == 3 ? "离线" : index == 2 ? "忙碌" : "在线")">
                <Avatar Size="Size.Lg" Name="@member.Name" Src="@member.Photo" />
            </Indicator>
        }
    </Flex>
</Flex>

@code {
    int unread = 8;
}
