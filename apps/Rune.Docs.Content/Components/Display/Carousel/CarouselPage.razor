@page "/components/carousel"
@attribute [DocMeta("Carousel 轮播", "横幅、商品图、图片组：原生横向滚动加吸附，上一张 / 下一张、页点、可关的自动播放；读屏按 WAI-ARIA 的轮播模式。", DocCategory.Display, Order = 8)]
@inherits DocPageBase
@using Rune.Docs.Components.Display.Carousel.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="drawings" Title="自动播放" Demo="typeof(DrawingsExample)">
                <Code>Items</Code> 与每一张的模板；滚动区域是原生横向滚动加 scroll-snap：触摸板、手指滑动、拖滚动条都是浏览器自己的。
                <Code>Autoplay</Code> 是换张的间隔：指针停在上面、焦点进到里面时暂停，底部有暂停 / 播放按钮；偏好减少动态效果时一开始就是暂停的。
                滚动、按钮、页点、自动播放都在浏览器里做（静态页面也能用），交互模式下换张后写回 <Code>Index</Code>。
            </Example>
            <Example Id="thumbnails" Title="缩略图" Demo="typeof(ThumbnailsExample)">
                <Code>@@bind-Index</Code> 是最前面那张的序号：外面改了就滚过去，滚动、按钮、页点也会写回。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="products" Title="一次看几张" Demo="typeof(ProductsExample)">
                <Code>SlidesPerView</Code> 一次看几张（可以是 2.5，露出下一张的一部分），<Code>Gap</Code> 是张与张之间的间距；
                <Code>Loop="false"</Code> 到头时那一侧的按钮不可用，<Code>Dots="false"</Code> 去掉页点。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="@([
        ("Tab", "进入滚动区域，再到上一张 / 下一张按钮与页点；焦点在里面时自动播放暂停"),
        ("← / →", "滚动区域聚焦时横向滚动，停下时吸附到整张"),
        ("Enter / Space", "按钮：换到上一张、下一张、那一页；暂停 / 继续自动播放"),
    ])">
        根元素是带名称的区域（aria-roledescription="carousel"），每张是 role="group"、名称“第 2 张，共 5 张”；不自动播放时换张会播报。
    </KeyboardReference>
    <ApiReference Types="[typeof(Carousel<>)]" />
</DocPage>
