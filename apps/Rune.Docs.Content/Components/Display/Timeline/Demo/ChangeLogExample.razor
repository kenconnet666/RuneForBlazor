@* 报价单的操作记录：新的在前，每项有操作人（头像或首字母）与时间，改了哪些字段用 FieldCompare 列在项里，完整的字段对比收在“查看详情”里。
   记录多，只显示最新的 4 条，其余在“展开其余 N 条”后面 *@
@inherits RuneComponent

<Card>
    <Timeline Items="items" Reverse="true" MaxVisible="4" @bind-Expanded="expanded" />
</Card>

@code {
    static readonly Quote V1 = new(86.5m, 2_000, 30, "华辰精密", "含税含运");
    static readonly Quote V2 = V1 with { UnitPrice = 82m, LeadDays = 25 };
    static readonly Quote V3 = V2 with { Quantity = 2_400, Remark = "含税含运，分两批交付" };
    static readonly Quote V4 = V3 with { UnitPrice = 79.8m, Supplier = "恒远五金" };

    readonly TimelineItem[] items;
    bool expanded;

    public ChangeLogExample()
    {
        items =
        [
            new("创建报价单") { Key = "1", Actor = "周宁", Time = "10-14 09:02", DateTime = "2026-10-14T09:02", Icon = Lucide.FilePlusCorner, Tone = Tone.Accent },
            Change(new("修改报价") { Key = "2", Actor = "周宁", Time = "10-14 15:40", DateTime = "2026-10-14T15:40", Icon = Lucide.Pencil }, V1, V2),
            new("提交审批") { Key = "3", Actor = "周宁", Time = "10-15 10:05", DateTime = "2026-10-15T10:05", Icon = Lucide.Send, Tone = Tone.Info },
            new("退回修改")
            {
                Key = "4", Actor = "陆川", Time = "10-16 11:20", DateTime = "2026-10-16T11:20", Icon = Lucide.Undo2, Tone = Tone.Warning,
                Description = "数量按 Q4 排产计划补到 2,400，备注写明分批交付",
            },
            Change(new("修改报价") { Key = "5", Actor = "周宁", Time = "10-16 16:48", DateTime = "2026-10-16T16:48", Icon = Lucide.Pencil }, V2, V3),
            Change(new("换供应商重新比价") { Key = "6", Actor = "方圆", Time = "10-18 09:30", DateTime = "2026-10-18T09:30", Icon = Lucide.Pencil }, V3, V4),
            new("审批通过") { Key = "7", Actor = "陆川", Time = "10-18 14:12", DateTime = "2026-10-18T14:12", Icon = Lucide.ShieldCheck, Tone = Tone.Success },
        ];
    }

    // 一次修改：项里列改了的字段，详情里是全部字段的对比表
    static TimelineItem Change(TimelineItem item, Quote before, Quote after) => item with
    {
        DescriptionContent = Compare(before, after, FieldCompareLayout.List, null),
        Details = Compare(before, after, FieldCompareLayout.Table, new Attrs { AriaLabel = "修改前后全部字段" }),
    };

    static RenderFragment Compare(Quote before, Quote after, FieldCompareLayout layout, Attrs? table) =>
        @<FieldCompare Before="before" After="after" Layout="layout" PropsTable="table">
            <PropertyColumn Property="q => q.UnitPrice" Title="单价" Type="ColumnType.Currency" Better="CompareBetter.Lower" />
            <PropertyColumn Property="q => q.Quantity" Title="数量" Type="ColumnType.Number" />
            <PropertyColumn Property="q => q.LeadDays" Title="交期（天）" Type="ColumnType.Number" Better="CompareBetter.Lower" />
            <PropertyColumn Property="q => q.Supplier" Title="供应商" />
            <PropertyColumn Property="q => q.Remark" Title="备注" />
        </FieldCompare>;

    sealed record Quote(decimal UnitPrice, int Quantity, int LeadDays, string Supplier, string Remark);
}
