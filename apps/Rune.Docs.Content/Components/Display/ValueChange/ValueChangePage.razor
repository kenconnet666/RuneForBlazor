@page "/components/value-change"
@attribute [DocMeta("ValueChange 值的变化", "一个值改了什么：原值划掉、箭头、新值；放在表格单元格、时间线、审批意见里。", DocCategory.Display, Order = 7)]
@inherits DocPageBase
@using Rune.Docs.Components.Display.ValueChange.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="log" Title="操作记录" Demo="typeof(LogExample)">
        <Code>Before</Code> 是原值，<Code>After</Code> 是新值；没有原值（新建）时只显示新值。原值是 del、新值是 ins，中间有给读屏的“改为”。
        要放组件（标记、链接）时用 <Code>BeforeContent</Code>、<Code>AfterContent</Code>。整份记录按字段对比用 <Code>FieldCompare</Code>，表格里标出改过的格见 DataTable 的“数据修正”。
    </Example>
    <ApiReference Types="[typeof(ValueChange)]" />
</DocPage>
