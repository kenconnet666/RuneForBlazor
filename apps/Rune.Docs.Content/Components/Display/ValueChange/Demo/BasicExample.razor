@* 报价单改了哪些字段：字段名一列、变化一列；状态用标记，新加的备注只有新值 *@
@inherits RuneComponent

<Descriptions Columns="1">
    <DescriptionsItem Label="单价"><ValueChange Before="¥86.50" After="¥82.00" /></DescriptionsItem>
    <DescriptionsItem Label="交期（天）"><ValueChange Before="30" After="25" /></DescriptionsItem>
    <DescriptionsItem Label="状态">
        <ValueChange>
            <BeforeContent><Badge Tone="Tone.Warning">待审批</Badge></BeforeContent>
            <AfterContent><Badge Tone="Tone.Success">已通过</Badge></AfterContent>
        </ValueChange>
    </DescriptionsItem>
    <DescriptionsItem Label="备注"><ValueChange After="分两批交付" /></DescriptionsItem>
</Descriptions>
