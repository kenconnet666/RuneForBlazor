@page "/components/date-field"
@attribute [DocMeta("DateField 日期输入框", "分段输入年、月、日（可选时、分、秒），不带弹层；知道确切日期时比翻日历快，生日、证件有效期。", DocCategory.Date, Order = 3)]
@inherits DocPageBase
@using Rune.Docs.Components.Date.DateField.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="basic" Title="基础用法" Demo="typeof(BasicExample)">
                每段单独聚焦、单独输入：打一个数字后再打一个就会超出范围时直接跳到下一段（月份打 <Kbd>3</Kbd> 就跳走，打 <Kbd>1</Kbd> 等第二位）；
                <Kbd>↑</Kbd> <Kbd>↓</Kbd> 加减，<Kbd>Backspace</Kbd> 删一位，删空回到上一段。所有段都填了才写回，删掉一段写回 <Code>null</Code>；
                超出 <Code>Min</Code> / <Code>Max</Code> 时外壳显示出错，写了 <Code>name</Code> 时随表单提交 ISO 文字（<Code>2026-10-20</Code>）。
            </Example>
            <Example Id="granularity" Title="精确到哪一段" Demo="typeof(GranularityExample)">
                <Code>Granularity</Code> 从 <Code>Year</Code> 到 <Code>Second</Code>，还有 <Code>Quarter</Code>、<Code>Week</Code>（ISO 周）。
                值仍是 <Code>DateOnly</Code> / <Code>DateTime</Code>：年、月、季度、周写回那一段的第一天；只显示日期时原来的时分秒不丢。
            </Example>
            <Example Id="rules" Title="不可选的日期、时制与时区" Demo="typeof(RulesExample)">
                <Code>IsDateUnavailable</Code> 标出不可选的日期：值照样写回、外壳显示出错，错误文字交给 Field。<Code>HourCycle</Code> 固定 12 / 24 小时制
                （不写时按语言），<Code>Suffix</Code> 放在框里最后。值是 <Code>DateTimeOffset</Code> 时按语言包的时区（<Code>Lang.TimeZone</Code>，没有时是本地）显示与写回。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="locales" Title="段的顺序跟随语言" Demo="typeof(LocalesExample)">
                段的顺序、分隔符、12 / 24 小时制取自语言的文化；每段是 <Code>role="spinbutton"</Code>，读屏念“生日 年”“生日 月”，没填的段念“未填写”。
                段可以编辑（<Code>contenteditable</Code> 加 <Code>inputmode="numeric"</Code>），手机上弹出数字键盘，输入法打的全角数字也认。
            </Example>
            <Example Id="appearance" Title="外观与状态" Demo="typeof(AppearanceExample)">
                和 TextField 同一个输入框外壳，<Code>InputDefaults</Code> 一起生效。
            </Example>
        </ExampleColumn>
    </Examples>
    <KeyboardReference Keys="DateKeys.Segments">
        每一段是一个 spinbutton，读屏念出段名与取值；整组是一个 group，名称取 Field 的标签。
    </KeyboardReference>
    <ApiReference Types="[typeof(DateField<>), typeof(SegmentedField<>)]" />
</DocPage>
