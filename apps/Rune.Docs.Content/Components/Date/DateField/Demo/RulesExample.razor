@inherits RuneComponent

@* 约束与写法：IsDateUnavailable 标出不可选的日期（周末），值照样写回、控件显示出错，错误文字由 Field 给；
   HourCycle 固定 12 / 24 小时制；Suffix 放在框里最后；可空的值一开始为空（DateTimeOffset 的时区见 DatePicker 的“带时区的时刻”） *@
<Grid MinItemWidth="@("15rem")" Gap="SpaceScale.Lg">
    <Field Label="到岗日期" Description="只能选工作日" Error="@(workday is { } day && Weekend(day) ? "这天是周末，请换一个工作日" : null)">
        <DateField @bind-Value="workday" IsDateUnavailable="Weekend" />
    </Field>
    <Field Label="会议开始（12 小时制）" DescriptionContent="@Show(meeting?.ToString("yyyy-MM-ddTHH:mm"))">
        <DateField @bind-Value="meeting" Granularity="DateGranularity.Minute" HourCycle="HourCycle.H12">
            <Suffix><Icon Data="Lucide.CalendarCheck" Tone="TextTone.Muted" /></Suffix>
        </DateField>
    </Field>
    <Field Label="发货日期" DescriptionContent="@Show(shipped?.ToString("yyyy-MM-dd"))">
        <DateField @bind-Value="shipped" />
    </Field>
</Grid>

@code {
    DateOnly? workday = new(2026, 10, 24);
    DateTime? meeting = new(2026, 10, 20, 14, 30, 0);
    DateOnly? shipped;

    static bool Weekend(DateOnly day) => day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    static RenderFragment Show(string? text) => @<Code>@(text ?? "null")</Code>;
}
