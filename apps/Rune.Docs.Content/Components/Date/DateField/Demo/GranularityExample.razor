@inherits RuneComponent

@* 精确到哪一段：年、年月、年月日、日期加时分（同原生的 month、date、datetime-local）；按段时写回那一段的第一天 *@
<Grid MinItemWidth="@("15rem")" Gap="SpaceScale.Lg">
    <Field Label="年度" DescriptionContent="@Show(year)"><DateField @bind-Value="year" Granularity="DateGranularity.Year" /></Field>
    <Field Label="账期" DescriptionContent="@Show(month)"><DateField @bind-Value="month" Granularity="DateGranularity.Month" /></Field>
    <Field Label="发货日期" DescriptionContent="@Show(day)"><DateField @bind-Value="day" /></Field>
    <Field Label="会议开始" DescriptionContent="@Show(at, "yyyy-MM-ddTHH:mm")"><DateField @bind-Value="at" Granularity="DateGranularity.Minute" /></Field>
    <Field Label="日志时间" DescriptionContent="@Show(precise, "yyyy-MM-ddTHH:mm:ss")"><DateField @bind-Value="precise" Granularity="DateGranularity.Second" /></Field>
</Grid>

@code {
    DateOnly? year = new(2026, 1, 1);
    DateOnly? month = new(2026, 10, 1);
    DateOnly? day = new(2026, 10, 20);
    DateTime? at = new(2026, 10, 20, 14, 30, 0);
    DateTime? precise = new(2026, 10, 20, 14, 30, 15);

    static RenderFragment Show(DateOnly? value) => @<Code>@(value?.ToString("yyyy-MM-dd") ?? "null")</Code>;

    static RenderFragment Show(DateTime? value, string format) => @<Code>@(value?.ToString(format) ?? "null")</Code>;
}
