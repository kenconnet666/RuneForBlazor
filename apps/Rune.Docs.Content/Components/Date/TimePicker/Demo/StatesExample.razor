@inherits RuneComponent

@* 精确到哪一段（Granularity）、不可空的值，以及与其他输入框同一套的外观与状态 *@
<Grid MinItemWidth="@("14rem")" Gap="SpaceScale.Lg">
    <Field Label="TimeGranularity.Second" DescriptionContent="@Show(lap?.ToString("HH:mm:ss"))">
        <TimePicker @bind-Value="lap" Granularity="TimeGranularity.Second" Step="5" Icon="Lucide.Timer" />
    </Field>
    <Field Label="TimeGranularity.Hour" DescriptionContent="@Show(shift?.ToString("HH:mm"))">
        <TimePicker @bind-Value="shift" Granularity="TimeGranularity.Hour" Step="60" Min="new TimeOnly(6, 0)" Max="new TimeOnly(22, 0)" />
    </Field>
    <Field Label="不可空的 TimeOnly" Description="@($"闹钟：{alarm:HH:mm}")">
        <TimePicker @bind-Value="alarm" />
    </Field>
    <Field Label="Variant.Soft · Radius.Full"><TimePicker Value="HalfPastOne" Variant="InputVariant.Soft" Radius="Radius.Full" Size="Size.Sm" /></Field>
    <Field Label="只读" ReadOnly="true"><TimePicker Value="Nine" /></Field>
    <Field Label="不可用" Disabled="true"><TimePicker Value="Nine" /></Field>
</Grid>

@code {
    static readonly TimeOnly HalfPastOne = new(13, 30);
    static readonly TimeOnly Nine = new(9, 0);
    TimeOnly? lap = new(0, 42, 15);
    TimeOnly? shift = new(8, 0);
    TimeOnly alarm = new(7, 0);

    static RenderFragment Show(string? text) => @<Code>@(text ?? "null")</Code>;
}
