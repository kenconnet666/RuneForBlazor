@inherits RuneComponent

@* 交货日期：日历旁边是常用的快捷选项（每次打开按今天算），日历下方的“今天”；今天之前不能选，所以“昨天”不可用 *@
<Grid MinItemWidth="@("16rem")" Gap="SpaceScale.Lg">
    <Field Label="交货日期" Description="@(delivery?.ToString("yyyy-MM-dd") ?? "今天之前不能选")">
        <DatePicker @bind-Value="delivery" Min="Today()" Presets="Presets" />
    </Field>
    <Field Label="账期" Description="@(period?.ToString("yyyy-MM") ?? "日历下方是“本月”")">
        <DatePicker @bind-Value="period" Granularity="DateGranularity.Month" />
    </Field>
</Grid>

@code {
    static DateOnly Today() => DateOnly.FromDateTime(DateTime.Today);

    static readonly IReadOnlyList<DatePreset> Presets =
    [
        new("昨天", () => Today().AddDays(-1)),
        new("明天", () => Today().AddDays(1)),
        new("一周后", () => Today().AddDays(7)),
        new("月底", () => Today() is var day ? new DateOnly(day.Year, day.Month, DateTime.DaysInMonth(day.Year, day.Month)) : default),
        new("下月初", () => Today().AddMonths(1) is var day ? new DateOnly(day.Year, day.Month, 1) : default),
    ];

    DateOnly? delivery;
    DateOnly? period;
}
