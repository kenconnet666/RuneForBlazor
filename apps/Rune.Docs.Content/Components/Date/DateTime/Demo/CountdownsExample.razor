@inherits RuneComponent

@* 限时抢购：Variant="CountdownVariant.Blocks" 一格一格的数字；待支付的订单：默认的“时:分:秒”；优惠券：Precision="CountdownPrecision.Minute" 精确到分、每分钟更新；
   验证码：60 秒后才能重发，到点时 OnEnd 恢复按钮。截止时刻相对页面打开的时刻，倒计时交互开始后才画（ClientOnly） *@
<ClientOnly>
    <Grid MinItemWidth="@("14rem")" Balanced="true" Gap="SpaceScale.Md">
        <Card Padding="SpaceScale.Md">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Small Tone="TextTone.Muted">双十一抢购距开始</Small>
                <TextSpan Size="Size.Lg"><Countdown To="saleStartsAt" Variant="CountdownVariant.Blocks" aria-label="距抢购开始" /></TextSpan>
            </Flex>
        </Card>
        <Card Padding="SpaceScale.Md">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Small Tone="TextTone.Muted">订单待支付，超时自动取消</Small>
                <Flex Align="ItemAlign.Center" Justify="ContentJustify.Between" Gap="SpaceScale.Sm">
                    <TextSpan Size="Size.Lg" Weight="Weight.Semibold"><Countdown To="orderExpiresAt" /></TextSpan>
                    <Button Size="Size.Sm">去支付</Button>
                </Flex>
            </Flex>
        </Card>
        <Card Padding="SpaceScale.Md">
            <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                <Small Tone="TextTone.Muted">满 200 减 30 优惠券</Small>
                <TextSpan><Countdown To="couponExpiresAt" Precision="CountdownPrecision.Minute" /> 后过期</TextSpan>
            </Flex>
        </Card>
        <Card Padding="SpaceScale.Md">
            <Flex Align="ItemAlign.End" Gap="SpaceScale.Sm">
                <Field Label="手机号"><TextField placeholder="138 0000 0000" inputmode="tel" /></Field>
                <Button Variant="ButtonVariant.Soft" Disabled="resendAt is not null" @onclick="() => resendAt = DemoClock.Now.AddSeconds(60)">
                    @if (resendAt is { } at)
                    {
                        <Countdown To="at" OnEnd="() => resendAt = null" Context="left">@Math.Ceiling(left.Total.TotalSeconds)</Countdown>
                        <span> 秒后重发</span>
                    }
                    else
                    {
                        <span>发送验证码</span>
                    }
                </Button>
            </Flex>
        </Card>
    </Grid>
</ClientOnly>

@code {
    // 演示数据：抢购在页面打开的 27 小时后开始，订单 15 分钟内不付就取消
    readonly DateTimeOffset saleStartsAt = DemoClock.Now.AddMinutes(27 * 60 + 15);
    readonly DateTimeOffset orderExpiresAt = DemoClock.Now.AddMinutes(15);
    readonly DateTimeOffset couponExpiresAt = DemoClock.Now.AddMinutes((2 * 24 + 3) * 60 + 15);
    DateTimeOffset? resendAt;
}
