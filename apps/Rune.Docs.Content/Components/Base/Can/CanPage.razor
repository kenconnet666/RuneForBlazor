@page "/components/can"
@attribute [DocMeta("Can 权限显示", "按权限显示按钮等界面：Blazor 自带的 AuthorizeView 就是 vue-tsx-pro 的 Can，有权限才渲染，没有时渲染 NotAuthorized。", DocCategory.Base, Order = 30)]
@inherits DocPageBase
@using Rune.Docs.Components.Base.Can.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="roles" Title="按角色显示按钮" Demo="typeof(RolesExample)">
                本库不另做 Can：Blazor 的 <Code>AuthorizeView</Code> 就是它。<Code>Roles</Code> 写角色（逗号分隔，有其中一个即可），<Code>Policy</Code> 写策略名
                （权限点就是策略：<Code>AddAuthorizationCore(o =&gt; o.AddPolicy("cost:project:add", …))</Code>）；<Code>NotAuthorized</Code> 是没有权限时显示的内容。
                当前用户来自级联的 <Code>Task&lt;AuthenticationState&gt;</Code>（<Code>CascadingAuthenticationState</Code> 或 <Code>AddCascadingAuthenticationState()</Code>），
                登录、退出、换角色后界面随之更新。要在代码里判断（禁用按钮、过滤菜单项）时注入 <Code>IAuthorizationService</Code>。
                这只控制界面，不是安全边界：接口上的 <Code>[Authorize]</Code> 才是。
            </Example>
        </ExampleColumn>
    </Examples>
</DocPage>
