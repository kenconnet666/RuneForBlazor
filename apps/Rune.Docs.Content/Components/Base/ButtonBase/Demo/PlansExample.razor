@* ButtonBase 只负责行为与焦点环，卡片外观全部由这里给出 *@
@inherits RuneComponent

<div role="group" aria-label="套餐" @attributes="Attrs.Merge(GridLayer)">
    @foreach (var item in plans)
    {
        var selected = item.Id == plan;
        <ButtonBase @key="item.Id" aria-pressed="@(selected ? "true" : "false")" Sx="@(selected ? SelectedSx : CardSx)" @onclick="() => plan = item.Id">
            <span @attributes="Attrs.Merge(HeadLayer)">
                <Strong>@item.Name</Strong>
                @if (selected)
                {
                    <Icon Data="Lucide.Check" Tone="TextTone.Accent" />
                }
            </span>
            <span @attributes="Attrs.Merge(PriceLayer)">@item.Price</span>
            <Small Tone="TextTone.Muted">@item.Detail</Small>
        </ButtonBase>
    }
</div>

@code {
    static readonly (string Id, string Name, string Price, string Detail)[] plans =
    [
        ("free", "个人版", "免费", "3 个项目 · 1 GB 存储"),
        ("team", "团队版", "¥ 99 / 月", "不限项目 · 50 GB · 10 人"),
        ("business", "企业版", "¥ 499 / 月", "SSO 登录 · 审计日志 · 专属支持"),
    ];

    string plan = "team";

    static readonly Sx CardSx = Sx.Of(Card);
    static readonly Sx SelectedSx = Sx.Of(Card, Selected);

    static readonly Attrs GridLayer = new() { Sx = Grid };
    static readonly Attrs HeadLayer = new() { Sx = Head };
    static readonly Attrs PriceLayer = new() { Sx = Price };

    static Style Grid => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        GridTemplateColumns = "repeat(auto-fit, minmax(13rem, 1fr))",
        Gap = Space.Md,
    });

    static Style Card => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        FlexDirection = FlexDirection.Column,
        AlignItems = AlignItems.FlexStart,
        Gap = Space.Xs,
        Padding = Space.Md,
        BorderWidth = BorderWidths.Xs,
        BorderStyle = BorderStyle.Solid,
        BorderColor = Colors.Border,
        BorderRadius = Radii.Md,
        BackgroundColor = Colors.Surface,
        TextAlign = TextAlign.Start,
        [When.Hover] = new() { BorderColor = Colors.BorderStrong, BackgroundColor = Colors.Fill },
    });

    static Style Selected => Css.Define(static () => new Style
    {
        BorderColor = Tones.Accent.Solid,
        BackgroundColor = Tones.Accent.Soft,
        [When.Hover] = new() { BorderColor = Tones.Accent.Solid, BackgroundColor = Tones.Accent.SoftHover },
    });

    static Style Head => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        AlignItems = AlignItems.Center,
        JustifyContent = JustifyContent.SpaceBetween,
        Width = CssLength.Percent(100),
    });

    static Style Price => Css.Define(static () => new Style { FontSize = FontSizes.Lg, FontWeight = FontWeights.Semibold });
}
