@inherits RuneComponent
@using System.Reflection

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Flex Gap="SpaceScale.Lg" Wrap="true">
        <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.MapPin" /> 上海·徐汇</TextSpan>
        <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.Clock" /> 3 分钟前</TextSpan>
        <TextSpan Tone="TextTone.Muted"><Icon Data="Lucide.Users" /> 128 人参与</TextSpan>
    </Flex>
    <Paragraph>
        图标跟随文字的字号与颜色，和文字基线对齐；放在句子中间也不会撑高行距，<TextLink Href="components/icon">查看设计规范 <Icon Data="Lucide.ExternalLink" /></TextLink>。
    </Paragraph>
    <Flex Gap="SpaceScale.Sm" Wrap="true" Align="ItemAlign.Center">
        <Button Icon="Lucide.Plus">新建项目</Button>
        <Button Variant="ButtonVariant.Ghost" IconEnd="Lucide.ArrowRight">继续</Button>
        <Badge Tone="Tone.Warning" Icon="Lucide.Star">精选</Badge>
    </Flex>
</Flex>
