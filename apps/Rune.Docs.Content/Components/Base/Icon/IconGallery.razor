@*
    图标库的网格（同 vue-tsx-pro 文档站的 IconGallery）：搜索并点选 Rune.Icons 里的 Lucide 图标。
    <IconGallery @bind-Value="name" />          Value 是属性名（Rocket），点选后更新
    Lucide 没有随包提供分类，按名字搜：属性名（ArrowRight）与文件名（arrow-right）都能匹配。
    全部图标都能滚动看到：按行虚拟滚动（VirtualList），每行放几个按容器宽度算（data-rune-observe-size），只画看得见的几行。
*@
@inherits RuneComponent
@using System.Reflection

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
    <TextField @bind-Value="query" Immediate="true" Icon="Lucide.Search" Clearable="true"
               placeholder="@($"搜索 {All.Count} 个图标，如 arrow、user、chart")" aria-label="搜索图标" data-testid="icon-search" />
    <div data-rune-observe-size @onruneresize="OnResize">
        <VirtualList Items="Rows" EstimateSize="Row" Sx="Scroller" aria-label="图标" Context="row">
            <div @attributes="Attrs.Merge(RowLayer)" style="@($"grid-template-columns:repeat({columns},minmax(0,1fr))")">
                @foreach (var item in row)
                {
                    var selected = item.Name == Value;
                    <button @key="item.Name" type="button" aria-pressed="@(selected ? "true" : "false")" title="@item.Name"
                            @attributes="Attrs.Merge(selected ? SelectedCellLayer : CellLayer)" @onclick="() => PickAsync(item.Name)">
                        <Icon Data="item.Icon" Sx="Glyph" />
                        <span @attributes="Attrs.Merge(NameLayer)">@item.Name</span>
                    </button>
                }
            </div>
        </VirtualList>
    </div>
    <Small Tone="TextTone.Muted">@(Matches.Count == 0 ? "没有匹配的图标：换个英文关键词试试" : $"共 {Matches.Count} 个，滚动查看全部")</Small>
</Flex>

@code {
    // 一格的最小宽度与格间距（px，间距同 Space.Xs）：据此算每行放几个；一行的估计高度：图标、名字与上下内边距
    const int Cell = 88;
    const int Gap = 4;
    const float Row = 68;

    static readonly Attrs RowLayer = new() { Sx = RowStyle };
    static readonly Attrs CellLayer = new() { Sx = Sx.Of(CellStyle, SharedStyles.FocusRing) };
    static readonly Attrs SelectedCellLayer = new() { Sx = Sx.Of(CellStyle, SharedStyles.FocusRing, Selected) };
    static readonly Attrs NameLayer = new() { Sx = NameStyle };

    string query = "";
    int columns = 6;
    Memo<(string Query, int Columns), Filtered> view;

    // 搜索结果与按每行几个分好的行
    sealed record Filtered(IReadOnlyList<IconEntry> Matches, IReadOnlyList<IconEntry[]> Rows);

    /// <summary>选中的图标（Lucide 的属性名）。</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>点选了一个图标。</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>全部图标：属性名、文件名与数据。旧名（[Obsolete] 转发）不重复列出。</summary>
    public static IReadOnlyList<IconEntry> All => all.Value;

    static readonly Lazy<IReadOnlyList<IconEntry>> all = new(() =>
        typeof(Lucide).GetProperties(BindingFlags.Public | BindingFlags.Static)
            .Where(p => p.PropertyType == typeof(IconData) && !p.IsDefined(typeof(ObsoleteAttribute)))
            .Select(p => new IconEntry(p.Name, (IconData)p.GetValue(null)!))
            .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            .ToList());

    IReadOnlyList<IconEntry> Matches => Current.Matches;

    IReadOnlyList<IconEntry[]> Rows => Current.Rows;

    Filtered Current => view.Get((query, columns), static k =>
    {
        var keyword = string.Join('-', k.Query.Trim().ToLowerInvariant().Split([' ', '_'], StringSplitOptions.RemoveEmptyEntries));
        var compact = keyword.Replace("-", "");
        IReadOnlyList<IconEntry> matches = keyword.Length == 0
            ? All
            : [.. All.Where(e => e.Icon.Name.Contains(keyword, StringComparison.Ordinal) || e.Name.Contains(compact, StringComparison.OrdinalIgnoreCase))];
        return new Filtered(matches, [.. matches.Chunk(k.Columns)]);
    });

    // 容器宽度变了：重新算每行放几个
    void OnResize(ResizeEventArgs e) => columns = Math.Max(1, (int)((e.Size + Gap) / (Cell + Gap)));

    async Task PickAsync(string name)
    {
        Value = name;
        await ValueChanged.InvokeAsync(name);
    }

    // VirtualList 自己是滚动容器（ScrollArea，滚动条和整页一样）
    static Style Scroller => Css.Define(static () => new Style { Height = CssLength.Rem(26) });

    // 行与行之间的间距：VirtualList 的每一项就是一行
    static Style RowStyle => Css.Define(static () => new Style { Display = Display.Grid, Gap = Space.Xs, PaddingBlockEnd = Space.Xs });

    // 一格：图标在上，名字在下（长名字截断，完整名字在 title 里）
    static Style CellStyle => Css.Define(static () => new Style
    {
        Display = Display.Flex,
        FlexDirection = FlexDirection.Column,
        AlignItems = AlignItems.Center,
        JustifyContent = JustifyContent.Center,
        Gap = Space.Xs,
        MinWidth = 0,
        PaddingBlock = Space.Sm,
        PaddingInline = Space.Xs,
        BorderWidth = BorderWidths.Sm,
        BorderStyle = BorderStyle.Solid,
        BorderColor = CssColors.Transparent,
        BorderRadius = Radii.Md,
        BackgroundColor = CssColors.Transparent,
        Color = Colors.Text,
        Font = CssWide.Inherit,
        Cursor = Cursor.Pointer,
        [When.Hover] = new() { BorderColor = Colors.Border, BackgroundColor = Colors.FillHover },
    });

    static Style Glyph => Css.Define(static () => new Style { FontSize = CssLength.Rem(1.375) });

    static Style NameStyle => Css.Define(static () => new Style
    {
        MaxWidth = CssLength.Percent(100),
        Overflow = Overflow.Hidden,
        TextOverflow = TextOverflow.Ellipsis,
        WhiteSpace = WhiteSpace.Nowrap,
        FontSize = CssLength.Rem(0.6875),
        Color = Colors.TextMuted,
    });

    static Style Selected => Css.Define(static () => new Style
    {
        BorderColor = Tones.Accent.Border,
        BackgroundColor = Tones.Accent.Soft,
        Color = Tones.Accent.Text,
        [When.Hover] = new() { BorderColor = Tones.Accent.Border, BackgroundColor = Tones.Accent.Soft },
    });
}
