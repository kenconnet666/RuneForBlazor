@page "/components/icon-button"
@attribute [DocMeta("IconButton 图标按钮", "只有图标的按钮：工具栏、卡片上的操作；预设的 CloseButton、ClearButton、CopyButton 与链接 IconLinkButton。", DocCategory.Base, Order = 2)]
@inherits DocPageBase
@using Rune.Docs.Components.Base.IconButton.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="toolbar" Title="基础用法" Demo="typeof(ToolbarExample)">
                宽高相等，默认 Ghost 样式、中性色（一排图标不会满屏品牌色）；外观选项同 Button。没有文字，必须写 Label，读屏才知道它是做什么的。
            </Example>
            <Example Id="states" Title="加载、不可用与异步复制" Demo="typeof(StatesExample)">
                Loading 时图标换成转圈、点击无效；FocusableWhenDisabled 让不可用的按钮仍能聚焦，配 Tooltip 说明为什么不能点。CopyButton 的 GetValue 点击时才生成内容（等待时转圈），Timeout 是对勾停留的毫秒数，OnCopied 拿到是否成功。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="presets" Title="预设按钮" Demo="typeof(PresetsExample)">
                CloseButton、ClearButton 带好了图标与读屏名称；CopyButton 复制成功时图标换成对勾、读屏播报“已复制”，几秒后复原。
            </Example>
            <Example Id="links" Title="图标链接" Demo="typeof(LinksExample)">
                点了去别处的图标用 IconLinkButton（a 元素）；External 在新窗口打开。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(CopyButton), typeof(IconButton), typeof(IconLinkButton)]" />
</DocPage>
