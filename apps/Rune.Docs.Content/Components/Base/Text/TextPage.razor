@page "/components/text"
@attribute [DocMeta("Text 文字与列表", "正文、链接、标题与列表：字号、字重、色调、截断与换行；Paragraph、Strong、Em、Small、Sub、Sup、Del、Ins、Strike、Abbr、TextLink、Mark、Kbd、Blockquote、H1–H6，正文里的 List、OrderedList。", DocCategory.Base, Order = 0)]
@inherits DocPageBase
@using Rune.Docs.Components.Base.Text.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="scale" Title="字号与字重" Demo="typeof(ScaleExample)">
                Size 对应主题的字号档位，Weight 对应字重；不写时继承上下文，Small 默认 Xs，Strong 默认 Semibold。
            </Example>
            <Example Id="tones" Title="色调" Demo="typeof(TonesExample)">
                Tone 取主题的文字色：Neutral 是正文色，Muted 用于次要说明，其余是品牌色与提示色的文字色。
            </Example>
            <Example Id="overflow" Title="截断与换行" Demo="typeof(OverflowExample)">
                Truncate 单行省略，LineClamp 限制行数；Wrap 的 Pretty 避免最后一行只剩一个字（Paragraph 默认），Balance 让标题各行长度均衡。
            </Example>
            <Example Id="lists" Title="列表：无序、有序与嵌套" Demo="typeof(ListsExample)">
                <Code>List</Code> 是圆点，<Code>OrderedList</Code> 是编号，<Code>start</Code>、<Code>reversed</Code> 这些原生属性照常可用；嵌套的列表紧贴上一项。
                <Code>Gap</Code> 改项与项之间的间距。
            </Example>
            <Example Id="list-icons" Title="图标代替圆点" Demo="typeof(ListIconsExample)">
                <Code>Icon</Code> 让每项前面画一个图标（功能清单的对勾），<Code>PropsIcon</Code> 改颜色；<Code>ListItem</Code> 的 <Code>Icon</Code> 逐项覆盖。
                图标是装饰，读屏照常念“列表，几项”。<Code>Size</Code> 是字号档位。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="inline" Title="行内语义" Demo="typeof(InlineExample)">
                一个元素一个组件：Strong、Em、Small、Mark（高亮）、Kbd（按键）、Code（行内代码）、Blockquote（引用，<Code>Source</Code> 写出处）。
                <Code>Sub</Code>、<Code>Sup</Code> 是上下标，不撑高所在的行；<Code>Strike</Code> 是不再有效的内容（原价），文档的增删用 <Code>Del</Code>、<Code>Ins</Code>
                （加进来的是浅绿底，不用下划线，免得和链接分不清）。<Code>Abbr</Code> 是缩写：全称在提示里，悬停、键盘聚焦、触屏点按都看得到（原生的 title 只有鼠标悬停才有）。
            </Example>
            <Example Id="links" Title="链接" Demo="typeof(LinksExample)">
                TextLink 默认带下划线（WCAG 1.4.1：正文里的链接不能只靠颜色区分）；导航这类上下文明确的地方可以 Underline="Hover" 或 None。按钮样式的链接用 LinkButton。
            </Example>
            <Example Id="headings" Title="标题" Demo="typeof(HeadingsExample)">
                H1–H6 是六个组件，默认字号依次减小；级别要连续，视觉层级用 Size 单独改。Anchor 加指向本节的锚点链接。
            </Example>
            <Example Id="numeric" Title="编号与数字" Demo="typeof(NumericExample)">
                Mono 用等宽字体（编号、件号），Numeric 用等宽数字（金额、计数）：上下对齐、变化时不跳动。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(Abbr), typeof(Blockquote), typeof(Kbd), typeof(Mark), typeof(List), typeof(OrderedList), typeof(ListItem)]" />
</DocPage>
