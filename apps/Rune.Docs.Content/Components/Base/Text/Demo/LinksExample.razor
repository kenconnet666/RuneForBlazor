@inherits RuneComponent

<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Paragraph>
        正文里的链接默认带下划线：<TextLink Href="components/button">按钮</TextLink>、<TextLink Href="components/provider">主题定制</TextLink>，不只靠颜色和周围的文字区分。去别的站点写 <TextLink Href="https://vuejs.org" External="true">Vue 文档</TextLink>：新窗口打开，带图标，读屏会念出“在新窗口打开”。
    </Paragraph>
    <Flex Gap="SpaceScale.Lg" Wrap="true">
        <TextSpan Size="Size.Sm"><TextLink Href="components/text" Underline="LinkUnderline.Hover">悬停时才有下划线</TextLink></TextSpan>
        <TextSpan Size="Size.Sm"><TextLink Href="components/text" Underline="LinkUnderline.None" Tone="TextTone.Muted">导航里的次要链接</TextLink></TextSpan>
        <TextSpan Size="Size.Sm"><TextLink Href="components/text" Tone="TextTone.Danger">注销账户</TextLink></TextSpan>
    </Flex>
</Flex>
