@page "/components/code"
@attribute [DocMeta("Code 代码", "行内代码（Code、文案里的 CodeText）、代码块（CodeBlock：标题、行号、高亮行、增删、折叠）、按标签切换的一组代码（CodeGroup）与示例卡片（CodePreview）。", DocCategory.Base, Order = 10)]
@inherits DocPageBase
@using Rune.Docs.Components.Base.Code.Demo

<DocPage Meta="Meta" Wide="true">
    <Examples>
        <ExampleColumn>
            <Example Id="basic" Title="行内代码" Demo="typeof(BasicExample)">
                句子里的命令、文件名、标识符用 <Code>Code</Code>：等宽字体、浅底，长内容可以在任意位置换行。
            </Example>
            <Example Id="block" Title="代码块" Demo="typeof(BlockExample)">
                <Code>CodeBlock</Code> 先显示纯文本，浏览器里用 Shiki 上色（第一次用到时才加载），结果到了再替换，布局不跳；<Code>LineNumbers</Code> 行号，<Code>HighlightLines</Code> 高亮行，有标题时复制按钮在标题栏里。
            </Example>
            <Example Id="text" Title="文案里的行内代码" Demo="typeof(TextExample)">
                文案写在数据里时用 <Code>CodeText</Code>：反引号里的是行内代码，不用拆成多个节点。只认成对的反引号，不是 Markdown。
            </Example>
            <Example Id="options" Title="换行、复制与延后高亮" Demo="typeof(OptionsExample)">
                长行默认在浮层滚动条里横向滚动，<Code>Wrap</Code> 改成自动换行；<Code>Copyable="false"</Code> 去掉复制按钮。<Code>Highlight="false"</Code> 时按纯文本显示，改回 true 才上色：收起的、还没滚到的代码可以等要显示时再高亮。
            </Example>
        </ExampleColumn>
        <ExampleColumn>
            <Example Id="diff" Title="增删与折叠" Demo="typeof(DiffExample)">
                <Code>AddedLines</Code>、<Code>RemovedLines</Code> 标出新增与删除的行；长代码写 <Code>MaxLines</Code>，超出的部分折叠，底部的按钮展开或收起。
            </Example>
            <Example Id="flush" Title="嵌在外框里" Demo="typeof(FlushExample)">
                <Code>Flush</Code> 去掉代码块自己的边框、圆角和底色，放进卡片、标签页这类已经有外框的容器。
            </Example>
        </ExampleColumn>
    </Examples>
    <ApiReference Types="[typeof(CodeBlock), typeof(Code), typeof(CodeText)]" />
</DocPage>
