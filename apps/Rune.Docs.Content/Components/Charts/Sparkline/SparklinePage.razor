@page "/components/sparkline"
@attribute [DocMeta("Sparkline 小图", "嵌在指标卡、表格、工作台里的小图：没有坐标轴的迷你折线（Sparkline）、半圆仪表盘（Gauge）、按构成分段的比例条（ProportionBar）。在 Rune.UI 里，纯 SVG。", DocCategory.Charts, Order = 12)]
@inherits DocPageBase
@using Rune.Docs.Components.Charts.Sparkline.Demo

<DocPage Meta="Meta" Wide="true" Package="RuneForBlazor.UI">
    <Example Id="cards" Title="迷你图：指标卡里" Demo="typeof(CardsExample)">
        放进 Stat 的子内容：占满数值下面的一行。<Code>Type</Code> 是 <Code>Line</Code>（默认）、<Code>Area</Code>（下面填一层浅色）或 <Code>Bar</Code>
        （每个值一根柱，从 0 起），<Code>Tone</Code> 是色调。默认标出最后一个点（<Code>ShowLast</Code>）。读屏念成一句话：几个值、从哪到哪、最低最高，
        按 <Code>ValueFormat</Code> 格式化，<Code>Label</Code> 写在前面。SVG 由 C# 直接输出，静态 SSR 也一样。
    </Example>
    <Example Id="in-table" Title="迷你图：表格里" Demo="typeof(InTableExample)">
        宽度占满容器，<Code>Height</Code> 默认 2em（随字号缩放），表格里配合行高调小。空值（<Code>null</Code>）处断开。
        <Code>Min</Code>、<Code>Max</Code> 固定纵向的范围（几行一起比较时用同一个范围）。
    </Example>
    <Example Id="gauge" Title="仪表盘：一个量落在哪个区间" Demo="typeof(GaugeExample)">
        <Code>Value</Code> 在 <Code>Min</Code>–<Code>Max</Code>（默认 0–100）之间；<Code>Bands</Code> 是外圈的区间（每段到 <Code>To</Code> 为止，带色调），
        数值弧取它所在区间的色调（<Code>Tone</Code> 可以指定）；<Code>Target</Code> 在外圈上画一道刻度。<Code>ValueFormat</Code>、<Code>Unit</Code>
        决定中间与读屏的数值写法。和 Progress 的分工：Progress 是做到哪了，Gauge 是一个量处在好坏的哪一段。
    </Example>
    <Example Id="gauge-sizes" Title="仪表盘：大小与中间的文字" Demo="typeof(GaugeSizesExample)">
        宽 10em，随字号缩放：<Code>Size</Code> 档位或外层的字号。<Code>ValueContent</Code> 换掉中间的文字；读屏仍念 <Code>aria-valuetext</Code>（格式化的数值与目标）。
    </Example>
    <Example Id="proportion-bar" Title="比例条：一个总数的构成" Demo="typeof(ProportionBarExample)">
        <Code>Segments</Code> 互斥、加起来是总数；颜色用 <Code>Tone</Code>（状态色）或 <Code>Color</Code>（任意颜色）。横条对读屏是一张图，
        名称（<Code>Label</Code>）后面自动带上各段的数量；图例是普通文字，<Code>ValueText</Code> 改数量的写法，<Code>LegendExtra</Code> 在图例项后面补一句。
        数量为 0 的段不画但留在图例里。要比较趋势、多个总数时用图表。
    </Example>
    <ApiReference Types="[typeof(Sparkline), typeof(Gauge), typeof(GaugeBand), typeof(ProportionBar), typeof(ProportionSegment)]" />
</DocPage>
