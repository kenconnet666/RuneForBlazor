@inherits RuneComponent

@* 项目的进度：计划是浅色的轨道，实际画在上面；拖期的一段标红（Color），还在进行的实际到“今天”为止。里程碑（年中评审、预算截止）是竖线；点图例隐藏“计划”只看实际 *@
<TimelineChart Items="Items" Series="Series" ShowToday="true" Today="Today.ToDateTime(TimeOnly.MinValue)" Markers="Markers" aria-label="项目进度" />

@code {
    static readonly DateOnly Today = new(2026, 10, 24);

    static readonly TimelineChartItem[] Items =
    [
        new("官网首页改版", new DateOnly(2026, 3, 1), new DateOnly(2026, 6, 30)) { Series = "plan" },
        new("官网首页改版", new DateOnly(2026, 3, 10), new DateOnly(2026, 6, 30)) { Series = "actual" },
        new("官网首页改版", new DateOnly(2026, 7, 1), new DateOnly(2026, 7, 24)) { Series = "actual", Color = Tone.Danger, Label = "官网首页改版（拖期）" },
        new("线缆收纳夹国产化", new DateOnly(2026, 5, 1), new DateOnly(2026, 9, 30)) { Series = "plan" },
        new("线缆收纳夹国产化", new DateOnly(2026, 5, 6), new DateOnly(2026, 9, 12)) { Series = "actual" },
        new("门店照明改造", new DateOnly(2026, 6, 15), new DateOnly(2026, 12, 31)) { Series = "plan" },
        new("门店照明改造", new DateOnly(2026, 7, 1), Today) { Series = "actual" },
        new("包装材料复用", new DateOnly(2026, 9, 1), new DateOnly(2027, 1, 31)) { Series = "plan" },
        new("包装材料复用", new DateOnly(2026, 9, 20), Today) { Series = "actual" },
        new("供应商年度议价", new DateOnly(2026, 11, 1), new DateOnly(2026, 12, 15)) { Series = "plan" },
    ];

    static readonly TimelineChartSeries[] Series =
    [
        new("plan", "计划") { Track = true, Color = ChartColor.Series(1) },
        new("actual", "实际") { Color = ChartColor.Series(1) },
    ];

    static readonly TimelineChartMarker[] Markers =
    [
        new(new DateTime(2026, 7, 15), "年中评审"),
        new(new DateTime(2026, 12, 20), "预算截止") { Color = Tone.Warning },
    ];
}
