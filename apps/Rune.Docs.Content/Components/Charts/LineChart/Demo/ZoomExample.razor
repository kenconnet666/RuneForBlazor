@inherits RuneComponent

@* 三年的月度数据：Zoom 在下面放一条区间滑块，拖两端（或聚焦后用方向键）只看其中一段，“显示全部”恢复；Exportable 在右上角放导出菜单 *@
<LineChart Items="Months" Category="m => m.Month" Series="Series" Unit="单" Zoom="true" @bind-ZoomRange="range" Exportable="true" aria-label="月度订单与退货" />
<Small Tone="TextTone.Muted">显示：@(range is { } r ? $"{Months[r.Low].Month} 到 {Months[r.High].Month}" : "全部 36 个月")</Small>

@code {
    sealed record Orders(string Month, decimal Count, decimal Returns);

    // 按月份算出一组有季节起伏、逐年增长的数据
    static readonly Orders[] Months = [.. Enumerable.Range(0, 36).Select(i =>
    {
        var month = i % 12 + 1;
        var season = Math.Sin(month / 12.0 * Math.PI * 2) * 18;
        return new Orders($"{2024 + i / 12}-{month:00}", (decimal)Math.Round(120 + i * 3.2 + season, MidpointRounding.AwayFromZero),
            (decimal)Math.Round(14 + Math.Cos(i / 3.0) * 4 + i * 0.2, MidpointRounding.AwayFromZero));
    })];

    static readonly ChartSeries<Orders>[] Series = [new("orders", "订单", m => m.Count), new("returns", "退货", m => m.Returns) { Color = Tone.Danger }];

    NumberRange<int>? range = new(24, 35);
}
