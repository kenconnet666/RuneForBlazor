@page "/guide/theming"
@attribute [DocMeta("Theming 主题定制", "十六套内置主题，局部主题、跟随系统、让用户切换并记住、写自己的主题与语言包。", DocCategory.Guide, Order = 3)]
@inherits DocPageBase
@using Rune.Docs.Guide.Demo

<DocPage Meta="Meta" Wide="true">
    <Example Id="builtin" Title="内置主题" Demo="typeof(ThemeGalleryExample)">
        十六套内置主题都在 <Code>Themes.All</Code> 里：亮色（默认）、暗色、纸张（米黄纸色与衬线标题）、午夜（深海军蓝与青色）、高对比（亮、暗两套，文字到 7:1）、
        森林、柠檬、樱花、喜庆、赛博朋克、大屏、薰衣草、余烬、墨白、青瓷。每套都通过对比度检查；示例里每张卡片套一层 <Code>RuneProvider</Code>，
        主题只作用在这一块，这就是局部主题的写法。
    </Example>
    <Example Id="follow-system" Title="跟随系统" Demo="typeof(FollowSystemExample)">
        <Code>Theme</Code> 与 <Code>DarkTheme</Code> 各给一套，<Code>ColorScheme.System</Code> 时按系统的明暗选一套；<Code>AddRuneUI</Code> 与 <Code>RuneProvider</Code>
        都接受这种写法。左边一张跟随系统，右边两张是系统亮、暗时它的样子。
    </Example>

    <GuideSection Id="switcher" Title="让用户切换">
        <Paragraph>
            <Code>ThemeChoices</Code> 列出用户可以选的主题；<Code>ThemeSwitcher</Code> 是图标按钮加单选菜单（“跟随系统”与各套主题），
            选中后记在浏览器的 localStorage 里，新主题从按钮处圆形展开。head 里的 <Code>ThemeBootScript</Code>
            在页面显示前按记住的选择设好，不闪一下默认主题。切换全在浏览器里，没有往返，静态 SSR 也能用。
        </Paragraph>
        <CodeBlock Code="@switcher" Lang="razor" />
        <Paragraph>
            本站右上角就是它。可选的主题越多，页面带的变量越多（每套约十几 KB，压缩前）：只列用得上的几套。
            “跟随系统”按系统的明暗选 <Code>SystemLight</Code> 或 <Code>SystemDark</Code>；写了 <Code>SystemContrast</Code> 时，
            系统要求增强对比度（Windows 的对比度主题、macOS 的“增强对比度”）改用它的两套。<Code>ThemeChoices.Builtin</Code> 已经配好高对比的亮、暗两套。
        </Paragraph>
    </GuideSection>

    <GuideSection Id="custom" Title="写自己的主题">
        <Paragraph>
            基于一套内置主题，只写不同的 token。名字要唯一（切换时按名字区分）；暗色主题写 <Code>IsDark = true</Code>，
            浏览器的原生控件、滚动条按暗色画。
        </Paragraph>
        <CodeBlock Code="@custom" Lang="csharp" />
    </GuideSection>

    <GuideSection Id="lang" Title="语言包">
        <Paragraph>
            组件里的文案（关闭、清空、共 N 条）、日期与数字的格式来自语言包：内置简体中文与美国英语。只改几条用 <Code>with</Code>。
        </Paragraph>
        <CodeBlock Code="@lang" Lang="csharp" />
    </GuideSection>
</DocPage>

@code {
    const string switcher = """
        @* Program.cs：builder.Services.AddRuneUI(o => o.ThemeChoices = ThemeChoices.Builtin); *@
        @* App.razor 的 head *@
        <ThemeBootScript />

        @* 顶栏 *@
        <ThemeSwitcher />

        @* 只列几套：new ThemeChoices([Themes.Light, Themes.Dark, Themes.Paper]) *@
        """;

    const string custom = """
        public static class BrandThemes
        {
            public static Theme Ocean => Css.Define(static () => new Theme("brand-ocean", basedOn: Themes.Light)
            {
                [Tones.Accent.Solid] = "#0a7ea4",
                [Tones.Accent.Text] = "#086a8a",
                [Radii.Md] = "0.5em",
            });
        }

        builder.Services.AddRuneUI(o => o.ThemeChoices = new([Themes.Light, Themes.Dark, BrandThemes.Ocean]));
        """;

    const string lang = """
        builder.Services.AddRuneUI(o => o.Lang = Lang.ZhCn with
        {
            Close = "关掉",
            SearchPlaceholder = "搜索商品",
        });
        """;
}
