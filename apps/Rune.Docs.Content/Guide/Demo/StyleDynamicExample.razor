@inherits RuneComponent

@* 任务进度：进度写进元素上的 CSS 变量（CssVar），样式只引用变量；拖动滑块时变的是变量的值，类名与样式规则都不变。
   延期是按条件多合并一层样式 *@
<Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
    <Flex Gap="SpaceScale.Md" Align="ItemAlign.Center" Wrap="true">
        <Slider TValue="int" Value="shift" ValueChanged="Shift" Min="-50" Max="50" aria-label="整体进度" Sx="SliderWidth" />
        <Button Variant="ButtonVariant.Outline" Size="Size.Sm" @onclick="ToggleLate">切换延期</Button>
        <TextSpan Size="Size.Sm" Tone="TextTone.Muted">进度条的类名一直是同一个</TextSpan>
    </Flex>
    <div @attributes="Attrs.Merge(RowsLayer)">
        @foreach (var task in tasks)
        {
            <div @key="task.Id" @attributes="Attrs.Merge(new Attrs { Sx = task.Late ? [Row, Late] : Row })">
                <span>@task.Name</span>
                <div @attributes="Attrs.Merge(TrackLayer)">
                    <div @attributes="Attrs.Merge(new Attrs { Sx = task.Late ? [Bar, LateBar] : Bar, Vars = [BarWidth.Set(CssLength.Percent(task.Progress))] })"></div>
                </div>
                <span @attributes="Attrs.Merge(ValueLayer)">@task.Id</span>
            </div>
        }
    </div>
</Flex>

@code {
    sealed class TaskRow(int id)
    {
        public int Id { get; } = id;
        public string Name { get; } = $"任务 {id}";
        public int Progress { get; set; } = id * 10;
        public bool Late { get; set; } = (id - 1) % 3 == 0;
    }

    readonly TaskRow[] tasks = [.. Enumerable.Range(1, 8).Select(id => new TaskRow(id))];
    int shift;

    void Shift(int value)
    {
        shift = value;
        foreach (var task in tasks) task.Progress = Math.Clamp(task.Id * 10 + value, 0, 100);
    }

    void ToggleLate()
    {
        foreach (var task in tasks) task.Late = !task.Late;
    }

    // 进度条的宽度：每行的值写在自己元素上
    static readonly CssVar<CssLength> BarWidth = CssVar.Length("demo-task-progress");

    static readonly Attrs RowsLayer = new() { Sx = Rows };
    static readonly Attrs TrackLayer = new() { Sx = Track };
    static readonly Attrs ValueLayer = new() { Sx = Value };

    static Style SliderWidth => Css.Define(static () => new Style { Flex = "1 1 14rem" });

    static Style Rows => Css.Define(static () => new Style { Display = Display.Grid, Gap = Space.Xs });

    static Style Row => Css.Define(static () => new Style
    {
        Display = Display.Grid,
        GridTemplateColumns = "6em minmax(0, 1fr) 3em",
        AlignItems = AlignItems.Center,
        Gap = Space.Sm,
        FontSize = FontSizes.Sm,
    });

    static Style Late => Css.Define(static () => new Style { Color = Tones.Danger.Text, FontWeight = FontWeights.Medium });

    static Style Track => Css.Define(static () => new Style { Height = CssLength.Em(0.5), BorderRadius = Radii.Full, BackgroundColor = Colors.Fill, Overflow = Overflow.Hidden });

    static Style Bar => Css.Define(static () => new Style { Width = BarWidth, Height = CssLength.Percent(100), BorderRadius = Radii.Full, BackgroundColor = Tones.Accent.Solid });

    static Style LateBar => Css.Define(static () => new Style { BackgroundColor = Tones.Danger.Solid });

    static Style Value => Css.Define(static () => new Style { TextAlign = TextAlign.End, FontVariantNumeric = FontVariantNumeric.TabularNums, Color = Colors.TextMuted });
}
