<Project>
  <!--
    按项目自己声明的属性区分的设置。放在 targets 而不是 props：props 在项目文件之前导入，
    那时项目里写的 IsLibrary 还没有值，条件永远不成立
  -->

  <!-- 只有对外发布的库打包；应用、测试、生成器（随 Rune 包一起发）都不单独打包 -->
  <PropertyGroup Condition="'$(IsLibrary)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 对外发布的库：NuGet 包的信息。文档注释（GenerateDocumentationFile）写在各库的项目文件里：SDK 在导入本文件之前就按它算好了 XML 文档的路径 -->
  <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
    <IsPackable>true</IsPackable>
    <!-- nuget.org 上的 Rune 已被别人占用：包 ID 一律是 RuneForBlazor.*（Rune.UI → RuneForBlazor.UI），程序集与命名空间仍是 Rune.* -->
    <PackageId>RuneForBlazor$(MSBuildProjectName.Substring(4))</PackageId>
    <Authors>kenconnet666</Authors>
    <Copyright>Copyright (c) 2026 kenconnet666</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- 包页面的“项目网站”是文档站；源码仓库在 RepositoryUrl -->
    <PackageProjectUrl>https://rune-for-blazor.zerodep.dpdns.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kenconnet666/RuneForBlazor</RepositoryUrl>
    <PackageTags>blazor;components;signals;css-in-csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink（SDK 自带）：调试时能跳进包的源码 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- WebAssembly 发布时会裁剪：声明可裁剪，同时打开裁剪分析器，用到反射的地方编译时就报出来 -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLibrary)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    库之间的依赖不排除分析器：NuGet 默认给依赖加 exclude="Build,Analyzers"，只装 RuneForBlazor.UI 的使用方就拿不到核心包里的 [State] 生成器。
    生成器、代码修复自己的引用（ReferenceOutputAssembly=false）不会变成包依赖
  -->
  <ItemDefinitionGroup Condition="'$(IsLibrary)' == 'true'">
    <ProjectReference>
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
