@*
    看起来像按钮的链接（a 元素）：<LinkButton Href="/orders/new" Icon="Lucide.Plus">新建订单</LinkButton>。
    跳转用它，执行操作用 Button。不可用时去掉 href（不能跳转），保留 aria-disabled。
    外部链接写 External：新窗口打开，文字后默认是外链箭头，读屏会听到“在新窗口打开”。
*@
@namespace Rune.UI
@inherits ButtonCore
@{ var parts = Parts(FullWidth ? ButtonShape.FullWidth : ButtonShape.Normal); }

<a @ref="Element" @attributes="Attrs.Merge(ExternalLink.Defaults(parts[ButtonPart.Root], External), UserAttrs(!Disabled && !IsLoading), Managed)">
    @RenderInner(parts, External ? ExternalText : ChildContent)
</a>

@code {
    /// <summary>链接地址。</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    /// <summary>链接文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>不可用：去掉 href，不能跳转、不在 Tab 顺序里。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>占满容器宽度。</summary>
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>外部链接：新窗口打开，默认 rel="noopener noreferrer"（可以自己写 target、rel 改掉）；没写 IconEnd 时文字后是外链箭头。</summary>
    [Parameter] public bool External { get; set; }

    /// <summary>外部链接给读屏的提示。；不写时取语言包（UIConfig.Lang）的“（在新窗口打开）”。</summary>
    [Parameter] public string? ExternalHint { get; set; }

    /// <inheritdoc/>
    protected override ButtonVariant DefaultVariant => ButtonVariant.Solid;

    /// <inheritdoc/>
    protected override Tone DefaultTone => UI.Tone.Accent;

    /// <inheritdoc/>
    protected override IconData? TrailingIcon => IconEnd ?? (External ? BuiltInIcons.ArrowUpRight : null);

    RenderFragment ExternalText => ChildContent is null ? Hint : builder =>
    {
        builder.AddContent(0, ChildContent);
        builder.AddContent(1, Hint);
    };

    RenderFragment Hint => @<VisuallyHidden>@(ExternalHint ?? Config.Lang.LinkNewWindow)</VisuallyHidden>;

    Memo<(string Href, bool Disabled, bool Loading, bool Ripple), Attrs> managed;

    /// <summary>a 上由组件管理的属性：地址（不可用时去掉）与状态；不变时复用同一个对象。外链的 target、rel 在默认层（ExternalLink）。</summary>
    Attrs Managed => managed.Get((Href, Disabled, IsLoading, RippleEnabled), static k => Attrs.Merge(
        // 链接没有原生 disabled：不可用总是 aria-disabled
        StateAttrs(k.Disabled, focusable: true, k.Loading, k.Ripple),
        new Attrs
        {
            ["href"] = k.Disabled || k.Loading ? null : k.Href,
        }));
}
