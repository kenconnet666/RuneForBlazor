@*
    图标按钮（button 元素，宽高相等）：<IconButton Icon="Lucide.Trash" Label="删除" @onclick="Remove" />。
    Label 必填：图标按钮没有文字，Label 就是它的名称（读屏读出、悬停提示）。默认无底、中性色。
*@
@namespace Rune.UI
@inherits ButtonCore
@{ var parts = Parts(ButtonShape.Square); }

<button type="button" @ref="Element" @attributes="Attrs.Merge(parts[ButtonPart.Root], UserAttrs(!IsLoading && !Disabled), Managed)">
    @RenderInner(parts, null)
</button>

@code {
    /// <summary>按钮的名称（读屏读出）；需要悬停提示时外面包一层 Tooltip。</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>不可用：原生 disabled，不能聚焦。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>不可用时仍可聚焦：改用 aria-disabled，点击无效（需要 Tooltip 说明原因时用）。</summary>
    [Parameter] public bool FocusableWhenDisabled { get; set; }

    /// <inheritdoc/>
    protected override ButtonVariant DefaultVariant => ButtonVariant.Ghost;

    /// <inheritdoc/>
    protected override Tone DefaultTone => UI.Tone.Neutral;

    Memo<(string Label, bool Disabled, bool Focusable, bool Loading, bool Ripple), Attrs> managed;

    /// <summary>button 上由组件管理的属性：名称与状态（见 <see cref="ButtonCore.StateAttrs"/>）；不变时复用同一个对象。</summary>
    Attrs Managed => managed.Get((Label, Disabled, FocusableWhenDisabled, IsLoading, RippleEnabled), static k =>
        Attrs.Merge(StateAttrs(k.Disabled, k.Focusable, k.Loading, k.Ripple), new Attrs { AriaLabel = k.Label }));
}
