@*
    按钮（button 元素）：<Button Icon="Lucide.Plus" @onclick="Add">新建</Button>。
    外观：Variant（样式）× Tone（色调）× Size × Radius；默认实底、强调色。
    点击用 @onclick（落到 button 元素上）；加载中、不可用时点击不会触发。
*@
@namespace Rune.UI
@inherits ButtonBase
@{ var parts = Parts(FullWidth ? ButtonShape.FullWidth : ButtonShape.Normal); }

<button type="@Type" @ref="Element" @attributes="Attrs.Merge(parts[ButtonPart.Root], UserAttrs(!IsLoading && !Disabled), Managed)">
    @RenderInner(parts, ChildContent)
</button>
