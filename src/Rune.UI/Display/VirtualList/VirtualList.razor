@*
    虚拟列表（同 vue-tsx-pro 的 VirtualList）：只渲染看得见的几十项，上万条数据也流畅。
    <VirtualList Items="users" EstimateSize="48" Sx="listHeight" aria-label="用户" Context="user"><UserRow User="user" /></VirtualList>
    组件自己是滚动容器（ScrollArea，浮层滚动条），高度由使用方给（Sx、class、style）。行高按 EstimateSize 估计，渲染后以实际为准（Blazor 的 Virtualize）。
    读屏：role="list"，每项带 aria-setsize / aria-posinset，没渲染的项也算在总数里；没有数据时显示 Empty（不是列表）。
    交互模式下才虚拟滚动；静态 SSR、预渲染时先输出前 InitialCount 项，交互接管后换成虚拟滚动。
    未声明的属性落到外层（ScrollArea）上；aria-label 写在这里就是列表的名称（读屏从视口读，组件转交过去）。
    还没做（阶段 7）：随页面滚动、横向、加载中的骨架行、跳到第几项、可见范围变化的回调。
*@
@namespace Rune.UI
@typeparam TItem
@inherits UIComponent
@using Microsoft.AspNetCore.Components.Web.Virtualization

<ScrollArea PropsViewport="ViewportLayer" @attributes="Attrs.MergeProps(RootLayer, Rest)">
    @if (Items.Count == 0)
    {
        @Empty
    }
    else
    {
        <div role="list" aria-label="@AriaLabel" @attributes="Attrs.Merge(null, PropsList)">
            @if (RendererInfo.IsInteractive)
            {
                <Virtualize Items="Indexes" ItemSize="EstimateSize" OverscanCount="Overscan" Context="index">@Item(index)</Virtualize>
            }
            else
            {
                for (var index = 0; index < Math.Min(InitialCount, Items.Count); index++)
                {
                    @Item(index)
                }
            }
        </div>
    }
</ScrollArea>

@code {
    static readonly Attrs RootLayer = new() { Sx = Root };
    static readonly Attrs ViewportLayer = new() { Sx = Viewport };
    // Virtualize 只要 ICollection：按序号虚拟，模板里才拿得到第几项（aria-posinset）
    Memo<int, int[]> indexes;

    /// <summary>数据。</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>渲染一项（Context 是这一项）。</summary>
    [Parameter, EditorRequired] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>每项的估计高度（px），渲染后以实际为准；默认 40。</summary>
    [Parameter] public float EstimateSize { get; set; } = 40;

    /// <summary>可见范围前后各多渲染几项，默认 4。</summary>
    [Parameter] public int Overscan { get; set; } = 4;

    /// <summary>静态渲染（没有交互时）先输出前多少项，默认 30。</summary>
    [Parameter] public int InitialCount { get; set; } = 30;

    /// <summary>没有数据时显示的内容。</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>列表层（role="list"）的部件属性。</summary>
    [Parameter] public Attrs? PropsList { get; set; }

    /// <summary>每一项外层（role="listitem"）的部件属性。</summary>
    [Parameter] public Attrs? PropsItem { get; set; }

    string? AriaLabel => AdditionalAttributes?.GetValueOrDefault("aria-label") as string;

    int[] Indexes => indexes.Get(Items.Count, static count => [.. Enumerable.Range(0, count)]);

    RenderFragment Item(int index) =>
        @<div role="listitem" aria-setsize="@Items.Count" aria-posinset="@(index + 1)" @attributes="Attrs.Merge(null, PropsItem)">@ChildContent?.Invoke(Items[index])</div>;

    // 滚到头时不带动外层页面
    static Style Root => Css.Define(static () => new Style { OverflowAnchor = OverflowAnchor.None });

    static Style Viewport => Css.Define(static () => new Style { OverscrollBehavior = OverscrollBehavior.Contain, OverflowAnchor = OverflowAnchor.None });
}
