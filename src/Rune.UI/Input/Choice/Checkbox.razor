@*
    勾选框：<Checkbox @bind-Value="agreed">我已阅读并同意</Checkbox>
    半选（表格的“全选”在部分选中时）：Indeterminate="true"，由使用方根据子项计算。原生 input，键盘、表单、读屏都是原生的。
    在 CheckboxGroup 里时写 GroupValue（这一项的值）：勾选状态、name、不可用、只读、校验未通过都来自组，不用 Value。
*@
@namespace Rune.UI
@inherits FormControl<bool>
@{ var parts = ChoiceStyles.Of(new ChoiceAppearance(ChoiceKind.Checkbox, Size, Tone, IsReadOnly), Config.Styles); }

<label data-state="@(Indeterminate ? "indeterminate" : IsChecked ? "checked" : "unchecked")" data-disabled="@(IsDisabled ? "true" : null)"
       data-readonly="@(IsReadOnly ? "true" : null)" @attributes="Attrs.Merge(parts[ChoicePart.Root], RootUserAttrs)">
    <span @attributes="Attrs.Merge(parts[ChoicePart.Control], PropsControl)">
        <input type="checkbox" @ref="Element" @attributes="Attrs.Merge(parts[ChoicePart.Input], InputUserAttrs, InputManaged)" @onclick:preventDefault="IsReadOnly" />
        <Icon Data="@(Indeterminate ? BuiltInIcons.Minus : BuiltInIcons.Check)" StrokeWidth="3" @attributes="Attrs.MergeProps(parts[ChoicePart.Indicator], PropsIndicator)" />
    </span>
    @if (ChildContent is not null)
    {
        <span @attributes="Attrs.Merge(parts[ChoicePart.Label], PropsLabel)">
            @ChildContent
            @if (Description is not null)
            {
                <span id="@descriptionId" @attributes="Attrs.Merge(parts[ChoicePart.Description])">@Description</span>
            }
        </span>
    }
</label>

@code {
    readonly string descriptionId = UniqueId.Next("checkbox-description");
    Memo<(Attrs Control, bool Checked, bool Indeterminate, string? DescribedBy, string? Name), Attrs> inputManaged;

    /// <summary>在 CheckboxGroup 里时这一项的值。</summary>
    [Parameter] public string? GroupValue { get; set; }

    /// <summary>所在的复选框组。</summary>
    [CascadingParameter] CheckboxGroupState? Group { get; set; }

    // 在组里（写了 GroupValue）：勾选与否、name、状态来自组
    CheckboxGroupState? InGroup => GroupValue is null ? null : Group;

    bool IsChecked => InGroup is { } group ? group.Checked.Contains(GroupValue!) : CurrentValue;

    /// <inheritdoc/>
    protected override InheritedControlState? InheritedState => InGroup?.State;

    /// <summary>半选：显示横线，读屏读作“部分选中”。点击后浏览器清除半选，由使用方重新计算。</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>勾上时的色调，默认品牌色。</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Accent;

    /// <summary>文字下面的说明（次要色、小一号），读屏在名称之后读出。</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>字号档位；不写时继承上下文字号。</summary>
    [Parameter] public Size? Size { get; set; }

    /// <summary>文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>文字的部件属性。</summary>
    [Parameter] public Attrs? PropsLabel { get; set; }

    /// <summary>控件格子的部件属性。</summary>
    [Parameter] public Attrs? PropsControl { get; set; }

    /// <summary>对勾的部件属性（交给 Icon）。</summary>
    [Parameter] public Attrs? PropsIndicator { get; set; }

    // input 上由组件管理的属性：表单状态、勾选、半选（原生的 indeterminate 只能用 JS 设置，JS 初始化器按 data-indeterminate 同步）
    Attrs InputManaged => inputManaged.Get((ControlAttrs, IsChecked, Indeterminate, DescribedBy, InGroup is { } group ? group.Name : FieldName), this,
        static (k, owner) => Attrs.Merge(k.Control, new Attrs
        {
            AriaDescribedBy = k.DescribedBy,
            ["checked"] = k.Checked,
            ["data-indeterminate"] = k.Indeterminate ? "true" : "false",
            // 用户点击勾上时 JS 初始化器把对勾一笔画出（初次渲染、外部改值不画）
            ["data-rune-check-draw"] = true,
            ["name"] = k.Name,
            // 在组里提交这一项的值；单独用时勾上提交 true（同 Blazor 的 InputCheckbox），绑得回 bool
            ["value"] = owner.InGroup is null ? "true" : owner.GroupValue,
            ["onchange"] = (Func<ChangeEventArgs, Task>)(e => owner.InGroup is { } group ? group.Toggle(owner.GroupValue!) : owner.SetValueAsync(e.Value is true)),
        }));

    // 自己的说明与所在 Field 的说明、错误一起关联
    string? DescribedBy => Description is null ? Field?.DescribedBy : Field?.DescribedBy is { } fromField ? $"{descriptionId} {fromField}" : descriptionId;
}
