@*
    组合输入（div，role="group"，同 vue-tsx-pro 的 ControlGroup）：输入框、选择框、按钮连成一条，共用边框：币种 + 金额、协议 + 域名、搜索框 + 搜索按钮。
    <ControlGroup aria-label="金额">
        <Select Items="currencies" @bind-Value="currency" aria-label="币种" />
        <NumberField @bind-Value="amount" aria-label="金额" />
    </ControlGroup>
    里面的输入框外壳与按钮家族经级联值（AttachedGroup）得知自己在组里：去掉相邻一侧的圆角、边框叠在一起，聚焦的那个浮到上面，焦点环完整。
    输入框默认占满剩余宽度，选择框、按钮按内容宽。只有文字的前后缀（单位、https://）用输入框自己的 Prefix / Suffix，不必拆成两个控件。
    放在 Field 里时组是 Field 的控件：标签、说明经 aria-labelledby / aria-describedby 关联到组；里面的控件不再拿 Field 的 id（会重复），各自写 aria-label。
*@
@namespace Rune.UI
@inherits UIComponent

<div @attributes="Attrs.Merge(ControlGroupStyles.Of(Orientation, Inline, Config.Styles)[ControlGroupPart.Root], Rest, Managed)">
    <CascadingValue TValue="FieldContext" Value="null" IsFixed="true">
        @* Field 的不可用、只读照常交给组里的控件（它们拿不到 Field 了）：叠在外层表单的设置上 *@
        <CascadingValue TValue="FieldLayout" Value="GroupLayout">
            <CascadingValue Value="AttachedGroup.Of(Orientation)">@ChildContent</CascadingValue>
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    Memo<(string? Id, string? LabelledBy, string? DescribedBy), Attrs> managed;

    /// <summary>排列方向，默认横排。</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>不占满一行（行内排列）；默认占满。</summary>
    [Parameter] public bool Inline { get; set; }

    /// <summary>输入框、选择框、按钮。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>所在的 Field：组是它的控件（id、标签、说明）。</summary>
    [CascadingParameter] FieldContext? Field { get; set; }

    /// <summary>外层表单的设置。</summary>
    [CascadingParameter] FieldLayout? Layout { get; set; }

    Memo<(bool Disabled, bool ReadOnly, FieldLayout? Outer), FieldLayout> groupLayout;

    FieldLayout? GroupLayout => Field is null
        ? Layout
        : groupLayout.Get((Field.Disabled, Field.ReadOnly, Layout), static k => new FieldLayout(Disabled: k.Disabled, ReadOnly: k.ReadOnly).Over(k.Outer));


    Attrs Managed => managed.Get(
        (Field?.ControlId, AdditionalAttributes?.ContainsKey("aria-label") == true ? null : Field?.LabelId, Field?.DescribedBy),
        static k => new Attrs { Id = k.Id, Role = "group", AriaLabelledBy = k.LabelledBy, AriaDescribedBy = k.DescribedBy });
}
