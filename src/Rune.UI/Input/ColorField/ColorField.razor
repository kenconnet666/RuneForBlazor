@*
    颜色输入（同 vue-tsx-pro 的 ColorField）：前面是色块（点开浏览器原生的取色器），后面可以直接输入颜色值。主题编辑器、品牌色设置这类地方用。
    <ColorField @bind-Value="brand" aria-label="品牌色" />
    - 值是 #rrggbb（有透明度时 #rrggbbaa）：输入 rgb()、hsl()、oklch()、颜色名也行（见 ColorValue），失焦或回车时规范成 #hex 写回；
      写不成颜色时外壳标为无效（aria-invalid），值不变，失焦后恢复成原来的值。输入时每次按键一次往返（Server 模式），要按草稿实时标无效。
    - 原生取色器不带透明度：用它选色时透明度去掉。
    - 接入 Field（标签、说明、错误、必填、不可用），外观同 TextField。未声明的属性落到文字输入框上；Sx 落在外壳上。
*@
@namespace Rune.UI
@inherits InputControl<string?>
@{
    var parts = InputStyles.Of(Appearance, Config.Styles);
    var own = ColorFieldStyles.Of(Config.Styles);
    var editable = !IsDisabled && !IsReadOnly;
    var hex = ColorValue.ToHex(CurrentValue);
}

<div @attributes="Attrs.Merge(parts[InputPart.Root], RootUserAttrs, ShellAttrs)" data-invalid="@(ShowInvalid ? true : null)" data-disabled="@(IsDisabled ? true : null)">
    <label @attributes="Attrs.Merge(own[ColorFieldPart.Swatch], PropsSwatch)">
        @* 没有值（或写不成颜色）时色块是空的，露出棋盘格 *@
        <span @attributes="Attrs.Merge(own[ColorFieldPart.Fill], null, FillVars(hex ?? NoColor))"></span>
        @* 原生取色器只认 #rrggbb *@
        <input type="color" @attributes="Attrs.Merge(own[ColorFieldPart.Picker], PropsPicker, PickerManaged(hex?[..7] ?? DefaultColor, editable))" />
    </label>
    @ValueElement.Input("text", Attrs.Merge(Attrs.Layer(parts[InputPart.Input], MonoInput), InputUserAttrs, InputManaged), CaptureElement)
</div>

@code {
    const string DefaultColor = "#000000";
    const string NoColor = "transparent";

    static readonly Attrs MonoInput = new() { Sx = ColorFieldStyles.MonoInput };

    Memo<string, Attrs> fillVars;
    // 正在输入的文字：写成颜色之前不写回 Value；Value 从外面变了时跟着换
    string draft = DefaultColor;
    string? draftOf;

    /// <summary>色块（包着原生取色器的 label）的部件属性。</summary>
    [Parameter] public Attrs? PropsSwatch { get; set; }

    /// <summary>原生取色器的部件属性；类型、取值、可用性与名称由组件管理。</summary>
    [Parameter] public Attrs? PropsPicker { get; set; }

    bool ShowInvalid => IsInvalid || !ColorValue.TryParse(draft, out _);

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        SyncDraft();
    }

    void SyncDraft()
    {
        if (draftOf == CurrentValue) return;
        draftOf = CurrentValue;
        draft = CurrentValue ?? DefaultColor;
    }

    Attrs FillVars(string color) => fillVars.Get(color, static c => new Attrs { Vars = [ColorFieldStyles.Color.Set(c)] });

    Attrs PickerManaged(string opaque, bool editable) => new()
    {
        ["value"] = opaque,
        ["disabled"] = editable ? null : true,
        ["aria-label"] = Config.Lang.ColorPick,
        ["oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, e => CommitAsync((string?)e.Value)),
    };

    Attrs InputManaged => Attrs.Merge(ControlAttrs, new Attrs
    {
        ["value"] = draft,
        ["spellcheck"] = "false",
        ["autocomplete"] = "off",
        ["aria-invalid"] = ShowInvalid ? "true" : null,
        ["oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, e => draft = (string?)e.Value ?? ""),
        // 失焦、回车时写回：写得成颜色就规范成 #hex，否则恢复成原来的值
        ["onchange"] = EventCallback.Factory.Create<ChangeEventArgs>(this, e => CommitAsync((string?)e.Value)),
    });

    async Task CommitAsync(string? text)
    {
        if (ColorValue.ToHex(text) is { } hex && hex != CurrentValue) await SetValueAsync(hex);
        draftOf = CurrentValue;
        draft = CurrentValue ?? DefaultColor;
    }
}
