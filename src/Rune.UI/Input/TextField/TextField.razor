@*
    文本框：<TextField @bind-Value="name" placeholder="姓名" />、<TextField @bind-Value="email" Type="email" Icon="Lucide.Mail" />
    默认失去焦点或回车时更新值；搜索框这类要边输边用的写 Immediate="true"（Server 模式下每次按键一次往返）。
    placeholder、name、autocomplete、maxlength 等落在 input 上；Sx 落在外壳上。放在 Field 里得到标签与错误信息。
    Type="password" 时有显示 / 隐藏密码的按钮（JS 初始化器切换，没有往返）；Clearable 有内容时显示清空按钮。
    Format（手机号、身份证号、银行卡号）让输入时自动分组显示：值是去掉分隔的原文，分组与光标在 JS 里。
*@
@namespace Rune.UI
@inherits InputControl<string?>
@{
    var parts = InputStyles.Of(Appearance, Config.Styles);
    var editable = !IsDisabled && !IsReadOnly;
}

<div @attributes="Attrs.Merge(parts[InputPart.Root], RootUserAttrs, ShellAttrs)">
    @if (Icon is not null)
    {
        <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[InputPart.Icon], PropsIcon)" />
    }
    @if (Prefix is not null)
    {
        <label for="@ControlId" @attributes="Attrs.Merge(parts[InputPart.Affix], PropsPrefix)">@Prefix</label>
    }
    @ValueElement.Input(Type, Attrs.Merge(InputDefaultsOver(parts[InputPart.Input]), NamedInputUserAttrs, InputManagedWithExtra), CaptureElement)
    @if (Suffix is not null)
    {
        <label for="@ControlId" @attributes="Attrs.Merge(parts[InputPart.Affix], PropsSuffix)">@Suffix</label>
    }
    @if (Clearable && editable && !string.IsNullOrEmpty(CurrentValue))
    {
        <ClearButton Label="@ClearLabel" Radius="UI.Radius.Full" @onclick="() => InputAsync(string.Empty)"
                     @attributes="Attrs.MergeProps(parts[InputPart.Button], PropsClear, RefocusInput)" />
    }
    @if (Type == "password")
    {
        <RevealButton Label="@(RevealLabel ?? Config.Lang.PasswordShow)" Radius="UI.Radius.Full" Disabled="IsDisabled" @attributes="Attrs.MergeProps(parts[InputPart.Button], PropsReveal, RevealTarget)" />
    }
    @if (ShowCount)
    {
        <CharacterCount Count="@(CurrentValue?.Length ?? 0)" Max="MaxLength" id="@CountId" @attributes="Attrs.MergeProps(null, PropsCount)" />
    }
    @if (IconEnd is not null)
    {
        <Icon Data="IconEnd" @attributes="Attrs.MergeProps(parts[InputPart.Icon], PropsIconEnd)" />
    }
</div>

@code {
    Memo<(Attrs Control, string? Value, bool Immediate, string? CountId, TextFormat? Format), Attrs> inputManaged;
    string? countId;
    Memo<string, Attrs> refocusInput, revealTarget;
    Memo<(Attrs Part, Attrs Extra), Attrs> inputDefaults;
    Memo<(Attrs Extra, Attrs Managed), Attrs> inputManagedWithExtra;

    /// <summary>input 的 type：text（默认）、email、password、search、url、tel。</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>显示格式：输入时自动分组（TextFormat.Phone、IdCard、BankCard 或自己 new），值是去掉分隔的原文。</summary>
    [Parameter] public TextFormat? Format { get; set; }

    /// <summary>每次输入都更新值；默认失去焦点或回车时更新。</summary>
    [Parameter] public bool? Immediate { get; set; }

    /// <summary>有内容时显示清空按钮。</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>前置图标。</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>后置图标。</summary>
    [Parameter] public IconData? IconEnd { get; set; }

    /// <summary>输入框前的固定文字（如 https://、¥），不算在值里。</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>输入框后的固定文字（如 .com、元），不算在值里。</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>显示字数计数；上限取 maxlength，超出时用危险色。输入时 JS 初始化器更新看得见的字数，没有往返。</summary>
    [Parameter] public bool ShowCount { get; set; }

    /// <summary>字数计数的部件属性（交给 CharacterCount）。</summary>
    [Parameter] public Attrs? PropsCount { get; set; }

    /// <summary>清空按钮的名称（读屏读出）；不写时取语言包（UIConfig.Lang）的“清空”。</summary>
    [Parameter] public string? ClearLabel { get; set; }

    /// <summary>显示 / 隐藏密码按钮的名称（读屏读出，按下状态用 aria-pressed 表示）；不写时取语言包的“显示密码”。</summary>
    [Parameter] public string? RevealLabel { get; set; }

    /// <summary>前置图标的部件属性（交给 Icon）。</summary>
    [Parameter] public Attrs? PropsIcon { get; set; }

    /// <summary>后置图标的部件属性（交给 Icon）。</summary>
    [Parameter] public Attrs? PropsIconEnd { get; set; }

    /// <summary>前缀文字的部件属性（指向输入框的 label）。</summary>
    [Parameter] public Attrs? PropsPrefix { get; set; }

    /// <summary>后缀文字的部件属性（指向输入框的 label）。</summary>
    [Parameter] public Attrs? PropsSuffix { get; set; }

    /// <summary>清空按钮的部件属性。</summary>
    [Parameter] public Attrs? PropsClear { get; set; }

    /// <summary>显示 / 隐藏密码按钮的部件属性。</summary>
    [Parameter] public Attrs? PropsReveal { get; set; }

    InputDefaults? Defaults => Config.Defaults.Get<InputDefaults>();

    // 清空后焦点回到输入框
    Attrs RefocusInput => refocusInput.Get(ControlId, static id => new Attrs { ["data-rune-refocus"] = id });

    Attrs RevealTarget => revealTarget.Get(ControlId, static id => new Attrs { ["data-rune-reveal"] = id });

    // 字数计数的 id：用到时才生成
    string CountId => countId ??= UniqueId.Next("text-field-count");

    int? MaxLength => CharacterCounting.MaxLengthOf(AdditionalAttributes);

    /// <summary>派生的预设（SearchField）给 input 加的默认属性（占位文字、名称）：排在使用方的属性之前，可以被盖掉。</summary>
    protected virtual Attrs? InputDefaultAttrs => null;

    /// <summary>派生的预设给 input 加的受管属性（事件）：与组件自己管理的合在一起，同名事件都执行。</summary>
    protected virtual Attrs? InputExtraManaged => null;

    /// <summary>输入框里的文字变了（打字、点清空）：默认就是更新值；派生的预设在这里接上自己的时机。</summary>
    protected virtual Task InputAsync(string? text) => SetValueAsync(text);

    Attrs InputDefaultsOver(Attrs part) => InputDefaultAttrs is { } extra
        ? inputDefaults.Get((part, extra), static k => Attrs.Layer(k.Part, k.Extra))
        : part;

    Attrs InputManagedWithExtra => InputExtraManaged is { } extra
        ? inputManagedWithExtra.Get((extra, InputManaged), static k => Attrs.Layer(k.Extra, k.Managed))
        : InputManaged;

    // input 上由组件管理的属性：表单状态（ControlAttrs）、值与更新值的事件、字数计数的关联；输入不变时是同一个对象
    // 有 Format 时：显示分好组的文字，写回去掉分隔的原文
    Attrs InputManaged => inputManaged.Get((ControlAttrs, CurrentValue, Immediate ?? Defaults?.Immediate ?? false, ShowCount ? CountId : null, Format), this,
        static (k, owner) => Attrs.Merge(k.Control, k.Format?.ToAttrs(), new Attrs
        {
            ["value"] = k.Format is { } format ? format.Apply(k.Value) : k.Value,
            [k.Immediate ? "oninput" : "onchange"] = (Func<ChangeEventArgs, Task>)(e =>
                owner.InputAsync(k.Format is { } format ? format.Parse((string?)e.Value) : (string?)e.Value)),
            AriaDescribedBy = CharacterCounting.DescribedBy(k.Control.AriaDescribedBy, k.CountId),
            ["data-rune-count"] = k.CountId,
        }));
}
