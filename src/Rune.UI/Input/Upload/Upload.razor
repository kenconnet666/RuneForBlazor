@*
    上传（div，同 vue-tsx-pro 的 Upload）：FileDrop 选文件，下面列出文件、上传进度、失败重试与移除。只负责界面与状态，怎样上传由 UploadAsync 决定：
    <Upload @bind-Value="files" Multiple="true" accept="image/*" MaxSize="5_000_000" UploadAsync="SendAsync" />
    - 值是 UploadFile 的列表（文件、状态、进度、错误、上传函数的返回值）；
    - 给了 UploadAsync 时选到文件就开始上传（父级放进值里的已选择文件也是），否则停在 Selected（等提交时一起上传）；移除正在上传的文件会取消（CancellationToken）；
    - 超过 MaxSize、不在 Accept 里的文件也列出来，带错误、不上传；单选（不写 Multiple）时新文件替换旧的；
    - 已有文件（之前上传过、从后端读回来的）用 UploadFile.Existing 放进值里：状态是完成，给了地址时文件名链到它，可以移除。
    - 图片墙（ListType="UploadListType.Picture"）：方形缩略图，选的图片用本地地址（JS 建的 object URL）马上显示，不等上传；
      点开看大图（墙上的图共用一个 Lightbox，按墙上的顺序左右切换）；上传中盖一层进度，失败标红；选文件的区域是墙上最后一格。
      Sortable 时拖动把手（或聚焦后用键盘）调整顺序（拖动在 JS 里，松开才交给 C#），Pasteable 时焦点在组件里按 Ctrl + V 把剪贴板里的图片加进来。
    在 Field 里时里面的 FileDrop 关联标签与错误。
*@
@namespace Rune.UI
@inherits FormControl<IReadOnlyList<UploadFile>>
@using Microsoft.AspNetCore.Components.Forms

@if (ListType == UploadListType.Picture)
{
    <div data-rune-upload-previews="@PreviewsInUse" data-rune-paste-files="@(PasteEnabled ? "" : null)" @onrunecommand="OnCommand"
         @attributes="Attrs.Merge(Attrs.Layer(UploadStyles.Root, ThumbnailVars), RootUserAttrs)">
        <div @attributes="UploadStyles.Wall">
            @* 状态变化（失败、完成）由读屏播报 *@
            <div role="list" aria-live="polite" data-rune-sortable="@(Sortable ? "grid" : null)" data-texts="@(Sortable ? SortableTexts.Of(Config.Lang) : null)"
                 data-disabled="@(IsDisabled ? "" : null)" @onrunereorder="ReorderAsync" @attributes="Attrs.Merge(UploadStyles.WallList, PropsList)">
                @foreach (var item in Files)
                {
                    var failed = item.Status == UploadStatus.Error;
                    var src = item.Rejected ? null : PreviewOf(item);
                    <div role="listitem" @key="item.Id" data-rune-sortable-item="@item.Id" data-label="@item.Name" data-state="@StateOf(item.Status)"
                         @attributes="Attrs.Merge(UploadStyles.Card, PropsItem)">
                        @if (src is not null)
                        {
                            <Image Src="@src" Alt="@item.Name" Width="Fill" Height="Fill" Radius="UI.Radius.None" Preview="true" OnPreview="() => OpenPreview(item)" />
                        }
                        else
                        {
                            <div @attributes="UploadStyles.Placeholder">
                                <Icon Data="@(failed ? BuiltInIcons.CircleExclamationPoint : BuiltInIcons.File)" @attributes="Attrs.MergeProps(UploadStyles.Icon(item.Status), PropsIcon)" />
                                @item.Name
                            </div>
                        }
                        @if (item.Status == UploadStatus.Uploading)
                        {
                            <div @attributes="UploadStyles.Overlay">
                                <Progress Size="UI.Size.Xs" Value="@PercentOf(item)" aria-label="@item.Name" @attributes="Attrs.MergeProps(UploadStyles.Progress, PropsProgress)" />
                            </div>
                        }
                        else if (failed && src is not null)
                        {
                            <div title="@item.Error" @attributes="UploadStyles.Overlay">@item.Error</div>
                        }
                        @if (item.Status == UploadStatus.Done)
                        {
                            <VisuallyHidden>@Config.Lang.UploadDone</VisuallyHidden>
                        }
                        @if (!IsReadOnly)
                        {
                            <div @attributes="UploadStyles.Actions">
                                @if (Sortable)
                                {
                                    @* 拖动的把手不出波纹 *@
                                    <ButtonBase Ripple="false" Disabled="IsDisabled" data-rune-sortable-handle aria-label="@Config.Lang.SortableHandle(item.Name)"
                                                aria-describedby="@instructionsId" aria-pressed="false" @attributes="Attrs.MergeProps(UploadStyles.Handle)">
                                        <Icon Data="BuiltInIcons.GripVertical" />
                                    </ButtonBase>
                                }
                                @if (failed && UploadAsync is not null && !item.Rejected)
                                {
                                    <IconButton Icon="BuiltInIcons.RotateCw" Variant="ButtonVariant.Ghost" Size="UI.Size.Xs" Label="@Config.Lang.UploadRetry(item.Name)"
                                                @onclick="() => StartAsync(item)" @attributes="Attrs.MergeProps(UploadStyles.Action, PropsRetry)" />
                                }
                                <IconButton Icon="BuiltInIcons.X" Variant="ButtonVariant.Ghost" Size="UI.Size.Xs" Label="@Config.Lang.UploadRemove(item.Name)" Disabled="IsDisabled"
                                            @onclick="() => RemoveAsync(item.Id)" @attributes="Attrs.MergeProps(UploadStyles.Action, PropsRemove)" />
                            </div>
                        }
                    </div>
                }
            </div>
            @if (!IsReadOnly && !IsFull)
            {
                <FileDrop @ref="drop" Accept="@Accept" Multiple="Multiple" Directory="Directory" Disabled="IsDisabled" Invalid="IsInvalid" Required="@(IsRequired && Files.Count == 0)"
                          ValueChanged="AddPicked" OnReject="AddRejected" @attributes="Attrs.MergeProps(UploadStyles.AddCard, PropsDrop)">
                    <Icon Data="BuiltInIcons.ImagePlus" />
                    @Config.Lang.UploadAddImage
                </FileDrop>
            }
        </div>
        @if (Hint is { } hint)
        {
            <span @attributes="UploadStyles.Hint">@hint</span>
        }
        @if (Sortable)
        {
            <VisuallyHidden id="@instructionsId">@Config.Lang.SortableInstructions</VisuallyHidden>
        }
        <Lightbox @bind-Open="previewing" @bind-Index="previewIndex" Items="PreviewItems" />
    </div>
}
else
{
    <div data-rune-paste-files="@(PasteEnabled ? "" : null)" @attributes="Attrs.Merge(UploadStyles.Root, RootUserAttrs)">
        @if (!IsReadOnly)
        {
            @* 选好的文件不在 FileDrop 的输入框里（选完就清空）：已有文件时不再原生必填，免得表单交不了 *@
            <FileDrop @ref="drop" Accept="@Accept" Multiple="Multiple" Directory="Directory" Disabled="IsDisabled" Invalid="IsInvalid" Required="@(IsRequired && Files.Count == 0)"
                      Description="Hint" ValueChanged="AddPicked" OnReject="AddRejected" @attributes="Attrs.MergeProps(null, PropsDrop)" />
        }
        @if (Files.Count > 0)
        {
            @* 状态变化（失败、完成）由读屏播报 *@
            <GridList Gap="SpaceScale.Xs" aria-live="polite" @attributes="Attrs.MergeProps(null, PropsList)">
                @foreach (var item in Files)
                {
                    var failed = item.Status == UploadStatus.Error;
                    <li @key="item.Id" data-state="@StateOf(item.Status)" @attributes="Attrs.Merge(UploadStyles.Item, PropsItem)">
                        <Icon Data="@(failed ? BuiltInIcons.CircleExclamationPoint : item.Status == UploadStatus.Done ? BuiltInIcons.CircleCheck : BuiltInIcons.File)"
                              @attributes="Attrs.MergeProps(UploadStyles.Icon(item.Status), PropsIcon)" />
                        <div @attributes="Attrs.Merge(UploadStyles.Body, PropsBody)">
                            <span @attributes="Attrs.Merge(UploadStyles.Name, PropsName)">@if (item.Url is { } url) { <TextLink Href="@url" Underline="LinkUnderline.Hover" target="_blank">@item.Name</TextLink> } else { @item.Name }</span>
                            @if (item.Status == UploadStatus.Uploading)
                            {
                                <Progress Size="UI.Size.Xs" Value="@PercentOf(item)" aria-label="@item.Name" @attributes="Attrs.MergeProps(UploadStyles.Progress, PropsProgress)" />
                            }
                            else
                            {
                                <span @attributes="Attrs.Merge(UploadStyles.Meta(failed), PropsMeta)">@(failed ? item.Error : SizeOf(item))@if (item.Status == UploadStatus.Done) { <VisuallyHidden> @Config.Lang.UploadDone</VisuallyHidden> }</span>
                            }
                        </div>
                        @if (failed && UploadAsync is not null && !item.Rejected && !IsReadOnly)
                        {
                            <IconButton Icon="BuiltInIcons.RotateCw" Variant="ButtonVariant.Ghost" Size="UI.Size.Sm" Label="@Config.Lang.UploadRetry(item.Name)"
                                        @onclick="() => StartAsync(item)" @attributes="Attrs.MergeProps(null, PropsRetry)" />
                        }
                        @if (!IsReadOnly)
                        {
                            <IconButton Icon="BuiltInIcons.X" Variant="ButtonVariant.Ghost" Size="UI.Size.Sm" Label="@Config.Lang.UploadRemove(item.Name)" Disabled="IsDisabled"
                                        @onclick="() => RemoveAsync(item.Id)" @attributes="Attrs.MergeProps(null, PropsRemove)" />
                        }
                    </li>
                }
            </GridList>
        }
    </div>
}
