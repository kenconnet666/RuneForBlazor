@*
    穿梭框（同 vue-tsx-pro 的 Transfer）：左边是可选的，右边是已选的，勾上之后点中间的按钮移过去（分配权限、指派成员、挑选导出的列）。
    <Transfer Items="users" ToOption="u => new(u.Id, u.Name)" @bind-Value="memberIds" Searchable="true" />
    每一边是一个可多选的 Listbox（焦点、方向键、空格勾选、虚拟滚动同 Listbox），上方是全选框、标题与“勾上 / 总数”，
    Searchable 时带搜索框（按选项文字，同 Select）。全选只管当前看得见（搜索后留下）的项。
    中间两个按钮把勾上的项移到另一边（没有勾上的时不可用），双击一项直接移过去（JS 发来 rune-command）；移动后读屏播报移了几项。
    不可用的选项（ListboxOption 的 Disabled）勾不上，也就移不动。值是右边的值，按移过去的先后排列；Items 里找不到的值不显示（也不会被删掉）。
    在 Field 里时整体是一组（role="group"，名称是 Field 的标签），两边的列表各以自己的标题为名。未声明的属性落到外层 div 上。
*@
@namespace Rune.UI
@typeparam TItem
@inherits FormControl<IReadOnlyList<string>?>
@{ var parts = TransferStyles.Of(Config.Styles); }

<div role="group" aria-labelledby="@(Field?.LabelId)" aria-describedby="@ControlAttrs.AriaDescribedBy" @attributes="Attrs.Merge(parts[TransferPart.Root], Rest)">
    @Panel(parts, 0)
    <div @attributes="Attrs.Merge(parts[TransferPart.Actions])">
        @foreach (var to in new[] { 1, 0 })
        {
            <IconButton Icon="@(to == 1 ? BuiltInIcons.ChevronRight : BuiltInIcons.ChevronLeft)" Label="@Config.Lang.TransferMoveTo(TitleOf(to))"
                        Variant="ButtonVariant.Soft" Size="UI.Size.Sm" PropsIcon="ActionIconLayer(parts)" Disabled="@(IsDisabled || checkedKeys[1 - to].Count == 0)"
                        @onclick="() => MoveAsync(1 - to, checkedKeys[1 - to])" @attributes="Attrs.MergeProps(null, PropsAction)" />
        }
    </div>
    @Panel(parts, 1)
    @* 移动后的播报：一直在 DOM 里的礼貌播报区 *@
    <span aria-live="polite" @attributes="Attrs.Merge(VisuallyHiddenLayer)">@announcement</span>
</div>

@code {
    /// <summary>一边：全选框、标题、计数、搜索框与列表。</summary>
    RenderFragment Panel(PartLayers<TransferPart> parts, int side) => __builder =>
    {
        var title = TitleOf(side);
        var titleId = $"{ControlId}-title-{side}";
        var shown = ShownEntries(side);
        var selectable = shown.Where(e => !e.Option.Disabled).Select(e => e.Option.Value).ToList();
        var visibleChecked = selectable.Count(checkedKeys[side].Contains);
        var all = selectable.Count > 0 && visibleChecked == selectable.Count;
        <section aria-labelledby="@titleId" @attributes="Attrs.Merge(parts[TransferPart.Panel], PropsPanel)">
            <div @attributes="Attrs.Merge(parts[TransferPart.Header])">
                <Checkbox Value="all" ValueChanged="next => CheckAll(side, selectable, next)" Indeterminate="@(!all && visibleChecked > 0)"
                          Disabled="@(IsDisabled || selectable.Count == 0)" aria-label="@Config.Lang.TransferSelectAll(title)" />
                <span id="@titleId" @attributes="Attrs.Merge(parts[TransferPart.Title])">@title</span>
                <Small Tone="TextTone.Muted">@Config.Lang.TransferCount(checkedKeys[side].Count, SideEntries(side).Count)</Small>
            </div>
            @if (Searchable)
            {
                <div @attributes="Attrs.Merge(parts[TransferPart.Search])">
                    <CascadingValue TValue="FieldContext" Value="null" IsFixed="true">
                        <TextField Type="search" Icon="BuiltInIcons.Search" Variant="InputVariant.Soft" Size="UI.Size.Sm" Immediate="true" Disabled="IsDisabled"
                                   Value="@searches[side]" ValueChanged="text => searches[side] = text ?? string.Empty" Sx="TransferStyles.SearchField"
                                   placeholder="@Config.Lang.SelectSearch" aria-label="@($"{Config.Lang.SelectSearch} {title}")" @attributes="Attrs.MergeProps(null, PropsSearch)" />
                    </CascadingValue>
                </div>
            }
            @* 列表各以自己的标题为名：不归外面的 Field 管 *@
            <CascadingValue TValue="FieldContext" Value="null" IsFixed="true">
                <Listbox TItem="TItem" Items="shown.Select(e => e.Item)" ToOption="ToOption" SelectionMode="SelectionMode.Multiple" Disabled="IsDisabled"
                         Values="checkedKeys[side]" ValuesChanged="keys => checkedKeys[side] = keys" id="@($"{ControlId}-{side}")" aria-labelledby="@titleId"
                         data-rune-option-dblclick @onrunecommand="e => DoubleClickAsync(side, e)" @attributes="Attrs.MergeProps(parts[TransferPart.List], PropsList)" />
            </CascadingValue>
        </section>
    };
}
