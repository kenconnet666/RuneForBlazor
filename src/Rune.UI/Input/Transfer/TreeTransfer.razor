@*
    左边是一棵树的穿梭框（同 vue-tsx-pro 的 TreeTransfer）：勾选叶子（父子联动、可搜索）移到右边。
    <TreeTransfer Items="orgs" GetKey="o => o.Id" GetLabel="o => o.Name" GetChildren="o => o.Children" @bind-Value="teamIds" Searchable="true" />
    左边是勾选的 Tree，已经移过去的节点勾上且不可用；只移叶子，值是叶子的 key（按移过去的先后）。右边、中间的按钮、播报、
    在 Field 里的名称同 Transfer。未声明的属性落到外层 div 上。
*@
@namespace Rune.UI
@typeparam TItem
@inherits FormControl<IReadOnlyList<string>?>
@{
    var parts = TransferStyles.Of(Config.Styles);
    var sourceLeaves = SourceLeaves;
}

<div role="group" aria-labelledby="@(Field?.LabelId)" aria-describedby="@ControlAttrs.AriaDescribedBy" @attributes="Attrs.Merge(parts[TransferPart.Root], Rest)">
    <TransferPanel Title="@TitleOf(0)" TitleId="@TitleId(0)" Selectable="@([.. sourceLeaves.Where(key => Matches(key, 0))])" Checked="checkedKeys[0]"
                   CheckedChanged="keys => checkedKeys[0] = keys" Total="sourceLeaves.Count" Searchable="Searchable" Search="@searches[0]"
                   SearchChanged="text => searches[0] = text ?? string.Empty" Disabled="IsDisabled" PropsSearch="PropsSearch" @attributes="Attrs.MergeProps(null, PropsPanel)">
        <Tree TItem="TItem" Items="Items" GetKey="GetKey" GetLabel="GetLabel" GetChildren="GetChildren" Checkable="true" IsDisabled="Off"
              Checked="@([.. Chosen, .. checkedKeys[0]])" CheckedChanged="SetSourceChecked" Filter="@searches[0]" @bind-Expanded="expanded"
              PropsScrollArea="Attrs.Layer(parts[TransferPart.List])" aria-labelledby="@TitleId(0)" @attributes="Attrs.MergeProps(null, PropsTree)" />
    </TransferPanel>
    <TransferActions Titles="(TitleOf(0), TitleOf(1))" CanMoveRight="@(!IsDisabled && checkedKeys[0].Count > 0)" CanMoveLeft="@(!IsDisabled && checkedKeys[1].Count > 0)"
                     OnMoveRight="() => MoveAsync(0, checkedKeys[0])" OnMoveLeft="() => MoveAsync(1, checkedKeys[1])" PropsAction="PropsAction" />
    <TransferPanel Title="@TitleOf(1)" TitleId="@TitleId(1)" Selectable="@([.. Chosen.Where(key => Matches(key, 1))])" Checked="checkedKeys[1]"
                   CheckedChanged="keys => checkedKeys[1] = keys" Total="Targets.Count" Searchable="Searchable" Search="@searches[1]"
                   SearchChanged="text => searches[1] = text ?? string.Empty" Disabled="IsDisabled" PropsSearch="PropsSearch" @attributes="Attrs.MergeProps(null, PropsPanel)">
        <Listbox TItem="ListboxOption" Items="@([.. Targets.Where(option => Matches(option.Value, 1))])" SelectionMode="SelectionMode.Multiple" Disabled="IsDisabled"
                 Values="checkedKeys[1]" ValuesChanged="keys => checkedKeys[1] = keys" id="@($"{ControlId}-1")" aria-labelledby="@TitleId(1)"
                 data-rune-option-dblclick @onrunecommand="DoubleClickAsync" @attributes="Attrs.MergeProps(parts[TransferPart.List], PropsList)" />
    </TransferPanel>
    @* 移动后的播报：一直在 DOM 里的礼貌播报区 *@
    <span aria-live="polite" @attributes="Attrs.Merge(VisuallyHiddenLayer)">@announcement</span>
</div>
