<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- 组件库：主题 tokens 与组件 -->
  <PropertyGroup>
    <IsLibrary>true</IsLibrary>
    <!-- 公开成员必须写文档注释（CS1591 视为错误）；XML 文档也给文档站的 API 表用 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Rune.UI</RootNamespace>
    <Description>基于 Rune 的 Blazor 组件库：主题与 tokens、组件默认值与按部件的样式定制、组件。</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- 组件的样式表不公开（外观定制走 Components 入口与部件属性），测试与基准要直接核对 -->
    <InternalsVisibleTo Include="Rune.Tests" />
    <InternalsVisibleTo Include="Rune.Benchmarks" />
    <!-- 日期包用组件库内部的样式工具（层、输入框与列表项的样式），不为分包把它们公开 -->
    <InternalsVisibleTo Include="Rune.UI.Dates" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rune\Rune.csproj" />
    <!-- [State] 生成器：以分析器方式引用，不进入程序集引用 -->
    <ProjectReference Include="..\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Rune.CodeFixes\Rune.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- 组件库自己的分析器级别（RUNE007：组件内部不写 px） -->
    <GlobalAnalyzerConfigFiles Include="components.globalconfig" />
  </ItemGroup>

</Project>
