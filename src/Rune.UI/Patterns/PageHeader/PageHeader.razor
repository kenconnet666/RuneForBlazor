@*
    页头（header，同 vue-tsx-pro 的 PageHeader）：面包屑、返回、标题与标记、说明、结束边的操作，下面还可以放摘要或标签页。
    列表页、详情页、表单页开头都是这一块，不用每页自己拿 Flex 拼。
    <PageHeader Title="@order.Id" Breadcrumbs="@([new("采购单", "/orders"), new(order.Id)])" BackHref="/orders">
        <Meta><Badge Tone="Tone.Success">已到货</Badge></Meta>
        <Description>华辰精密 · 2026-10-20 下单</Description>
        <Actions><Button Variant="ButtonVariant.Outline">编辑</Button><Button>催单</Button></Actions>
    </PageHeader>
    - 标题是 h1（HeadingLevel 可改），标题与说明在 hgroup 里；放不下时操作换到下一行，手机上标题占满一行。
    - 返回：给 OnBack 是按钮，给 BackHref 是链接（能在新标签页打开）；名称取文案（“返回”）。
    - ChildContent 放在最下面：摘要（Descriptions）、标签页（TabList）。
*@
@namespace Rune.UI
@inherits UIComponent
@{ var parts = PageHeaderStyles.Of(Config.Styles); }

<header @attributes="Attrs.Merge(parts[PageHeaderPart.Root], Rest)">
    @if (Breadcrumbs is { Count: > 0 })
    {
        <Breadcrumbs Items="Breadcrumbs" @attributes="Attrs.MergeProps(parts[PageHeaderPart.Breadcrumbs], PropsBreadcrumbs)" />
    }
    <div @attributes="Attrs.Merge(parts[PageHeaderPart.Main], PropsMain)">
        @if (BackHref is not null)
        {
            <IconLinkButton Href="@BackHref" Icon="BuiltInIcons.ArrowLeft" Label="@BackLabel" PropsIcon="FlippedIcon" @onclick="OnBack"
                            @attributes="Attrs.MergeProps(parts[PageHeaderPart.Back], PropsBack)" />
        }
        else if (OnBack.HasDelegate)
        {
            <IconButton Icon="BuiltInIcons.ArrowLeft" Label="@BackLabel" PropsIcon="FlippedIcon" @onclick="OnBack"
                        @attributes="Attrs.MergeProps(parts[PageHeaderPart.Back], PropsBack)" />
        }
        <hgroup @attributes="Attrs.Merge(parts[PageHeaderPart.Heading], PropsHeading)">
            <div @attributes="Attrs.Merge(parts[PageHeaderPart.TitleRow], PropsTitleRow)">
                @* 标题的字号固定是 Xxl（级别只决定语义），可以用 PropsTitle 改 *@
                @switch (HeadingLevel)
                {
                    case 2:
                        <H2 Size="Size.Xxl" @attributes="Attrs.MergeProps(parts[PageHeaderPart.Title], PropsTitle)">@Title</H2>
                        break;
                    case 3:
                        <H3 Size="Size.Xxl" @attributes="Attrs.MergeProps(parts[PageHeaderPart.Title], PropsTitle)">@Title</H3>
                        break;
                    default:
                        <H1 Size="Size.Xxl" @attributes="Attrs.MergeProps(parts[PageHeaderPart.Title], PropsTitle)">@Title</H1>
                        break;
                }
                @if (Meta is not null)
                {
                    <div @attributes="Attrs.Merge(parts[PageHeaderPart.Meta], PropsMeta)">@Meta</div>
                }
            </div>
            @if (Description is not null)
            {
                <Paragraph Tone="TextTone.Muted" @attributes="Attrs.MergeProps(parts[PageHeaderPart.Description], PropsDescription)">@Description</Paragraph>
            }
        </hgroup>
        @if (Actions is not null)
        {
            <div @attributes="Attrs.Merge(parts[PageHeaderPart.Actions], PropsActions)">@Actions</div>
        }
    </div>
    @ChildContent
</header>

@code {
    // 返回的箭头在从右到左的排版里翻过来
    static readonly Attrs FlippedIcon = new() { [nameof(Icon.FlipInRtl)] = true };

    /// <summary>标题。</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>标题下面的说明。</summary>
    [Parameter] public RenderFragment? Description { get; set; }

    /// <summary>标题的级别（1–3），默认 1：整页的页头是 1；嵌在页面里的一块（抽屉、分栏的右侧）用 2、3。</summary>
    [Parameter] public int HeadingLevel { get; set; } = 1;

    /// <summary>面包屑：最后一项是当前页。</summary>
    [Parameter] public IReadOnlyList<BreadcrumbItem>? Breadcrumbs { get; set; }

    /// <summary>标题后面的标记：状态、标签。</summary>
    [Parameter] public RenderFragment? Meta { get; set; }

    /// <summary>结束边的操作：按钮；放不下时换到标题下面一行。</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>点了返回（给了它就显示返回按钮）。</summary>
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>返回的地址：给了它返回是一个链接；和 <see cref="OnBack"/> 都给时用链接，点击时也调用 OnBack。</summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>面包屑的部件属性。</summary>
    [Parameter] public Attrs? PropsBreadcrumbs { get; set; }

    /// <summary>标题行（返回、标题、操作）的部件属性。</summary>
    [Parameter] public Attrs? PropsMain { get; set; }

    /// <summary>返回按钮的部件属性（给了 BackHref 时是图标链接按钮）。</summary>
    [Parameter] public Attrs? PropsBack { get; set; }

    /// <summary>标题与说明外层（hgroup）的部件属性。</summary>
    [Parameter] public Attrs? PropsHeading { get; set; }

    /// <summary>标题与标记那一行的部件属性。</summary>
    [Parameter] public Attrs? PropsTitleRow { get; set; }

    /// <summary>标题的部件属性。</summary>
    [Parameter] public Attrs? PropsTitle { get; set; }

    /// <summary>标记外层的部件属性。</summary>
    [Parameter] public Attrs? PropsMeta { get; set; }

    /// <summary>说明的部件属性。</summary>
    [Parameter] public Attrs? PropsDescription { get; set; }

    /// <summary>操作外层的部件属性。</summary>
    [Parameter] public Attrs? PropsActions { get; set; }

    /// <summary>页头下面的内容：摘要、标签页。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string BackLabel => Config.Lang.Patterns.PageHeaderBack;
}
