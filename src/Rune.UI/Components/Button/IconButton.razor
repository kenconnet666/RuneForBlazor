@*
    图标按钮（button 元素，宽高相等）：<IconButton Icon="Lucide.Trash" Label="删除" @onclick="Remove" />。
    Label 必填：图标按钮没有文字，Label 就是它的名称（读屏读出、悬停提示）。默认无底、中性色。
*@
@namespace Rune.UI
@inherits ButtonBase
@{ var parts = Parts(ButtonShape.Square); }

<button type="button" @attributes="Attrs.Merge(parts[ButtonPart.Root], UserAttrs(!Loading && !Disabled), Managed)">
    @RenderInner(parts, null)
</button>

@code {
    /// <summary>按钮的名称（读屏读出，也作为悬停提示）。</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>不可用（原生 disabled）。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <inheritdoc/>
    protected override ButtonVariant DefaultVariant => ButtonVariant.Ghost;

    /// <inheritdoc/>
    protected override Tone DefaultTone => UI.Tone.Neutral;

    Memo<(string Label, bool Disabled, bool Loading, bool Ripple), Attrs> managed;

    /// <summary>button 上由组件管理的属性：名称、不可用、加载中、波纹；不变时复用同一个对象。</summary>
    Attrs Managed => managed.Get((Label, Disabled, Loading, RippleEnabled), static k => new Attrs
    {
        AriaLabel = k.Label,
        Title = k.Label,
        ["disabled"] = k.Disabled ? true : null,
        ["aria-busy"] = k.Loading ? "true" : null,
        AriaDisabled = k.Loading ? true : null,
        ["data-loading"] = k.Loading ? true : null,
        ["data-rune-ripple"] = k.Ripple ? true : null,
    });
}
