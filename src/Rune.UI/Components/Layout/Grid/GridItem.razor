@*
    Grid 里的单元格（div）：跨列。<GridItem Span="2">…</GridItem>、<GridItem FullRow="true">…</GridItem>
    不跨列的单元格不需要它，直接放子元素。
*@
@namespace Rune.UI
@inherits UIComponent

<div @attributes="Attrs.Merge(LayoutStyles.GridItem(FullRow ? int.MaxValue : Span, Config.Styles)[LayoutPart.Root], Rest)">@ChildContent</div>

@code {
    /// <summary>跨几列。</summary>
    [Parameter] public int? Span { get; set; }

    /// <summary>占满一整行（不论有几列），优先于 <see cref="Span"/>。</summary>
    [Parameter] public bool FullRow { get; set; }

    /// <summary>单元格内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
