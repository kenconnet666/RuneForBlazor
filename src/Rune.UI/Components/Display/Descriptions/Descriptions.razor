@*
    描述列表（div > dl，同 vue-tsx-pro 的 Descriptions）：键值对的详情（订单信息、用户资料），可分栏、可跨列，标签在左（横排）或在上（竖排）。
    语义是 dl > div > dt + dd（HTML 允许用 div 给 dt / dd 分组），读屏按“名称、值”念。参考 Ant Design Descriptions。
    <Descriptions Title="订单信息" Columns="3">
        <DescriptionsItem Label="订单号" Value="A-1024" Copyable="true" />
        <DescriptionsItem Label="状态"><Badge Tone="Tone.Success">已发货</Badge></DescriptionsItem>
        <DescriptionsItem Label="收货地址" Span="3">@address</DescriptionsItem>
    </Descriptions>
    固定栏数时容器窄于 32em 自动排成一列（容器查询）。写了 MinItemWidth 时按容器的宽度自己定栏数：每栏不窄于它，最多 MaxColumns 栏
    （同一份详情放在抽屉、整页里各自合适），同 Grid 的 MinItemWidth；跨列（Span）按算出的栏数封顶。都是容器查询，不量宽度、没有往返。
*@
@namespace Rune.UI
@inherits UIComponent

@{ var parts = Context.Parts; }
<div @attributes="Attrs.Merge(parts[DescriptionsPart.Root], Rest, Managed)">
    @if (TitleContent is not null || Title is not null)
    {
        <div @attributes="Attrs.Merge(parts[DescriptionsPart.Title], PropsTitle)">@(TitleContent ?? (RenderFragment)(b => b.AddContent(0, Title)))</div>
    }
    <dl @attributes="Attrs.Merge(parts[DescriptionsPart.List], PropsList)">
        <CascadingValue Value="Context">@ChildContent</CascadingValue>
    </dl>
</div>

@code {
    Memo<DescriptionsLayout, Attrs> managed;

    /// <summary>标题（文字）。</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>标题（任意内容），盖过 <see cref="Title"/>。</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>固定分几栏，默认 1；写了 <see cref="MinItemWidth"/> 时以后者为准。</summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>每栏的最小宽度：按容器的宽度自己定栏数（最多 <see cref="MaxColumns"/> 栏）。vue-tsx-pro 的 columns="auto" 默认 240px。</summary>
    [Parameter] public CssLength? MinItemWidth { get; set; }

    /// <summary>自适应栏数时最多几栏，默认 4。</summary>
    [Parameter] public int MaxColumns { get; set; } = 4;

    /// <summary>标签与值的排列，默认横排。</summary>
    [Parameter] public DescriptionsLayout Layout { get; set; }

    /// <summary>带边框（表格样式）：标签有底色，各项之间有分隔线。</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>字号档位；不写时继承。</summary>
    [Parameter] public Size? Size { get; set; }

    /// <summary>各项（DescriptionsItem）。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>标题的部件属性。</summary>
    [Parameter] public Attrs? PropsTitle { get; set; }

    /// <summary>列表（dl）的部件属性。</summary>
    [Parameter] public Attrs? PropsList { get; set; }

    /// <summary>每一项（div）的部件属性；单独一项的属性直接写在 DescriptionsItem 上。</summary>
    [Parameter] public Attrs? PropsItem { get; set; }

    /// <summary>名称（dt）的部件属性。</summary>
    [Parameter] public Attrs? PropsLabel { get; set; }

    /// <summary>值（dd）的部件属性。</summary>
    [Parameter] public Attrs? PropsValue { get; set; }

    /// <summary>复制按钮的部件属性（交给 CopyButton 组件）。</summary>
    [Parameter] public Attrs? PropsCopy { get; set; }

    DescriptionsAppearance Appearance => new(Layout, Bordered, Size, Math.Max(1, Columns), MinItemWidth, Math.Max(1, MaxColumns));

    DescriptionsContext Context => new(Appearance, DescriptionsStyles.Of(Appearance, Config.Styles), PropsItem, PropsLabel, PropsValue, PropsCopy);

    Attrs Managed => managed.Get(Layout, static layout => new Attrs { ["data-layout"] = layout.ToString().ToLowerInvariant() });
}
