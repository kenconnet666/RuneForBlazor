@*
    卡片（div）：把一组相关内容放在一块表面上。页头、页脚可选，与正文之间有分隔线。
    <Card>
        <Header>超时最久的项目</Header>
        <Extra><TextLink Href="/overdue">全部</TextLink></Extra>
        <ChildContent>…</ChildContent>
        <Footer><Button>查看</Button></Footer>
    </Card>
    标题需要标题语义时在 Header 里放 H2/H3；需要语义容器（article、section）时在外面包。
*@
@namespace Rune.UI
@inherits UIComponent
@{ var parts = CardStyles.Of(CardAppearance.Resolve(Variant, Padding, Radius, Extra is not null, Config), Config.Styles); }

<div @attributes="Attrs.Merge(parts[CardPart.Root], Rest)">
    @if (Header is not null || Extra is not null)
    {
        <div @attributes="Attrs.Merge(parts[CardPart.Header], PropsHeader)">@Header@Extra</div>
    }
    <div @attributes="Attrs.Merge(parts[CardPart.Body], PropsBody)">@ChildContent</div>
    @if (Footer is not null)
    {
        <div @attributes="Attrs.Merge(parts[CardPart.Footer], PropsFooter)">@Footer</div>
    }
</div>

@code {
    /// <summary>样式，默认表面色加细边框。</summary>
    [Parameter] public CardVariant? Variant { get; set; }

    /// <summary>页头、正文、页脚的内边距档位，默认 Lg。</summary>
    [Parameter] public SpaceScale? Padding { get; set; }

    /// <summary>圆角，默认大圆角。</summary>
    [Parameter] public Radius? Radius { get; set; }

    /// <summary>页头：标题（文字或 H3）、操作；与正文之间有分隔线。</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>页头结束边的内容（“全部 ↗”、标记、按钮）：和 Header 排在一行，放不下时换行。</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>页脚：操作按钮。</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>正文。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>页头的部件属性。</summary>
    [Parameter] public Attrs? PropsHeader { get; set; }

    /// <summary>正文的部件属性。</summary>
    [Parameter] public Attrs? PropsBody { get; set; }

    /// <summary>页脚的部件属性。</summary>
    [Parameter] public Attrs? PropsFooter { get; set; }
}
