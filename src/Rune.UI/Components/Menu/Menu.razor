@*
    菜单（下拉菜单）：一组操作。
    <Menu>
        <Trigger Context="t"><IconButton @attributes="t" Icon="Lucide.Ellipsis" Label="更多操作" /></Trigger>
        <ChildContent>
            <MenuItem Icon="Lucide.Pencil" @onclick="Edit">编辑</MenuItem>
            <MenuSeparator />
            <MenuItem Icon="Lucide.Trash" Tone="Tone.Danger" @onclick="Delete">删除</MenuItem>
        </ChildContent>
    </Menu>
    打开时焦点在第一项，方向键、Home / End、首字母移动，Enter 选择，Esc 或 Tab 关闭；选了一项菜单自动关闭。
    菜单项很轻，一开始就渲染（打开时 JS 要立即聚焦第一项）。
*@
@namespace Rune.UI
@inherits PopoverBase

@{ var overlay = OverlayAttrs(role: "menu"); }

@Trigger?.Invoke(TriggerAttrs)
<div @attributes="Attrs.Merge(MenuStyles.Of(Placement, Config.Styles)[MenuPart.Root], Rest, overlay)" @onrunetoggle="HandleToggle">
    @ChildContent
</div>

@code {
    /// <summary>菜单项（MenuItem、MenuSeparator）。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc/>
    protected override string HasPopup => "menu";
}
