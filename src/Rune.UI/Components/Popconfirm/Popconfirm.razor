@*
    气泡确认：在触发元素旁边问一句再执行（删除一行、撤销发布），比对话框轻。
    <Popconfirm Title="删除这条记录？" Description="删除后无法恢复。" ConfirmText="删除" Tone="Tone.Danger" OnConfirm="Delete">
        <Trigger Context="t"><Button @attributes="t" Variant="ButtonVariant.Ghost" Tone="Tone.Danger">删除</Button></Trigger>
    </Popconfirm>
    打开时焦点在“取消”上（不小心按回车也不会执行）；确认或取消后关闭，焦点回到触发元素。
*@
@namespace Rune.UI
@inherits UIComponent
@{ var parts = PopconfirmStyles.Of(Config.Styles); }

<Popover Role="alertdialog" Placement="Placement" Trigger="Trigger" Lazy="false" aria-labelledby="@titleId" @attributes="Rest">
    <div @attributes="Attrs.Merge(parts[PopconfirmPart.Body])">
        <Icon Data="@(Icon ?? BuiltInIcons.TriangleExclamationPoint)" Tone="Tone" @attributes="Attrs.MergeProps(parts[PopconfirmPart.Icon], PropsIcon)" />
        <div>
            <div id="@titleId" @attributes="Attrs.Merge(parts[PopconfirmPart.Title], PropsTitle)">@Title</div>
            @if (Description is not null)
            {
                <div @attributes="Attrs.Merge(parts[PopconfirmPart.Description], PropsDescription)">@Description</div>
            }
        </div>
    </div>
    <div @attributes="Attrs.Merge(parts[PopconfirmPart.Actions], PropsActions)">
        <Button Size="UI.Size.Sm" Variant="ButtonVariant.Ghost" Tone="UI.Tone.Neutral" data-rune-close autofocus @onclick="OnCancel">@CancelText</Button>
        <Button Size="UI.Size.Sm" Tone="Tone" data-rune-close @onclick="OnConfirm">@ConfirmText</Button>
    </div>
</Popover>

@code {
    readonly string titleId = UniqueId.Next("popconfirm-title");

    /// <summary>要确认的问题（也是浮层的名称）。</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>补充说明（后果）。</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>确认按钮的文字。</summary>
    [Parameter] public string ConfirmText { get; set; } = "确定";

    /// <summary>取消按钮的文字。</summary>
    [Parameter] public string CancelText { get; set; } = "取消";

    /// <summary>色调：确认按钮与图标的颜色，默认警告色；删除这类不可撤销的操作写 Danger。</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Warning;

    /// <summary>标题前的图标；不写时是警示三角。</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>确认后。</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>取消后（点取消按钮；点外面、按 Esc 关闭不算）。</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>触发元素：参数是要加在它上面的属性。</summary>
    [Parameter] public RenderFragment<Attrs>? Trigger { get; set; }

    /// <summary>相对触发元素的位置，默认下方。</summary>
    [Parameter] public Placement Placement { get; set; }

    /// <summary>图标的部件属性（交给 Icon）。</summary>
    [Parameter] public Attrs? PropsIcon { get; set; }

    /// <summary>标题的部件属性。</summary>
    [Parameter] public Attrs? PropsTitle { get; set; }

    /// <summary>说明的部件属性。</summary>
    [Parameter] public Attrs? PropsDescription { get; set; }

    /// <summary>按钮区的部件属性。</summary>
    [Parameter] public Attrs? PropsActions { get; set; }
}
