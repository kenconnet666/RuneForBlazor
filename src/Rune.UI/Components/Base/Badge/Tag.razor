@*
    标签（span）：外观同 Badge，可以带移除按钮。技能、分类、筛选条件这类成组出现的短文字用它。
    <Tag OnRemove="() => filters.Remove(item)">@item</Tag>
    给了 OnRemove 才显示移除按钮：点击后标签先淡出缩小，离场结束才调用 OnRemove（JS 初始化器做，没有往返）；
    标签随后被移除时焦点交给同组的下一个（没有就上一个）可聚焦元素，没被移除就重新显示。
*@
@namespace Rune.UI
@inherits UIComponent
@{ var parts = BadgeStyles.Of(BadgeAppearance.Resolve(Variant, Tone, Size, Radius, Config, OnRemove.HasDelegate ? BadgeKind.RemovableTag : BadgeKind.Tag), Config.Styles); }

@if (OnRemove.HasDelegate)
{
    <span @attributes="Attrs.Merge(parts[BadgePart.Root], Rest, Dismissible)">
        @if (Icon is not null)
        {
            <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[BadgePart.Icon], PropsIcon)" />
        }
        @* 文字与移除按钮之间不留空白 *@
        @ChildContent<CloseButton Label="@RemoveLabel" Radius="UI.Radius.Full" @attributes="Attrs.MergeProps(parts[BadgePart.Remove], PropsRemove, dismissButton)" />
    </span>
}
else
{
    <span @attributes="Attrs.Merge(parts[BadgePart.Root], Rest)">
        @if (Icon is not null)
        {
            <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[BadgePart.Icon], PropsIcon)" />
        }
        @ChildContent
    </span>
}

@code {
    static readonly Attrs dismissButton = new() { ["data-rune-dismiss"] = true };

    /// <summary>样式，默认浅色底。</summary>
    [Parameter] public BadgeVariant? Variant { get; set; }

    /// <summary>色调，默认中性。</summary>
    [Parameter] public Tone? Tone { get; set; }

    /// <summary>字号档位，默认 Xs。</summary>
    [Parameter] public Size? Size { get; set; }

    /// <summary>圆角，默认 Sm。</summary>
    [Parameter] public Radius? Radius { get; set; }

    /// <summary>文字前的图标。</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>标签的文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>给了就显示移除按钮；离场动画结束后调用，由使用方把标签从列表里拿掉。</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>移除按钮的名称（读屏读出），默认“移除”；建议写成“移除 张三”这样能区分的说法。</summary>
    [Parameter] public string RemoveLabel { get; set; } = "移除";

    /// <summary>图标的部件属性。</summary>
    [Parameter] public Attrs? PropsIcon { get; set; }

    /// <summary>移除按钮（CloseButton）的部件属性。</summary>
    [Parameter] public Attrs? PropsRemove { get; set; }

    Attrs? dismissible;

    // 可移除时根元素上由组件管理的属性：标记与离场结束的事件；只建一次
    Attrs Dismissible => dismissible ??= new Attrs
    {
        ["data-rune-dismissible"] = true,
        ["onrunedismiss"] = EventCallback.Factory.Create<EventArgs>(this, () => OnRemove.InvokeAsync()),
    };
}
