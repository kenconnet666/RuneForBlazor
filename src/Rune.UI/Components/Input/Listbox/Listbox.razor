@*
    列表框（role="listbox"）：在一列选项里单选或多选（同 vue-tsx-pro 的 Listbox）。
    <Listbox Items="cities" @bind-Value="city" aria-label="城市" />
    <Listbox Items="tags" SelectionMode="SelectionMode.Multiple" @bind-Values="picked" aria-label="标签" />
    <Listbox Items="users" ToOption="u => new(u.Id, u.Name)" @bind-Value="userId" aria-label="成员" />
    选项是 ListboxOption（值、文字、不可用、说明、图标、分组）或字符串，别的数据用 ToOption 转换；自定义内容的 ChildContent 拿到原始数据。
    焦点在列表上，高亮项经 aria-activedescendant 告诉读屏：↑↓、Home / End、Page Up / Down 移动，Enter / 空格选中，按字母跳到以它开头的项
    （JS 初始化器在浏览器里移动高亮，不用每按一次方向键往返一次；选中才回到 C#）。
    Loading：选项换成骨架行（很快返回时不显示，见 DelayedLoading），列表带 aria-busy。
    选项多时（交互模式下超过 VirtualThreshold 个）虚拟滚动：只渲染看得见的几十行（Blazor 的 Virtualize），
    全部选项的文字与不可用写在列表的 data-rune-options 上，键盘照样能移到任何一项。静态 SSR 没法按滚动加载，全部渲染。
*@
@using Microsoft.AspNetCore.Components.Web.Virtualization
@namespace Rune.UI
@typeparam TItem
@inherits FormControl<string?>
@{
    var parts = ListboxStyles.Of(ownScroll: true, Config.Styles);
    var entries = Entries;
    var rows = Rows;
}

<div @attributes="Attrs.Merge(parts[ListboxPart.Root], Rest, RootManaged)">
    @if (indicator.Shown)
    {
        for (var row = 0; row < SkeletonRows; row++)
        {
            <Skeleton @key="row" Delay="@(row * ShimmerStyles.Stagger)" @attributes="Attrs.MergeProps(parts[ListboxPart.Skeleton], SkeletonWidths[row], PropsSkeleton)" />
        }
    }
    else if (entries.Count == 0)
    {
        @* 加载刚开始、骨架还没到显示的时候（防闪烁）先空着 *@
        if (!Loading)
        {
            @(Empty ?? DefaultEmpty)
        }
    }
    else
    {
        if (IsVirtual)
        {
            <Virtualize Items="rows" ItemSize="EstimatedRowHeight" OverscanCount="6" Context="row">@RenderRow(row, parts, entries)</Virtualize>
        }
        else
        {
            foreach (var row in rows)
            {
                @RenderRow(row, parts, entries)
            }
        }
    }
</div>

@code {
    static readonly Attrs LabelLayer = new() { Sx = ItemStyles.Label };

    /// <summary>选项超过这么多个（且在交互模式下）时虚拟滚动；不多时全部渲染：DOM 小，滚动、页内查找都是原生的。</summary>
    public const int VirtualThreshold = 100;

    // 一行的估计高度（px）：虚拟滚动据此算占位，渲染后以实际高度为准
    const float EstimatedRowHeight = 36;

    // 加载中显示几行骨架，一行比一行短
    const int SkeletonRows = 4;
    static readonly Attrs[] SkeletonWidths = [.. Enumerable.Range(0, SkeletonRows).Select(row => new Attrs { InlineStyle = $"width:{85 - row * 15}%" })];

    RenderFragment? defaultEmpty;
    RenderFragment DefaultEmpty => defaultEmpty ??=
        @<Empty Size="Size.Sm" HideIcon Description="@(b => b.AddContent(0, Config.Lang.SelectEmpty))" @attributes="Attrs.MergeProps(PropsEmpty)" />;

    DelayedLoading? delayedLoading;
    DelayedLoading indicator => delayedLoading ??= new(() => InvokeAsync(StateHasChanged));

    Memo<(IEnumerable<TItem> Items, Func<TItem, ListboxOption>? ToOption), IReadOnlyList<ListEntry<TItem>>> entries;
    Memo<IReadOnlyList<ListEntry<TItem>>, ListRow[]> rows;
    Memo<IReadOnlyList<ListEntry<TItem>>, string> optionTable;
    Memo<(Attrs Control, string? LabelledBy, bool Multiple, bool Disabled, bool Loading, string? Options, int Selected), Attrs> rootManaged;

    /// <summary>数据：ListboxOption、字符串，或任意数据加 ToOption。</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];

    /// <summary>数据 → 选项（值、文字、不可用、分组……）；Items 是 ListboxOption 或字符串时可以不写。</summary>
    [Parameter] public Func<TItem, ListboxOption>? ToOption { get; set; }

    /// <summary>单选（默认，值是 Value）或多选（值是 Values）。</summary>
    [Parameter] public SelectionMode SelectionMode { get; set; }

    /// <summary>多选时选中的值。</summary>
    [Parameter] public IReadOnlyList<string>? Values { get; set; }

    /// <summary>多选时选择变了。</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>加载中：选项换成骨架行（很快返回时不显示），列表带 aria-busy。</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>点选了一项（点击或 Enter；再选已选的那项也会调用）：放在弹层里时据此关闭。</summary>
    [Parameter] public EventCallback<string> OnPick { get; set; }

    /// <summary>自定义选项内容：拿到 Items 里的原始数据与是否已选。</summary>
    [Parameter] public RenderFragment<ListOptionState<TItem>>? ChildContent { get; set; }

    /// <summary>没有选项时显示的内容；不写时是 Empty（文案取语言包）。</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>选项的部件属性。</summary>
    [Parameter] public Attrs? PropsOption { get; set; }

    /// <summary>分组标题的部件属性。</summary>
    [Parameter] public Attrs? PropsGroupLabel { get; set; }

    /// <summary>已选标记的部件属性（交给 Icon）。</summary>
    [Parameter] public Attrs? PropsCheck { get; set; }

    /// <summary>空状态的部件属性（交给 Empty）。</summary>
    [Parameter] public Attrs? PropsEmpty { get; set; }

    /// <summary>加载中占位行的部件属性（交给 Skeleton）。</summary>
    [Parameter] public Attrs? PropsSkeleton { get; set; }

    IReadOnlyList<ListEntry<TItem>> Entries => entries.Get((Items, ToOption), static k => ListState.Entries(k.Items, k.ToOption));

    ListRow[] Rows => rows.Get(Entries, static entries => ListState.Rows(entries));

    bool IsVirtual => RendererInfo.IsInteractive && Entries.Count > VirtualThreshold;

    // 虚拟滚动时交给 JS 的选项表：看不见的选项不在 DOM 里，键盘移动、类型搜索要用它们的文字与是否不可用
    string? OptionTable => IsVirtual ? optionTable.Get(Entries, static entries => ListboxInterop.OptionTable(entries)) : null;

    // 虚拟滚动时第一个已选的可用项的序号：列表获得焦点时高亮它（它可能没渲染）
    int FirstSelectedIndex()
    {
        if (!IsVirtual) return -1;
        var entries = Entries;
        for (var index = 0; index < entries.Count; index++)
        {
            var option = entries[index].Option;
            if (!option.Disabled && IsSelected(option.Value)) return index;
        }
        return -1;
    }

    IReadOnlyList<string> Selected => SelectionMode == SelectionMode.Multiple
        ? Values ?? []
        : CurrentValue is { } value ? [value] : [];

    bool IsSelected(string value) => SelectionMode == SelectionMode.Multiple ? Values?.Contains(value) == true : CurrentValue == value;

    // 列表上由组件管理的属性：角色、可聚焦、多选、表单状态（Field 的标签经 aria-labelledby 命名）、交给 JS 的键盘约定
    Attrs RootManaged => rootManaged.Get(
        (ControlAttrs, AdditionalAttributes?.ContainsKey("aria-label") == true ? null : Field?.LabelId, SelectionMode == SelectionMode.Multiple, IsDisabled, Loading,
            OptionTable, FirstSelectedIndex()),
        static k => new Attrs
        {
            Id = k.Control.Id,
            Role = "listbox",
            ["tabindex"] = k.Disabled ? "-1" : "0",
            AriaLabelledBy = k.LabelledBy,
            AriaDescribedBy = k.Control.AriaDescribedBy,
            ["aria-multiselectable"] = k.Multiple ? "true" : null,
            AriaDisabled = k.Disabled ? true : null,
            ["aria-required"] = k.Control["aria-required"],
            ["aria-invalid"] = k.Control["aria-invalid"],
            ["aria-busy"] = k.Loading ? "true" : null,
            // 列表自己有焦点：空格选中、字母类型搜索
            ["data-rune-list"] = "space typeahead",
            ["data-rune-options"] = k.Options,
            ["data-rune-selected"] = k.Options is null ? null : k.Selected.ToString(System.Globalization.CultureInfo.InvariantCulture),
        });

    // 一行：分组标题或选项。选项的 id 是 {列表 id}-{序号}，JS 按序号找到高亮项
    RenderFragment RenderRow(ListRow row, PartLayers<ListboxPart> parts, IReadOnlyList<ListEntry<TItem>> entries)
    {
        var (option, item) = entries[row.Index];
        if (row.IsGroupLabel)
        {
            // 只是视觉上的标题：组名经各选项的 aria-describedby 念出
            return @<span id="@GroupLabelId(row.Index)" aria-hidden="true" @attributes="Attrs.Merge(parts[ListboxPart.GroupLabel], PropsGroupLabel)">@option.Group</span>;
        }
        var selected = IsSelected(option.Value);
        return @<div @key="option.Value" id="@($"{ControlId}-{row.Index}")" role="option" aria-selected="@(selected ? "true" : "false")"
                     aria-disabled="@(option.Disabled ? "true" : null)" aria-setsize="@entries.Count" aria-posinset="@(row.Index + 1)"
                     aria-describedby="@(row.GroupStart < 0 ? null : GroupLabelId(row.GroupStart))" data-label="@option.Label"
                     data-state="@(selected ? "checked" : "unchecked")"
                     @onclick="() => PickAsync(option.Value)" @attributes="Attrs.Merge(parts[ListboxPart.Option], PropsOption)">
            @if (ChildContent is not null)
            {
                @ChildContent(new ListOptionState<TItem>(item, option, selected))
            }
            else
            {
                if (option.Icon is not null)
                {
                    <Icon Data="option.Icon" />
                }
                <span @attributes="Attrs.Merge(parts[ListboxPart.Content])"><span @attributes="Attrs.Merge(LabelLayer)">@option.Label</span>@if (option.Description is not null)
                    {
                        <span @attributes="Attrs.Merge(parts[ListboxPart.Description])">@option.Description</span>
                    }</span>
            }
            <Icon Data="BuiltInIcons.Check" @attributes="Attrs.MergeProps(parts[ListboxPart.Check], PropsCheck)" />
        </div>;
    }

    string GroupLabelId(int start) => $"{ControlId}-group-{start}";

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        indicator.Update(Loading);
    }

    /// <inheritdoc/>
    protected override void OnDispose()
    {
        base.OnDispose();
        delayedLoading?.Dispose();
    }

    async Task PickAsync(string value)
    {
        if (IsDisabled || IsReadOnly) return;
        var option = Entries.FirstOrDefault(e => e.Option.Value == value).Option;
        if (option is null || option.Disabled) return;
        if (ListState.Toggle(Selected, value, SelectionMode, IsRequired) is { } next)
        {
            if (SelectionMode == SelectionMode.Multiple) await ValuesChanged.InvokeAsync(next);
            else await SetValueAsync(next.Count == 0 ? null : next[0]);
        }
        await OnPick.InvokeAsync(value);
    }
}
