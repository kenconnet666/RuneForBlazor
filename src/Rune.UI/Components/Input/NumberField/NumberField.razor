@*
    数字输入框（role="spinbutton"）：外框同 TextField，右侧带减少 / 增加按钮。
    <Field Label="数量"><NumberField @bind-Value="count" Min="1" Max="99" /></Field>
    <NumberField @bind-Value="price" Step="0.01m" Format="C2" aria-label="单价" />
    值可以是任何数字类型（int、long、decimal、double…），可空类型（int?）空着时为 null；不可空的不能清空。
    Min、Max、Step 写成 decimal（同 Blazor 的 InputNumber，值的类型不限）。输入时是普通文本，失去焦点或回车时解析、夹到 Min–Max、
    对齐到 Step 后写回（decimal 计算，没有浮点误差），解析不了时恢复原值；认全角数字与当前文化的千分位。
    ↑ / ↓ 加减 Step，Page Up / Page Down 加减 BigStep，Home / End 到 Min / Max（JS 初始化器处理，没有往返）。
    写了 name 时原生表单提交的是十进制文本（不带千分位与货币符号）：name 落在一个隐藏的 input 上，不是显示格式的输入框。
*@
@namespace Rune.UI
@typeparam TValue
@inherits InputControl<TValue>
@using System.Globalization
@{
    var parts = InputStyles.Of(Appearance, Config.Styles);
    var current = NumberText.ToDecimal(CurrentValue);
}

<div @attributes="Attrs.Merge(parts[InputPart.Root], RootUserAttrs, ShellAttrs)">
    @if (Icon is not null)
    {
        <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[InputPart.Icon], PropsIcon)" />
    }
    @if (Prefix is not null)
    {
        <label for="@ControlId" @attributes="Attrs.Merge(parts[InputPart.Affix], PropsPrefix)">@Prefix</label>
    }
    <input @key="version" type="text" inputmode="decimal" autocomplete="off"
           @attributes="Attrs.Merge(parts[InputPart.Input], VisibleUserAttrs, InputManaged)" />
    @if (Suffix is not null)
    {
        <label for="@ControlId" @attributes="Attrs.Merge(parts[InputPart.Affix], PropsSuffix)">@Suffix</label>
    }
    @if (Clearable && !IsDisabled && !IsReadOnly && current is not null && NumberText.TryFromDecimal<TValue>(null, out _))
    {
        <ClearButton Label="@ClearLabel" Radius="UI.Radius.Full" @onclick="() => ApplyAsync(null)"
                     @attributes="Attrs.MergeProps(parts[InputPart.Button], PropsClear, RefocusInput)" />
    }
    @if (ShowStepper)
    {
        <IconButton Icon="BuiltInIcons.Minus" Label="@(DecrementLabel ?? Config.Lang.NumberDecrement)" Radius="UI.Radius.Full" tabindex="-1" data-rune-repeat
                    Disabled="@(IsDisabled || AtLimit(current, Min, -1))" @onclick="() => StepAsync(-1)"
                    @attributes="Attrs.MergeProps(parts[InputPart.Button], PropsDecrement)" />
        <IconButton Icon="BuiltInIcons.Plus" Label="@(IncrementLabel ?? Config.Lang.NumberIncrement)" Radius="UI.Radius.Full" tabindex="-1" data-rune-repeat
                    Disabled="@(IsDisabled || AtLimit(current, Max, 1))" @onclick="() => StepAsync(1)"
                    @attributes="Attrs.MergeProps(parts[InputPart.Button], PropsIncrement)" />
    }
    @if (FormName is { } name)
    {
        <input type="hidden" name="@name" value="@current?.ToString(CultureInfo.InvariantCulture)" disabled="@IsDisabled" />
    }
</div>

@code {
    Memo<(Attrs Control, TValue Value, decimal? Min, decimal? Max, decimal Step, decimal? BigStep, string? Format, CultureInfo Culture), Attrs> inputManaged;
    // 解析不了、或夹到范围后与原值相同时，输入框里的文字要恢复成当前值；值没变 Blazor 不会更新 DOM，换一个 key 重建 input
    int version;

    /// <summary>最小值；不写时不限。</summary>
    [Parameter] public decimal? Min { get; set; }

    /// <summary>最大值；不写时不限。</summary>
    [Parameter] public decimal? Max { get; set; }

    /// <summary>步长，默认 1；提交时对齐到 Min + n × Step。小数步长写成 <c>0.01m</c>。</summary>
    [Parameter] public decimal Step { get; set; } = 1;

    /// <summary>Page Up / Page Down 的步长，默认 Step × 10。</summary>
    [Parameter] public decimal? BigStep { get; set; }

    /// <summary>显示的格式（.NET 的数字格式：N2、C2、P0），默认 G；按当前文化显示。</summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>显示减少 / 增加按钮，默认是；只读时不显示。</summary>
    [Parameter] public bool Stepper { get; set; } = true;

    /// <summary>前置图标。</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>前置图标的部件属性。</summary>
    [Parameter] public Attrs? PropsIcon { get; set; }

    /// <summary>减少按钮的部件属性（交给 IconButton）。</summary>
    [Parameter] public Attrs? PropsDecrement { get; set; }

    /// <summary>增加按钮的部件属性（交给 IconButton）。</summary>
    [Parameter] public Attrs? PropsIncrement { get; set; }

    /// <summary>数字前的内容（币种符号）。</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>数字后的内容（单位）。</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>有值时显示清空按钮（可空的值类型才有：清空后是 null）。</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>清空按钮的名称（读屏读出）；不写时取语言包（UIConfig.Lang）的“清空”。</summary>
    [Parameter] public string? ClearLabel { get; set; }

    /// <summary>清空按钮的部件属性。</summary>
    [Parameter] public Attrs? PropsClear { get; set; }

    /// <summary>减少按钮的名称（读屏读出）；不写时取语言包的“减少”。</summary>
    [Parameter] public string? DecrementLabel { get; set; }

    /// <summary>增加按钮的名称；不写时取语言包的“增加”。</summary>
    [Parameter] public string? IncrementLabel { get; set; }

    /// <summary>前缀的部件属性（指向输入框的 label）。</summary>
    [Parameter] public Attrs? PropsPrefix { get; set; }

    /// <summary>后缀的部件属性（指向输入框的 label）。</summary>
    [Parameter] public Attrs? PropsSuffix { get; set; }

    bool ShowStepper => Stepper && !IsReadOnly;

    Memo<string, Attrs> refocusInput;
    Memo<IReadOnlyDictionary<string, object>?, Attrs> visibleUserAttrs;

    // 清空后焦点回到输入框
    Attrs RefocusInput => refocusInput.Get(ControlId, static id => new Attrs { ["data-rune-refocus"] = id });

    // 表单提交用的字段名：落在隐藏的 input 上（提交十进制文本），显示的输入框不带它
    string? FormName => AdditionalAttributes?.TryGetValue("name", out var name) == true ? name as string : null;

    Attrs VisibleUserAttrs => visibleUserAttrs.Get(AdditionalAttributes, static attributes =>
        Attrs.From(attributes, null) is var all && attributes?.ContainsKey("name") == true ? all.Without("name") : all);

    static bool AtLimit(decimal? current, decimal? bound, int direction) =>
        current is { } value && bound is { } limit && (direction < 0 ? value <= limit : value >= limit);

    // input 上由组件管理的属性：表单状态、显示的文字、spinbutton 的 aria 值，以及给 JS 处理方向键的范围与步长（不变量格式）
    Attrs InputManaged => inputManaged.Get((ControlAttrs, CurrentValue, Min, Max, Step, BigStep, Format, CultureInfo.CurrentCulture), this,
        static (k, owner) =>
        {
            var invariant = CultureInfo.InvariantCulture;
            var value = NumberText.ToDecimal(k.Value);
            return Attrs.Merge(k.Control, new Attrs
            {
                Role = "spinbutton",
                ["value"] = NumberText.Format(k.Value, k.Format, k.Culture),
                ["aria-valuenow"] = value?.ToString(invariant),
                ["aria-valuetext"] = value is null ? null : NumberText.Format(k.Value, k.Format, k.Culture),
                ["aria-valuemin"] = k.Min?.ToString(invariant),
                ["aria-valuemax"] = k.Max?.ToString(invariant),
                ["data-rune-spin"] = true,
                ["data-step"] = k.Step.ToString(invariant),
                ["data-big-step"] = k.BigStep?.ToString(invariant),
                ["data-decimal"] = k.Culture.NumberFormat.NumberDecimalSeparator,
                ["onchange"] = (Func<ChangeEventArgs, Task>)(e => owner.CommitAsync(e.Value as string)),
            });
        });

    // 解析输入的文字并写回；解析不了时恢复原来的显示
    async Task CommitAsync(string? text)
    {
        if (!NumberText.TryParse(text, CultureInfo.CurrentCulture, out var parsed))
        {
            version++;
            return;
        }
        await ApplyAsync(parsed);
    }

    // 空着时从 Min（没有就是 0）开始
    Task StepAsync(int direction) => ApplyAsync((NumberText.ToDecimal(CurrentValue) ?? Min ?? 0) + direction * Step);

    // 夹到范围、对齐步长后写回；结果与原值相同（或不可空的类型被清空）时恢复输入框里的显示
    async Task ApplyAsync(decimal? value)
    {
        var constrained = value is { } v ? NumberText.Constrain(v, Min, Max, Step) : (decimal?)null;
        if (!NumberText.TryFromDecimal<TValue>(constrained, out var next) || EqualityComparer<TValue>.Default.Equals(next, CurrentValue)) version++;
        else await SetValueAsync(next);
    }
}
