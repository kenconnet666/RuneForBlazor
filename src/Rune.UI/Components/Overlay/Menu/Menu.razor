@*
    菜单（下拉菜单）：一组操作。
    <Menu>
        <Trigger Context="t"><IconButton @attributes="t" Icon="Lucide.Ellipsis" Label="更多操作" /></Trigger>
        <ChildContent>
            <MenuItem Icon="Lucide.Pencil" @onclick="Edit">编辑</MenuItem>
            <MenuSeparator />
            <MenuItem Icon="Lucide.Trash" Tone="Tone.Danger" @onclick="Delete">删除</MenuItem>
        </ChildContent>
    </Menu>
    打开、定位好之后焦点在第一项，方向键、Home / End、类型搜索移动，Enter 选择，Esc 或 Tab 关闭；选了一项菜单自动关闭。
    最大高度限制在视口剩下的空间里，菜单项多时在菜单里滚动（ScrollArea 的浮层滚动条）。菜单项很轻，一开始就渲染。
*@
@namespace Rune.UI
@inherits PopoverBase
@{ var overlay = OverlayAttrs("menu", TriggerId, fitHeight: true); }

@Trigger?.Invoke(TriggerAttrs)
@{ var parts = MenuStyles.Of(Config.Styles); }
<div @attributes="Attrs.Merge(parts[MenuPart.Root], Rest, overlay)" @onrunetoggle="HandleToggle">
    @* 焦点在菜单项上，视口不进 Tab 顺序 *@
    <ScrollArea Focusable="false" PropsViewport="FloatingStyles.ContainedViewport" PropsContent="parts[MenuPart.Content]" Sx="FloatingStyles.ScrollArea">@ChildContent</ScrollArea>
</div>

@code {
    /// <summary>菜单项（MenuItem、MenuSeparator）。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc/>
    protected override string HasPopup => "menu";
}
