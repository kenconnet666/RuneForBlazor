@*
    表单：包一层 Blazor 的 EditForm，补上组件库要的几样。
    <Form Model="model" OnValidSubmit="SaveAsync">
        <Field Label="姓名" Required="true"><TextField @bind-Value="model.Name" /></Field>
        <Button Type="submit">保存</Button>
    </Form>
    - 默认带 DataAnnotationsValidator（用 FluentValidation 等时写 DataAnnotations="false"，把自己的校验器放在内容里）；
    - 提交的回调执行期间，里面的提交按钮（Type="submit"）显示加载中、不能重复提交；
    - 提交未通过时在顶部列出错误（FormErrorSummary：“姓名：请填写姓名”），焦点到它上面，点一项跳到那个控件；
      没有错误汇总时焦点到第一个出错的控件；
      ErrorSummary="false" 时不放，可以自己把 FormErrorSummary 放在别处；
    - 整张表单的标签布局与只读、不可用（LabelPlacement、LabelWidth、LabelAlign、Disabled、ReadOnly）交给里面的 Field 与控件（FieldLayout），
      FormSection 可以按组再改。
*@
@namespace Rune.UI
@inherits UIComponent
@using Microsoft.AspNetCore.Components.Forms
@{ var parts = FormStyles.Of(Config.Styles); }

<EditForm EditContext="context" OnSubmit="HandleSubmitAsync" FormName="@FormName" data-disabled="@(Disabled ? true : null)" data-readonly="@(ReadOnly ? true : null)"
          data-rune-invalid-submit="@(invalidSubmits > 0 ? invalidSubmits : null)"
          @attributes="Attrs.Merge(parts[FormPart.Root], Rest)">
    @if (DataAnnotations)
    {
        <DataAnnotationsValidator />
    }
    <CascadingValue Value="state">
        <CascadingValue Value="Layout">
            @if (ErrorSummary)
            {
                <FormErrorSummary Title="SummaryTitle" @attributes="Attrs.MergeProps(null, PropsSummary)" />
            }
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</EditForm>

@code {
    readonly FormState state = new();
    // 每次提交没通过加一：属性变了，JS 把焦点移到错误汇总或第一个出错的控件
    int invalidSubmits;
    EditContext context = default!;
    object? contextModel;
    Memo<FieldLayout, FieldLayout> layout;

    /// <summary>表单绑定的对象（与 <see cref="EditContext"/> 二选一）。</summary>
    [Parameter] public object? Model { get; set; }

    /// <summary>自己创建的 EditContext（需要在外面调用 Validate、监听变化时）。</summary>
    [Parameter] public EditContext? EditContext { get; set; }

    /// <summary>校验通过后提交：回调执行期间提交按钮显示加载中。</summary>
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }

    /// <summary>校验未通过时。</summary>
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    /// <summary>自动加上 DataAnnotationsValidator，默认是。</summary>
    [Parameter] public bool DataAnnotations { get; set; } = true;

    /// <summary>在顶部放一个错误汇总（FormErrorSummary），默认是。</summary>
    [Parameter] public bool ErrorSummary { get; set; } = true;

    /// <summary>错误汇总的标题（参数是错误数）；不写时取语言包的“有 N 项需要修改”。</summary>
    [Parameter] public Func<int, string>? SummaryTitle { get; set; }

    /// <summary>静态 SSR 下提交表单时的名字（Blazor 的 FormName）；交互模式不需要。</summary>
    [Parameter] public string? FormName { get; set; }

    /// <summary>里面的 Field 的标签位置：上方（默认）或起始边（标签一列、控件一列）。</summary>
    [Parameter] public FieldLabelPlacement? LabelPlacement { get; set; }

    /// <summary>标签在起始边时标签列的宽度，默认 8em。</summary>
    [Parameter] public CssLength? LabelWidth { get; set; }

    /// <summary>标签在起始边时文字的对齐，默认靠结束边（贴着控件）。</summary>
    [Parameter] public FieldLabelAlign? LabelAlign { get; set; }

    /// <summary>整张表单不可用：里面的字段与控件都不可用。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>整张表单只读（查看详情、审批时）：里面的字段与控件都只读。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>表单内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>错误汇总的部件属性（交给 FormErrorSummary，再交给 Alert）。</summary>
    [Parameter] public Attrs? PropsSummary { get; set; }

    // 字段布局：输入不变时是同一个对象，里面的 Field 不被迫重新渲染
    FieldLayout Layout => layout.Get(new(LabelPlacement, LabelWidth, LabelAlign, Disabled, ReadOnly), static k => k);

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (EditContext is not null)
        {
            if (!ReferenceEquals(context, EditContext)) Subscribe(EditContext);
            return;
        }
        if (Model is null) throw new InvalidOperationException("Form 需要 Model 或 EditContext");
        if (!ReferenceEquals(contextModel, Model))
        {
            contextModel = Model;
            Subscribe(new EditContext(Model));
        }
    }

    void Subscribe(EditContext next)
    {
        context = next;
        state.Context = next;
        state.ShowErrors = false;
    }

    async Task HandleSubmitAsync(EditContext editContext)
    {
        if (!editContext.Validate())
        {
            state.ShowErrors = true;
            invalidSubmits++;
            await OnInvalidSubmit.InvokeAsync(editContext);
            return;
        }
        state.ShowErrors = false;
        state.Submitting = true;
        StateHasChanged();
        try
        {
            await OnValidSubmit.InvokeAsync(editContext);
        }
        finally
        {
            state.Submitting = false;
        }
    }
}
