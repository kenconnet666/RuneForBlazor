@*
    加载指示：Lucide 的 loader-circle 匀速旋转。<Spinner Label="正在加载" />
    单独使用时写 Label，读屏会播报（role="status"）；放在已经标了 aria-busy 的元素里（按钮的加载中）时不写，对读屏隐藏。
*@
@namespace Rune.UI
@inherits UIComponent

<Icon Data="BuiltInIcons.LoaderCircle" Label="@Label" Size="Size"
      @attributes="Attrs.MergeProps(SpinnerStyles.Of(Config.Styles)[SpinnerPart.Root], Rest, Label is null ? null : statusRole)" />

@code {
    static readonly Attrs statusRole = new() { Role = "status" };

    /// <summary>播报给读屏的说明；不写时对读屏隐藏。</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>字号档位；不写时跟着上下文字号。</summary>
    [Parameter] public Size? Size { get; set; }
}
