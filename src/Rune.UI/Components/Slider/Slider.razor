@*
    滑块：在一个范围里拖动选值（音量、进度、价格）。<Slider @bind-Value="volume" aria-label="音量" />
    <Field Label="价格上限"><Slider @bind-Value="price" Min="0" Max="1000" Step="50" ShowValue="true" ValueText="v => $"{v} 元"" /></Field>
    原生 input type="range"：方向键、Page Up / Down、Home / End、读屏都是原生的；颜色用 accent-color，拖动时的填充由浏览器画，没有往返。
    默认松开时写回值；拖动中就要用值（实时预览）写 Immediate="true"（Server 模式下每次移动一次往返）。
*@
@namespace Rune.UI
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>
@inherits FormControl<TValue>
@{ var parts = SliderStyles.Of(Size, Tone, Config.Styles); }

<div @attributes="Attrs.Merge(parts[SliderPart.Root], RootUserAttrs)">
    <input type="range" @attributes="Attrs.Merge(parts[SliderPart.Input], InputUserAttrs, InputManaged)" />
    @if (ShowValue)
    {
        <output for="@ControlId" @attributes="Attrs.Merge(parts[SliderPart.Value], PropsValue)">@TextOf(CurrentValue)</output>
    }
</div>

@code {
    Memo<(Attrs Control, TValue Value, TValue Min, TValue Max, TValue Step, bool Immediate), Attrs> inputManaged;

    /// <summary>最小值，默认 0。</summary>
    [Parameter] public TValue Min { get; set; } = TValue.Zero;

    /// <summary>最大值，默认 100。</summary>
    [Parameter] public TValue Max { get; set; } = TValue.CreateChecked(100);

    /// <summary>步长，默认 1。</summary>
    [Parameter] public TValue Step { get; set; } = TValue.One;

    /// <summary>拖动中每次移动都写回值；默认松开时写回。</summary>
    [Parameter] public bool Immediate { get; set; }

    /// <summary>在滑块后面显示当前值。</summary>
    [Parameter] public bool ShowValue { get; set; }

    /// <summary>值的说明文字（显示与读屏）：<c>v => $"{v} 元"</c>；默认就是数字。</summary>
    [Parameter] public Func<TValue, string>? ValueText { get; set; }

    /// <summary>已选的一段与滑块的色调，默认品牌色。</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Accent;

    /// <summary>字号档位；不写时继承上下文字号。</summary>
    [Parameter] public Size? Size { get; set; }

    /// <summary>显示的值的部件属性。</summary>
    [Parameter] public Attrs? PropsValue { get; set; }

    string TextOf(TValue value) => ValueText?.Invoke(value) ?? value.ToString(null, System.Globalization.CultureInfo.CurrentCulture);

    Attrs InputManaged => inputManaged.Get((ControlAttrs, CurrentValue, Min, Max, Step, Immediate), this, static (k, owner) =>
    {
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        return Attrs.Merge(k.Control, new Attrs
        {
            ["min"] = k.Min.ToString(null, invariant),
            ["max"] = k.Max.ToString(null, invariant),
            ["step"] = k.Step.ToString(null, invariant),
            ["value"] = k.Value.ToString(null, invariant),
            ["aria-valuetext"] = owner.ValueText is null ? null : owner.ValueText(k.Value),
            [k.Immediate ? "oninput" : "onchange"] = (Func<ChangeEventArgs, Task>)(e =>
                decimal.TryParse(e.Value as string, System.Globalization.NumberStyles.Number, invariant, out var parsed)
                    ? owner.SetValueAsync(TValue.CreateSaturating(parsed))
                    : Task.CompletedTask),
        });
    });
}
