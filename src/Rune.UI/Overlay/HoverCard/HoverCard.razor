@*
    悬停卡片（同 vue-tsx-pro 的 HoverCard）：指针停在触发元素（通常是链接、用户名）上、或用键盘聚焦它时，弹出一张富内容卡片（用户资料、链接预览）。
    <HoverCard>
        <Trigger Context="t"><TextLink @attributes="t" Href="u/ada">@@ada</TextLink></Trigger>
        <ChildContent><Avatar Name="Ada Lovelace" /> …</ChildContent>
    </HoverCard>
    开关时机同 Tooltip（停留后打开、可以移到卡片上、同组只开一个、刚关掉一个时下一个直接打开），定位同 Popover（可选箭头）。
    卡片只是预览：里面的信息要在别处也能拿到（触屏没有悬停）。卡片里可以有链接、按钮：键盘聚焦触发元素打开后按 Tab 进入卡片，
    焦点离开触发元素与卡片时关闭；Esc 关闭。用 popover="manual" 渲染在顶层，不会关掉正打开的菜单或弹出框；开关、定位都在 JS 初始化器里。
    卡片在交互渲染后才输出（同 vue）：静态 SSR 下没有卡片，触发元素照常可用。
*@
@namespace Rune.UI
@inherits UIComponent
@{ var parts = HoverCardStyles.Of(Arrow, Config.Styles); }

@Trigger?.Invoke(Disabled ? NoCard : TriggerAttrs)
@* 交互渲染后才输出面板（同 vue 的 useMounted）：预渲染的 HTML 里触发元素在 <p> 里时，<div> 会把段落提前截断 *@
@if (!Disabled && mounted)
{
    <div @attributes="Attrs.Merge(parts[HoverCardPart.Root], Rest, Managed)" @onrunetoggle="HandleToggle">
        @if (ShouldRenderContent)
        {
            @ChildContent
        }
        @if (Arrow)
        {
            <span @attributes="Attrs.Merge(FloatingStyles.ArrowLayer, PropsArrow, Floating.ArrowAttrs)"></span>
        }
    </div>
}

@code {
    static readonly Attrs NoCard = new();

    readonly string id = UniqueId.Next("hover-card");
    Attrs? triggerAttrs;
    bool hasOpened, mounted;
    Memo<(Placement Placement, int? Offset, int Delay, int CloseDelay), Attrs> managed;

    /// <summary>触发元素：参数是要加在它上面的属性（交给 JS 的标记）。</summary>
    [Parameter] public RenderFragment<Attrs>? Trigger { get; set; }

    /// <summary>卡片内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>弹出位置，默认下方居中；空间不够时自动翻转。</summary>
    [Parameter] public Placement Placement { get; set; } = Placement.Bottom;

    /// <summary>与触发元素的距离（px），默认 6。</summary>
    [Parameter] public int? Offset { get; set; }

    /// <summary>指针停留多久后打开（毫秒），默认 700。</summary>
    [Parameter] public int Delay { get; set; } = 700;

    /// <summary>指针离开多久后关闭（毫秒），默认 300：留出移到卡片上的时间。</summary>
    [Parameter] public int CloseDelay { get; set; } = 300;

    /// <summary>不打开（触发元素照常渲染）。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>显示指向触发元素的箭头。</summary>
    [Parameter] public bool Arrow { get; set; }

    /// <summary>箭头的部件属性。</summary>
    [Parameter] public Attrs? PropsArrow { get; set; }

    /// <summary>第一次打开才渲染内容（默认）。内容要一直在（里面的组件要报告状态）时写 false。</summary>
    [Parameter] public bool Lazy { get; set; } = true;

    /// <summary>打开或关闭后。</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    // 打开过就保留内容
    bool ShouldRenderContent => !Lazy || hasOpened;

    Attrs TriggerAttrs => triggerAttrs ??= new Attrs { ["data-rune-hovercard"] = id };

    Attrs Managed => managed.Get((Placement, Offset, Delay, CloseDelay), id, static (k, id) => Attrs.Merge(
        Floating.Placed(k.Placement, k.Offset),
        new Attrs
        {
            Id = id,
            ["popover"] = "manual",
            ["data-rune-hover-panel"] = "card",
            ["data-delay"] = k.Delay,
            ["data-close-delay"] = k.CloseDelay,
        }));

    /// <inheritdoc/>
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        mounted = true;
        StateHasChanged();
    }

    Task HandleToggle(OverlayToggleEventArgs e)
    {
        if (e.Open) hasOpened = true;
        return OpenChanged.InvokeAsync(e.Open);
    }
}
