@*
    菜单项（button，role="menuitem"）：<MenuItem Icon="Lucide.Pencil" Shortcut="Mod+E" @onclick="Edit">编辑</MenuItem>
    点击、Enter、空格、快捷键执行 @onclick，随后关闭菜单（CloseOnSelect="false" 时不关，适合要连按几次的操作）。
    不可用时仍可聚焦（读屏能读到），点击无效。
*@
@namespace Rune.UI
@inherits MenuItemBase
@{
    var parts = MenuStyles.Item(Tone, Config.Styles);
    // 不可用时去掉使用方的点击处理
    var user = Disabled ? Rest.Without("onclick") : Rest;
}

<button type="button" @attributes="Attrs.Merge(parts[MenuItemPart.Root], user, Managed)">
    @ItemContent(parts, ChildContent, shortcut: Shortcut)
</button>

@code {
    Attrs Managed => ItemAttrs("menuitem", closeOnSelect: CloseOnSelect);

    /// <summary>色调；删除等破坏性操作写 Danger。</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Neutral;

    /// <summary>执行后关闭菜单，默认 true。</summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;

    /// <summary>菜单项文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
