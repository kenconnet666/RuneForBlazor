@*
    单选菜单项（button，role="menuitemradio"，同 vue-tsx-pro 的 MenuRadioItem）：放在 MenuRadioGroup 里，默认选中后关闭菜单。
    起始边的圆点按 aria-checked 显示，没选中时占着位置，各项文字对齐。
*@
@namespace Rune.UI
@inherits MenuItemBase
@{ var parts = MenuStyles.Item(Tone.Neutral, Config.Styles); }

<button type="button" @attributes="Attrs.Merge(parts[MenuItemPart.Root], Rest, Managed)">
    @ItemContent(parts, ChildContent, BuiltInIcons.Dot, PropsIndicator, Shortcut)
</button>

@code {
    Attrs Managed => ItemAttrs("menuitemradio", isChecked: Checked, closeOnSelect: CloseOnSelect, onClick: select);

    EventCallback? select;

    /// <summary>这一项的值。</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>执行后关闭菜单，默认 true。</summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;

    /// <summary>菜单项文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>选中标记（圆点，Icon 组件）的部件属性。</summary>
    [Parameter] public Attrs? PropsIndicator { get; set; }

    [CascadingParameter] MenuRadioGroupState? Group { get; set; }

    bool Checked => Group?.Value is { } value && value == Value;

    /// <inheritdoc/>
    protected override void OnInitialized() => select = EventCallback.Factory.Create(this, () => Group?.Select(Value) ?? Task.CompletedTask);
}
