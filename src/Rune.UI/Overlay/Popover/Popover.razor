@*
    弹出框（非模态，同 vue-tsx-pro 的 Popover）：点触发元素在旁边弹出一块内容（筛选条件、简短表单、详情），点外面或按 Esc 关闭。
    <Popover Placement="Placement.BottomStart" Arrow="true">
        <Trigger Context="t"><Button @attributes="t" Icon="Lucide.Share2">分享</Button></Trigger>
        <ChildContent>…</ChildContent>
    </Popover>
    打开、定位好之后焦点移到第一个可聚焦元素（有 autofocus 的优先），关闭后回到触发元素。
    弹出层是 role="dialog"，名称默认取触发元素的文字；内容有自己的标题时用 aria-labelledby 指向它。
    内容在交互模式下第一次打开才渲染。里面的按钮写 data-rune-close 点击后关闭弹出框。
*@
@namespace Rune.UI
@inherits PopoverBase
@{ var parts = PopoverStyles.Of(Arrow, Config.Styles); }

@Trigger?.Invoke(TriggerAttrs)
<div @attributes="Attrs.Merge(parts[PopoverPart.Root], Rest, OverlayAttrs(Role, LabelledBy, fitHeight: !Arrow))" @onrunetoggle="HandleToggle">
    @if (ShouldRenderContent)
    {
        @ChildContent
    }
    @if (Arrow)
    {
        <span @attributes="Attrs.Merge(FloatingStyles.ArrowLayer, PropsArrow, Floating.ArrowAttrs)"></span>
    }
</div>

@code {
    /// <summary>浮层的角色，默认 dialog；要用户在确认与取消之间选择时（Popconfirm）用 alertdialog。</summary>
    [Parameter] public string Role { get; set; } = "dialog";

    /// <summary>显示指向触发元素的箭头。</summary>
    [Parameter] public bool Arrow { get; set; }

    /// <summary>箭头的部件属性。</summary>
    [Parameter] public Attrs? PropsArrow { get; set; }

    /// <summary>内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 交互模式下第一次打开才渲染内容（默认）。内容很轻、或者打开时就要聚焦里面的元素（autofocus）时写 false。
    /// </summary>
    [Parameter] public bool Lazy { get; set; } = true;

    /// <inheritdoc/>
    protected override string HasPopup => "dialog";

    // 打开过就保留内容，再打开不重建；静态渲染没有交互，来不及等渲染，一开始就渲染
    bool ShouldRenderContent => !Lazy || HasOpened || Open == true || !RendererInfo.IsInteractive;

    // 名称默认取触发元素的文字；使用方给了 aria-label 或 aria-labelledby 时用使用方的
    string? LabelledBy => AdditionalAttributes is { } rest && (rest.ContainsKey("aria-label") || rest.ContainsKey("aria-labelledby")) ? null : TriggerId;
}
