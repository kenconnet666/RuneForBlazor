@*
    表单字段：标签 + 控件 + 说明 + 错误信息，并把它们关联起来（标签的 for、控件的 aria-describedby）。
    <Field Label="邮箱" Description="用于找回密码" Required="true">
        <TextField @bind-Value="model.Email" Type="email" />
    </Field>
    在 EditForm 里时，错误信息取自表单的校验结果（控件用 @bind-Value 绑定的字段）；也可以直接给 Error。
    控件上显式写的状态（Disabled、Required……）优先于 Field 的。
    标签可以放在起始边（LabelPlacement="Start"）：标签一列、控件一列，第一行文字按基线对齐；通常在 Form 上统一设置。
*@
@namespace Rune.UI
@inherits UIComponent
@using Microsoft.AspNetCore.Components.Forms
@{
    var appearance = Appearance;
    var parts = FieldStyles.Of(appearance, Config.Styles);
    var errors = Errors;
    var startLayout = appearance.Placement == FieldLabelPlacement.Start && !LabelHidden;
}

<div data-label-placement="@(startLayout ? "start" : "top")" data-invalid="@(errors.Count > 0 || Invalid ? "true" : null)" data-disabled="@(IsDisabled ? "true" : null)"
     @attributes="Attrs.Merge(parts[FieldPart.Root], Rest, LayoutAttrs(startLayout))">
    @if (Label is not null)
    {
        <label id="@labelId" for="@controlId" @attributes="Attrs.Merge(parts[FieldPart.Label], PropsLabel)">@Label@if (Required)
            {
                <Icon Data="BuiltInIcons.Asterisk" @attributes="Attrs.MergeProps(parts[FieldPart.RequiredMark])" />
            }</label>
    }
    @if (startLayout)
    {
        <div @attributes="Attrs.Merge(parts[FieldPart.Control], PropsControl)">
            @Content(errors)
        </div>
    }
    else
    {
        @Content(errors)
    }
</div>

@code {
    readonly string controlId = UniqueId.Next("field-control");
    readonly string labelId = UniqueId.Next("field-label");
    readonly string descriptionId = UniqueId.Next("field-description");
    readonly string errorId = UniqueId.Next("field-error");
    readonly FieldRegistration registration = new();
    Memo<(bool HasLabel, string? DescribedBy, bool Invalid, bool Required, bool Disabled, bool ReadOnly), FieldContext> context;
    EditContext? subscribedContext;

    /// <summary>标签。</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>说明（标签下面、控件后面的小字）。</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>带格式的说明（如含 Code、链接）；写了时代替 Description。</summary>
    [Parameter] public RenderFragment? DescriptionContent { get; set; }

    /// <summary>错误信息；不写时取表单里这个字段的校验结果。</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>校验未通过、但不显示错误信息：控件只标红（错误写在别处时）。</summary>
    [Parameter] public bool Invalid { get; set; }

    /// <summary>必填：标签后加 *，控件加 aria-required（校验交给表单）。</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>里面的控件不可用；所在的 Form、FormSection 不可用时也是。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>里面的控件只读；所在的 Form、FormSection 只读时也是。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>标签的位置：上方（默认）或起始边；不写时取所在 Form、FormSection 的。</summary>
    [Parameter] public FieldLabelPlacement? LabelPlacement { get; set; }

    /// <summary>标签在起始边时标签列的宽度，默认 8em；不写时取所在 Form、FormSection 的。</summary>
    [Parameter] public CssLength? LabelWidth { get; set; }

    /// <summary>标签在起始边时标签文字的对齐，默认靠结束边（贴着控件）；不写时取所在 Form、FormSection 的。</summary>
    [Parameter] public FieldLabelAlign? LabelAlign { get; set; }

    /// <summary>视觉上隐藏标签（读屏仍读得到）：上下文已经说明了是什么（表格里的单元格、搜索框）。</summary>
    [Parameter] public bool LabelHidden { get; set; }

    /// <summary>标签在起始边时控件、说明、错误的容器的部件属性。</summary>
    [Parameter] public Attrs? PropsControl { get; set; }

    /// <summary>控件。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>标签的部件属性。</summary>
    [Parameter] public Attrs? PropsLabel { get; set; }

    /// <summary>说明的部件属性。</summary>
    [Parameter] public Attrs? PropsDescription { get; set; }

    /// <summary>错误信息的部件属性。</summary>
    [Parameter] public Attrs? PropsError { get; set; }

    /// <summary>所在的 Blazor 表单。</summary>
    [CascadingParameter] EditContext? EditContext { get; set; }

    /// <summary>所在的 Form：登记标签与控件 id，错误汇总据此写出“标签：错误”并跳到控件。</summary>
    [CascadingParameter] FormState? Form { get; set; }

    /// <summary>所在的 Form、FormSection 的标签布局与只读、不可用。</summary>
    [CascadingParameter] FieldLayout? Layout { get; set; }

    bool IsDisabled => Disabled || Layout?.Disabled == true;

    bool IsReadOnly => ReadOnly || Layout?.ReadOnly == true;

    FieldIdentifier? registered;
    // 创建序号：错误汇总排序时区分同一个模型的不同实例（报价单的各行）
    readonly long order = FormState.NextOrder();

    // 控件与说明、错误：标签在上方时直接排在外层里，在起始边时放进第二列的容器
    RenderFragment Content(IReadOnlyList<string> errors) => @<text>
        <CascadingValue Value="ContextFor(errors.Count > 0)">@ChildContent</CascadingValue>
        @if (HasDescription)
        {
            <span id="@descriptionId" @attributes="Attrs.Merge(FieldStyles.Of(Appearance, Config.Styles)[FieldPart.Description], PropsDescription)">@if (DescriptionContent is not null) { @DescriptionContent } else { @Description }</span>
        }
        @if (errors.Count > 0)
        {
            <span id="@errorId" @attributes="Attrs.Merge(FieldStyles.Of(Appearance, Config.Styles)[FieldPart.Error], PropsError)"><Icon Data="BuiltInIcons.CircleExclamationPoint" Sx="FieldStyles.ErrorIcon" />@string.Join("；", errors)</span>
        }
    </text>;

    bool HasDescription => Description is not null || DescriptionContent is not null;

    FieldAppearance Appearance => new(LabelPlacement ?? Layout?.LabelPlacement ?? FieldLabelPlacement.Top, LabelAlign ?? Layout?.LabelAlign ?? FieldLabelAlign.End, LabelHidden, Label is not null, IsDisabled);
    Memo<CssLength, Attrs> layoutAttrs;

    // 标签在起始边时标签列的宽度：任意长度，经 CSS 变量写在元素上（类不随宽度变化）；没写时用样式里的默认值
    Attrs? LayoutAttrs(bool startLayout) =>
        startLayout && (LabelWidth ?? Layout?.LabelWidth) is { } width
            ? layoutAttrs.Get(width, static w => new Attrs { Vars = [FieldStyles.LabelWidth.Set(w)] })
            : null;

    // 显式的 Error 优先；否则是表单里控件绑定的字段的错误（registration.Field 是信号，控件报上来后这里自动重新渲染）
    IReadOnlyList<string> Errors =>
        Error is not null ? [Error]
        : EditContext is not null && registration.Field is { } identifier ? [.. EditContext.GetValidationMessages(identifier)]
        : [];

    FieldContext ContextFor(bool invalid)
    {
        var describedBy = (HasDescription, invalid) switch
        {
            (true, true) => $"{descriptionId} {errorId}",
            (true, false) => descriptionId,
            (false, true) => errorId,
            _ => null,
        };
        // 只写了 Invalid 时只标红：没有错误元素，不进 aria-describedby
        return context.Get((Label is not null, describedBy, invalid || Invalid, Required, IsDisabled, IsReadOnly), this,
            static (k, owner) => new FieldContext(owner.controlId, k.HasLabel ? owner.labelId : null, k.DescribedBy, k.Invalid, k.Required, k.Disabled, k.ReadOnly, owner.registration));
    }

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        // 表单的校验结果变了要重新渲染错误信息
        if (ReferenceEquals(subscribedContext, EditContext)) return;
        if (subscribedContext is not null) subscribedContext.OnValidationStateChanged -= OnValidationStateChanged;
        subscribedContext = EditContext;
        if (subscribedContext is not null) subscribedContext.OnValidationStateChanged += OnValidationStateChanged;
    }

    void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => StateHasChanged();

    /// <inheritdoc/>
    protected override void OnAfterRender(bool firstRender)
    {
        // 控件渲染后才报上它绑定的字段，所以在渲染之后登记
        if (Form is null || registration.Field is not { } field) return;
        if (registered is { } old && !old.Equals(field)) Form.Unregister(old);
        Form.Register(field, Label, controlId, order);
        registered = field;
    }

    /// <inheritdoc/>
    protected override void OnDispose()
    {
        if (registered is { } field) Form?.Unregister(field);
        if (subscribedContext is not null) subscribedContext.OnValidationStateChanged -= OnValidationStateChanged;
    }
}
