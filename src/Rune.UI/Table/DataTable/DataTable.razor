@*
    数据表格（同 vue-tsx-pro 的 DataTable）：按列渲染一组行，始终虚拟滚动（十万行也只渲染看得见的几十行）。
    <DataTable Items="orders" GetKey="o => o.Id" @bind-Sort="sort" SelectionMode="SelectionMode.Multiple" @bind-Selected="picked" aria-label="订单">
        <PropertyColumn Property="o => o.Id" Width="120" Sticky="ColumnSticky.Start" />
        <PropertyColumn Property="o => o.Customer" Sortable />
        <PropertyColumn Property="o => o.Amount" Type="ColumnType.Currency" Sortable Summary="ColumnSummary.Sum" />
        <StatusColumn Property="o => o.Status" Statuses="OrderStatuses" Filter="ColumnFilterKind.Values" />
        <TemplateColumn Title="操作" Width="96" Sticky="ColumnSticky.End" Context="order"><Button Variant="ButtonVariant.Link">编辑</Button></TemplateColumn>
    </DataTable>
    - 结构：原生 table（读屏按表格念：第几行第几列、列标题）+ table-layout: fixed + colgroup 定列宽，外层是 ScrollArea（两个方向滚动）。
    - 高度：外层默认最高 32em，用 PropsRoot 的 Sx 改，或 Flexible 放进竖排的弹性容器；表头吸顶、固定列不随横向滚动。
    - 虚拟滚动在 JS 里（js/virtual.js 的表格模式）：只渲染看得见的行，上下各一个占位行撑出滚动高度；行带 aria-rowindex，表格带 aria-rowcount。
    - 排序：点可排序的列标题在 正序 → 倒序 → 不排 之间切换；默认在本地排（Collation：数字、日期、按语言的文字），
      ManualSort 时只写回排序，由调用方向服务端要排好序的数据。MultiSort 时排序写在 Sorts，按住 Shift 点是追加一列。
    - 表头筛选：列写 Filter 时列标题上有筛选按钮，Filters 是各列选中的值；默认在本地筛，ManualFilter 时只写回。
    - 列菜单：ColumnMenu 时列标题结尾有 ⋮（排序、固定在开头 / 结尾、前后移动、隐藏），写回 ColumnPins、ColumnOrder、HiddenColumns。
    - 列宽：Resizable 时可以拖动或用键盘调整，ColumnWidths 记录调整后的宽度。
    - 分组表头：列写 Group 时相邻、同组的列上方共用一个标题（th scope="colgroup"），表头两行，没分组的列跨两行。
    - 详情行：DetailContent 给出一行的详情，多一列展开按钮（aria-expanded、aria-controls），展开的行下面多一行跨全部列的详情，
      在虚拟滚动里也算一行（测量真实高度），内容贴着视口的起始边，横向滚动时不跟着滚走。
    - 选择：SelectionMode 时多一列勾选框（单选是单选框），Selected 是已选行的 key。
    - 加载：只用骨架行：Loading 时表体换成骨架；滚动加载（OnRangeChange）已有数据时骨架接在末尾。
    - 合计：列写 Summary（Sum 精确相加）或 SummaryContent 时底部多一行吸底的合计。
    - 状态列（StatusColumn）显示成 StatusBadge；RowTone 给整行着色；ActiveKey 标出主从视图里正在看的一行。
    未声明的属性落到 table 上；aria-label 或 aria-labelledby 是表格的名称。
*@
@namespace Rune.UI
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits UIComponent

<CascadingValue Value="columns" IsFixed="true">
    @{ columns.Start(); }
    @ChildContent
    @Deferred
</CascadingValue>

@code {
    readonly string detailIdPrefix = UniqueId.Next("data-table-detail");

    // 表格在各列把自己交给表格之后才渲染：排到渲染队列的末尾（Defer 是内部组件，不能写成标记）
    RenderFragment Deferred => builder =>
    {
        builder.OpenComponent<Defer>(0);
        builder.AddComponentParameter(1, nameof(Defer.ChildContent), (RenderFragment)(inner =>
        {
            FinishCollectingColumns();
            inner.AddContent(0, Table);
        }));
        builder.CloseComponent();
    };

    RenderFragment Table => __builder =>
    {
        var look = Look;
        var parts = DataTableStyles.Of(look, Config.Styles);
        var items = Rows;
        var shown = Shown;
        var layout = ColumnDisplay.HeaderLayout(shown);
        var headerRows = layout is null ? 1 : 2;
        var hasDetail = DetailContent is not null;
        var offsets = ColumnDisplay.Offsets(shown, LeadingWidth);
        var span = shown.Count + (SelectionMode is null ? 0 : 1) + (hasDetail ? 1 : 0);
        var bodyCount = BodyCount;
        var summary = items.Count > 0 && !Replacing && shown.Any(static view => view.Column.Summary is not null || view.Column.SummaryContent is not null);
        // 有起始边的固定列时，勾选列、详情列也固定在最前面
        var stickySelectStyle = offsets.Start.Count > 0 ? DataTableStyles.StickySelect : null;
        Attrs? stickySelect = stickySelectStyle is null ? null : new Attrs { Sx = stickySelectStyle };
        Attrs? stickyDetail = offsets.Start.Count == 0 ? null : new Attrs
        {
            Sx = DataTableStyles.Sticky,
            InlineStyle = $"inset-inline-start:{ColumnDisplay.Px(SelectionMode is null ? 0 : SelectWidth)}",
        };
        var rowSpan = headerRows > 1 ? headerRows : (int?)null;
        var navigable = Navigable;
        var reorderable = Reorderable;

        <ScrollArea Axis="ScrollAxis.Both" Focusable="Virtual" PropsViewport="ViewportManaged"
                    @attributes="Attrs.MergeProps(Attrs.Layer(parts[DataTablePart.Root], Flexible ? DataTableStyles.Flexible : null as Attrs), PropsRoot)">
            <table @attributes="Attrs.Merge(parts[DataTablePart.Table], Rest, TableManaged(bodyCount + headerRows + (summary ? 1 : 0), shown))">
                <colgroup>
                    @if (SelectionMode is not null)
                    {
                        <col style="width:@ColumnDisplay.Px(SelectWidth)" />
                    }
                    @if (hasDetail)
                    {
                        <col style="width:@ColumnDisplay.Px(DetailWidth)" />
                    }
                    @foreach (var view in shown)
                    {
                        var width = view.Width is { } px ? ColumnDisplay.Px(px) : ColumnDisplay.FlexWidth(view, shown, LeadingWidth);
                        <col @key="view.Column" data-column="@view.Key" style="@(width is null ? null : $"width:{width}")" />
                    }
                </colgroup>
                <thead @attributes="Attrs.Merge(parts[DataTablePart.Head])">
                    <tr aria-rowindex="1" @attributes="Attrs.Merge(parts[DataTablePart.HeadRow])">
                        @if (SelectionMode is not null)
                        {
                            <th scope="col" rowspan="@rowSpan" @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.HeaderCell], parts[DataTablePart.SelectHeaderCell], stickySelect))">
                                @if (SelectionMode == UI.SelectionMode.Multiple)
                                {
                                    var state = SelectAllState;
                                    <Checkbox Value="state.All" Indeterminate="state.Some" Disabled="!state.Any" ValueChanged="@(_ => ToggleAllAsync())"
                                              aria-label="@Config.Lang.TableSelectAll" @attributes="Attrs.MergeProps(parts[DataTablePart.SelectAll])" />
                                }
                                else
                                {
                                    <VisuallyHidden>@Config.Lang.TableSelectColumn</VisuallyHidden>
                                }
                            </th>
                        }
                        @if (hasDetail)
                        {
                            <th scope="col" rowspan="@rowSpan" @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.HeaderCell], parts[DataTablePart.DetailHeaderCell], stickyDetail))">
                                <VisuallyHidden>@Config.Lang.TableDetails</VisuallyHidden>
                            </th>
                        }
                        @if (layout is null)
                        {
                            foreach (var view in shown)
                            {
                                @HeaderCell(view, shown, parts, offsets, 1, false)
                            }
                        }
                        else
                        {
                            for (var position = 0; position < layout.Count; position++)
                            {
                                var cell = layout[position];
                                // 分组与相邻的列之间一条竖线
                                var divider = position > 0 && (cell.Group is not null || layout[position - 1].Group is not null);
                                if (cell.Group is { } group)
                                {
                                    <th @key="@($"{group}-{position}")" scope="colgroup" colspan="@cell.Columns.Count"
                                        @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.HeaderCell], parts[DataTablePart.GroupHeaderCell], GroupLayer(cell.Columns, offsets, divider)))">@group</th>
                                }
                                else
                                {
                                    @HeaderCell(cell.Columns[0], shown, parts, offsets, 2, divider)
                                }
                            }
                        }
                    </tr>
                    @if (layout is not null)
                    {
                        <tr aria-rowindex="2" @attributes="Attrs.Merge(parts[DataTablePart.HeadRow])">
                            @for (var position = 0; position < layout.Count; position++)
                            {
                                var cell = layout[position];
                                if (cell.Group is null) continue;
                                for (var member = 0; member < cell.Columns.Count; member++)
                                {
                                    @HeaderCell(cell.Columns[member], shown, parts, offsets, 1, member == 0 && position > 0)
                                }
                            }
                        </tr>
                    }
                </thead>
                <tbody data-rune-virtual-list @attributes="Attrs.Merge(parts[DataTablePart.Body], reorderable ? SortableBody : null)">
                    @if (Replacing)
                    {
                        @SkeletonRows(SkeletonRowCount, parts, shown.Count)
                    }
                    else if (items.Count == 0 && !Loading)
                    {
                        <tr>
                            <td colspan="@span" @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.Cell], parts[DataTablePart.EmptyCell]))">
                                @if (Empty is not null)
                                {
                                    @Empty
                                }
                                else
                                {
                                    <Empty Size="Size.Sm" @attributes="Attrs.MergeProps(null, PropsEmpty)"><Title>@(EmptyText ?? Config.Lang.TableEmpty)</Title></Empty>
                                }
                            </td>
                        </tr>
                    }
                    else if (items.Count > 0)
                    {
                        var (from, to) = RenderedRange;
                        var selectedKeys = SelectedKeys;
                        var expanded = expandedRows.Value;
                        @if (Virtual)
                        {
                            <tr data-rune-virtual-before aria-hidden="true"><td colspan="@span" @attributes="Attrs.Merge(parts[DataTablePart.Spacer])"></td></tr>
                        }
                        @for (var position = from; position <= to; position++)
                        {
                            var entry = EntryAt(position);
                            var index = entry.Index;
                            var item = items[index];
                            var key = GetKey(item);
                            var detailId = $"{detailIdPrefix}-{index}";
                            if (entry.Detail)
                            {
                                // 详情：一行一个跨全部列的格；内容让过勾选列与展开列，和第一个数据列对齐
                                <tr @key="@($"{key}\u0000detail")" data-index="@position" data-virtual-key="@($"{key}#detail")" data-detail aria-rowindex="@(position + headerRows + 1)"
                                    @attributes="Attrs.Merge(parts[DataTablePart.DetailRow])">
                                    <td id="@detailId" colspan="@span" @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.Cell], parts[DataTablePart.DetailCell]))">
                                        <div @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.DetailContent], DetailIndent))">@DetailContent!(item)</div>
                                    </td>
                                </tr>
                                continue;
                            }
                            var number = index + 1;
                            var isSelected = SelectionMode is not null && selectedKeys.Contains(key);
                            var isExpanded = hasDetail && expanded.Contains(key);
                            var active = ActiveKey is not null && ActiveKey == key;
                            var tone = RowTone?.Invoke(item);
                            var rowParts = IsStriped && index % 2 == 1 ? DataTableStyles.Of(look with { Striped = true }, Config.Styles) : parts;
                            var label = reorderable ? RowLabel(item, shown) : null;
                            var rowLayer = Attrs.Layer(rowParts[DataTablePart.Row], new Attrs
                            {
                                Sx = Sx.Of(tone is { } t ? DataTableStyles.ToneOf(t) : null, isSelected ? DataTableStyles.Selected : null,
                                    active ? DataTableStyles.Active : null, OnRowClick.HasDelegate ? DataTableStyles.Clickable : null,
                                    reorderable ? DataTableStyles.SortableRow : null),
                                ["data-rune-sortable-item"] = reorderable ? key : null,
                                ["data-label"] = label,
                            });
                            <tr @key="key" data-index="@position" data-key="@key" data-state="@(isSelected ? "selected" : null)" data-tone="@tone?.ToString().ToLowerInvariant()"
                                aria-rowindex="@(position + headerRows + 1)" aria-selected="@(SelectionMode is null ? null : isSelected ? "true" : "false")" aria-current="@(active ? "true" : null)"
                                @attributes="Attrs.Merge(rowLayer, PropsRowFor?.Invoke(item, index) ?? PropsRow)">
                                @if (SelectionMode is not null)
                                {
                                    <td @attributes="Attrs.Merge(Attrs.Layer(rowParts[DataTablePart.Cell], rowParts[DataTablePart.SelectCell], new Attrs { Sx = Sx.Of(stickySelectStyle, active ? DataTableStyles.ActiveEdge : null) }))">
                                        @if (SelectionMode == UI.SelectionMode.Single)
                                        {
                                            <CascadingValue TValue="IRadioGroup<string>" Value="Radios">
                                                <Radio TValue="string" Value="key" Disabled="!IsSelectable(item)" aria-label="@Config.Lang.TableSelectRow(number)"
                                                       Sx="rowParts[DataTablePart.SelectRadio].Sx" />
                                            </CascadingValue>
                                        }
                                        else
                                        {
                                            <Checkbox Value="isSelected" Indeterminate="@(PartialKeys?.Contains(key) == true)" Disabled="!IsSelectable(item)" ValueChanged="@(_ => ToggleRowAsync(key))"
                                                      aria-label="@Config.Lang.TableSelectRow(number)" @attributes="Attrs.MergeProps(rowParts[DataTablePart.SelectCheckbox])" />
                                        }
                                    </td>
                                }
                                @if (hasDetail)
                                {
                                    <td @attributes="Attrs.Merge(Attrs.Layer(rowParts[DataTablePart.Cell], rowParts[DataTablePart.DetailToggleCell], Attrs.Layer(stickyDetail, active && SelectionMode is null ? (Attrs)DataTableStyles.ActiveEdge : null)))">
                                        @if (HasDetail?.Invoke(item) ?? true)
                                        {
                                            <IconButton Icon="BuiltInIcons.ChevronRight" Size="Size.Sm" Radius="Radius.Full" Label="@Config.Lang.TableRowDetails(RowLabel(item, shown))"
                                                        PropsIcon="@(isExpanded ? ExpandedIcon : CollapsedIcon)" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@(isExpanded ? detailId : null)"
                                                        @onclick="DetailClick(key)" @attributes="Attrs.MergeProps(rowParts[DataTablePart.DetailToggle])" />
                                        }
                                    </td>
                                }
                                @{ var rowErrors = navigable ? ValidateRow?.Invoke(item) : null; }
                                @for (var column = 0; column < shown.Count; column++)
                                {
                                    var view = shown[column];
                                    var editingHere = editing is { } edit && edit.Row == key && edit.Column == view.Key;
                                    var editable = navigable && view.Column.CanEdit(item);
                                    var error = rowErrors?.GetValueOrDefault(view.Key);
                                    var cellLayer = Attrs.Layer(rowParts[DataTablePart.Cell], new Attrs
                                    {
                                        Sx = Sx.Of(TableStyles.AlignOf(view.Align), view.Column.Wrap ? TableStyles.Wrap : null,
                                            active && column == 0 && SelectionMode is null && !hasDetail ? DataTableStyles.ActiveEdge : null,
                                            navigable ? DataTableStyles.GridCell : null, editable && EditTrigger == EditTrigger.Click ? DataTableStyles.ClickToEdit : null,
                                            editingHere ? DataTableStyles.EditingCell : null, error is null ? null : DataTableStyles.InvalidCell),
                                    }, StickyLayer(view, offsets));
                                    // 单元格导航：data-column 是 JS 认格的标记；校验错误悬停看，读屏随格一起念（aria-description）
                                    var gridLayer = navigable ? new Attrs
                                    {
                                        Title = error,
                                        ["data-column"] = view.Key,
                                        ["data-editable"] = editable ? "" : null,
                                        ["data-editing"] = editingHere ? "" : null,
                                        ["aria-invalid"] = error is null ? null : "true",
                                        ["aria-description"] = error,
                                    } : null;
                                    <td @key="view.Column" @attributes="Attrs.Merge(cellLayer, PropsCellFor?.Invoke(item, view.Key), gridLayer)">
                                        @if (editingHere)
                                        {
                                            @EditorCell(view.Column, item)
                                        }
                                        else if (column == 0 && (reorderable || Leading is not null))
                                        {
                                            @* 第一个数据列前面：拖动的把手，再是 Leading（树形表格的缩进与展开按钮） *@
                                            <div @attributes="Attrs.Merge(DataTableStyles.Leading)">
                                                @if (reorderable)
                                                {
                                                    <ButtonBase Ripple="false" data-rune-sortable-handle aria-label="@Config.Lang.SortableHandle(label!)" aria-describedby="@sortableInstructionsId"
                                                                aria-pressed="false" Sx="Sx.Of(DataTableStyles.RowHandle)">
                                                        <Icon Data="BuiltInIcons.GripVertical" />
                                                    </ButtonBase>
                                                }
                                                @Leading?.Invoke(item)
                                                <div @attributes="Attrs.Merge(DataTableStyles.LeadingContent)">@CellOf(view.Column, item, view.Type)</div>
                                            </div>
                                        }
                                        else
                                        {
                                            @CellOf(view.Column, item, view.Type)
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if (Virtual)
                        {
                            <tr data-rune-virtual-after aria-hidden="true"><td colspan="@span" @attributes="Attrs.Merge(parts[DataTablePart.Spacer])"></td></tr>
                        }
                    }
                    @if (Appending)
                    {
                        @SkeletonRows(MoreSkeletonRows, parts, shown.Count)
                    }
                </tbody>
                @if (summary)
                {
                    <tfoot @attributes="Attrs.Merge(parts[DataTablePart.Foot])">
                        <tr aria-rowindex="@(bodyCount + headerRows + 1)">
                            @if (SelectionMode is not null)
                            {
                                <td @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.Cell], parts[DataTablePart.SummaryCell], stickySelect))"></td>
                            }
                            @if (hasDetail)
                            {
                                <td @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.Cell], parts[DataTablePart.SummaryCell], stickyDetail))"></td>
                            }
                            @for (var position = 0; position < shown.Count; position++)
                            {
                                var view = shown[position];
                                <td @key="view.Column" @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.Cell], parts[DataTablePart.SummaryCell],
                                        Attrs.Layer(TableStyles.AlignOf(view.Align), StickyLayer(view, offsets))))">
                                    @SummaryOf(view.Column, position, view.Type)
                                </td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
        </ScrollArea>
        @if (OnReorder.HasDelegate)
        {
            <VisuallyHidden id="@sortableInstructionsId">@Config.Lang.SortableInstructions</VisuallyHidden>
        }
    };

    // 能拖动时表体是 sortable 的列表（js/sortable.js）：行是项，把手在第一个数据列里
    Attrs SortableBody => new()
    {
        Sx = SortableStyles.List.Sx,
        Class = SortableStyles.List.Class,
        ["data-rune-sortable"] = "vertical",
        ["data-texts"] = SortableTexts.Of(Config.Lang),
        ["onrunereorder"] = EventCallback.Factory.Create<ReorderEventArgs>(this, OnReorderAsync),
    };

    // 编辑中的格：列的编辑器，提交被拒的原因浮在下面
    RenderFragment EditorCell(DataTableColumn<TItem> column, TItem item) => __builder =>
    {
        var session = EditSession(column);
        <div data-rune-cell-editor @attributes="Attrs.Merge(DataTableStyles.Editor)">
            @column.EditorFor(item, session)
            @if (session.Error is { } error)
            {
                <div role="alert" @attributes="Attrs.Merge(DataTableStyles.EditorError)">@error</div>
            }
        </div>
    };

    // 一个列标题：可排序的是按钮；有表头筛选、列菜单时按钮在结尾；可以调整宽度时结束边有手柄。
    // rowSpan 是没分组的列在两行表头里跨两行，divider 是与分组相邻的竖线
    RenderFragment HeaderCell(ColumnView<TItem> view, IReadOnlyList<ColumnView<TItem>> shown, PartLayers<DataTablePart> parts, StickyOffsets offsets, int rowSpan, bool divider) => __builder =>
    {
        var column = view.Column;
        var sortList = ActiveSorts;
        var priority = IndexOfSort(sortList, view.Key);
        var direction = priority >= 0 ? sortList[priority].Direction : (SortDirection?)null;
        var actions = column.Filter is not null || ColumnMenu;
        var position = IndexOfView(shown, view.Key);
        <th @key="column" scope="col" rowspan="@(rowSpan > 1 ? rowSpan : null)" data-column="@view.Key" data-sticky="@view.Sticky?.ToString().ToLowerInvariant()"
            aria-sort="@(column.Sortable ? (priority == 0 ? AriaSort(direction) : "none") : null)"
            @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.HeaderCell], new Attrs { Sx = Sx.Of(TableStyles.AlignOf(view.Align), divider ? DataTableStyles.GroupDivider : null) }, StickyLayer(view, offsets)))">
            @if (actions)
            {
                <div @attributes="Attrs.Merge(parts[DataTablePart.HeaderContent])">
                    <span @attributes="Attrs.Merge(Attrs.Layer(parts[DataTablePart.HeaderMain], view.Align == TableAlign.End ? (Attrs)DataTableStyles.HeaderMainEnd : null))">
                        @HeaderTitle(view, parts, priority, direction, sortList.Count)
                    </span>
                    @if (column.Filter is { } kind)
                    {
                        <ColumnFilterButton Label="@column.Label" Options="@(kind == ColumnFilterKind.Keyword ? null : FilterOptionsOf(column))"
                                            Values="@filters.Value.GetValueOrDefault(view.Key, [])" ValuesChanged="@(values => SetFilterAsync(view.Key, values))" />
                    }
                    @if (ColumnMenu)
                    {
                        <ColumnMenuButton Label="@column.Label" Sortable="column.Sortable" Sorted="direction" Pinned="view.Sticky"
                                          CanMoveBackward="@(position > 0 && shown[position - 1].Sticky == view.Sticky)"
                                          CanMoveForward="@(position < shown.Count - 1 && shown[position + 1].Sticky == view.Sticky)"
                                          CanHide="@(shown.Count > 1)" OnAction="@(action => OnColumnActionAsync(view, shown, action))" />
                    }
                </div>
            }
            else
            {
                @HeaderTitle(view, parts, priority, direction, sortList.Count)
            }
            @if (column.Resizable ?? Resizable)
            {
                <ColumnResizer Label="@column.Label" Width="view.Width" MinWidth="@(column.MinWidth ?? 64)" WidthChanged="@(width => SetWidthAsync(view.Key, width))" />
            }
        </th>
    };

    // 列标题的文字：可排序的是按钮（箭头、多列排序时的次序）
    RenderFragment HeaderTitle(ColumnView<TItem> view, PartLayers<DataTablePart> parts, int priority, SortDirection? direction, int sortCount) => __builder =>
    {
        var column = view.Column;
        if (!column.Sortable)
        {
            @Header(column)
            return;
        }
        <ButtonBase @attributes="Attrs.MergeProps(parts[DataTablePart.SortButton])" @onclick="SortClick(column)">
            <span @attributes="Attrs.Merge(parts[DataTablePart.SortLabel])">@Header(column)</span>
            <Icon Data="@(direction switch { SortDirection.Ascending => BuiltInIcons.ArrowUp, SortDirection.Descending => BuiltInIcons.ArrowDown, _ => BuiltInIcons.ArrowUpDown })"
                  @attributes="Attrs.MergeProps(Attrs.Layer(parts[DataTablePart.SortIcon], direction is null ? null : (Attrs)DataTableStyles.SortActive))" />
            @if (sortCount > 1 && priority >= 0)
            {
                <span aria-hidden="true" @attributes="Attrs.Merge(parts[DataTablePart.SortPriority])">@(priority + 1)</span>
                @* aria-sort 只放在第一排序列上（ARIA 的要求），其余列的次序与方向写给读屏 *@
                @if (priority > 0)
                {
                    <VisuallyHidden>@Config.Lang.TableSortPriority(priority + 1, direction == SortDirection.Ascending ? Config.Lang.TableSortAscending : Config.Lang.TableSortDescending)</VisuallyHidden>
                }
            }
        </ButtonBase>
    };

    // 一行骨架：同一行的单元格一起扫，行与行依次错开（一道波从上往下推过表格）
    RenderFragment SkeletonRows(int count, PartLayers<DataTablePart> parts, int columnCount) => __builder =>
    {
        for (var row = 0; row < count; row++)
        {
            <tr @key="@($"skeleton-{row}")" aria-hidden="true" @attributes="Attrs.Merge(parts[DataTablePart.Row])">
                @if (SelectionMode is not null)
                {
                    <td @attributes="Attrs.Merge(parts[DataTablePart.Cell])"></td>
                }
                @if (DetailContent is not null)
                {
                    <td @attributes="Attrs.Merge(parts[DataTablePart.Cell])"></td>
                }
                @for (var position = 0; position < columnCount; position++)
                {
                    <td @attributes="Attrs.Merge(parts[DataTablePart.Cell])">
                        <Skeleton Delay="@(row * ShimmerStyles.Stagger)" @attributes="Attrs.MergeProps(Attrs.Layer(parts[DataTablePart.Skeleton], SkeletonWidth(row, position)), PropsSkeleton)" />
                    </td>
                }
            </tr>
        }
    };

    static readonly Attrs CollapsedIcon = new() { Sx = DisclosureStyles.Icon, ["FlipInRtl"] = true };
    static readonly Attrs ExpandedIcon = new() { Sx = Sx.Of(DisclosureStyles.Icon, DisclosureStyles.Turn), ["FlipInRtl"] = true };

    // 详情内容让过勾选列与展开列，和第一个数据列对齐；宽度不超过视口
    Attrs DetailIndent => new() { InlineStyle = $"margin-inline-start:{ColumnDisplay.Px(LeadingWidth)};max-width:calc(100cqi - {ColumnDisplay.Px(LeadingWidth)})" };

    // 骨架条的长短错落：90%、75%、60%、45%
    static Attrs SkeletonWidth(int row, int position) => new() { InlineStyle = $"width:{90 - (row + position) % 4 * 15}%" };

    // 分组标题的固定：组里的列都固定在同一侧时跟着固定，偏移取最靠外的一列；含挨着滚动列的那一列时也画竖线
    static Attrs GroupLayer(IReadOnlyList<ColumnView<TItem>> members, StickyOffsets offsets, bool divider)
    {
        var dividerStyle = divider ? DataTableStyles.GroupDivider : null;
        var side = members[0].Sticky;
        if (side is null || members.Any(member => member.Sticky != side)) return new() { Sx = Sx.Of(dividerStyle) };
        var (outer, inner) = side == ColumnSticky.Start ? (members[0], members[^1]) : (members[^1], members[0]);
        return side == ColumnSticky.Start
            ? new()
            {
                Sx = Sx.Of(dividerStyle, DataTableStyles.Sticky, offsets.StartEdge == inner.Key ? DataTableStyles.StickyStartEdge : null),
                InlineStyle = $"inset-inline-start:{ColumnDisplay.Px(offsets.Start[outer.Key])}",
            }
            : new()
            {
                Sx = Sx.Of(dividerStyle, DataTableStyles.Sticky, offsets.EndEdge == inner.Key ? DataTableStyles.StickyEndEdge : null),
                InlineStyle = $"inset-inline-end:{ColumnDisplay.Px(offsets.End[outer.Key])}",
            };
    }

    RenderFragment Header(DataTableColumn<TItem> column) => column.HeaderContent ?? (builder => builder.AddContent(0, column.Label));

    static int IndexOfSort(IReadOnlyList<ColumnSort> sorts, string key)
    {
        for (var at = 0; at < sorts.Count; at++)
        {
            if (sorts[at].Key == key) return at;
        }
        return -1;
    }

    static int IndexOfView(IReadOnlyList<ColumnView<TItem>> shown, string key)
    {
        for (var at = 0; at < shown.Count; at++)
        {
            if (shown[at].Key == key) return at;
        }
        return -1;
    }

    static string? AriaSort(SortDirection? direction) => direction switch
    {
        SortDirection.Ascending => "ascending",
        SortDirection.Descending => "descending",
        _ => "none",
    };
}
