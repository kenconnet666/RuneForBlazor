@*
    表头单元格（th）：表头里是列标题，表体与表尾里是行标题（scope 跟着所在的区，也可以写 Scope 指定）。<TableHeaderCell Align="TableAlign.End" Width="@("8rem")">金额</TableHeaderCell>
    读屏念单元格时会带上行名与列名。未声明的属性（colspan 等）落到 th 上。
*@
@namespace Rune.UI
@inherits UIComponent
@{
    var parts = TableStyles.Of(Table ?? TableAppearance.Standalone, Config.Styles);
    var head = Section == TableSection.Head;
    var layer = head
        ? Attrs.Layer(parts[TablePart.HeaderCell], CellLayer)
        : Attrs.Layer(parts[TablePart.Cell], Attrs.Layer(parts[TablePart.RowHeader], Section == TableSection.Foot ? Part.Unmarked(parts[TablePart.FootCell]) : null, CellLayer));
}

<th scope="@(Scope ?? (head ? "col" : "row"))" @attributes="Attrs.Merge(layer, Rest)">@ChildContent</th>

@code {
    /// <summary>对齐，默认起始边；数字、金额用 End。</summary>
    [Parameter] public TableAlign Align { get; set; }

    /// <summary>不换行（超出时省略号）；默认可以换行。</summary>
    [Parameter] public bool NoWrap { get; set; }

    /// <summary>固定在起始边（第一列，常是行标题）：横向滚动时一直看得到。</summary>
    [Parameter] public bool Sticky { get; set; }

    /// <summary>对应的方向：不写时表头里是 col（列标题），表体与表尾里是 row（行标题）。</summary>
    [Parameter] public string? Scope { get; set; }

    /// <summary>列宽：日期、数字、操作这类按内容定宽的列；不写的列分剩下的。</summary>
    [Parameter] public CssLength? Width { get; set; }

    /// <summary>内容。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] TableAppearance? Table { get; set; }

    [CascadingParameter] TableSection Section { get; set; } = TableSection.Head;

    // 对齐、换行、列宽：叠在部件层之后
    Attrs CellLayer => new()
    {
        Sx = Sx.Of(TableStyles.AlignOf(Align), NoWrap ? null : TableStyles.Wrap, Width is null ? null : TableStyles.Width, Sticky ? DataTableStyles.StickyStart : null, Sticky ? DataTableStyles.StickyStartEdge : null),
        Vars = Width is { } width ? [TableStyles.ColumnWidth.Set(width)] : [],
    };
}
