@*
    日期区间选择器（同 vue-tsx-pro 的 DateRangePicker）：一个输入框里两组分段（开始 – 结束），按钮弹出区间日历，旁边可以放快捷区间。
    <Field Label="统计区间"><DateRangePicker @bind-Value="range" Max="today" Presets="[DateRangePreset.Last7Days, DateRangePreset.ThisMonth]" /></Field>
    <DateRangePicker @bind-Value="months" Granularity="DateGranularity.Month" aria-label="预算期间" />
    值是 DateRange（两端都含），两组都填好才写回，删掉一段写回 null。Granularity 同 DateField 的年、季度、月、周、日：
    按月、按年时开始是那一段的第一天、结束是最后一天（日历里选整月、整年；季度在月份视图里选）。
    结束早于开始、超出范围、夹着不可选的日期（AllowsUnavailableInRange 为 false 时）时外壳显示出错，值照样写回，由表单校验决定能不能提交。
    开始那组填满时焦点自动进结束那组；日历里点开始、再点结束后关闭，焦点回到按钮。Esc、点外部关闭，分段里 Alt + ↓ 打开。
    未声明的属性落到外壳（role="group"）上。写了 StartName、EndName 时两端各用一个隐藏的 input 随表单提交 ISO 文字。
*@
@namespace Rune.UI
@inherits InputControl<DateRange?>
@{
    var parts = InputStyles.Of(Appearance, Config.Styles);
    var own = SegmentedFieldStyles.Of(Config.Styles);
    var picker = PickerStyles.Of(Size, Config.Styles);
    var lang = Config.Lang;
    var invalid = IsInvalid || OutOfRange;
    var editable = !IsDisabled && !IsReadOnly;
    var labelled = AdditionalAttributes?.ContainsKey("aria-label") == true ? null : Field?.LabelId;
    var fields = DateSegments.FieldsOf(Granularity);
}

<div @attributes="Attrs.Merge(parts[InputPart.Root], Attrs.Merge(RootUserAttrs, InputUserAttrs), ShellManaged(labelled, invalid))">
    @if (Icon is not null)
    {
        <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[InputPart.Icon], PropsIcon)" />
    }
    <span id="@StartLabelId" @attributes="Attrs.Merge(HiddenLayer)">@lang.DateRangeStart</span>
    <span id="@EndLabelId" @attributes="Attrs.Merge(HiddenLayer)">@lang.DateRangeEnd</span>
    <DateSegmentGroup Id="@($"{ControlId}-start")" Fields="fields" Iso="@startIso" Disabled="IsDisabled" ReadOnly="IsReadOnly" Required="IsRequired" Invalid="invalid"
                      LabelledBy="@Join(labelled, StartLabelId)" DescribedBy="@Field?.DescribedBy" Name="@StartName" UserAttrs="PropsStart"
                      PropsSegment="PropsSegment" PropsLiteral="PropsLiteral" OnChange="StartChangedAsync" />
    <span aria-hidden="true" @attributes="Attrs.Merge(SeparatorLayer, PropsSeparator)">–</span>
    <DateSegmentGroup Id="@($"{ControlId}-end")" Fields="fields" Iso="@endIso" Disabled="IsDisabled" ReadOnly="IsReadOnly" Required="IsRequired" Invalid="invalid"
                      LabelledBy="@Join(labelled, EndLabelId)" DescribedBy="@Field?.DescribedBy" Name="@EndName" UserAttrs="PropsEnd"
                      PropsSegment="PropsSegment" PropsLiteral="PropsLiteral" OnChange="EndChangedAsync" />
    @if (Clearable && editable)
    {
        <ClearButton Label="@ClearLabel" Radius="UI.Radius.Full" tabindex="-1" data-rune-segments-clear hidden="@(startIso is null && endIso is null)"
                     @attributes="Attrs.MergeProps(Attrs.Layer(parts[InputPart.Button], own[SegmentedFieldPart.Clear]), PropsClear)" />
    }
    @PickerParts.Trigger(BuiltInIcons.CalendarRange, lang.DatePickerOpen, editable, open, PopoverId, parts[InputPart.Button], PropsButton)
</div>
<div @attributes="Attrs.Merge(picker[PickerPart.Popover], PropsPopover, PopoverManaged)">
    @if (open)
    {
        @if (Presets.Count > 0)
        {
            var today = Today;
            var first = LangFormat.FirstDayOfWeek(lang);
            <div role="group" aria-label="@lang.DateRangePresets" @attributes="Attrs.Merge(picker[PickerPart.Presets])">
                @foreach (var preset in Presets)
                {
                    var range = preset.RangeOn(today, first);
                    var active = CurrentValue == range;
                    <Button @key="preset.LabelIn(lang)" Size="UI.Size.Sm" Variant="@(active ? ButtonVariant.Soft : ButtonVariant.Ghost)" Tone="Tone.Neutral"
                            aria-pressed="@(active ? "true" : "false")" Disabled="!Selectable(range)"
                            @onclick="() => PickAsync(range)" @attributes="Attrs.MergeProps(picker[PickerPart.Preset])">@preset.LabelIn(lang)</Button>
                }
            </div>
        }
        <RangeCalendar Value="CurrentValue" OnPick="PickAsync" Granularity="CalendarUnit" Min="Min" Max="Max" IsDateUnavailable="IsDateUnavailable"
                       AllowsUnavailableInRange="AllowsUnavailableInRange" VisibleMonths="VisibleMonths" Size="Size"
                       FirstDayOfWeek="@(Granularity == DateGranularity.Week ? DayOfWeek.Monday : null)" ShowWeekNumbers="@(Granularity == DateGranularity.Week)"
                       aria-label="@lang.DatePickerOpen" @attributes="Attrs.MergeProps(null, PropsCalendar)" />
    }
</div>
