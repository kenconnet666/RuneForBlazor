@*
    季度面板（同 vue-tsx-pro 的 QuarterCalendar）：一年一页的四个季度（季度报表、考核周期），翻页换年；选一个季度，或选一段区间（先开始、再结束）。
    DatePicker、DateRangePicker 的 Granularity="DateGranularity.Quarter" 弹出的就是它，也可以单独放在页面上。
    <QuarterCalendar @bind-Value="quarter" aria-label="考核季度" />            值是那个季度的第一天
    <QuarterCalendar @bind-Range="range" aria-label="对比区间" />             开始季度的第一天到结束季度的最后一天
    外观与 Calendar 的月份视图一致（同一套 CalendarStyles）：一行四格，区间连成一条，本季度带描边。
    焦点在当前季度上（roving tabindex）：←→ 移动（到头时换年；从右到左排版时反过来），Home / End 到第一、第四季度，
    Page Up / Down 换年，Enter / 空格选中；区间选到一半时悬停预览，Esc 取消（js/calendar.js 的 quarter 视图）。整段在 Min–Max 之外的季度不可用。
    未声明的属性落到根元素上。
*@
@namespace Rune.UI
@inherits UIComponent
@{
    var parts = CalendarStyles.Of(Config.Styles);
    var lang = Config.Lang;
    var range = Selection;
}

<div @attributes="Attrs.Merge(parts[CalendarPart.Root], Rest, RootManaged)" @onrunecommand="OnCommandAsync">
    <div @attributes="Attrs.Merge(parts[CalendarPart.Header])">
        <IconButton Icon="BuiltInIcons.ChevronLeft" Label="@lang.CalendarPreviousYear" PropsIcon="FlipIcon" Disabled="Disabled" @onclick="() => year--" />
        <span data-static @attributes="Attrs.Merge(parts[CalendarPart.Heading])">@lang.CalendarYear(year)</span>
        <IconButton Icon="BuiltInIcons.ChevronRight" Label="@lang.CalendarNextYear" PropsIcon="FlipIcon" Disabled="Disabled" @onclick="() => year++" />
    </div>
    <table role="grid" aria-label="@lang.CalendarYear(year)" aria-multiselectable="@(IsRange ? "true" : null)" data-view="month" @attributes="Attrs.Merge(parts[CalendarPart.Grid])">
        <tbody>
            <tr>
                @for (var quarter = 1; quarter <= 4; quarter++)
                {
                    var start = new DateOnly(year, (quarter - 1) * 3 + 1, 1);
                    var off = Disabled || Unavailable(start);
                    var inRange = range is { } r && start >= r.Start && start <= r.End;
                    var ends = range is { } e && (start == e.Start || DateSegments.PeriodEnd(start, DateGranularity.Quarter) == e.End);
                    var selected = IsRange ? inRange : Value is { } v && Start(v) == start;
                    var focusable = Start(focused) == start || (focused.Year != year && quarter == 1);
                    <td @key="start" role="gridcell" aria-selected="@(selected ? "true" : "false")" aria-disabled="@(off ? "true" : null)"
                        data-in-range="@(inRange ? true : null)" data-range-start="@(range is { } s && s.Start == start ? true : null)"
                        data-range-end="@(range is { } t && DateSegments.PeriodEnd(start, DateGranularity.Quarter) == t.End ? true : null)"
                        @attributes="Attrs.Merge(parts[CalendarPart.Cell])">
                        <button type="button" tabindex="@(focusable ? "0" : "-1")" aria-disabled="@(off ? "true" : null)" aria-describedby="@(anchor is null ? null : HintId)"
                                data-date="@DateValues.Iso(start)" data-focused="@(focusable ? true : null)" data-selected="@((IsRange ? ends : selected) ? true : null)"
                                data-today="@(Start(Today) == start ? true : null)" data-anchor="@(anchor == start ? true : null)" data-in-range="@(inRange ? true : null)" data-period
                                @attributes="Attrs.Merge(parts[CalendarPart.CellButton])">
                            <span @attributes="Attrs.Merge(HiddenLayer)">@QuarterLabel(year, quarter)</span>
                            <span aria-hidden="true">@lang.CalendarQuarter(quarter)</span>
                        </button>
                    </td>
                }
            </tr>
        </tbody>
    </table>
    <span aria-live="polite" @attributes="Attrs.Merge(HiddenLayer)">@lang.CalendarYear(year)</span>
    @if (anchor is not null)
    {
        <span id="@HintId" @attributes="Attrs.Merge(HiddenLayer)">@lang.CalendarPickEnd</span>
    }
</div>

@code {
    static readonly Attrs FlipIcon = new() { ["FlipInRtl"] = true };
    static readonly Attrs HiddenLayer = new() { Sx = SharedStyles.VisuallyHidden };

    readonly string HintId = UniqueId.Next("quarter-hint");
    DateOnly focused;
    int year;
    // 区间选到一半：已经点了的开始季度
    DateOnly? anchor;
    bool started;

    [Inject] IServiceProvider Services { get; set; } = null!;

    /// <summary>选中的季度（<c>@bind-Value</c>）：那个季度的第一天；没有时 null。</summary>
    [Parameter] public DateOnly? Value { get; set; }

    /// <summary>选中的季度变了。</summary>
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    /// <summary>选中的区间（<c>@bind-Range</c>，写了它就是选区间）：开始季度的第一天到结束季度的最后一天。</summary>
    [Parameter] public DateRange? Range { get; set; }

    /// <summary>选中的区间变了。</summary>
    [Parameter] public EventCallback<DateRange?> RangeChanged { get; set; }

    /// <summary>最早可选的日期：整个季度都早于它时不可用。</summary>
    [Parameter] public DateOnly? Min { get; set; }

    /// <summary>最晚可选的日期：整个季度都晚于它时不可用。</summary>
    [Parameter] public DateOnly? Max { get; set; }

    /// <summary>不可用：不能翻页、不能选。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>只读：能翻页、移动焦点，不能改选择。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>选好了一个季度（区间时是选完了结束）：日期选择器据此关闭弹层。</summary>
    [Parameter] public EventCallback OnPick { get; set; }

    bool IsRange => RangeChanged.HasDelegate || Range is not null;

    DateOnly Today
    {
        get
        {
            var time = Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
            return DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(time.GetUtcNow(), LangFormat.ZoneOf(Config.Lang)).DateTime);
        }
    }

    // 已选的区间；选到一半时不画（从开始到悬停、焦点的预览在 JS 里画）
    DateRange? Selection => IsRange && anchor is null ? Range : null;

    static DateOnly Start(DateOnly day) => new(day.Year, (day.Month - 1) / 3 * 3 + 1, 1);

    string QuarterLabel(int year, int quarter) =>
        Config.Lang.DateFieldPeriodPatterns.TryGetValue("quarter", out var pattern)
            ? pattern.Replace("{year}", year.ToString(System.Globalization.CultureInfo.InvariantCulture)).Replace("{quarter}", quarter.ToString(System.Globalization.CultureInfo.InvariantCulture))
            : $"{year}-Q{quarter}";

    // 整个季度都在 Min–Max 之外
    bool Unavailable(DateOnly start) => (Max is { } max && start > max) || (Min is { } min && DateSegments.PeriodEnd(start, DateGranularity.Quarter) < min);

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (started) return;
        // 一开始显示已选（没有时是本季度）那一年，焦点也在它上面
        started = true;
        focused = Start(Value ?? Range?.Start ?? Today);
        year = focused.Year;
    }

    Attrs RootManaged => new()
    {
        Role = "group",
        ["data-rune-calendar"] = true,
        ["data-view"] = "quarter",
        ["data-focused-date"] = DateValues.Iso(focused),
        ["data-anchor"] = anchor is { } start ? DateValues.Iso(start) : null,
        ["data-disabled"] = Disabled ? true : null,
    };

    // JS 交来的：焦点移到某个季度（focus）、点了一格（activate）、Esc 取消选到一半的区间（cancel）
    async Task OnCommandAsync(CommandEventArgs args)
    {
        if (Disabled) return;
        if (args.Name == "cancel")
        {
            anchor = null;
            return;
        }
        if (!DateValues.TryParseIso(args.Text, out var date)) return;
        focused = Start(date);
        year = focused.Year;
        if (args.Name == "activate") await PickAsync(focused);
    }

    async Task PickAsync(DateOnly start)
    {
        if (ReadOnly || Unavailable(start)) return;
        if (!IsRange)
        {
            Value = start;
            await ValueChanged.InvokeAsync(start);
            await OnPick.InvokeAsync();
            return;
        }
        if (anchor is not { } first)
        {
            anchor = start;
            return;
        }
        anchor = null;
        var picked = DateRange.Of(first, start);
        Range = new DateRange(picked.Start, DateSegments.PeriodEnd(picked.End, DateGranularity.Quarter));
        await RangeChanged.InvokeAsync(Range);
        await OnPick.InvokeAsync();
    }
}
