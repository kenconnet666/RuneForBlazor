@*
    分段输入框（同 vue-tsx-pro 的 SegmentedField）：输入框外壳（同 TextField）里一组日期分段，可选的前置图标、清空按钮与尾部内容。
    DateField、TimeField 继承它（只差有哪些段、值的类型与怎样算超出范围）。
    - 一组分段见 DateSegmentGroup；点外壳的空白处时焦点进第一个没填的段。
    - 写了 name 时用隐藏的 input 随表单提交 ISO 文字。未声明的属性落到这组段上；Sx 落在外壳上。
*@
@namespace Rune.UI
@typeparam TValue
@inherits InputControl<TValue>
@{
    var parts = InputStyles.Of(Appearance, Config.Styles);
    var own = SegmentedFieldStyles.Of(Config.Styles);
    var iso = CurrentIso;
    var invalid = IsInvalid || (iso is not null && IsOutOfRange(iso));
    var editable = !IsDisabled && !IsReadOnly;
}

<div id="@ShellId" @attributes="Attrs.Merge(parts[InputPart.Root], RootUserAttrs, ShellAttrs)" data-invalid="@(invalid ? true : null)" data-disabled="@(IsDisabled ? true : null)">
    @if (Icon is not null)
    {
        <Icon Data="Icon" @attributes="Attrs.MergeProps(parts[InputPart.Icon], PropsIcon)" />
    }
    <DateSegmentGroup Id="@ControlId" Fields="Fields" Iso="@iso" HourCycle="HourCycle" Disabled="IsDisabled" ReadOnly="IsReadOnly" Required="IsRequired"
                      Invalid="invalid" LabelledBy="@Field?.LabelId" DescribedBy="@Field?.DescribedBy" Name="@FieldName" UserAttrs="InputUserAttrs"
                      PropsSegment="PropsSegment" PropsLiteral="PropsLiteral" OnChange="OnChangeAsync" />
    @if (Clearable && editable)
    {
        <ClearButton Label="@ClearLabel" Radius="UI.Radius.Full" tabindex="-1" data-rune-segments-clear hidden="@(iso is null)"
                     @attributes="Attrs.MergeProps(Attrs.Layer(parts[InputPart.Button], own[SegmentedFieldPart.Clear]), PropsClear)" />
    }
    @Suffix
    @Trigger
</div>
@Popover

@code {
    /// <summary>12 / 24 小时制（有时的段时）；不写时取语言包的，再不写按地区惯例。</summary>
    [Parameter] public HourCycle? HourCycle { get; set; }

    /// <summary>有值时显示清空按钮。</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>清空按钮的名称，默认取语言包的“清空”。</summary>
    [Parameter] public string? ClearLabel { get; set; }

    /// <summary>前置图标。</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>框里最后的内容（日期选择器打开日历的按钮、图标）。</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>前置图标的部件属性。</summary>
    [Parameter] public Attrs? PropsIcon { get; set; }

    /// <summary>每段的部件属性；角色、名称、取值由组件管理。</summary>
    [Parameter] public Attrs? PropsSegment { get; set; }

    /// <summary>分隔符的部件属性。</summary>
    [Parameter] public Attrs? PropsLiteral { get; set; }

    /// <summary>清空按钮的部件属性。</summary>
    [Parameter] public Attrs? PropsClear { get; set; }

    /// <summary>有哪些段，按年 → 秒的顺序（显示顺序按语言）。</summary>
    private protected abstract DateSegmentType[] Fields { get; }

    /// <summary>当前值的 ISO 文字（形式随段）；没有值时 null。</summary>
    private protected abstract string? CurrentIso { get; }

    /// <summary>填好的 ISO 文字 → 值（null 是删掉了一段）；值的类型写不了 null 时返回 false，值不变。</summary>
    private protected abstract bool TryFromIso(string? iso, out TValue value);

    /// <summary>值超出范围、不可选：外壳显示出错，值照样写回（由表单校验决定能不能提交）。</summary>
    private protected abstract bool IsOutOfRange(string iso);

    /// <summary>输入框外壳的 id：选择器的弹层贴着它定位。</summary>
    private protected string ShellId { get; } = UniqueId.Next("segmented-field");

    /// <summary>外壳里最后的打开按钮（选择器）；没有时 null。</summary>
    private protected virtual RenderFragment? Trigger => null;

    /// <summary>外壳后面的弹层（选择器）；没有时 null。</summary>
    private protected virtual RenderFragment? Popover => null;

    /// <summary>可以改值（不是不可用、只读）。</summary>
    private protected bool Editable => !IsDisabled && !IsReadOnly;

    /// <summary>写回一个值（选择器在弹层里选好了）。</summary>
    private protected Task WriteAsync(TValue value) => SetValueAsync(value);

    /// <summary>语言包的时区（DateTimeOffset 的值按它显示与写回）。</summary>
    private protected TimeZoneInfo Zone => LangFormat.ZoneOf(Config.Lang);

    async Task OnChangeAsync(string? iso)
    {
        if (TryFromIso(iso, out var value)) await SetValueAsync(value);
    }
}
