<Project Sdk="Microsoft.NET.Sdk">

  <!--
    分析器的代码修复（IDE 里的灯泡、dotnet format）。要引用 Workspaces，不能和生成器放在同一个程序集里（RS1038：编译器只提供编译器的程序集，
    生成器引用 Workspaces 在命令行构建时加载失败），所以单独一个项目，随 Rune 包一起发布。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Rune.CodeFixes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <ProjectReference Include="..\Rune.Generators\Rune.Generators.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
