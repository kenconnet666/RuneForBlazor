<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- 运行时：信号、组件基类、属性合并、样式引擎 -->
  <PropertyGroup>
    <IsLibrary>true</IsLibrary>
    <!-- 公开成员必须写文档注释（CS1591 视为错误）；XML 文档也给文档站的 API 表用 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Rune</RootNamespace>
    <Description>Blazor 组件库底座：信号式的响应式状态（[State] 生成器）、可逐层覆盖的属性合并、强类型的运行时样式与主题。</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rune.Tests" />
    <InternalsVisibleTo Include="Rune.Benchmarks" />
  </ItemGroup>

  <!--
    生成器随 Rune 包一起发布：放进包的 analyzers/dotnet/cs，安装 Rune 就能用 [State]。
    先构建生成器（不作为程序集引用），再把它的输出打进包里。仓库里的项目仍各自以分析器方式引用生成器
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rune.Generators\Rune.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Rune.Generators\bin\$(Configuration)\netstandard2.0\Rune.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- 代码修复（RUNE006 的灯泡、dotnet format）随同一个包发布 -->
    <ProjectReference Include="..\Rune.CodeFixes\Rune.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Rune.CodeFixes\bin\$(Configuration)\netstandard2.0\Rune.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
