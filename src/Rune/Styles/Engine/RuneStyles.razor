@*
    输出当前作用域登记的样式规则，只追加：每次渲染把这期间新登记的规则合成一个 style 元素加在后面，已经输出的不再变。
    （每条规则单独一个 style 元素时，交互模式下翻几页就有几百个，每插入一个浏览器都要重新整理一遍样式表。）
    放置位置：
      1. App.razor 的 head 里：服务端渲染（含增强导航）的样式；
      2. 每个交互根（带 @rendermode 的页面或组件）里：交互模式下新用到的样式；
      3. 流式渲染（[StreamRendering]）的页面末尾：流式更新只发送页面自己的内容，head 里的这一份收不到。
*@
@namespace Rune.Styles
@implements IDisposable
@inject StyleRegistry Registry
@{ Collect(); }

@foreach (var (start, css) in chunks)
{
    <style @key="start" data-rune>@((MarkupString)css)</style>
}

@code {
    readonly List<(int Start, string Css)> chunks = [];
    int collected;
    // 已经排了一次渲染、还没执行：第一次渲染一页会登记几百条规则，只排一次
    int queued;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        // 在渲染器的线程上：把登记表绑定到这个渲染器，之后任何组件（含非 Rune 组件执行的内容片段）都能找到它
        Registry.BindToRenderer();
        Registry.Changed += OnRulesChanged;
    }

    // 上次渲染以来新登记的规则合成一块
    void Collect()
    {
        var added = Registry.RulesFrom(collected);
        if (added.Count == 0) return;
        chunks.Add((collected, string.Concat(added)));
        collected += added.Count;
    }

    // 规则多半在别的组件渲染时登记，这时可能在渲染器的线程上，也可能不在；渲染排着队时不重复排。
    // 先清标记再渲染：渲染时（Collect）取走的是到那一刻为止的全部规则，之后登记的会再排一次
    void OnRulesChanged()
    {
        if (Interlocked.Exchange(ref queued, 1) == 1) return;
        _ = InvokeAsync(() =>
        {
            Volatile.Write(ref queued, 0);
            StateHasChanged();
        });
    }

    /// <inheritdoc/>
    public void Dispose() => Registry.Changed -= OnRulesChanged;
}
