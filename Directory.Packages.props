<Project>
  <!-- 集中管理 NuGet 包版本：各项目的 PackageReference 不写 Version，升级只改这里 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspNetCoreVersion>10.0.14</AspNetCoreVersion>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.13.3" />
  </ItemGroup>

  <ItemGroup Label="源代码生成器">
    <!-- 生成器引用的 Roslyn 版本不能高于使用方的编译器；4.14 对应 .NET 9 SDK / VS 17.14 及以上 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
