<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- 运行时、组件（bUnit）、生成器的测试。xunit v3 的测试项目是可执行程序 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rune.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rune\Rune.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI\Rune.UI.csproj" />
    <ProjectReference Include="..\..\src\Rune.UI.Dates\Rune.UI.Dates.csproj" />
    <!-- 文档内容：目录、示例源码、API 表的读取 -->
    <ProjectReference Include="..\..\apps\Rune.Docs.Content\Rune.Docs.Content.csproj" />
    <!-- 既作为分析器（测试组件里用 [State]），也作为程序集引用（直接驱动生成器做测试） -->
    <ProjectReference Include="..\..\src\Rune.Generators\Rune.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
